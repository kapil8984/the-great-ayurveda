@model Ayurveda.Domain.Entities.Order
@{
    ViewData["Title"] = $"Order Details — #{Model.OrderNumber}";
    var addr = Model.ShippingAddress;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Orders
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">Order #@Model.OrderNumber</h2>
            <p class="text-muted small mb-0">Placed on @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt") • Payment: @Model.PaymentMethod (@Model.PaymentStatus)</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Invoice" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm rounded-pill px-3" target="_blank">
                <i class="bi bi-printer me-1"></i> Print Tax Invoice &amp; Slip
            </a>
            @if (Model.Status != "Cancelled" && User.IsInRole("FinanceManager") || User.IsInRole("SuperAdmin"))
            {
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#refundModal">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Process Refund
                </button>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left: Items & Delivery Address -->
    <div class="col-lg-8">
        <!-- Order Items -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-box-seam text-success me-2"></i>Ordered Formulations</h5>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light small">
                        <tr>
                            <th>Formulation</th>
                            <th class="text-center">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderItems)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold small text-dark">@(item.Product?.Title ?? "Ayurvedic Formulation")</div>
                                    <div class="text-muted" style="font-size: 0.725rem;">SKU: @(item.Product?.Sku ?? "TGA")</div>
                                </td>
                                <td class="text-center fw-semibold">@item.Quantity</td>
                                <td class="text-end text-muted small">₹@item.UnitPrice.ToString("N0")</td>
                                <td class="text-end fw-bold text-success">₹@((item.UnitPrice * item.Quantity).ToString("N0"))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-semibold">Total Amount (Incl. GST):</td>
                            <td class="text-end fw-bold text-success fs-5">₹@Model.TotalAmount.ToString("N0")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- Shipping & Customer Details -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt text-success me-2"></i>Delivery Address &amp; Customer</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="small text-muted text-uppercase fw-semibold mb-1">Customer Profile</div>
                        <div class="fw-bold text-dark">@(Model.User?.FullName ?? "Guest")</div>
                        <div class="small text-muted">@(Model.User?.Email ?? "N/A")</div>
                        <div class="small text-muted">@(Model.User?.ContactNumber ?? "Contact on file")</div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <div class="small text-muted text-uppercase fw-semibold mb-1">Shipping Destination</div>
                        @if (!string.IsNullOrWhiteSpace(Model.ShippingAddress))
                        {
                            <div class="small text-dark fw-medium">@Model.ShippingAddress</div>
                        }
                        else
                        {
                            <div class="small text-muted">Standard courier delivery address</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Status Transition & Dispatch -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-arrow-repeat text-success me-2"></i>Status Progression</h5>
            <form asp-action="UpdateStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Current State</label>
                    <select name="status" class="form-select rounded-3">
                        <option value="Placed" selected="@(Model.Status == "Placed")">Placed / Payment Confirmed</option>
                        <option value="Packed" selected="@(Model.Status == "Packed")">Packed in Warehouse</option>
                        <option value="Shipped" selected="@(Model.Status == "Shipped")">Shipped / In Transit</option>
                        <option value="Delivered" selected="@(Model.Status == "Delivered")">Delivered to Recipient</option>
                        <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled</option>
                        <option value="ReturnRequested" selected="@(Model.Status == "ReturnRequested")">Return Requested</option>
                        <option value="Returned" selected="@(Model.Status == "Returned")">Returned &amp; Closed</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Courier Tracking Number (AWB)</label>
                    <input type="text" name="trackingNumber" value="@Model.TrackingNumber" class="form-control rounded-3" placeholder="e.g. DELHIVERY-8941092" />
                    <small class="text-muted">Delhivery, BlueDart, DTDC or IndiaPost tracking code.</small>
                </div>

                <button type="submit" class="btn btn-success rounded-pill w-100 py-2 shadow-xs">
                    <i class="bi bi-check-lg me-1"></i> Update Order Status
                </button>
            </form>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-shield-check text-success me-1"></i>COD Reconciliation</h6>
            <p class="small text-muted mb-0">For Cash on Delivery orders, delivery logistics partner reconciles payment into the escrow account within 48 hours of delivery.</p>
        </div>
    </div>
</div>

<!-- Refund Modal -->
<div class="modal fade" id="refundModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="ProcessRefund" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="orderId" value="@Model.Id" />
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-arrow-counterclockwise me-2"></i>Process Financial Refund</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Refund Amount (₹)</label>
                        <input type="number" name="amount" value="@Model.TotalAmount" max="@Model.TotalAmount" class="form-control rounded-3" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Refund Reason</label>
                        <textarea name="reason" rows="3" class="form-control rounded-3" placeholder="Defective formulation, customer cancellation, or non-delivery..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Execute Refund</button>
                </div>
            </form>
        </div>
    </div>
</div>
