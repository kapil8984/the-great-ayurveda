@model Ayurveda.Application.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Executive Admin Dashboard";
    var totalConsults = Model.VideoConsultationsCount + Model.AudioConsultationsCount + Model.ChatConsultationsCount;
    var safeConsults = Math.Max(1, totalConsults);
    var videoPct = Math.Round((double)Model.VideoConsultationsCount / safeConsults * 100);
    var audioPct = Math.Round((double)Model.AudioConsultationsCount / safeConsults * 100);
    var chatPct = Math.Round((double)Model.ChatConsultationsCount / safeConsults * 100);

    var totalPipeline = Math.Max(1, Model.OrdersPlacedCount + Model.OrdersShippedCount + Model.OrdersDeliveredCount + Model.OrdersCancelledCount);
    var placedPct = Math.Round((double)Model.OrdersPlacedCount / totalPipeline * 100);
    var shippedPct = Math.Round((double)Model.OrdersShippedCount / totalPipeline * 100);
    var deliveredPct = Math.Round((double)Model.OrdersDeliveredCount / totalPipeline * 100);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-success me-2"></i>Executive Management Console</h2>
        <p class="text-muted small mb-0">Platform health, real-time sales telemetry, telemedicine volume, and operational queue.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success-subtle text-success px-3 py-2 border border-success-subtle rounded-pill">
            <i class="bi bi-broadcast me-1"></i> Systems Operational
        </span>
        <a asp-controller="Settings" asp-action="Health" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-activity me-1"></i> Health Check
        </a>
    </div>
</div>

<!-- 8 Strategic KPI Cards with Animated Count-Ups -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Finance" asp-action="Index" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #10B981 !important;" title="View Financial Breakdown">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Gross Revenue</span>
                    <h3 class="fw-bold text-success mb-0 mt-1 admin-kpi-number" data-target="@Model.TotalRevenue" data-prefix="₹" data-decimals="0">₹@Model.TotalRevenue.ToString("N0")</h3>
                    <small class="text-muted">Total marketplace volume <i class="bi bi-arrow-right ms-1 text-success"></i></small>
                </div>
                <div class="rounded-4 bg-success-subtle text-success p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-currency-rupee"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Orders" asp-action="Index" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #3B82F6 !important;" title="Manage Orders">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Orders Placed</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1 admin-kpi-number" data-target="@Model.TotalOrders">@Model.TotalOrders</h3>
                    <small class="text-muted">Avg: ₹@Model.AverageOrderValue.ToString("N0") AOV <i class="bi bi-arrow-right ms-1 text-primary"></i></small>
                </div>
                <div class="rounded-4 bg-primary-subtle text-primary p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Users" asp-action="Index" asp-route-role="Customer" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #06B6D4 !important;" title="View Registered Patients">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Active Patients</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1 admin-kpi-number" data-target="@Model.TotalCustomers">@Model.TotalCustomers</h3>
                    <small class="text-muted">Registered accounts <i class="bi bi-arrow-right ms-1 text-info"></i></small>
                </div>
                <div class="rounded-4 bg-info-subtle text-info p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Doctors" asp-action="Index" asp-route-status="Approved" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #059669 !important;" title="View Verified Doctors">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Active Vaidyas</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1 admin-kpi-number" data-target="@Model.ActiveDoctorsCount">@Model.ActiveDoctorsCount</h3>
                    <small class="text-muted">Verified &amp; practicing <i class="bi bi-arrow-right ms-1 text-success"></i></small>
                </div>
                <div class="rounded-4 bg-success-subtle text-success p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-hospital"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Appointments" asp-action="Index" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #6366F1 !important;" title="View Today's Tele-Consultations">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Consultations Today</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1 admin-kpi-number" data-target="@Model.ConsultationsTodayCount">@Model.ConsultationsTodayCount</h3>
                    <small class="text-muted">Scheduled for today <i class="bi bi-arrow-right ms-1 text-primary"></i></small>
                </div>
                <div class="rounded-4 bg-primary-subtle text-primary p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-calendar2-heart"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Products" asp-action="Index" asp-route-lowStock="true" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #EF4444 !important;" title="Audit Low-Stock Inventory">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Low-Stock SKUs</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1 admin-kpi-number" data-target="@Model.LowStockProductsCount">@Model.LowStockProductsCount</h3>
                    <small class="text-muted">&lt; 10 units in warehouse <i class="bi bi-arrow-right ms-1 text-danger"></i></small>
                </div>
                <div class="rounded-4 bg-danger-subtle text-danger p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Doctors" asp-action="Pending" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #F59E0B !important;" title="Review Pending Doctor Approvals">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Doctor Approvals</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1 admin-kpi-number" data-target="@Model.PendingDoctorApprovals">@Model.PendingDoctorApprovals</h3>
                    <small class="text-muted">Credentials awaiting audit <i class="bi bi-arrow-right ms-1 text-warning"></i></small>
                </div>
                <div class="rounded-4 bg-warning-subtle text-warning p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-person-exclamation"></i>
                </div>
            </div>
        </a>
    </div>

    <div class="col-sm-6 col-xl-3">
        <a asp-controller="Finance" asp-action="Index" class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100 admin-kpi-card text-decoration-none d-block" style="border-top: 3px solid #14B8A6 !important;" title="View Average Order Value Analytics">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold" style="letter-spacing: 0.5px; font-size: 0.75rem;">Average Order Value</span>
                    <h3 class="fw-bold text-success mb-0 mt-1 admin-kpi-number" data-target="@Model.AverageOrderValue" data-prefix="₹" data-decimals="0">₹@Model.AverageOrderValue.ToString("N0")</h3>
                    <small class="text-muted">Basket size telemetry <i class="bi bi-arrow-right ms-1 text-success"></i></small>
                </div>
                <div class="rounded-4 bg-success-subtle text-success p-3 fs-4 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-graph-up"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Middle Row: 7-Day Sales Trend (Chart.js Line) & Telemedicine Real Counts -->
<div class="row g-4 mb-4">
    <!-- Chart.js 7-Day Sales Trend Line Chart -->
    <div class="col-lg-8">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-up text-success me-2"></i>7-Day Marketplace Sales Trend</h5>
                    <small class="text-muted">Real-time daily transaction volume via Chart.js</small>
                </div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1">
                    <i class="bi bi-circle-fill text-success me-1" style="font-size: 0.5rem;"></i> Live Telemetry
                </span>
            </div>

            <div style="position: relative; height: 260px; width: 100%;">
                <canvas id="adminSalesTrendChart" 
                        data-dates='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrendDates))' 
                        data-amounts='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrendAmounts))'></canvas>
            </div>
        </div>
    </div>

    <!-- Telemedicine Volume Distribution from REAL database counts -->
    <div class="col-lg-4">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-broadcast text-primary me-2"></i>Consultation Modes</h5>
                <a asp-controller="Appointments" asp-action="Index" class="small text-decoration-none text-success">All Sessions</a>
            </div>

            <div class="d-flex flex-column gap-3 py-2">
                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span><i class="bi bi-camera-video text-primary me-1"></i> HD Video Consultations</span>
                        <span class="text-primary">@videoPct% (@Model.VideoConsultationsCount)</span>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 6px; background-color: var(--admin-border-subtle);">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(videoPct)%; transition: width 0.8s ease;" aria-valuenow="@videoPct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span><i class="bi bi-telephone text-success me-1"></i> Audio Tele-Calls</span>
                        <span class="text-success">@audioPct% (@Model.AudioConsultationsCount)</span>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 6px; background-color: var(--admin-border-subtle);">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @(audioPct)%; transition: width 0.8s ease;" aria-valuenow="@audioPct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span><i class="bi bi-chat-dots text-warning me-1"></i> Clinical Chat Consultations</span>
                        <span class="text-warning">@chatPct% (@Model.ChatConsultationsCount)</span>
                    </div>
                    <div class="progress" style="height: 10px; border-radius: 6px; background-color: var(--admin-border-subtle);">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(chatPct)%; transition: width 0.8s ease;" aria-valuenow="@chatPct" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>

            <hr class="my-3 opacity-25" />

            <div class="d-flex justify-content-between small text-muted">
                <span>Total Booked: <strong class="text-dark">@totalConsults</strong></span>
                <span class="text-success"><i class="bi bi-shield-lock me-1"></i> Real DB Counts</span>
            </div>
        </div>
    </div>
</div>

<!-- Secondary Charts & Order Pipeline Funnel Row -->
<div class="row g-4 mb-4">
    <!-- Chart.js Category Distribution Doughnut -->
    <div class="col-lg-4">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart text-success me-2"></i>Category Share</h5>
                <a asp-controller="Categories" asp-action="Index" class="small text-success text-decoration-none">Manage</a>
            </div>
            <div style="position: relative; height: 230px; width: 100%;">
                <canvas id="adminCategoryShareChart" 
                        data-labels='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryDistribution.Select(c => c.CategoryName)))' 
                        data-counts='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryDistribution.Select(c => c.ProductCount)))'></canvas>
            </div>
        </div>
    </div>

    <!-- Chart.js Top Products Bar Chart -->
    <div class="col-lg-4">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart text-primary me-2"></i>Top Formulations</h5>
                <a asp-controller="Products" asp-action="Index" class="small text-success text-decoration-none">Catalog</a>
            </div>
            <div style="position: relative; height: 230px; width: 100%;">
                <canvas id="adminTopProductsChart" 
                        data-titles='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.Title)))' 
                        data-prices='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopSellingProducts.Select(p => p.Price)))'></canvas>
            </div>
        </div>
    </div>

    <!-- Order Pipeline Funnel -->
    <div class="col-lg-4">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-funnel text-warning me-2"></i>Order Pipeline Funnel</h5>
                <a asp-controller="Orders" asp-action="Index" class="small text-success text-decoration-none">Orders Queue</a>
            </div>

            <div class="d-flex flex-column gap-3 py-1">
                <div class="p-2 rounded-3" style="background: rgba(59, 130, 246, 0.08);">
                    <div class="d-flex justify-content-between small fw-bold text-primary mb-1">
                        <span><i class="bi bi-box me-1"></i> Placed &amp; Processing</span>
                        <span>@Model.OrdersPlacedCount (@placedPct%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-primary" style="width: @(placedPct)%"></div>
                    </div>
                </div>

                <div class="p-2 rounded-3" style="background: rgba(227, 167, 47, 0.08);">
                    <div class="d-flex justify-content-between small fw-bold text-warning mb-1">
                        <span><i class="bi bi-truck me-1"></i> Dispatched / In Transit</span>
                        <span>@Model.OrdersShippedCount (@shippedPct%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-warning" style="width: @(shippedPct)%"></div>
                    </div>
                </div>

                <div class="p-2 rounded-3" style="background: rgba(31, 94, 59, 0.08);">
                    <div class="d-flex justify-content-between small fw-bold text-success mb-1">
                        <span><i class="bi bi-check2-circle me-1"></i> Fulfilled &amp; Delivered</span>
                        <span>@Model.OrdersDeliveredCount (@deliveredPct%)</span>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success" style="width: @(deliveredPct)%"></div>
                    </div>
                </div>

                @if (Model.OrdersCancelledCount > 0)
                {
                    <div class="p-2 rounded-3" style="background: rgba(239, 68, 68, 0.08);">
                        <div class="d-flex justify-content-between small fw-bold text-danger mb-1">
                            <span><i class="bi bi-x-circle me-1"></i> Cancelled</span>
                            <span>@Model.OrdersCancelledCount</span>
                        </div>
                    </div>
                }
            </div>

            <hr class="my-2 opacity-25" />
            <div class="small text-muted text-center">
                Total pipeline volume: <strong class="text-dark">@Model.TotalOrders</strong> orders
            </div>
        </div>
    </div>
</div>

<!-- Operational Section: Pending Approvals, Recent Orders, Low Stock Alerts -->
<div class="row g-4 mb-4">
    <!-- Doctor Verification Queue -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-check text-warning me-2"></i>Doctor Verification Queue</h5>
                <a asp-controller="Doctors" asp-action="Pending" class="small text-success fw-semibold text-decoration-none">Manage Queue</a>
            </div>

            @if (Model.PendingDoctors != null && Model.PendingDoctors.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var doc in Model.PendingDoctors)
                    {
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center border-bottom">
                            <div>
                                <h6 class="fw-bold mb-1">Dr. @doc.DoctorName</h6>
                                <div class="small text-muted">@doc.Qualification • @doc.ExperienceYears Yrs Exp • @doc.Specialization</div>
                                <div class="small text-muted">@doc.Email</div>
                            </div>
                            <div class="d-flex gap-2">
                                <form asp-controller="Doctors" asp-action="Approve" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs">Approve</button>
                                </form>
                                <a asp-controller="Doctors" asp-action="Pending" class="btn btn-outline-secondary btn-sm rounded-pill px-2">Review</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-patch-check-fill text-success fs-2 d-block mb-2"></i>
                    <p class="small mb-0">All applicant credentials reviewed. Verification queue clear.</p>
                </div>
            }
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-cart-check text-primary me-2"></i>Recent Orders</h5>
                <a asp-controller="Orders" asp-action="Index" class="small text-success fw-semibold text-decoration-none">View All Orders</a>
            </div>

            @if (Model.RecentOrders != null && Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Order Ref</th>
                                <th>Customer</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="fw-bold small text-decoration-none text-dark">
                                            #@order.OrderNumber
                                        </a>
                                        <div class="text-muted" style="font-size: 0.725rem;">@order.OrderDate.ToString("dd MMM, hh:mm tt")</div>
                                    </td>
                                    <td class="small text-truncate" style="max-width: 140px;">@order.CustomerEmail</td>
                                    <td class="text-end fw-bold text-success small">₹@order.TotalAmount.ToString("N0")</td>
                                    <td class="text-center">
                                        @{
                                            var st = (order.Status ?? "").ToLowerInvariant();
                                            var badgeClass = st.Contains("deliver") ? "bg-success-subtle text-success border border-success-subtle" :
                                                             (st.Contains("ship") || st.Contains("transit")) ? "bg-info-subtle text-info border border-info-subtle" :
                                                             (st.Contains("cancel")) ? "bg-danger-subtle text-danger border border-danger-subtle" :
                                                             "bg-primary-subtle text-primary border border-primary-subtle";
                                        }
                                        <span class="badge @badgeClass rounded-pill px-2 py-1">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small py-4 text-center mb-0">No customer orders placed yet.</p>
            }
        </div>
    </div>
</div>

<!-- Bottom Row: Low Stock Alerts & Live-Looking Activity Feed -->
<div class="row g-4">
    <!-- Low Stock Inventory Alerts -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Inventory Replenishment Alerts</h5>
                <a asp-controller="Products" asp-action="Index" asp-route-lowStock="true" class="small text-danger fw-semibold text-decoration-none">Manage Stock</a>
            </div>

            @if (Model.LowStockAlerts != null && Model.LowStockAlerts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Formulation SKU</th>
                                <th>Unit Price</th>
                                <th class="text-center">Stock Left</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.LowStockAlerts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold small text-dark">@p.Title</div>
                                        <span class="badge bg-light text-muted border font-monospace">@p.Sku</span>
                                    </td>
                                    <td class="small fw-semibold text-muted">₹@p.Price</td>
                                    <td class="text-center">
                                        <span class="badge bg-danger-subtle text-danger fw-bold fs-6 px-2 py-1">@p.StockQuantity</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill">
                                            Restock
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                    All formulation SKUs have healthy inventory balances.
                </div>
            }
        </div>
    </div>

    <!-- Live Activity Feed (Audit Trail) -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-activity text-success me-2"></i>Live Activity Feed</h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small" style="font-size: 0.65rem;">
                        <span class="spinner-grow spinner-grow-sm me-1 text-success" style="width: 0.5rem; height: 0.5rem;"></span> Real-time
                    </span>
                </div>
                <a asp-controller="Audit" asp-action="Index" class="small text-success fw-semibold text-decoration-none">Audit Trail</a>
            </div>

            @if (Model.RecentAuditLogs != null && Model.RecentAuditLogs.Any())
            {
                <div class="activity-feed-timeline">
                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        var dotColor = log.Action.Contains("Approve") ? "success" : log.Action.Contains("Delete") ? "danger" : "primary";
                        <div class="activity-feed-item">
                            <span class="activity-feed-dot bg-@dotColor"></span>
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span class="badge bg-@dotColor-subtle text-@dotColor small">@log.Action</span>
                                <span class="activity-feed-time">@log.Timestamp.ToString("dd MMM, hh:mm tt")</span>
                            </div>
                            <div class="small fw-semibold text-dark mt-1">@log.EntityName: @log.Details</div>
                            <div class="text-muted" style="font-size: 0.725rem;">Actor: @log.UserEmail (IP: @log.IpAddress)</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small py-4 text-center mb-0">No administrative events recorded today.</p>
            }
        </div>
    </div>
</div>
