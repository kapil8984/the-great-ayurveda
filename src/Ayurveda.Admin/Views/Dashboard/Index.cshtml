@model Ayurveda.Application.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Executive Admin Dashboard";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-speedometer2 text-success me-2"></i>Executive Management Console</h2>
        <p class="text-muted small mb-0">Platform health, real-time sales telemetry, telemedicine volume, and operational queue.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success-subtle text-success px-3 py-2 border border-success-subtle rounded-pill">
            <i class="bi bi-broadcast me-1"></i> Systems Operational
        </span>
        <a asp-controller="Settings" asp-action="Health" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-activity me-1"></i> Health Check
        </a>
    </div>
</div>

<!-- 8 Strategic KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Gross Revenue</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">₹@Model.TotalRevenue.ToString("N0")</h3>
                    <small class="text-muted">Total marketplace volume</small>
                </div>
                <div class="rounded-circle bg-success-subtle text-success p-3 fs-4">
                    <i class="bi bi-currency-rupee"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Orders Placed</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalOrders</h3>
                    <small class="text-muted">Avg: ₹@Model.AverageOrderValue.ToString("N0") AOV</small>
                </div>
                <div class="rounded-circle bg-primary-subtle text-primary p-3 fs-4">
                    <i class="bi bi-cart-check"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Active Patients</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalCustomers</h3>
                    <small class="text-muted">Registered accounts</small>
                </div>
                <div class="rounded-circle bg-info-subtle text-info p-3 fs-4">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Active Vaidyas</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.ActiveDoctorsCount</h3>
                    <small class="text-muted">Verified &amp; practicing</small>
                </div>
                <div class="rounded-circle bg-success-subtle text-success p-3 fs-4">
                    <i class="bi bi-hospital"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Consultations Today</span>
                    <h3 class="fw-bold text-primary mb-0 mt-1">@Model.ConsultationsTodayCount</h3>
                    <small class="text-muted">Scheduled for today</small>
                </div>
                <div class="rounded-circle bg-primary-subtle text-primary p-3 fs-4">
                    <i class="bi bi-calendar2-heart"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Low-Stock SKUs</span>
                    <h3 class="fw-bold text-danger mb-0 mt-1">@Model.LowStockProductsCount</h3>
                    <small class="text-muted">&lt; 10 units in warehouse</small>
                </div>
                <div class="rounded-circle bg-danger-subtle text-danger p-3 fs-4">
                    <i class="bi bi-exclamation-octagon"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Doctor Approvals</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@Model.PendingDoctorApprovals</h3>
                    <small class="text-muted">Credentials awaiting audit</small>
                </div>
                <div class="rounded-circle bg-warning-subtle text-warning p-3 fs-4">
                    <i class="bi bi-person-exclamation"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Average Order Value</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">₹@Model.AverageOrderValue.ToString("N0")</h3>
                    <small class="text-muted">Basket size telemetry</small>
                </div>
                <div class="rounded-circle bg-success-subtle text-success p-3 fs-4">
                    <i class="bi bi-graph-up"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Middle Row: Sales Trend & Telemedicine Mode Distribution -->
<div class="row g-4 mb-4">
    <!-- 7-Day Sales Trend Bar Chart -->
    <div class="col-lg-8">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-line text-success me-2"></i>7-Day Marketplace Sales Trend</h5>
                <span class="badge bg-light text-dark border">Recent Daily Gross</span>
            </div>

            <div class="d-flex align-items-end justify-content-between gap-2 pt-4 pb-2" style="height: 180px;">
                @{
                    var maxSales = Model.SalesTrendAmounts.Any() ? Math.Max(1m, Model.SalesTrendAmounts.Max()) : 1m;
                }
                @for (int i = 0; i < Model.SalesTrendDates.Count; i++)
                {
                    var date = Model.SalesTrendDates[i];
                    var amt = Model.SalesTrendAmounts[i];
                    var heightPct = Math.Max(12, (int)Math.Round((amt / maxSales) * 100));

                    <div class="d-flex flex-column align-items-center flex-grow-1" style="height: 100%;">
                        <div class="small fw-bold text-muted mb-auto" style="font-size: 0.7rem;">₹@amt.ToString("N0")</div>
                        <div class="w-100 rounded-3 bg-success opacity-75 hover-opacity-100 transition" 
                             style="height: @(heightPct)%; max-width: 44px; min-height: 12px;" 
                             title="@date: ₹@amt.ToString("N0")"></div>
                        <div class="small text-muted mt-2 fw-semibold" style="font-size: 0.75rem;">@date</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Telemedicine Volume Distribution -->
    <div class="col-lg-4">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-broadcast text-primary me-2"></i>Consultation Modes</h5>
                <a asp-controller="Appointments" asp-action="Index" class="small text-decoration-none text-success">All Sessions</a>
            </div>

            <div class="d-flex flex-column gap-3 py-2">
                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span><i class="bi bi-camera-video text-primary me-1"></i> HD Video Consultations</span>
                        <span>@Model.VideoConsultationsCount</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @(Model.VideoConsultationsCount > 0 ? 65 : 20)%"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span><i class="bi bi-telephone text-success me-1"></i> Audio Tele-Calls</span>
                        <span>@Model.AudioConsultationsCount</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-success" role="progressbar" style="width: @(Model.AudioConsultationsCount > 0 ? 25 : 15)%"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between small fw-bold mb-1">
                        <span><i class="bi bi-chat-dots text-warning me-1"></i> Clinical Chat Consultations</span>
                        <span>@Model.ChatConsultationsCount</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-warning" role="progressbar" style="width: @(Model.ChatConsultationsCount > 0 ? 10 : 10)%"></div>
                    </div>
                </div>
            </div>

            <hr class="my-3" />

            <div class="d-flex justify-content-between small text-muted">
                <span>Total Booked: <strong>@(Model.VideoConsultationsCount + Model.AudioConsultationsCount + Model.ChatConsultationsCount)</strong></span>
                <span class="text-success"><i class="bi bi-shield-lock me-1"></i> Encrypted Rooms</span>
            </div>
        </div>
    </div>
</div>

<!-- Operational Section: Pending Approvals, Recent Orders, Low Stock Alerts -->
<div class="row g-4 mb-4">
    <!-- Doctor Verification Queue -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-person-check text-warning me-2"></i>Doctor Verification Queue</h5>
                <a asp-controller="Doctors" asp-action="Pending" class="small text-success fw-semibold text-decoration-none">Manage Queue</a>
            </div>

            @if (Model.PendingDoctors != null && Model.PendingDoctors.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var doc in Model.PendingDoctors)
                    {
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">Dr. @doc.DoctorName</h6>
                                <div class="small text-muted">@doc.Qualification • @doc.ExperienceYears Yrs Exp • @doc.Specialization</div>
                                <div class="small text-muted">@doc.Email</div>
                            </div>
                            <div class="d-flex gap-2">
                                <form asp-controller="Doctors" asp-action="Approve" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs">Approve</button>
                                </form>
                                <a asp-controller="Doctors" asp-action="Pending" class="btn btn-outline-secondary btn-sm rounded-pill px-2">Review</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-patch-check-fill text-success fs-2 d-block mb-2"></i>
                    <p class="small mb-0">All applicant credentials reviewed. Verification queue clear.</p>
                </div>
            }
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-cart-check text-primary me-2"></i>Recent Orders</h5>
                <a asp-controller="Orders" asp-action="Index" class="small text-success fw-semibold text-decoration-none">View All Orders</a>
            </div>

            @if (Model.RecentOrders != null && Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Order Ref</th>
                                <th>Customer</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="fw-bold small text-decoration-none text-dark">
                                            #@order.OrderNumber
                                        </a>
                                        <div class="text-muted" style="font-size: 0.725rem;">@order.OrderDate.ToString("dd MMM, hh:mm tt")</div>
                                    </td>
                                    <td class="small text-truncate" style="max-width: 140px;">@order.CustomerEmail</td>
                                    <td class="text-end fw-bold text-success small">₹@order.TotalAmount.ToString("N0")</td>
                                    <td class="text-center"><span class="badge bg-success-subtle text-success">@order.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small py-4 text-center mb-0">No customer orders placed yet.</p>
            }
        </div>
    </div>
</div>

<!-- Bottom Row: Low Stock Alerts & Recent Audit Activity -->
<div class="row g-4">
    <!-- Low Stock Inventory Alerts -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Inventory Replenishment Alerts</h5>
                <a asp-controller="Products" asp-action="Index" asp-route-lowStock="true" class="small text-danger fw-semibold text-decoration-none">Manage Stock</a>
            </div>

            @if (Model.LowStockAlerts != null && Model.LowStockAlerts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Formulation SKU</th>
                                <th>Unit Price</th>
                                <th class="text-center">Stock Left</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.LowStockAlerts)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold small text-dark">@p.Title</div>
                                        <span class="badge bg-light text-muted border font-monospace">@p.Sku</span>
                                    </td>
                                    <td class="small fw-semibold text-muted">₹@p.Price</td>
                                    <td class="text-center">
                                        <span class="badge bg-danger-subtle text-danger fw-bold fs-6 px-2 py-1">@p.StockQuantity</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill">
                                            Restock
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                    All formulation SKUs have healthy inventory balances.
                </div>
            }
        </div>
    </div>

    <!-- Recent System Audit Activity -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-shield-check text-success me-2"></i>Recent Security Audit Trail</h5>
                <a asp-controller="Audit" asp-action="Index" class="small text-success fw-semibold text-decoration-none">Complete Audit Log</a>
            </div>

            @if (Model.RecentAuditLogs != null && Model.RecentAuditLogs.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var log in Model.RecentAuditLogs)
                    {
                        <div class="list-group-item px-0 py-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="badge bg-secondary-subtle text-secondary small">@log.Action</span>
                                <span class="text-muted" style="font-size: 0.725rem;">@log.Timestamp.ToString("dd MMM, hh:mm tt")</span>
                            </div>
                            <div class="small fw-semibold text-dark">@log.EntityName: @log.Details</div>
                            <div class="text-muted" style="font-size: 0.725rem;">Actor: @log.UserEmail (IP: @log.IpAddress)</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small py-4 text-center mb-0">No administrative events recorded today.</p>
            }
        </div>
    </div>
</div>
