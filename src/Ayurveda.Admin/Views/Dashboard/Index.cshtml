@model Ayurveda.Application.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Overview";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Administrative Dashboard</h2>
        <p class="text-muted small mb-0">Platform performance, doctor approvals, and live fulfillment metrics</p>
    </div>
    <div>
        <span class="badge bg-success-subtle text-success px-3 py-2"><i class="bi bi-broadcast me-1"></i> System Healthy</span>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Gross Revenue</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">₹@Model.TotalRevenue.ToString("N0")</h3>
                </div>
                <div class="rounded-3 bg-success-subtle text-success p-3 fs-4">
                    <i class="bi bi-currency-rupee"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Orders Placed</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalOrders</h3>
                </div>
                <div class="rounded-3 bg-primary-subtle text-primary p-3 fs-4">
                    <i class="bi bi-box-seam"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Active Patients</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@Model.TotalCustomers</h3>
                </div>
                <div class="rounded-3 bg-info-subtle text-info p-3 fs-4">
                    <i class="bi bi-people"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-3 bg-white">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small text-uppercase fw-semibold">Pending Doctors</span>
                    <h3 class="fw-bold text-warning mb-0 mt-1">@Model.PendingDoctorApprovals</h3>
                </div>
                <div class="rounded-3 bg-warning-subtle text-warning p-3 fs-4">
                    <i class="bi bi-person-exclamation"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Pending Doctor Verifications -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Doctor Verification Queue</h5>
                <a asp-controller="Doctors" asp-action="Pending" class="small text-success fw-semibold text-decoration-none">View All</a>
            </div>

            @if (Model.PendingDoctors != null && Model.PendingDoctors.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var doc in Model.PendingDoctors)
                    {
                        <div class="list-group-item px-0 py-3 d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">Dr. @doc.DoctorName</h6>
                                <div class="small text-muted">@doc.Qualification • @doc.ExperienceYears Yrs Exp</div>
                                <div class="small text-muted">@doc.Email</div>
                            </div>
                            <div>
                                <form asp-controller="Doctors" asp-action="Approve" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">Approve</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small py-4 text-center mb-0">No physician applications awaiting review.</p>
            }
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="col-lg-6">
        <div class="card p-4 border-0 shadow-sm rounded-4 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Recent Orders</h5>
                <a asp-controller="Orders" asp-action="Index" class="small text-success fw-semibold text-decoration-none">View All</a>
            </div>

            @if (Model.RecentOrders != null && Model.RecentOrders.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Order</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold small">#@order.OrderNumber</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">@order.CustomerEmail</div>
                                    </td>
                                    <td class="fw-bold text-success small">₹@order.TotalAmount.ToString("N0")</td>
                                    <td><span class="badge bg-success-subtle text-success">@order.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small py-4 text-center mb-0">No orders placed yet.</p>
            }
        </div>
    </div>
</div>
