@{
    ViewData["Title"] = "Admin Account Activation • Verify OTP";
    Layout = null;
    var email = ViewBag.Email as string ?? "";
    var returnUrl = ViewBag.ReturnUrl as string ?? "";
    var hasError = !ViewData.ModelState.IsValid;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account Activation • The Great Ayurveda Admin</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0C1E14" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        :root {
            --tga-forest-deep: #08150E;
            --tga-forest-base: #0E2418;
            --tga-forest-surface: #153423;
            --tga-forest-light: #204B34;
            --tga-gold-primary: #D4AF37;
            --tga-gold-light: #F3E5AB;
            --tga-emerald: #10B981;
        }

        body {
            background: radial-gradient(circle at 50% 20%, #153423 0%, #08150E 100%);
            min-height: 100vh;
            color: #E2E8F0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 1.5rem;
        }

        .auth-card {
            background: rgba(14, 36, 24, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 1.25rem;
            max-width: 440px;
            width: 100%;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.45);
        }

        .otp-input {
            letter-spacing: 0.35em;
            background: rgba(8, 21, 14, 0.6) !important;
            border: 2px solid rgba(212, 175, 55, 0.4) !important;
            color: #FFFFFF !important;
            font-size: 1.75rem !important;
            border-radius: 0.75rem !important;
        }

        .otp-input:focus {
            border-color: var(--tga-gold-primary) !important;
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.25) !important;
        }

        .btn-gold {
            background: linear-gradient(135deg, #D4AF37 0%, #AA820A 100%);
            color: #08150E;
            font-weight: 700;
            border: none;
            border-radius: 9999px;
            padding: 0.75rem 1.5rem;
            transition: all 0.2s ease;
        }

        .btn-gold:hover {
            background: linear-gradient(135deg, #F3E5AB 0%, #D4AF37 100%);
            color: #08150E;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="auth-card p-4 p-sm-5 text-center">
        <div class="mb-3">
            <div class="d-inline-flex p-3 rounded-circle bg-success-subtle text-success fs-2 mb-2">
                <i class="bi bi-shield-lock-fill" style="color: #10B981;"></i>
            </div>
            <h4 class="fw-bold mb-1" style="color: #F3E5AB;">Account Activation</h4>
            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill small mb-2">Registration OTP Required</span>
            <p class="text-muted small mt-2 mb-0">
                A 6-digit registration verification code has been dispatched to your corporate email:<br />
                <strong class="text-light font-monospace">@email</strong>
            </p>
        </div>

        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning py-2 small border-0 text-start mb-3">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["WarningMessage"]
            </div>
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success py-2 small border-0 text-start mb-3">
                <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger py-2 small border-0 text-start mb-3">
                <i class="bi bi-x-circle me-1"></i> @TempData["ErrorMessage"]
            </div>
        }
        @if (hasError)
        {
            <div class="alert alert-danger py-2 small border-0 text-start mb-3">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="VerifyOtp" method="post" class="mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="email" value="@email" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="mb-3">
                <label class="form-label text-xs text-uppercase tracking-wider fw-bold text-muted d-block">Enter 6-Digit Code</label>
                <input type="text"
                       name="otp"
                       class="form-control text-center font-monospace fw-bold otp-input"
                       maxlength="6"
                       placeholder="000000"
                       autocomplete="one-time-code"
                       inputmode="numeric"
                       required
                       autofocus />
            </div>

            <button type="submit" class="btn btn-gold w-100 mb-2">
                <i class="bi bi-check2-circle me-1"></i> Verify &amp; Activate Account
            </button>
        </form>

        <div class="d-flex justify-content-between align-items-center pt-3 border-top border-secondary">
            <form asp-action="ResendOtp" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="email" value="@email" />
                <button type="submit" class="btn btn-link text-decoration-none text-light small p-0 opacity-75">
                    <i class="bi bi-arrow-repeat me-1"></i> Resend Code
                </button>
            </form>
            <a asp-action="Login" class="text-decoration-none text-muted small">
                <i class="bi bi-box-arrow-in-left me-1"></i> Return to Sign In
            </a>
        </div>
    </div>
</body>
</html>
