@model Ayurveda.Application.ViewModels.AdminLoginViewModel
@{
    ViewData["Title"] = "Admin Security Authentication";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Sign In | The Great Ayurveda</title>
    <meta name="theme-color" content="#18221D" />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/admin.webmanifest" />

    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <style>
        body {
            background-color: #0F1612;
            color: #E2E8F0;
            font-family: system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .admin-login-card {
            background: #18221D;
            border: 1px solid #28392F;
            border-radius: 20px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            max-width: 440px;
            width: 100%;
        }
        .form-control {
            background-color: #121A15;
            border: 1px solid #2C3E34;
            color: #FFFFFF;
        }
        .form-control:focus {
            background-color: #121A15;
            border-color: #2C7E50;
            color: #FFFFFF;
            box-shadow: 0 0 0 0.25rem rgba(44, 126, 80, 0.25);
        }
    </style>
</head>
<body>
    <div class="admin-login-card p-4 p-md-5">
        <div class="text-center mb-4">
            <img src="/images/admin-logo-full.svg" alt="The Great Ayurveda Admin Portal" height="46" class="img-fluid" />
            <div class="mt-2 text-warning small fw-bold letter-spacing-1">
                RESTRICTED ACCESS • AUTHORIZED PERSONNEL ONLY
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 small border-0 rounded-3 mb-3" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Login" method="post" id="adminLoginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label asp-for="Email" class="form-label small text-light opacity-75">Admin Email *</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted border-end-0"><i class="bi bi-shield-lock"></i></span>
                    <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="admin@thegreatayurveda.com" required autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small text-light opacity-75">Master Password *</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted border-end-0"><i class="bi bi-key"></i></span>
                    <input asp-for="Password" type="password" class="form-control border-start-0 border-end-0 ps-0" id="adminPwdInput" placeholder="••••••••" required autocomplete="current-password" />
                    <button type="button" class="input-group-text bg-dark border-secondary text-muted border-start-0" id="toggleAdminPwdBtn" aria-label="Toggle password visibility">
                        <i class="bi bi-eye" id="toggleAdminPwdIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <!-- TOTP 2FA Authenticator Code Input -->
            <div class="mb-3">
                <label asp-for="TotpCode" class="form-label small text-light opacity-75">
                    Authenticator Code (2FA) <span class="text-muted">(Optional if not enabled)</span>
                </label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-secondary text-muted border-end-0"><i class="bi bi-phone"></i></span>
                    <input asp-for="TotpCode" type="text" maxlength="6" class="form-control border-start-0 ps-0" placeholder="6-digit TOTP code" inputmode="numeric" />
                </div>
                <span asp-validation-for="TotpCode" class="text-danger small"></span>
            </div>

            <!-- Caps Lock Alert -->
            <div id="adminCapsLockAlert" class="alert alert-warning py-1 px-2 text-xs d-none my-2 rounded-2" role="alert">
                <i class="bi bi-capslock-fill me-1"></i> <strong>Caps Lock is ON</strong>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" id="adminRememberCheck" />
                <label class="form-check-label small text-light opacity-75" for="adminRememberCheck">Keep session active</label>
            </div>

            <button type="submit" class="btn btn-warning text-dark fw-bold w-100 py-2 rounded-pill shadow mb-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Authenticate Administrative Session
            </button>
        </form>

        <div class="border-top border-secondary pt-3 text-center text-xs text-muted">
            <i class="bi bi-shield-shaded me-1"></i> All administrative access attempts are IP logged &amp; monitored.
        </div>
    </div>

    <script>
        const aToggle = document.getElementById("toggleAdminPwdBtn");
        const aPwd = document.getElementById("adminPwdInput");
        const aIcon = document.getElementById("toggleAdminPwdIcon");
        const aCaps = document.getElementById("adminCapsLockAlert");

        if (aToggle && aPwd && aIcon) {
            aToggle.addEventListener("click", () => {
                const isPwd = aPwd.getAttribute("type") === "password";
                aPwd.setAttribute("type", isPwd ? "text" : "password");
                aIcon.className = isPwd ? "bi bi-eye-slash" : "bi bi-eye";
            });
        }

        if (aPwd && aCaps) {
            aPwd.addEventListener("keyup", function (e) {
                if (e.getModifierState && e.getModifierState("CapsLock")) {
                    aCaps.classList.remove("d-none");
                } else {
                    aCaps.classList.add("d-none");
                }
            });
        }
    </script>
</body>
</html>
