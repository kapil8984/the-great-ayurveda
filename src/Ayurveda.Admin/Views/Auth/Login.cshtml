@model Ayurveda.Application.ViewModels.AdminLoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Environment
@{
    ViewData["Title"] = "Admin Security Authentication";
    Layout = null;
    var showChips = Environment.IsDevelopment() && Configuration.GetValue<bool>("DemoMode:ShowCredentialChips", false);
    var devAdminPassword = showChips ? (Configuration["DevDemo:AdminPassword"] ?? "") : "";
    var hasError = !ViewData.ModelState.IsValid;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Portal • The Great Ayurveda</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0C1E14" />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/admin.webmanifest" />

    <!-- Local Assets Only (No CDN) -->
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        :root {
            --tga-forest-deep: #08150E;
            --tga-forest-base: #0E2418;
            --tga-forest-surface: #153423;
            --tga-forest-light: #204B34;
            --tga-gold-primary: #D4AF37;
            --tga-gold-light: #F3E5AB;
            --tga-gold-dark: #AA820A;
            --tga-emerald: #10B981;
            --tga-ink-light: #E6ECE8;
            --tga-ink-muted: #94A39B;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--tga-forest-deep);
            color: var(--tga-ink-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            align-items: stretch;
        }

        /* ----------------------------------------------------------------------
           SPLIT SCREEN VIEWPORT CONTAINER
           ---------------------------------------------------------------------- */
        .admin-login-layout {
            display: flex;
            width: 100vw;
            min-height: 100vh;
            position: relative;
        }

        /* ----------------------------------------------------------------------
           LEFT 60%: BRANDED SACRED AMBIENCE SCENE
           ---------------------------------------------------------------------- */
        .ambient-brand-pane {
            flex: 0 0 60%;
            width: 60%;
            background: radial-gradient(circle at 20% 30%, #153A26 0%, #0E2418 50%, #06120B 100%);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 3.5rem 4.5rem;
            border-right: 1px solid rgba(212, 175, 55, 0.15);
        }

        /* Ambient Glowing Gradient Orbs */
        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            opacity: 0.55;
            will-change: transform;
            animation: orbFloat 18s ease-in-out infinite alternate;
        }

        .orb-gold {
            width: 420px;
            height: 420px;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.4) 0%, rgba(212, 175, 55, 0) 70%);
            top: -60px;
            left: -80px;
        }

        .orb-emerald {
            width: 500px;
            height: 500px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.35) 0%, rgba(16, 185, 129, 0) 70%);
            bottom: -100px;
            right: 5%;
            animation-duration: 24s;
            animation-direction: alternate-reverse;
        }

        @@keyframes orbFloat {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(40px, 30px) scale(1.08); }
            100% { transform: translate(-30px, 50px) scale(0.95); }
        }

        /* Slowly Rotating Mandala */
        .mandala-wrap {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 640px;
            height: 640px;
            opacity: 0.12;
            pointer-events: none;
            animation: rotateMandala 90s linear infinite;
            will-change: transform;
        }

        @@keyframes rotateMandala {
            from { transform: translate(-50%, -50%) rotate(0deg); }
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }

        /* Floating Leaves & Particle Drift */
        .particle-drift-layer {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .drift-leaf {
            position: absolute;
            opacity: 0.25;
            animation: floatLeaf 16s ease-in-out infinite;
            color: var(--tga-gold-primary);
        }

        .leaf-1 { top: 15%; left: 12%; animation-duration: 14s; font-size: 1.4rem; }
        .leaf-2 { top: 65%; left: 22%; animation-duration: 19s; font-size: 1.8rem; animation-delay: 2s; }
        .leaf-3 { top: 35%; left: 78%; animation-duration: 17s; font-size: 1.2rem; animation-delay: 4s; }
        .leaf-4 { top: 82%; left: 70%; animation-duration: 22s; font-size: 1.6rem; animation-delay: 1s; }
        .leaf-5 { top: 48%; left: 45%; animation-duration: 25s; font-size: 1rem; animation-delay: 3s; }

        @@keyframes floatLeaf {
            0% { transform: translateY(0) rotate(0deg) scale(0.9); }
            50% { transform: translateY(-35px) rotate(25deg) scale(1.05); }
            100% { transform: translateY(0) rotate(0deg) scale(0.9); }
        }

        /* Left Content Layering */
        .ambient-content-top {
            position: relative;
            z-index: 2;
        }

        .admin-badge {
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.25), rgba(212, 175, 55, 0.08));
            border: 1px solid rgba(212, 175, 55, 0.5);
            color: var(--tga-gold-light);
            font-size: 0.76rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            font-weight: 700;
            padding: 0.35rem 0.85rem;
            border-radius: 9999px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .ambient-content-mid {
            position: relative;
            z-index: 2;
            max-width: 620px;
            margin: 2.5rem 0;
        }

        .ambient-title {
            font-size: 2.35rem;
            line-height: 1.2;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: -0.02em;
            margin-bottom: 1.25rem;
            text-shadow: 0 4px 16px rgba(0, 0, 0, 0.6);
        }

        .rotating-line-wrap {
            height: 3.2rem;
            position: relative;
            display: flex;
            align-items: center;
        }

        .rotating-line {
            font-size: 1.05rem;
            line-height: 1.5;
            color: var(--tga-gold-light);
            font-weight: 500;
            opacity: 0;
            position: absolute;
            transition: opacity 0.6s ease, transform 0.6s ease;
            transform: translateY(8px);
        }

        .rotating-line.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* 3 Animated Stat Counters */
        .ambient-stats-row {
            position: relative;
            z-index: 2;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1.25rem;
            padding-top: 1.5rem;
            border-top: 1px solid rgba(212, 175, 55, 0.18);
        }

        .stat-card {
            background: rgba(14, 36, 24, 0.55);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(212, 175, 55, 0.18);
            border-radius: 16px;
            padding: 1.1rem 1.25rem;
            transition: transform 0.25s ease, border-color 0.25s ease;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(212, 175, 55, 0.4);
        }

        .stat-val {
            font-size: 1.6rem;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: -0.01em;
            display: flex;
            align-items: baseline;
            gap: 2px;
        }

        .stat-val-gold {
            color: var(--tga-gold-light);
        }

        .stat-label {
            font-size: 0.78rem;
            color: var(--tga-ink-muted);
            margin-top: 2px;
            font-weight: 500;
        }

        .stat-tag {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: rgba(212, 175, 55, 0.8);
            display: block;
            margin-top: 4px;
        }

        /* ----------------------------------------------------------------------
           RIGHT 40%: GLASS LOGIN CARD PANE
           ---------------------------------------------------------------------- */
        .login-form-pane {
            flex: 0 0 40%;
            width: 40%;
            background: radial-gradient(circle at 80% 20%, #10261A 0%, #08150E 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem;
            position: relative;
        }

        .glass-login-card {
            width: 100%;
            max-width: 480px;
            background: rgba(18, 36, 26, 0.78);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border: 1px solid rgba(212, 175, 55, 0.24);
            border-radius: 24px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.08);
            padding: 2.5rem 2.25rem;
            position: relative;
            z-index: 5;
            animation: cardEntrance 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @@keyframes cardEntrance {
            from {
                opacity: 0;
                transform: translateY(24px) scale(0.97);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* Staggered form field animations */
        .stagger-1 { animation: staggerIn 0.5s ease 0.1s both; }
        .stagger-2 { animation: staggerIn 0.5s ease 0.18s both; }
        .stagger-3 { animation: staggerIn 0.5s ease 0.26s both; }
        .stagger-4 { animation: staggerIn 0.5s ease 0.34s both; }
        .stagger-5 { animation: staggerIn 0.5s ease 0.42s both; }
        .stagger-6 { animation: staggerIn 0.5s ease 0.5s both; }

        @@keyframes staggerIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Shake animation on invalid credentials */
        .shake-target {
            animation: errorShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97) both;
        }

        @@keyframes errorShake {
            10%, 90% { transform: translate3d(-2px, 0, 0); }
            20%, 80% { transform: translate3d(4px, 0, 0); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
            40%, 60% { transform: translate3d(6px, 0, 0); }
        }

        .card-header-title {
            font-size: 1.55rem;
            font-weight: 800;
            color: #FFFFFF;
            letter-spacing: -0.01em;
            margin-bottom: 0.35rem;
        }

        .card-header-desc {
            font-size: 0.85rem;
            color: var(--tga-ink-muted);
        }

        /* Floating Label Custom Styling */
        .form-floating > .form-control {
            background-color: rgba(9, 21, 14, 0.75);
            border: 1px solid rgba(212, 175, 55, 0.22);
            color: #FFFFFF;
            border-radius: 14px;
            font-size: 0.92rem;
            height: calc(3.4rem + 2px);
            padding: 1rem 1rem 0.25rem 1rem;
            transition: all 0.25s ease;
        }

        .form-floating > .form-control:focus {
            background-color: rgba(12, 28, 19, 0.95);
            border-color: var(--tga-gold-primary);
            color: #FFFFFF;
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.18);
        }

        .form-floating > label {
            color: var(--tga-ink-muted);
            font-size: 0.85rem;
            padding: 1rem 1rem;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: var(--tga-gold-light);
            transform: scale(0.8) translateY(-0.6rem) translateX(0.15rem);
        }

        .pwd-toggle-btn {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--tga-ink-muted);
            cursor: pointer;
            padding: 6px;
            z-index: 10;
            transition: color 0.2s ease;
        }

        .pwd-toggle-btn:hover {
            color: var(--tga-gold-light);
        }

        /* Checkbox styling */
        .custom-check .form-check-input {
            background-color: rgba(9, 21, 14, 0.75);
            border-color: rgba(212, 175, 55, 0.3);
            border-radius: 6px;
            width: 1.1rem;
            height: 1.1rem;
        }

        .custom-check .form-check-input:checked {
            background-color: var(--tga-gold-primary);
            border-color: var(--tga-gold-primary);
        }

        .custom-check .form-check-label {
            font-size: 0.835rem;
            color: var(--tga-ink-muted);
            padding-left: 4px;
            cursor: pointer;
        }

        /* Premium Gradient Submit Button */
        .btn-gradient-submit {
            background: linear-gradient(135deg, #E3A72F 0%, #D4AF37 50%, #B8860B 100%);
            color: #07170D;
            font-weight: 800;
            font-size: 0.95rem;
            letter-spacing: 0.02em;
            border: none;
            border-radius: 14px;
            padding: 0.85rem 1.5rem;
            box-shadow: 0 8px 24px rgba(212, 175, 55, 0.32);
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-gradient-submit:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(212, 175, 55, 0.45);
            color: #000000;
        }

        .btn-gradient-submit:active:not(:disabled) {
            transform: translateY(0);
        }

        .btn-gradient-submit:disabled {
            opacity: 0.75;
            cursor: not-allowed;
        }

        /* Demo Credentials Chips */
        .demo-chip-box {
            background: rgba(10, 24, 16, 0.6);
            border: 1px dashed rgba(212, 175, 55, 0.35);
            border-radius: 16px;
            padding: 1rem 1.1rem;
            margin-top: 1.5rem;
        }

        .chip-pill {
            background: rgba(212, 175, 55, 0.12);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: var(--tga-gold-light);
            font-size: 0.74rem;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: 9999px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .chip-pill:hover {
            background: var(--tga-gold-primary);
            color: #08150E;
            transform: translateY(-1px);
        }

        /* Footer Link */
        .bottom-view-site {
            color: var(--tga-gold-light);
            font-size: 0.82rem;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .bottom-view-site:hover {
            color: #FFFFFF;
            transform: translateX(-2px);
        }

        /* ----------------------------------------------------------------------
           RESPONSIVENESS (Down to Phone)
           ---------------------------------------------------------------------- */
        @@media (max-width: 991.98px) {
            .admin-login-layout {
                flex-direction: column;
            }

            .ambient-brand-pane {
                flex: 0 0 auto;
                width: 100%;
                padding: 2.5rem 1.75rem 2rem 1.75rem;
                border-right: none;
                border-bottom: 1px solid rgba(212, 175, 55, 0.15);
            }

            .mandala-wrap {
                width: 400px;
                height: 400px;
            }

            .ambient-title {
                font-size: 1.75rem;
            }

            .ambient-stats-row {
                grid-template-columns: 1fr;
                gap: 0.75rem;
            }

            .login-form-pane {
                flex: 1 0 auto;
                width: 100%;
                padding: 2rem 1.25rem 3rem 1.25rem;
            }

            .glass-login-card {
                padding: 2rem 1.5rem;
            }
        }

        /* ----------------------------------------------------------------------
           PREFERS-REDUCED-MOTION CALM FALLBACK
           ---------------------------------------------------------------------- */
        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.001ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.001ms !important;
            }

            .orb {
                animation: none !important;
            }

            .mandala-wrap {
                animation: none !important;
                transform: translate(-50%, -50%) rotate(0deg) !important;
            }

            .drift-leaf {
                animation: none !important;
            }

            .rotating-line {
                transition: none !important;
            }

            .glass-login-card {
                animation: none !important;
            }
        }
    </style>
</head>
<body>
    <div class="admin-login-layout">
        <!-- ==================================================================
             LEFT 60%: SACRED AMBIENCE SCENE (MANDALA, DRIFT, ORBS, STATS)
             ================================================================== -->
        <div class="ambient-brand-pane">
            <!-- Glowing Ambient Orbs -->
            <div class="orb orb-gold" aria-hidden="true"></div>
            <div class="orb orb-emerald" aria-hidden="true"></div>

            <!-- Slowly Rotating Sacred Mandala (SVG) -->
            <div class="mandala-wrap" aria-hidden="true">
                <svg viewBox="0 0 500 500" width="100%" height="100%" fill="none" stroke="currentColor">
                    <circle cx="250" cy="250" r="240" stroke="#D4AF37" stroke-width="1.5" stroke-dasharray="6 6" />
                    <circle cx="250" cy="250" r="210" stroke="#D4AF37" stroke-width="2" />
                    <circle cx="250" cy="250" r="170" stroke="#10B981" stroke-width="1.5" />
                    <circle cx="250" cy="250" r="130" stroke="#D4AF37" stroke-width="2" stroke-dasharray="4 8" />
                    <circle cx="250" cy="250" r="80" stroke="#D4AF37" stroke-width="2" />
                    <!-- 12 Petal Geometries -->
                    <g stroke="#D4AF37" stroke-width="1.5">
                        <path d="M250,50 Q280,150 250,250 Q220,150 250,50 Z" />
                        <path d="M250,450 Q280,350 250,250 Q220,350 250,450 Z" />
                        <path d="M50,250 Q150,280 250,250 Q150,220 50,250 Z" />
                        <path d="M450,250 Q350,280 250,250 Q350,220 450,250 Z" />
                        <path d="M108,108 Q200,180 250,250 Q180,200 108,108 Z" />
                        <path d="M392,392 Q300,320 250,250 Q320,300 392,392 Z" />
                        <path d="M392,108 Q320,200 250,250 Q300,180 392,108 Z" />
                        <path d="M108,392 Q180,300 250,250 Q200,320 108,392 Z" />
                    </g>
                    <!-- Inner Star -->
                    <polygon points="250,170 275,225 330,250 275,275 250,330 225,275 170,250 225,225" stroke="#D4AF37" stroke-width="2" fill="rgba(212,175,55,0.06)" />
                    <circle cx="250" cy="250" r="18" fill="#D4AF37" />
                </svg>
            </div>

            <!-- Floating Leaves & Particle Drift -->
            <div class="particle-drift-layer" aria-hidden="true">
                <i class="bi bi-flower1 drift-leaf leaf-1"></i>
                <i class="bi bi-tree drift-leaf leaf-2"></i>
                <i class="bi bi-flower2 drift-leaf leaf-3"></i>
                <i class="bi bi-stars drift-leaf leaf-4"></i>
                <i class="bi bi-flower3 drift-leaf leaf-5"></i>
            </div>

            <!-- Top Header: Brand Logo & Admin Portal Badge -->
            <div class="ambient-content-top">
                <div class="d-flex align-items-center gap-3 flex-wrap">
                    <img src="/images/admin-logo-full.svg" alt="The Great Ayurveda" height="44" class="img-fluid" onerror="this.onerror=null;this.src='/images/logo.svg';" />
                    <span class="admin-badge">
                        <i class="bi bi-shield-check text-warning"></i> Admin Portal
                    </span>
                </div>
            </div>

            <!-- Middle: Headline & Rotating Lines -->
            <div class="ambient-content-mid">
                <h1 class="ambient-title">
                    Sacred Ayurveda Governance &amp; Enterprise Console
                </h1>
                <div class="rotating-line-wrap" aria-live="polite">
                    <div class="rotating-line active" id="rotLine0">
                        <i class="bi bi-box-seam me-2 text-warning"></i> Real-time dispatch oversight across pan-India warehouses
                    </div>
                    <div class="rotating-line" id="rotLine1">
                        <i class="bi bi-hospital me-2 text-warning"></i> AYUSH medical council verified doctor licensing desk
                    </div>
                    <div class="rotating-line" id="rotLine2">
                        <i class="bi bi-receipt-cutoff me-2 text-warning"></i> Automated GST compliance, doctor settlements &amp; fiscal ledger
                    </div>
                    <div class="rotating-line" id="rotLine3">
                        <i class="bi bi-shield-lock me-2 text-warning"></i> Role-based access control with comprehensive security audit logs
                    </div>
                </div>
            </div>

            <!-- Bottom: 3 Animated Stat Counters (Sample Metrics) -->
            <div class="ambient-stats-row">
                <div class="stat-card ambient-stat-card">
                    <div class="stat-val stat-val-gold">
                        <span>₹</span><span class="counter-num" data-val="28.4" data-decimals="1">0.0</span><span>L+</span>
                    </div>
                    <div class="stat-label">Monthly Gross Herb Sales</div>
                    <span class="stat-tag"><i class="bi bi-info-circle me-1"></i> Sample Metric</span>
                </div>
                <div class="stat-card ambient-stat-card">
                    <div class="stat-val">
                        <span class="counter-num" data-val="1840" data-decimals="0">0</span><span>+</span>
                    </div>
                    <div class="stat-label">Vaidya Tele-Consultations</div>
                    <span class="stat-tag"><i class="bi bi-info-circle me-1"></i> Sample Metric</span>
                </div>
                <div class="stat-card ambient-stat-card">
                    <div class="stat-val text-success">
                        <span class="counter-num" data-val="99.9" data-decimals="1">0.0</span><span>%</span>
                    </div>
                    <div class="stat-label">Formulation Dispatch Accuracy</div>
                    <span class="stat-tag"><i class="bi bi-info-circle me-1"></i> Sample Metric</span>
                </div>
            </div>
        </div>

        <!-- ==================================================================
             RIGHT 40%: GLASS-STYLE SIGN-IN CARD
             ================================================================== -->
        <div class="login-form-pane">
            <div class="glass-login-card @(hasError ? "shake-target" : "")" id="glassCard">
                <!-- Header -->
                <div class="stagger-1 mb-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="badge border border-warning border-opacity-50 text-warning px-2 py-1 rounded-pill small">
                            <i class="bi bi-lock-fill me-1"></i> Restricted Area
                        </span>
                        <span class="text-xs text-muted font-monospace">v10.0 • Production</span>
                    </div>
                    <h2 class="card-header-title">Staff Authentication</h2>
                    <p class="card-header-desc mb-0">Sign in with your verified administrative credentials.</p>
                </div>

                <!-- Error Messages Alert -->
                @if (hasError)
                {
                    <div class="stagger-2 alert alert-danger py-2 px-3 small border border-danger border-opacity-50 rounded-3 mb-3 d-flex align-items-start gap-2" role="alert">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5 flex-shrink-0 mt-1"></i>
                        <div class="flex-grow-1" id="errorMessageArea">
                            <div asp-validation-summary="All" class="mb-0"></div>
                        </div>
                    </div>
                }

                <!-- Form: Same POST, fields, Anti-Forgery -->
                <form asp-action="Login" method="post" id="adminLoginForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <!-- Email Field -->
                    <div class="stagger-3 form-floating mb-3 position-relative">
                        <input asp-for="Email" type="email" class="form-control" id="Email" placeholder="admin@ayurveda.com" required autocomplete="username" />
                        <label for="Email">
                            <i class="bi bi-envelope text-warning"></i> Administrative Email *
                        </label>
                        <span asp-validation-for="Email" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <!-- Password Field with Show/Hide -->
                    <div class="stagger-4 form-floating mb-2 position-relative">
                        <input asp-for="Password" type="password" class="form-control pe-5" id="Password" placeholder="Master Password" required autocomplete="current-password" />
                        <label for="Password">
                            <i class="bi bi-key text-warning"></i> Master Password *
                        </label>
                        <button type="button" class="pwd-toggle-btn" id="togglePasswordBtn" aria-label="Toggle password visibility">
                            <i class="bi bi-eye" id="toggleAdminPwdIcon"></i>
                        </button>
                        <span asp-validation-for="Password" class="text-danger text-xs mt-1 d-block"></span>
                    </div>

                    <!-- Caps Lock Alert -->
                    <div id="adminCapsLockAlert" class="alert alert-warning py-1 px-3 text-xs d-none my-2 rounded-pill" role="alert">
                        <i class="bi bi-capslock-fill me-1"></i> <strong>Caps Lock is ON</strong>
                    </div>

                    <!-- Remember Me -->
                    <div class="stagger-5 form-check custom-check mb-4 mt-2">
                        <input asp-for="RememberMe" class="form-check-input" id="adminRememberCheck" />
                        <label class="form-check-label" for="adminRememberCheck">
                            Keep administrative session active on this workstation
                        </label>
                    </div>

                    <!-- Submit Button with Gradient & Loading State -->
                    <div class="stagger-6">
                        <button type="submit" id="submitBtn" class="btn btn-gradient-submit w-100">
                            <span id="btnSubmitText"><i class="bi bi-box-arrow-in-right me-1"></i> Authenticate Session</span>
                            <span class="spinner-border spinner-border-sm text-dark d-none" id="btnSubmitSpinner" role="status" aria-hidden="true"></span>
                        </button>
                    </div>
                </form>

                <!-- Demo Credentials Chips (Shown ONLY in Development when DemoMode:ShowCredentialChips is enabled) -->
                @if (showChips)
                {
                    <div class="demo-chip-box">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-warning text-xs fw-bold">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Development Quick Fill
                            </span>
                            <span class="badge bg-warning bg-opacity-25 text-warning font-monospace text-xs">Dev Only</span>
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            <button type="button" class="chip-pill demo-chip" data-demo-email="admin@thegreatayurveda.com" data-demo-pwd="@devAdminPassword" title="Full super administrative privileges">
                                <i class="bi bi-shield-shaded"></i> SuperAdmin
                            </button>
                            <button type="button" class="chip-pill demo-chip" data-demo-email="catalog@thegreatayurveda.com" data-demo-pwd="@devAdminPassword" title="Manage catalog, herbs & products">
                                <i class="bi bi-capsule"></i> Catalog Mgr
                            </button>
                            <button type="button" class="chip-pill demo-chip" data-demo-email="finance@thegreatayurveda.com" data-demo-pwd="@devAdminPassword" title="Manage ledger, settlements & payouts">
                                <i class="bi bi-currency-rupee"></i> Finance Mgr
                            </button>
                            <button type="button" class="chip-pill demo-chip" data-demo-email="support@thegreatayurveda.com" data-demo-pwd="@devAdminPassword" title="Support agent & doctor approval">
                                <i class="bi bi-headset"></i> Support Agent
                            </button>
                        </div>
                    </div>
                }

                <!-- Footer Links: Small "View Website" link and Security indicator -->
                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-secondary border-opacity-25">
                    <a href="@(Configuration["PublicSiteUrl"] ?? "http://localhost:5100")" target="_blank" class="bottom-view-site">
                        <i class="bi bi-arrow-left"></i> View Public Website
                    </a>
                    <span class="text-xs text-muted">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> IP Logged &amp; Monitored
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Client Script: Show/Hide Pwd, Caps Lock, Loading State, Chip autofill, Rotating Text, Stat Counters -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Password Visibility Toggle
            const toggleBtn = document.getElementById("togglePasswordBtn") || document.getElementById("toggleAdminPwdBtn");
            const pwdInput = document.getElementById("Password") || document.getElementById("adminPwdInput");
            const pwdIcon = document.getElementById("toggleAdminPwdIcon");

            if (toggleBtn && pwdInput && pwdIcon) {
                toggleBtn.addEventListener("click", function () {
                    const isPwd = pwdInput.getAttribute("type") === "password";
                    pwdInput.setAttribute("type", isPwd ? "text" : "password");
                    pwdIcon.className = isPwd ? "bi bi-eye-slash" : "bi bi-eye";
                });
            }

            // 2. Caps Lock Detection
            const capsAlert = document.getElementById("adminCapsLockAlert");
            if (pwdInput && capsAlert) {
                const checkCaps = (e) => {
                    if (e.getModifierState && e.getModifierState("CapsLock")) {
                        capsAlert.classList.remove("d-none");
                    } else {
                        capsAlert.classList.add("d-none");
                    }
                };
                pwdInput.addEventListener("keydown", checkCaps);
                pwdInput.addEventListener("keyup", checkCaps);
            }

            // 3. Demo Chips Autofill
            const chips = document.querySelectorAll(".chip-pill[data-demo-email]");
            const emailInput = document.getElementById("Email") || document.getElementById("adminEmailInput");
            chips.forEach(chip => {
                chip.addEventListener("click", function () {
                    const e = this.getAttribute("data-demo-email");
                    const p = this.getAttribute("data-demo-pwd");
                    if (emailInput) {
                        emailInput.value = e;
                        emailInput.focus();
                    }
                    if (pwdInput && p) {
                        pwdInput.value = p;
                        pwdInput.focus();
                    }
                });
            });

            // 4. Form Submit Loading State
            const loginForm = document.getElementById("adminLoginForm");
            const submitBtn = document.getElementById("submitBtn") || document.getElementById("btnSubmitAdmin");
            const submitText = document.getElementById("btnSubmitText");
            const submitSpinner = document.getElementById("btnSubmitSpinner");

            if (loginForm && submitBtn) {
                loginForm.addEventListener("submit", function () {
                    if (loginForm.checkValidity()) {
                        submitBtn.disabled = true;
                        if (submitSpinner) submitSpinner.classList.remove("d-none");
                        if (submitText) submitText.innerHTML = "Authenticating Session...";
                    }
                });
            }

            // 5. Rotating Headline Lines
            const lines = [
                document.getElementById("rotLine0"),
                document.getElementById("rotLine1"),
                document.getElementById("rotLine2"),
                document.getElementById("rotLine3")
            ].filter(Boolean);

            if (lines.length > 1) {
                let currentIdx = 0;
                setInterval(() => {
                    lines[currentIdx].classList.remove("active");
                    currentIdx = (currentIdx + 1) % lines.length;
                    lines[currentIdx].classList.add("active");
                }, 4000);
            }

            // 6. Animated Stat Counters
            const counters = document.querySelectorAll(".counter-num");
            const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

            counters.forEach(c => {
                const target = parseFloat(c.getAttribute("data-val")) || 0;
                const decimals = parseInt(c.getAttribute("data-decimals"), 10) || 0;

                if (prefersReduced) {
                    c.textContent = target.toFixed(decimals);
                    return;
                }

                let current = 0;
                const duration = 1600;
                const startTime = performance.now();

                function updateCounter(now) {
                    const elapsed = now - startTime;
                    const progress = Math.min(elapsed / duration, 1);
                    // easeOutQuart
                    const ease = 1 - Math.pow(1 - progress, 4);
                    const val = current + (target - current) * ease;
                    c.textContent = val.toFixed(decimals);

                    if (progress < 1) {
                        requestAnimationFrame(updateCounter);
                    } else {
                        c.textContent = target.toFixed(decimals);
                    }
                }
                requestAnimationFrame(updateCounter);
            });
        });
    </script>
</body>
</html>
