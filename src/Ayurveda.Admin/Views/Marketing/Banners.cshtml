@model List<Ayurveda.Domain.Entities.Banner>
@{
    ViewData["Title"] = "Storefront Hero Banners";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-images text-success me-2"></i>Storefront Banners</h2>
        <p class="text-muted small mb-0">Manage visual promotional banners rendered on the public storefront.</p>
    </div>
    <button type="button" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs fw-semibold" data-bs-toggle="modal" data-bs-target="#createBannerModal">
        <i class="bi bi-plus-circle me-1"></i> Add Promotional Banner
    </button>
</div>

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12 text-center py-5 text-muted card border-0 shadow-sm rounded-4">
            <i class="bi bi-image display-4 d-block mb-2"></i>
            No promotional banners active. Default brand assets rendered on storefront.
        </div>
    }
    else
    {
        @foreach (var b in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                    <img src="@b.ImageUrl" alt="@b.Title" class="card-img-top bg-light" style="height: 180px; object-fit: cover;" onerror="this.src='/images/hero-mandala.svg'" />
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-dark mb-0">@b.Title</h5>
                            <span class="badge bg-light text-dark border">Order: @b.DisplayOrder</span>
                        </div>
                        <p class="small text-muted mb-3">@(b.Subtitle ?? "Promotional campaign asset")</p>
                        <div class="small text-truncate text-muted mb-3">Link: <code>@(b.LinkUrl ?? "/")</code></div>
                        <div class="text-end">
                            <form asp-action="DeleteBanner" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('Remove this banner?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                    <i class="bi bi-trash3 me-1"></i> Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- Create Banner Modal -->
<div class="modal fade" id="createBannerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="CreateBanner" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Create Storefront Banner</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Banner Heading *</label>
                        <input type="text" name="title" class="form-control rounded-3" placeholder="e.g. Ritucharya Spring Rejuvenation" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Subtitle / Tagline</label>
                        <input type="text" name="subtitle" class="form-control rounded-3" placeholder="e.g. Up to 25% OFF Shastriya Rasayanas" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Image Asset URL *</label>
                        <input type="text" name="imageUrl" class="form-control rounded-3" placeholder="/images/hero-mandala.svg" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Destination URL</label>
                        <input type="text" name="linkUrl" class="form-control rounded-3" placeholder="/Shop" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Display Sequence</label>
                        <input type="number" name="displayOrder" value="1" class="form-control rounded-3" />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Publish Banner</button>
                </div>
            </form>
        </div>
    </div>
</div>
