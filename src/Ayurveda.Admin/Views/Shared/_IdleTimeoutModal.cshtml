<!-- Accessible Session Inactivity Warning Modal (Phase 9) -->
<div class="modal fade" id="idleTimeoutModal" tabindex="-1" aria-labelledby="idleModalTitle" aria-describedby="idleModalDesc" aria-hidden="true" role="dialog" aria-modal="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0 rounded-4">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-dark d-flex align-items-center gap-2" id="idleModalTitle">
                    <i class="bi bi-clock-history text-warning fs-4"></i>
                    <span>Administrative Inactivity Warning</span>
                </h5>
            </div>
            <div class="modal-body py-3 text-secondary" id="idleModalDesc">
                <p class="mb-2">Your administrative console has been inactive. For platform security, your session will automatically terminate in:</p>
                <div class="text-center py-2">
                    <span class="display-6 fw-bold text-danger font-monospace" id="idleCountdownTimer">60</span>
                    <span class="text-muted small d-block">seconds remaining</span>
                </div>
                <p class="small text-muted mb-0">Click <strong>Stay Signed In</strong> to continue managing the platform.</p>
            </div>
            <div class="modal-footer border-top-0 pt-0 justify-content-between">
                <form id="idleLogoutForm" method="post" asp-controller="Auth" asp-action="Logout" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out Now
                    </button>
                </form>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-semibold" id="btnStaySignedIn">
                    <i class="bi bi-check-circle me-1"></i> Stay Signed In
                </button>
            </div>
        </div>
    </div>
</div>
