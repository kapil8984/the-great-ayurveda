<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | TGA Admin Portal" : "Admin Portal | The Great Ayurveda")</title>
    
    <!-- Local Bootstrap 5.3 & Icons -->
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    <style>
        :root {
            --admin-dark-bg: #111814;
            --admin-sidebar-bg: #18221D;
            --admin-accent: #2C7E50;
            --admin-gold: #E3A72F;
        }
        body {
            background-color: #F8F9FA;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
        }
        .admin-sidebar {
            background-color: var(--admin-sidebar-bg);
            min-height: 100vh;
            color: #C2D1C9;
        }
        .admin-sidebar a {
            color: #C2D1C9;
            text-decoration: none;
            padding: 10px 16px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 0.925rem;
            transition: all 0.2s ease;
        }
        .admin-sidebar a:hover, .admin-sidebar a.active {
            background-color: rgba(44, 126, 80, 0.25);
            color: #FFFFFF;
        }
        .admin-header {
            background-color: #FFFFFF;
            border-bottom: 1px solid #E5E7EB;
        }
    </style>
</head>
<body class="d-flex">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <!-- Left Sidebar Navigation -->
        <aside class="admin-sidebar p-3 d-flex flex-column" style="width: 260px; flex-shrink: 0;">
            <div class="d-flex align-items-center gap-2 mb-4 px-2">
                <img src="/images/logo.svg" alt="TGA Admin" height="34" style="filter: brightness(0) invert(1);" />
                <span class="badge bg-warning text-dark fw-bold">ADMIN</span>
            </div>

            <nav class="d-flex flex-column gap-1 flex-grow-1">
                <a asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>
                <a asp-controller="Doctors" asp-action="Pending">
                    <i class="bi bi-person-check"></i> Doctor Verification
                </a>
                <a asp-controller="Products" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Products & Stock
                </a>
                <a asp-controller="Orders" asp-action="Index">
                    <i class="bi bi-cart-check"></i> Orders & Dispatch
                </a>
                <a asp-controller="Yoga" asp-action="Index">
                    <i class="bi bi-flower1"></i> Yoga & Wellness
                </a>
                <a asp-controller="Users" asp-action="Index">
                    <i class="bi bi-people"></i> Users & Patients
                </a>
            </nav>

            <div class="border-top border-secondary pt-3 mt-auto">
                <div class="small text-white-50 px-2 mb-2 text-truncate">@User.Identity.Name</div>
                <form asp-controller="Auth" asp-action="Logout" method="post" id="adminLogoutForm" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="button" class="btn btn-outline-danger btn-sm w-100 rounded-pill btn-logout-trigger">
                        <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                    </button>
                </form>
            </div>
        </aside>
    }

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column min-vh-100">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <header class="admin-header py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0 text-dark">Management Console</h5>
                <span class="badge bg-success-subtle text-success border border-success px-3 py-1">Protected Admin Host</span>
            </header>
        }

        <main class="p-4 flex-grow-1">
            @RenderBody()
        </main>
    </div>

    <!-- Reusable Accessible Confirm Modal -->
    <div class="modal fade" id="confirmActionModal" tabindex="-1" aria-labelledby="confirmModalTitle" aria-hidden="true" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow border-0 rounded-4">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="confirmModalTitle">Confirm Action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4 text-muted" id="confirmModalBody">
                    Are you sure you want to proceed?
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary px-4 rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger px-4 rounded-pill" id="confirmModalProceedBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toasts Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="toast align-items-center text-bg-success border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle me-2"></i> @TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="toast align-items-center text-bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const logoutTriggers = document.querySelectorAll(".btn-logout-trigger");
            const confirmModalEl = document.getElementById("confirmActionModal");
            if (confirmModalEl) {
                logoutTriggers.forEach(btn => {
                    btn.addEventListener("click", function (e) {
                        e.preventDefault();
                        const form = document.getElementById("adminLogoutForm");
                        document.getElementById("confirmModalTitle").innerText = "Sign Out from Admin";
                        document.getElementById("confirmModalBody").innerText = "Are you sure you want to terminate your administrative session?";
                        document.getElementById("confirmModalProceedBtn").onclick = function () {
                            if (form) form.submit();
                        };
                        const modal = new bootstrap.Modal(confirmModalEl);
                        modal.show();
                    });
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
