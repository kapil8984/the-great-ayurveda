@* Reusable Smart SearchBox Partial (Admin scope) *@
@{
    var scope = ViewData["Scope"] as string ?? "admin";
    var placeholder = ViewData["Placeholder"] as string ?? "Search orders, customers, doctors, products...";
}

<div class="search-container position-relative tga-search-box-wrapper" data-scope="@scope" style="max-width: 480px; width: 100%;">
    <form action="/Products" method="get" class="search-form m-0" role="search">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0 text-muted ps-3">
                <i class="bi bi-search"></i>
            </span>
            <input type="text"
                   name="query"
                   class="form-control border-start-0 border-end-0 tga-search-input"
                   placeholder="@placeholder"
                   autocomplete="off"
                   aria-label="Admin Quick Search"
                   aria-autocomplete="list"
                   aria-expanded="false"
                   data-scope="@scope" />
            <button type="button" class="input-group-text bg-white border-start-0 border-end-0 text-muted btn-clear-search d-none" title="Clear search">
                <i class="bi bi-x-circle-fill"></i>
            </button>
            <button type="submit" class="btn btn-dark px-3 d-none d-sm-inline-flex align-items-center">
                <span>Find</span>
            </button>
        </div>
    </form>
    <div class="search-results-dropdown shadow-lg rounded-3" role="region" aria-live="polite"></div>
</div>
