@model Ayurveda.Application.ViewModels.AdminSystemSettingsViewModel
@{
    ViewData["Title"] = "Platform System Settings";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1"><i class="bi bi-sliders text-success me-2"></i>Global Platform Settings</h2>
    <p class="text-muted small mb-0">Configure taxation schedules, logistics shipping rules, telemedicine fees, and IP perimeter security.</p>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="max-width: 800px;">
    <form asp-action="SaveSettings" method="post">
        @Html.AntiForgeryToken()

        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-truck text-success me-2"></i>Shipping &amp; Logistics Thresholds</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="FreeShippingThreshold" class="form-label small fw-semibold">Free Shipping Basket Minimum (₹)</label>
                <input asp-for="FreeShippingThreshold" type="number" step="10" class="form-control rounded-3" />
                <small class="text-muted">Orders at or above this value qualify for free surface shipping.</small>
            </div>
            <div class="col-md-6">
                <label asp-for="StandardShippingFee" class="form-label small fw-semibold">Standard Surface Delivery Fee (₹)</label>
                <input asp-for="StandardShippingFee" type="number" step="5" class="form-control rounded-3" />
                <small class="text-muted">Flat delivery charge for orders under threshold.</small>
            </div>
        </div>

        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-percent text-success me-2"></i>Taxation &amp; Telemedicine Commission</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label asp-for="GstPercentageRate" class="form-label small fw-semibold">Standard Formulation GST Rate (%)</label>
                <input asp-for="GstPercentageRate" type="number" step="0.5" class="form-control rounded-3" />
                <small class="text-muted">Statutory CGST+SGST rate (Default 12% on Ayurvedic medicines).</small>
            </div>
            <div class="col-md-6">
                <label asp-for="DoctorCommissionPercentageRate" class="form-label small fw-semibold">Marketplace Platform Commission (%)</label>
                <input asp-for="DoctorCommissionPercentageRate" type="number" step="1" class="form-control rounded-3" />
                <small class="text-muted">Platform deduction on completed doctor consultations (Default 15%).</small>
            </div>
            <div class="col-md-6">
                <label asp-for="ConsultationSlotDurationMinutes" class="form-label small fw-semibold">Standard Slot Duration (Minutes)</label>
                <input asp-for="ConsultationSlotDurationMinutes" type="number" step="5" class="form-control rounded-3" />
            </div>
        </div>

        <h5 class="fw-bold text-dark mb-3"><i class="bi bi-shield-lock text-success me-2"></i>IP Perimeter Allowlisting</h5>
        <div class="row g-3 mb-4">
            <div class="col-12">
                <div class="form-check form-switch mb-2">
                    <input class="form-check-input" type="checkbox" role="switch" asp-for="EnableIpAllowlisting" id="ipSwitch">
                    <label class="form-check-label small fw-semibold" for="ipSwitch">Enable Corporate IP Allowlisting</label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="AllowedIpListCsv" class="form-label small fw-semibold">Authorized IP Addresses (Comma-Separated)</label>
                <input asp-for="AllowedIpListCsv" class="form-control rounded-3 font-monospace" placeholder="127.0.0.1, ::1, 103.21.244.0" />
            </div>
        </div>

        <div class="text-end pt-3 border-top">
            <button type="submit" class="btn btn-success rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-check-lg me-1"></i> Save Platform Settings
            </button>
        </div>
    </form>
</div>
