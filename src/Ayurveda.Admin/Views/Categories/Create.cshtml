@model Ayurveda.Domain.Entities.Category
@{
    ViewData["Title"] = "Add Category";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small">
        <i class="bi bi-arrow-left me-1"></i> Back to Categories Catalog
    </a>
    <h3 class="fw-bold text-dark mt-2">
        <i class="bi bi-plus-circle text-success me-2"></i> Add New Ayurvedic Category
    </h3>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data" id="createCategoryForm">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Digestion & Gut Agni, Rasayana, Sleep & Stress" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" rows="4" class="form-control" placeholder="Clinical therapeutic focus, classical doshic balance, indicated conditions..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Category Icon / Artwork</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" id="categoryImgInput" />
                        <div class="form-text">Upload SVG or PNG icon. If left blank, an authentic Ayurvedic SVG icon matching the name will be assigned automatically.</div>
                        <div class="mt-2" id="previewContainer" style="display:none;">
                            <img id="previewImg" src="#" alt="Preview" class="border rounded-3 p-1" style="width: 80px; height: 80px; object-fit: contain;" />
                        </div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked />
                        <label class="form-check-label fw-semibold" for="isActiveSwitch">Category Active & Visible to Patients</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" id="btnSubmitCreateCategory" class="btn btn-success rounded-pill px-4 fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Create Category
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('categoryImgInput')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    const preview = document.getElementById('previewImg');
                    preview.src = evt.target.result;
                    document.getElementById('previewContainer').style.display = 'block';
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}
