@model Ayurveda.Application.ViewModels.CatalogSystemStatusViewModel
@{
    ViewData["Title"] = "Product Catalogue & Genuine Image Synchronization";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <h2 class="fw-bold mb-0"><i class="bi bi-cloud-arrow-up-fill text-success me-2"></i>Catalogue &amp; Image Synchronization</h2>
            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-2 py-1 small fw-semibold">
                <i class="bi bi-shield-lock-fill me-1"></i> SuperAdmin Restricted
            </span>
        </div>
        <p class="text-muted small mb-0">
            Safely synchronize the 400-product genuine Ayurvedic catalogue and real product photographs into production without modifying existing stock, prices, orders, or accounts.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Back to Products
        </a>
    </div>
</div>

<!-- Non-Destructive Production Safety Guarantee Alert -->
<div class="alert alert-success border-0 shadow-xs rounded-4 p-3 mb-4 d-flex align-items-start gap-3 bg-success bg-opacity-10">
    <div class="bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; flex-shrink: 0;">
        <i class="bi bi-shield-check fs-5"></i>
    </div>
    <div class="small">
        <h6 class="fw-bold text-success mb-1">Enterprise Non-Destructive Guarantees</h6>
        <div class="text-secondary">
            • <strong>Zero Data Loss:</strong> Existing products, customer orders, stock quantities, prices, descriptions, and user accounts are <strong>never deleted or overwritten</strong>.<br />
            • <strong>Disk Verified:</strong> Proposed genuine image paths are physically verified against the server filesystem before any mapping occurs.<br />
            • <strong>Admin Uploads Preserved:</strong> Custom images stored in <code>/uploads/</code> are strictly protected and never replaced.<br />
            • <strong>Transaction Guarded:</strong> All database operations execute in atomic transactions with automatic rollback on error.
        </div>
    </div>
</div>

<!-- System Status Telemetry Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="text-muted small fw-semibold">Database Products</div>
            <div class="d-flex align-items-baseline gap-2 mt-1">
                <h3 class="fw-bold text-dark mb-0">@Model.DatabaseProductCount</h3>
                <span class="small text-muted">active records</span>
            </div>
            <div class="small text-muted mt-2">
                <i class="bi bi-database me-1"></i> Live DB Table
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="text-muted small fw-semibold">Catalogue Target</div>
            <div class="d-flex align-items-baseline gap-2 mt-1">
                <h3 class="fw-bold text-primary mb-0">@Model.CatalogJsonProductCount</h3>
                <span class="small text-muted">target products</span>
            </div>
            <div class="small text-muted mt-2">
                <i class="bi bi-filetype-json me-1"></i> catalog_300plus.json
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="text-muted small fw-semibold">Missing Products</div>
            <div class="d-flex align-items-baseline gap-2 mt-1">
                <h3 class="fw-bold @(Model.MissingProductsCount > 0 ? "text-warning" : "text-success") mb-0">@Model.MissingProductsCount</h3>
                <span class="small text-muted">to be inserted</span>
            </div>
            <div class="small text-muted mt-2">
                @(Model.MissingProductsCount > 0 ? "Ready for safe insertion" : "Catalogue fully synchronized")
            </div>
        </div>
    </div>

    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="text-muted small fw-semibold">Generic / SVG Images</div>
            <div class="d-flex align-items-baseline gap-2 mt-1">
                <h3 class="fw-bold @(Model.GenericOrPlaceholderImageCount > 0 ? "text-danger" : "text-success") mb-0">@Model.GenericOrPlaceholderImageCount</h3>
                <span class="small text-muted">need genuine photo</span>
            </div>
            <div class="small text-muted mt-2">
                <i class="bi bi-images me-1"></i> Placeholder/SVG images
            </div>
        </div>
    </div>
</div>

<!-- Two Primary Operation Modules: 1. Product Insertion, 2. Image Mapping -->
<div class="row g-4 mb-4">
    <!-- Module 1: Safe Product Import -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success bg-opacity-10 text-success p-2 rounded-circle">
                            <i class="bi bi-plus-circle-fill fs-5"></i>
                        </span>
                        <h5 class="fw-bold mb-0">1. Product Catalogue Insertion</h5>
                    </div>
                    <span class="badge bg-light text-dark border">Safe &amp; Additive</span>
                </div>
                <p class="text-muted small mb-3">
                    Inserts the missing products from <code>catalog_300plus.json</code> into the database. Existing products, current warehouse inventory stock, prices, and descriptions are <strong>never modified</strong>.
                </p>
                <div class="p-3 bg-light rounded-3 small text-secondary mb-3">
                    <i class="bi bi-info-circle me-1 text-primary"></i>
                    Matching uses exact SKU, Title, and normalized slug. Ambiguous items are flagged without guessing.
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-semibold" id="btnPreviewImport">
                    <i class="bi bi-eye me-1"></i> Preview Products to Insert
                </button>
                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold shadow-xs" id="btnConfirmImportModal" data-bs-toggle="modal" data-bs-target="#confirmImportModal">
                    <i class="bi bi-cloud-arrow-up me-1"></i> Confirm Product Insertion
                </button>
            </div>
        </div>
    </div>

    <!-- Module 2: Safe Image Mapping -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary bg-opacity-10 text-primary p-2 rounded-circle">
                            <i class="bi bi-camera-fill fs-5"></i>
                        </span>
                        <h5 class="fw-bold mb-0">2. Existing Product Image Mapping</h5>
                    </div>
                    <span class="badge bg-light text-dark border">Non-Destructive</span>
                </div>
                <p class="text-muted small mb-3">
                    Maps existing products with placeholder/SVG images to verified genuine packaging photographs. Adds missing multi-angle gallery photos without deleting any existing <code>ProductImage</code> records.
                </p>
                <div class="p-3 bg-light rounded-3 small text-secondary mb-3">
                    <i class="bi bi-shield-check me-1 text-success"></i>
                    Verifies each image file exists on disk. Preserves custom admin uploads in <code>/uploads/</code>.
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 pt-2 border-top">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-semibold" id="btnPreviewImageMapping">
                    <i class="bi bi-eye me-1"></i> Preview Image Mapping
                </button>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-xs" id="btnConfirmImageMappingModal" data-bs-toggle="modal" data-bs-target="#confirmImageModal">
                    <i class="bi bi-check-circle me-1"></i> Confirm Image Mapping
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Dynamic Results & Preview Output Stage -->
<div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4" id="resultsCard" style="display: none;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0" id="resultsTitle">Operation Output</h5>
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-circle p-1" onclick="document.getElementById('resultsCard').style.display='none'" style="width: 28px; height: 28px;">
            <i class="bi bi-x"></i>
        </button>
    </div>
    <div id="resultsContent">
        <!-- Injected via AJAX -->
    </div>
</div>

<!-- Confirmation Modal: Product Import -->
<div class="modal fade" id="confirmImportModal" tabindex="-1" aria-labelledby="confirmImportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="confirmImportModalLabel">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirm Product Import
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-secondary small mb-3">
                    You are about to execute the product insertion operation. This will add missing products from <code>catalog_300plus.json</code> to the active database.
                </p>
                <div class="bg-light p-3 rounded-3 small mb-2 text-dark">
                    <strong>Safety Checklist:</strong>
                    <ul class="mb-0 ps-3 mt-1 text-muted">
                        <li>Existing products are preserved intact.</li>
                        <li>Existing product stock and prices are never overwritten.</li>
                        <li>Operation runs in an isolated database transaction.</li>
                        <li>Audit log entry will be recorded under your account.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 fw-semibold shadow-xs" id="btnExecuteImportConfirm">
                    <i class="bi bi-check-lg me-1"></i> Proceed with Import
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal: Image Mapping -->
<div class="modal fade" id="confirmImageModal" tabindex="-1" aria-labelledby="confirmImageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="confirmImageModalLabel">
                    <i class="bi bi-camera-fill text-primary me-2"></i>Confirm Image Mapping
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="text-secondary small mb-3">
                    You are about to synchronize product images. This will update products having placeholder or generic SVG images with genuine photographs, and add missing multi-angle gallery photos.
                </p>
                <div class="bg-light p-3 rounded-3 small mb-2 text-dark">
                    <strong>Safety Checklist:</strong>
                    <ul class="mb-0 ps-3 mt-1 text-muted">
                        <li>Zero existing ProductImage rows will be deleted.</li>
                        <li>Custom uploads in <code>/uploads/</code> are preserved.</li>
                        <li>Only images verified to exist on disk are applied.</li>
                        <li>Operation runs in an isolated database transaction.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold shadow-xs" id="btnExecuteImageConfirm">
                    <i class="bi bi-check-lg me-1"></i> Proceed with Image Mapping
                </button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

    function showResults(title, html) {
        document.getElementById('resultsTitle').innerHTML = title;
        document.getElementById('resultsContent').innerHTML = html;
        document.getElementById('resultsCard').style.display = 'block';
        document.getElementById('resultsCard').scrollIntoView({ behavior: 'smooth' });
    }

    function showLoading(title) {
        showResults(title, `
            <div class="text-center py-5">
                <div class="spinner-border text-success" role="status"></div>
                <div class="mt-3 text-muted small fw-semibold">Analyzing database and catalogue data...</div>
            </div>
        `);
    }

    // 1. Preview Import
    document.getElementById('btnPreviewImport').addEventListener('click', async () => {
        showLoading('<i class="bi bi-eye text-success me-2"></i>Product Insertion Preview');
        try {
            const resp = await fetch('@Url.Action("PreviewImport", "CatalogImport")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const res = await resp.json();
            if (!res.success) {
                showResults('Error', `<div class="alert alert-danger">${res.data?.message || 'Error executing preview'}</div>`);
                return;
            }

            const p = res.data;
            let html = `
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-success bg-opacity-10 text-success p-2">New to Insert: <strong>${p.newProductsToInsertCount}</strong></span>
                    <span class="badge bg-secondary bg-opacity-10 text-dark p-2">Already in DB: <strong>${p.existingMatchingCount}</strong></span>
                    <span class="badge bg-warning bg-opacity-10 text-warning p-2">Ambiguous: <strong>${p.ambiguousMatchesCount}</strong></span>
                </div>
                <div class="alert alert-info py-2 small mb-3">${p.message}</div>
            `;

            if (p.newProducts && p.newProducts.length > 0) {
                html += `
                    <h6 class="fw-bold mt-3 mb-2">New Products to be Added (${p.newProducts.length})</h6>
                    <div class="table-responsive" style="max-height: 420px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle small mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Title & Brand</th>
                                    <th>Category</th>
                                    <th>Price / MRP</th>
                                    <th>SKU</th>
                                    <th>Primary Image</th>
                                    <th>Gallery Angles</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                p.newProducts.forEach(item => {
                    html += `
                        <tr>
                            <td>
                                <div class="fw-semibold">${item.title}</div>
                                <div class="text-muted" style="font-size: 0.75rem;">${item.brand}</div>
                            </td>
                            <td>${item.categoryName} <span class="text-muted">/ ${item.subcategoryName}</span></td>
                            <td>₹${item.price} <span class="text-muted text-decoration-line-through">₹${item.mrp}</span></td>
                            <td><code>${item.sku || 'N/A'}</code></td>
                            <td><span class="text-truncate d-inline-block text-muted" style="max-width: 180px;" title="${item.imageUrl}">${item.imageUrl}</span></td>
                            <td><span class="badge bg-light text-dark border">+${item.additionalImagesCount} angles</span></td>
                        </tr>
                    `;
                });
                html += `</tbody></table></div>`;
            } else {
                html += `<div class="alert alert-success py-2 small">All 400 catalogue products are already present in the database! Zero new products to insert.</div>`;
            }

            showResults('<i class="bi bi-eye text-success me-2"></i>Product Insertion Preview', html);
        } catch (err) {
            showResults('Error', `<div class="alert alert-danger">${err.message}</div>`);
        }
    });

    // 2. Confirm Import
    document.getElementById('btnExecuteImportConfirm').addEventListener('click', async () => {
        bootstrap.Modal.getInstance(document.getElementById('confirmImportModal')).hide();
        showLoading('<i class="bi bi-cloud-arrow-up text-success me-2"></i>Executing Safe Product Import...');

        try {
            const resp = await fetch('@Url.Action("ConfirmImport", "CatalogImport")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const res = await resp.json();
            const d = res.data;

            if (res.success) {
                let html = `
                    <div class="alert alert-success p-3 rounded-4 mb-3">
                        <h6 class="fw-bold mb-1"><i class="bi bi-check-circle-fill me-1"></i> Product Insertion Succeeded!</h6>
                        <div>Successfully inserted <strong>${d.insertedCount}</strong> new products into the database. Skipped <strong>${d.skippedCount}</strong> already-present products.</div>
                    </div>
                    <div class="small text-muted mb-2">Executed by: <code>${d.executedBy}</code> at ${new Date(d.executedAt).toLocaleString()}</div>
                `;
                if (d.insertedProductTitles && d.insertedProductTitles.length > 0) {
                    html += `
                        <h6 class="fw-bold mt-3 mb-2">Inserted Formulations (${d.insertedProductTitles.length}):</h6>
                        <div class="p-3 bg-light rounded-3 small" style="max-height: 250px; overflow-y: auto;">
                            <ul class="mb-0 ps-3">
                                ${d.insertedProductTitles.map(t => `<li>${t}</li>`).join('')}
                            </ul>
                        </div>
                    `;
                }
                html += `
                    <div class="mt-3">
                        <button class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="location.reload()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh System Status
                        </button>
                    </div>
                `;
                showResults('<i class="bi bi-check-circle-fill text-success me-2"></i>Import Execution Result', html);
            } else {
                showResults('Import Failed', `
                    <div class="alert alert-danger">
                        <h6>Execution failed and transaction was safely rolled back:</h6>
                        <div>${(d?.errors || []).join('<br/>')}</div>
                    </div>
                `);
            }
        } catch (err) {
            showResults('Error', `<div class="alert alert-danger">${err.message}</div>`);
        }
    });

    // 3. Preview Image Mapping
    document.getElementById('btnPreviewImageMapping').addEventListener('click', async () => {
        showLoading('<i class="bi bi-camera text-primary me-2"></i>Image Mapping Preview');
        try {
            const resp = await fetch('@Url.Action("PreviewImageMapping", "CatalogImport")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const res = await resp.json();
            if (!res.success) {
                showResults('Error', `<div class="alert alert-danger">${res.data?.message || 'Error executing image preview'}</div>`);
                return;
            }

            const p = res.data;
            let html = `
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <span class="badge bg-warning bg-opacity-10 text-warning p-2">Requires Correction: <strong>${p.requiresCorrectionCount}</strong></span>
                    <span class="badge bg-success bg-opacity-10 text-success p-2">Already Correct: <strong>${p.alreadyCorrectCount}</strong></span>
                    <span class="badge bg-info bg-opacity-10 text-info p-2">Admin Uploads Preserved: <strong>${p.adminUploadedPreservedCount}</strong></span>
                    <span class="badge bg-danger bg-opacity-10 text-danger p-2">Missing on Disk: <strong>${p.missingOnDiskCount}</strong></span>
                </div>
                <div class="alert alert-info py-2 small mb-3">${p.message}</div>
            `;

            if (p.items && p.items.length > 0) {
                html += `
                    <h6 class="fw-bold mt-3 mb-2">Image Mapping Table (${p.items.length} products analyzed)</h6>
                    <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                        <table class="table table-sm table-hover align-middle small mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>ID</th>
                                    <th>Product Details</th>
                                    <th>Current Image</th>
                                    <th>Proposed Genuine Image</th>
                                    <th>Gallery Additions</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                p.items.forEach(item => {
                    let badgeClass = 'bg-secondary';
                    let statusLabel = item.status;
                    if (item.status === 0) { badgeClass = 'bg-warning text-dark'; statusLabel = 'Requires Correction'; }
                    else if (item.status === 1) { badgeClass = 'bg-success text-white'; statusLabel = 'Already Correct'; }
                    else if (item.status === 2) { badgeClass = 'bg-info text-dark'; statusLabel = 'Admin Upload Protected'; }
                    else if (item.status === 3) { badgeClass = 'bg-danger text-white'; statusLabel = 'Missing on Server Disk'; }

                    html += `
                        <tr>
                            <td>#${item.productId}</td>
                            <td>
                                <div class="fw-semibold">${item.title}</div>
                                <div class="text-muted" style="font-size: 0.72rem;">${item.brand || ''} ${item.sku ? '• ' + item.sku : ''}</div>
                            </td>
                            <td>
                                <div class="text-truncate text-muted" style="max-width: 140px;" title="${item.currentPrimaryImage}">${item.currentPrimaryImage}</div>
                            </td>
                            <td>
                                <div class="text-truncate fw-semibold ${item.willUpdatePrimary ? 'text-success' : 'text-muted'}" style="max-width: 180px;" title="${item.proposedPrimaryImage}">
                                    ${item.willUpdatePrimary ? '<i class="bi bi-arrow-right me-1"></i>' : ''}${item.proposedPrimaryImage}
                                </div>
                            </td>
                            <td>
                                ${item.newGalleryImagesCount > 0 ? `<span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle">+${item.newGalleryImagesCount} angles</span>` : '<span class="text-muted">None</span>'}
                            </td>
                            <td>
                                <span class="badge ${badgeClass}">${statusLabel}</span>
                                <div class="text-muted" style="font-size: 0.7rem;">${item.statusDetails}</div>
                            </td>
                        </tr>
                    `;
                });
                html += `</tbody></table></div>`;
            }

            showResults('<i class="bi bi-camera text-primary me-2"></i>Image Mapping Preview', html);
        } catch (err) {
            showResults('Error', `<div class="alert alert-danger">${err.message}</div>`);
        }
    });

    // 4. Confirm Image Mapping
    document.getElementById('btnExecuteImageConfirm').addEventListener('click', async () => {
        bootstrap.Modal.getInstance(document.getElementById('confirmImageModal')).hide();
        showLoading('<i class="bi bi-camera text-primary me-2"></i>Executing Safe Image Mapping...');

        try {
            const resp = await fetch('@Url.Action("ConfirmImageMapping", "CatalogImport")', {
                method: 'POST',
                headers: { 'RequestVerificationToken': token }
            });
            const res = await resp.json();
            const d = res.data;

            if (res.success) {
                let html = `
                    <div class="alert alert-success p-3 rounded-4 mb-3">
                        <h6 class="fw-bold mb-1"><i class="bi bi-check-circle-fill me-1"></i> Image Mapping Succeeded!</h6>
                        <div>Updated <strong>${d.updatedPrimaryCount}</strong> primary product images to genuine packaging. Added <strong>${d.addedGalleryImagesCount}</strong> multi-angle gallery photos. Zero existing ProductImage rows were deleted.</div>
                    </div>
                    <div class="small text-muted mb-2">Executed by: <code>${d.executedBy}</code> at ${new Date(d.executedAt).toLocaleString()}</div>
                `;
                if (d.details && d.details.length > 0) {
                    html += `
                        <h6 class="fw-bold mt-3 mb-2">Execution Log:</h6>
                        <div class="p-3 bg-light rounded-3 small" style="max-height: 250px; overflow-y: auto;">
                            <ul class="mb-0 ps-3">
                                ${d.details.map(t => `<li>${t}</li>`).join('')}
                            </ul>
                        </div>
                    `;
                }
                html += `
                    <div class="mt-3">
                        <button class="btn btn-outline-success btn-sm rounded-pill px-3" onclick="location.reload()">
                            <i class="bi bi-arrow-clockwise me-1"></i> Refresh System Status
                        </button>
                    </div>
                `;
                showResults('<i class="bi bi-check-circle-fill text-success me-2"></i>Image Mapping Execution Result', html);
            } else {
                showResults('Image Mapping Failed', `
                    <div class="alert alert-danger">
                        <h6>Execution failed and transaction was safely rolled back:</h6>
                        <div>${(d?.errors || []).join('<br/>')}</div>
                    </div>
                `);
            }
        } catch (err) {
            showResults('Error', `<div class="alert alert-danger">${err.message}</div>`);
        }
    });
</script>
}

