@model Ayurveda.Application.ViewModels.AdminUserDetailsViewModel
@{
    var u = Model.User;
    var isLocked = u.LockoutEnd.HasValue && u.LockoutEnd > DateTimeOffset.UtcNow;
    ViewData["Title"] = $"User Dossier — {u.FullName}";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Users Directory
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">@u.FullName</h2>
            <p class="text-muted small mb-0">@u.Email • Registered @u.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="ExportData" asp-route-id="@u.Id" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                <i class="bi bi-file-earmark-arrow-down me-1"></i> GDPR / DPDP Export
            </a>

            <form asp-action="ForcePasswordReset" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('Assign temporary password to this user?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-warning btn-sm rounded-pill px-3">
                    <i class="bi bi-key me-1"></i> Force Password Reset
                </button>
            </form>

            @if (isLocked)
            {
                <form asp-action="Unsuspend" asp-route-id="@u.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                        <i class="bi bi-unlock me-1"></i> Unsuspend Account
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#suspendModal">
                    <i class="bi bi-lock me-1"></i> Suspend Account
                </button>
            }

            @if (User.IsInRole("SuperAdmin"))
            {
                <form asp-action="Anonymize" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('PERMANENT ACTION: Scrub all personal data (Right to be Forgotten)? This cannot be undone.');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm rounded-pill px-3">
                        <i class="bi bi-person-x me-1"></i> Anonymize PII
                    </button>
                </form>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: User Profile & Addresses -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-person-badge text-success me-2"></i>Profile Dossier</h5>
            
            <div class="mb-3">
                <span class="text-muted small">Account Role</span>
                <div><span class="badge bg-light text-dark border">@Model.Role</span></div>
            </div>

            <div class="mb-3">
                <span class="text-muted small">Mobile Contact</span>
                <div class="fw-semibold text-dark">@(u.ContactNumber ?? "Not provided")</div>
            </div>

            <div class="mb-3">
                <span class="text-muted small">Gender</span>
                <div class="fw-semibold text-dark">@(u.Gender ?? "Not specified")</div>
            </div>

            <div class="mb-3">
                <span class="text-muted small">Email Verification</span>
                <div>
                    @if (u.EmailConfirmed)
                    {
                        <span class="badge bg-success-subtle text-success"><i class="bi bi-patch-check-fill me-1"></i>Verified</span>
                    }
                    else
                    {
                        <span class="badge bg-warning-subtle text-warning">Pending</span>
                    }
                </div>
            </div>

            <div class="mb-0">
                <span class="text-muted small">Account Status</span>
                <div>
                    @if (isLocked)
                    {
                        <span class="badge bg-danger-subtle text-danger"><i class="bi bi-lock-fill me-1"></i>Locked until @u.LockoutEnd?.ToString("yyyy-MM-dd")</span>
                    }
                    else
                    {
                        <span class="badge bg-success-subtle text-success"><i class="bi bi-check-circle-fill me-1"></i>In Good Standing</span>
                    }
                </div>
            </div>
        </div>

        <!-- Saved Delivery Addresses -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-geo-alt text-success me-2"></i>Saved Delivery Addresses</h5>
            @if (!Model.Addresses.Any())
            {
                <p class="text-muted small mb-0 text-center py-2">No saved addresses on file.</p>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    @foreach (var addr in Model.Addresses)
                    {
                        <div class="p-2 border rounded-3 bg-light small">
                            <div class="fw-bold">@addr.RecipientName (@addr.Phone)</div>
                            <div>@addr.AddressLine1</div>
                            <div class="text-muted">@addr.City, @addr.State — @addr.PostalCode</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Right Column: Orders & Consultations History -->
    <div class="col-lg-8">
        <!-- Order History Table -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam text-success me-2"></i>E-Commerce Order History</h5>
                <span class="badge bg-light text-dark border">@Model.Orders.Count Orders</span>
            </div>

            @if (!Model.Orders.Any())
            {
                <p class="text-muted small mb-0 py-3 text-center">No orders placed by this customer.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Order Ref</th>
                                <th>Date</th>
                                <th class="text-end">Amount</th>
                                <th class="text-center">Status</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.Orders)
                            {
                                <tr>
                                    <td class="fw-bold small">#@o.OrderNumber</td>
                                    <td class="small text-muted">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                    <td class="text-end fw-bold text-success small">₹@o.TotalAmount.ToString("N0")</td>
                                    <td class="text-center"><span class="badge bg-success-subtle text-success">@o.Status</span></td>
                                    <td class="text-end">
                                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id" class="btn btn-outline-secondary btn-sm py-0 px-2 rounded-pill">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Telemedicine Consultations Table -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-hospital text-success me-2"></i>Telemedicine Consultation Sessions</h5>
                <span class="badge bg-light text-dark border">@Model.Consultations.Count Sessions</span>
            </div>

            @if (!Model.Consultations.Any())
            {
                <p class="text-muted small mb-0 py-3 text-center">No consultations booked by this patient.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Ref #</th>
                                <th>Date &amp; Slot</th>
                                <th>Mode</th>
                                <th>Chief Concern</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.Consultations)
                            {
                                <tr>
                                    <td class="fw-bold small">#@appt.Id</td>
                                    <td class="small">@appt.AppointmentDate.ToString("dd MMM yyyy") (@appt.TimeSlot)</td>
                                    <td><span class="badge bg-light text-dark border">@appt.ConsultationType</span></td>
                                    <td class="small text-muted text-truncate" style="max-width: 180px;">@appt.HealthConcern</td>
                                    <td class="text-center"><span class="badge bg-success-subtle text-success">@appt.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Suspend Modal -->
<div class="modal fade" id="suspendModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="Suspend" asp-route-id="@u.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-lock me-2"></i>Suspend Account</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-muted small">Suspending will lock out @u.FullName from logging into both storefront and patient portals:</p>
                    <textarea name="reason" rows="3" class="form-control rounded-3" placeholder="Reason for administrative suspension..." required></textarea>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Suspension</button>
                </div>
            </form>
        </div>
    </div>
</div>
