@model Ayurveda.Application.ViewModels.AdminUserEditViewModel
@{
    ViewData["Title"] = $"Edit User Profile — {Model.FullName}";
    var roles = new[] { "Customer", "Doctor", "Admin", "SuperAdmin", "SupportAgent", "CatalogManager", "FinanceManager" };
}

<div class="mb-4">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Dossier
    </a>
    <h2 class="fw-bold mb-1"><i class="bi bi-pencil-square text-success me-2"></i>Edit User Profile</h2>
    <p class="text-muted small mb-0">Update account credentials, contact phone, demographic details, and permissions.</p>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="max-width: 750px;">
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="editUserForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Email" />

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label small fw-semibold">Full Legal Name *</label>
                <input asp-for="FullName" id="inputUserFullName" class="form-control rounded-3" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label small fw-semibold">Email Address</label>
                <input value="@Model.Email" class="form-control rounded-3 bg-light" readonly />
                <div class="text-xs text-muted mt-1">Unique account identifier cannot be altered directly.</div>
            </div>

            <div class="col-md-6">
                <label asp-for="ContactNumber" class="form-label small fw-semibold">Mobile Contact Number</label>
                <input asp-for="ContactNumber" id="inputUserContact" class="form-control rounded-3" placeholder="+91 98765 43210" />
            </div>

            <div class="col-md-6">
                <label asp-for="Gender" class="form-label small fw-semibold">Gender</label>
                <select asp-for="Gender" class="form-select rounded-3">
                    <option value="">-- Not Specified --</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="DateOfBirth" class="form-label small fw-semibold">Date of Birth</label>
                <input asp-for="DateOfBirth" type="date" class="form-control rounded-3" />
            </div>

            <div class="col-md-6">
                <label asp-for="Role" class="form-label small fw-semibold">Assigned Role</label>
                <select asp-for="Role" class="form-select rounded-3">
                    @foreach (var r in roles)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>

            <div class="col-12 pt-2">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="userIsActiveSwitch">
                    <label class="form-check-label small fw-semibold" for="userIsActiveSwitch">
                        Active Account (Uncheck to suspend login permissions)
                    </label>
                </div>
            </div>

            <div class="col-12 border-top pt-3 mt-3 d-flex gap-2">
                <button type="submit" id="btnSaveUser" class="btn btn-success rounded-pill px-4">
                    <i class="bi bi-check2-circle me-1"></i> Save Changes
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light rounded-pill px-4">Cancel</a>
            </div>
        </div>
    </form>
</div>
