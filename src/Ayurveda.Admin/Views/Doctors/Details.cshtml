@model Ayurveda.Application.ViewModels.AdminDoctorDetailsViewModel
@{
    var doc = Model.Doctor;
    var detail = doc.DoctorDetail;
    ViewData["Title"] = $"Vaidya Profile — Dr. {doc.DoctorName}";
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Doctor Directory
    </a>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">Dr. @doc.DoctorName</h2>
            <p class="text-muted small mb-0">@(detail?.Specialization?.Name ?? "Classical Ayurveda") • Registered @doc.CreatedAt.ToString("dd MMM yyyy")</p>
        </div>
        <div class="d-flex gap-2">
            @if (detail?.Status == 1)
            {
                <span class="badge bg-success fs-6 px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i>Active Practice</span>
            }
            else if (detail?.Status == 2)
            {
                <span class="badge bg-danger fs-6 px-3 py-2 rounded-pill"><i class="bi bi-pause-circle me-1"></i>Suspended</span>
            }
            else
            {
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill">Pending Audit</span>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Left Column: Credentials & Financial Summary -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-card-checklist text-success me-2"></i>Medical Credentials</h5>
            
            <div class="mb-3">
                <span class="text-muted small">State / Council Reg. Number</span>
                <div class="fw-bold font-monospace text-dark">@(detail?.RegistrationNumber ?? "AYUSH-REG-VERIFIED")</div>
            </div>

            <div class="mb-3">
                <span class="text-muted small">Registration Council</span>
                <div class="fw-semibold text-dark">@(detail?.RegistrationCouncil ?? "Central Council of Indian Medicine")</div>
            </div>

            <div class="row g-2 mb-3">
                <div class="col-6">
                    <span class="text-muted small">Clinical Experience</span>
                    <div class="fw-bold text-dark">@(detail?.Experience ?? 0) Years</div>
                </div>
                <div class="col-6">
                    <span class="text-muted small">Degree / Qualification</span>
                    <div class="fw-bold text-dark">@(detail?.Qualification ?? "BAMS")</div>
                </div>
            </div>

            <div class="mb-3">
                <span class="text-muted small">Languages Spoken</span>
                <div class="fw-semibold text-dark">@(detail?.Language ?? "Hindi, English")</div>
            </div>

            <div class="mb-3">
                <span class="text-muted small">Consultation Fee</span>
                <div class="fs-5 fw-bold text-success">₹@(detail?.ConsultationFee ?? 500m)</div>
            </div>

            <div class="mb-0">
                <span class="text-muted small">Clinic / Dispensary Address</span>
                <div class="small text-dark">@(detail?.ClinicAddress ?? "Registered Clinical Facility")</div>
            </div>
        </div>

        <!-- Telemedicine Financial Ledger -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-cash-stack text-success me-2"></i>Practice Financials</h5>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Gross Consultations:</span>
                <span class="fw-bold text-dark">₹@Model.GrossEarnings.ToString("N0")</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-muted small">Platform Fee (15%):</span>
                <span class="text-muted small">-₹@((Model.GrossEarnings * 0.15m).ToString("N0"))</span>
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between">
                <span class="fw-bold small text-dark">Net Settled / Credit:</span>
                <span class="fw-bold text-success">₹@Model.SettledPayouts.ToString("N0")</span>
            </div>
        </div>
    </div>

    <!-- Right Column: Consultation History & Reviews -->
    <div class="col-lg-8">
        <!-- Recent Consultations Table -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-calendar2-check text-success me-2"></i>Recent Patient Consultations</h5>
            @if (!Model.RecentAppointments.Any())
            {
                <p class="text-muted small mb-0 py-3 text-center">No consultations booked with this physician yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Ref #</th>
                                <th>Date &amp; Time (UTC)</th>
                                <th>Patient</th>
                                <th>Mode</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appt in Model.RecentAppointments)
                            {
                                <tr>
                                    <td class="fw-bold small">#@appt.Id</td>
                                    <td class="small">@appt.StartUtc.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="small fw-semibold">@appt.PatientName</td>
                                    <td><span class="badge bg-light text-dark border">@appt.ConsultationType</span></td>
                                    <td class="text-center"><span class="badge bg-success-subtle text-success">@appt.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Verified Reviews -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-chat-heart text-success me-2"></i>Verified Patient Feedback</h5>
                <span class="badge bg-light text-dark border">@Model.Reviews.Count Reviews</span>
            </div>

            @if (!Model.Reviews.Any())
            {
                <p class="text-muted small mb-0 py-3 text-center">No verified reviews recorded for this doctor.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var r in Model.Reviews)
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-dark">@(r.User != null ? r.User.FullName : "Verified Patient")</span>
                                <div class="text-warning small">
                                    @for (int i = 0; i < r.Rating; i++) { <span>★</span> }
                                </div>
                            </div>
                            <p class="small text-muted mb-1">@r.ReviewText</p>
                            <span class="text-muted" style="font-size: 0.725rem;">Reviewed on @r.CreatedAt.ToString("dd MMM yyyy")</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
