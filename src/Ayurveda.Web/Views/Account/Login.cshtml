@model Ayurveda.Application.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="row g-0">
                    <!-- Left: Benefit Panel -->
                    <div class="col-md-5 d-none d-md-flex flex-column justify-content-between p-5 text-white" 
                         style="background: linear-gradient(135deg, #143F27, #1F5E3B);">
                        <div>
                            <img src="/images/logo-dark.svg" alt="The Great Ayurveda" height="44" class="mb-4" />
                            <h3 class="fw-bold mb-3" style="font-family: Georgia, serif;">Welcome to Holistic Wellbeing</h3>
                            <p class="text-light-emphasis small">
                                Sign in to manage your Ayurvedic prescriptions, review your medical consults, and order pure lab-tested herbal formulations.
                            </p>
                        </div>
                        <div class="border-top border-success-subtle pt-3 small text-white-50">
                            <i class="bi bi-shield-check text-warning me-1"></i> 100% Encrypted & AYUSH Compliant
                        </div>
                    </div>

                    <!-- Right: Form -->
                    <div class="col-md-7 p-4 p-md-5 bg-white">
                        <h2 class="fw-bold text-dark mb-1" style="font-family: Georgia, serif;">Sign In</h2>
                        <p class="text-muted small mb-4">Enter your credentials to access your account</p>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small" role="alert">
                                <div asp-validation-summary="All"></div>
                            </div>
                        }

                        <form asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Email Address</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" required autofocus />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-semibold mb-0">Password</label>
                                    <a asp-action="ForgotPassword" class="small text-success text-decoration-none">Forgot password?</a>
                                </div>
                                <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMeCheck" />
                                <label class="form-check-label small text-muted" for="rememberMeCheck">
                                    Keep me signed in
                                </label>
                            </div>

                            <button type="submit" class="btn btn-tga-primary w-100 py-2 rounded-pill fw-semibold shadow">
                                Sign In
                            </button>

                            <div class="text-center mt-4 small text-muted">
                                Don't have an account? 
                                <a asp-action="Register" class="text-success fw-bold text-decoration-none">Create Account</a>
                            </div>

                            <div class="text-center mt-2 small text-muted">
                                Are you a Doctor? 
                                <a asp-action="DoctorRegister" class="text-primary fw-semibold text-decoration-none">Register as Physician</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
