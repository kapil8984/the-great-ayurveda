@model Ayurveda.Application.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card p-4 p-md-5 shadow-sm border-0 rounded-4">
                <h2 class="fw-bold text-dark mb-1" style="font-family: Georgia, serif;">Join The Great Ayurveda</h2>
                <p class="text-muted small mb-4">Create your patient profile for seamless consultations and orders</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Full Name *</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Aarav Sharma" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Email Address *</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="aarav@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mobile Number *</label>
                        <input asp-for="ContactNumber" class="form-control" placeholder="10-digit mobile number" required />
                        <span asp-validation-for="ContactNumber" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Password *</label>
                            <input asp-for="Password" type="password" class="form-control" placeholder="Min 8 characters" required />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Confirm Password *</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input class="form-check-input" type="checkbox" asp-for="AgreeToTerms" id="agreeTerms" required />
                        <label class="form-check-label small text-muted" for="agreeTerms">
                            I agree to the <a asp-controller="Home" asp-action="Privacy" target="_blank" class="text-success">Terms of Service & Medical Disclaimer</a>.
                        </label>
                        <span asp-validation-for="AgreeToTerms" class="text-danger small d-block"></span>
                    </div>

                    <button type="submit" class="btn btn-tga-primary w-100 py-2 rounded-pill fw-semibold shadow">
                        Create My Account
                    </button>

                    <div class="text-center mt-4 small text-muted">
                        Already have an account? 
                        <a asp-action="Login" class="text-success fw-bold text-decoration-none">Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
