@model Ayurveda.Application.ViewModels.ForgotPasswordViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Forgot Password";
    var smtpHost = Configuration["Smtp:Host"];
    var isSmtpConfigured = !string.IsNullOrWhiteSpace(smtpHost) && smtpHost != "smtp.example.com" && !Configuration.GetValue<bool>("DemoMode", false);
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card p-4 p-md-5 shadow-sm border-0 rounded-4">
                <h3 class="fw-bold text-dark mb-1" style="font-family: Georgia, serif;">Reset Password</h3>
                <p class="text-muted small mb-3">Enter your registered email address and we'll send a 6-digit security OTP code.</p>

                @if (!isSmtpConfigured)
                {
                    <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-3" role="alert">
                        <i class="bi bi-info-circle me-1"></i> <strong>Email is disabled in this demo.</strong>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Email Address *</label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-tga-primary w-100 py-2 rounded-pill fw-semibold shadow">
                        Send Verification Code
                    </button>

                    <div class="text-center mt-3 small text-muted">
                        <a asp-action="Login" class="text-success text-decoration-none">Back to Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
