@model Ayurveda.Application.ViewModels.ResetPasswordOtpViewModel
@{
    ViewData["Title"] = "Enter Security OTP";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="card p-4 p-md-5 shadow-sm border-0 rounded-4">
                <h3 class="fw-bold text-dark mb-1" style="font-family: Georgia, serif;">Verify Code & Update</h3>
                <p class="text-muted small mb-4">Enter the 6-digit verification code sent to your email and your new password.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">6-Digit Security OTP *</label>
                        <input asp-for="Otp" class="form-control text-center fs-4 letter-spacing-2" maxlength="6" placeholder="123456" required autofocus />
                        <span asp-validation-for="Otp" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">New Password *</label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min 8 characters" required />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Confirm New Password *</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter new password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-tga-primary w-100 py-2 rounded-pill fw-semibold shadow">
                        Reset Password
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
