@model Ayurveda.Application.ViewModels.ResetPasswordOtpViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Reset Password Code & Update";
    var otpMode = Configuration["Auth:OtpMode"] ?? Configuration["Auth__OtpMode"] ?? "Demo";
    var isDemoOtp = !string.Equals(otpMode, "Email", StringComparison.OrdinalIgnoreCase) && !string.Equals(otpMode, "Live", StringComparison.OrdinalIgnoreCase);
}

<div class="container py-4 my-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card p-3 p-sm-4 p-md-5 shadow-xl border-0 rounded-4 bg-white text-center">
                <div class="mb-3">
                    <div class="d-inline-flex p-3 rounded-circle bg-warning-subtle text-warning fs-2 mb-2">
                        <i class="bi bi-key"></i>
                    </div>
                    <h2 class="fw-bold font-serif text-dark mb-1 fs-3">Set New Password</h2>
                    <p class="text-muted small mb-2 text-break">
                        Enter the 6-digit verification code sent to<br />
                        <strong class="text-dark">@Model.Email</strong>
                    </p>
                    @if (isDemoOtp)
                    {
                        <div class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill small mb-3">
                            <i class="bi bi-info-circle me-1"></i> Demo: enter any 6 digits
                        </div>
                    }
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small border-0 rounded-3 mb-3 text-start" role="alert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-action="ResetPassword" method="post" id="resetPasswordForm" class="text-start">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Otp" id="hiddenResetOtp" />

                    <!-- 6-digit Auto-Advancing OTP Boxes Responsive to 320px -->
                    <label class="form-label small fw-semibold d-block text-center mb-2">Enter 6-Digit Code *</label>
                    <div class="d-flex justify-content-center mb-3" style="gap: clamp(4px, 1.5vw, 8px); max-width: 100%;">
                        @for (int i = 0; i < 6; i++)
                        {
                            <input type="text" 
                                   maxlength="1" 
                                   class="form-control text-center fw-bold fs-4 reset-otp-box rounded-3" 
                                   style="width: clamp(34px, 11vw, 44px); height: clamp(42px, 12vw, 52px); padding: 0; border: 2px solid #E5DED2;" 
                                   data-index="@i" 
                                   inputmode="numeric" 
                                   pattern="[0-9]*" 
                                   required />
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label small fw-semibold">New Password *</label>
                        <div class="input-group">
                            <input asp-for="NewPassword" type="password" class="form-control border-end-0" id="resetNewPwd" placeholder="Minimum 8 characters" required />
                            <button type="button" class="input-group-text bg-light text-muted border-start-0" id="toggleResetPwdBtn">
                                <i class="bi bi-eye" id="toggleResetPwdIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>

                        <!-- Live Strength Meter -->
                        <div class="mt-2">
                            <div class="progress" style="height: 5px;">
                                <div class="progress-bar bg-danger" id="resetStrengthBar" style="width: 0%;"></div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm New Password *</label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-tga-gold text-dark fw-bold w-100 py-2 rounded-pill mb-3">
                        <i class="bi bi-shield-check me-1"></i> Update &amp; Secure Account
                    </button>
                </form>

                <!-- Resend Timer -->
                <div class="pt-3 border-top text-center">
                    <div class="small text-muted mb-2" id="resetResendTimerContainer">
                        Didn't receive code? Resend in <span class="fw-bold text-dark" id="resetCountdownTimer">60</span>s
                    </div>
                    <button type="button" class="btn btn-link text-success text-decoration-none fw-semibold small p-0 d-none" id="resetResendBtn">
                        <i class="bi bi-arrow-repeat me-1"></i> Resend Verification Code
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const resetBoxes = document.querySelectorAll(".reset-otp-box");
    const hiddenOtp = document.getElementById("hiddenResetOtp");
    const resetForm = document.getElementById("resetPasswordForm");

    resetBoxes.forEach((box, idx) => {
        box.addEventListener("input", (e) => {
            const val = e.target.value.replace(/[^0-9]/g, "");
            e.target.value = val;
            if (val.length === 1 && idx < resetBoxes.length - 1) {
                resetBoxes[idx + 1].focus();
            }
            updateOtp();
        });

        box.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && !box.value && idx > 0) {
                resetBoxes[idx - 1].focus();
            }
        });

        box.addEventListener("paste", (e) => {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData("text").replace(/[^0-9]/g, "");
            if (pasted.length >= 6) {
                for (let i = 0; i < 6; i++) {
                    resetBoxes[i].value = pasted[i];
                }
                resetBoxes[5].focus();
                updateOtp();
            }
        });
    });

    function updateOtp() {
        let code = "";
        resetBoxes.forEach(b => code += b.value);
        if (hiddenOtp) hiddenOtp.value = code;
    }

    if (resetForm) {
        resetForm.addEventListener("submit", (e) => {
            updateOtp();
            if (hiddenOtp.value.length < 6) {
                e.preventDefault();
                alert("Please enter all 6 digits of your verification code.");
            }
        });
    }

    if (resetBoxes.length > 0) resetBoxes[0].focus();

    // Toggle Password Visibility
    const pwdBtn = document.getElementById("toggleResetPwdBtn");
    const pwdInput = document.getElementById("resetNewPwd");
    const pwdIcon = document.getElementById("toggleResetPwdIcon");
    if (pwdBtn && pwdInput && pwdIcon) {
        pwdBtn.addEventListener("click", () => {
            const isPassword = pwdInput.getAttribute("type") === "password";
            pwdInput.setAttribute("type", isPassword ? "text" : "password");
            pwdIcon.className = isPassword ? "bi bi-eye-slash" : "bi bi-eye";
        });
    }

    // Password Strength
    const rBar = document.getElementById("resetStrengthBar");
    if (pwdInput && rBar) {
        pwdInput.addEventListener("input", () => {
            const val = pwdInput.value;
            let score = 0;
            if (val.length >= 8) score += 25;
            if (/[A-Z]/.test(val)) score += 25;
            if (/[0-9]/.test(val)) score += 25;
            if (/[^A-Za-z0-9]/.test(val)) score += 25;
            rBar.style.width = score + "%";
            rBar.className = score <= 25 ? "progress-bar bg-danger" : score <= 50 ? "progress-bar bg-warning" : score <= 75 ? "progress-bar bg-info" : "progress-bar bg-success";
        });
    }

    // 60s Countdown
    let resetTimer = 60;
    const rTimerEl = document.getElementById("resetCountdownTimer");
    const rContainerEl = document.getElementById("resetResendTimerContainer");
    const rResendBtn = document.getElementById("resetResendBtn");

    const timerInt = setInterval(() => {
        resetTimer--;
        if (rTimerEl) rTimerEl.innerText = resetTimer;
        if (resetTimer <= 0) {
            clearInterval(timerInt);
            if (rContainerEl) rContainerEl.classList.add("d-none");
            if (rResendBtn) rResendBtn.classList.remove("d-none");
        }
    }, 1000);

    if (rResendBtn) {
        rResendBtn.addEventListener("click", () => {
            rResendBtn.disabled = true;
            fetch("/account/resend-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: "@Model.Email" })
            })
            .then(res => res.json())
            .then(data => {
                alert(data.message || "A new code has been dispatched.");
                rResendBtn.disabled = false;
                rResendBtn.classList.add("d-none");
                rContainerEl.classList.remove("d-none");
                resetTimer = 60;
                if (rTimerEl) rTimerEl.innerText = resetTimer;
            })
            .catch(() => {
                rResendBtn.disabled = false;
                alert("Failed to resend code.");
            });
        });
    }
</script>
}
