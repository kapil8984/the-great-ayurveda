@model Ayurveda.Application.ViewModels.VerifyEmailOtpViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Verify Email Address";
    var otpMode = Configuration["Auth:OtpMode"] ?? Configuration["Auth__OtpMode"] ?? "Demo";
    var isDemoOtp = !string.Equals(otpMode, "Email", StringComparison.OrdinalIgnoreCase) && !string.Equals(otpMode, "Live", StringComparison.OrdinalIgnoreCase);
}

<div class="container py-4 my-auto">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card p-3 p-sm-4 p-md-5 shadow-xl border-0 rounded-4 text-center bg-white">
                <div class="mb-3">
                    <div class="d-inline-flex p-3 rounded-circle bg-success-subtle text-success fs-2 mb-2">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <h2 class="fw-bold font-serif text-dark mb-1 fs-3">Verify Your Email</h2>
                    <p class="text-muted small mb-2 text-break">
                        We sent a 6-digit verification code to<br />
                        <strong class="text-dark">@Model.Email</strong>
                    </p>
                    @if (isDemoOtp)
                    {
                        <div class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill small mb-3">
                            <i class="bi bi-info-circle me-1"></i> Demo: enter any 6 digits
                        </div>
                    }
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small border-0 rounded-3 mb-3 text-start" role="alert" id="otpValidationAlert">
                        <div asp-validation-summary="All"></div>
                    </div>
                }
                <div id="clientOtpError" class="alert alert-danger py-2 px-3 small border-0 rounded-3 mb-3 text-start d-none" role="alert"></div>

                <form asp-action="VerifyOtp" method="post" id="otpForm" novalidate class="@(!ViewData.ModelState.IsValid ? "form-shake-error" : "")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="Otp" id="hiddenOtpInput" />

                    <!-- 6 Separate Auto-Advancing Input Boxes Responsive to 320px -->
                    <div class="d-flex justify-content-center mb-3 stagger-field stagger-1" id="otpBoxesContainer" style="gap: clamp(3px, 1.2vw, 8px); max-width: 100%;">
                        @for (int i = 0; i < 6; i++)
                        {
                            <input type="text" 
                                   maxlength="1" 
                                   class="form-control text-center fw-bold fs-4 otp-box rounded-3" 
                                   style="width: clamp(32px, 10vw, 46px); height: clamp(42px, 13vw, 56px); padding: 0; border: 2px solid #E5DED2;" 
                                   data-index="@i" 
                                   inputmode="numeric" 
                                   pattern="[0-9]*" 
                                   autocomplete="one-time-code" />
                        }
                    </div>
                    <span asp-validation-for="Otp" class="text-danger small d-block mb-3"></span>

                    <button type="submit" class="btn btn-tga-gold text-dark fw-bold w-100 py-2 rounded-pill mb-3 stagger-field stagger-2" id="verifyOtpSubmitBtn" data-loading-btn="true">
                        <i class="bi bi-check-circle me-1"></i> Verify &amp; Continue
                    </button>
                </form>

                <!-- Resend Timer Section -->
                <div class="pt-3 border-top text-center">
                    <div class="small text-muted mb-2" id="resendCountdownContainer">
                        Didn't receive the code? Resend in <span class="fw-bold text-dark" id="countdownTimer">60</span>s
                    </div>
                    <button type="button" class="btn btn-link text-success text-decoration-none fw-semibold small p-0 d-none" id="resendOtpBtn">
                        <i class="bi bi-arrow-repeat me-1"></i> Resend Verification Code
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const otpBoxes = document.querySelectorAll(".otp-box");
    const hiddenOtp = document.getElementById("hiddenOtpInput");
    const form = document.getElementById("otpForm");

    // 6-box auto advance and backspace
    otpBoxes.forEach((box, idx) => {
        box.addEventListener("input", (e) => {
            const val = e.target.value.replace(/[^0-9]/g, "");
            e.target.value = val;

            if (val.length === 1 && idx < otpBoxes.length - 1) {
                otpBoxes[idx + 1].focus();
            }
            updateHiddenOtp();
        });

        box.addEventListener("keydown", (e) => {
            if (e.key === "Backspace" && !box.value && idx > 0) {
                otpBoxes[idx - 1].focus();
            }
        });

        // Paste support (e.g. pasting 6-digit code)
        box.addEventListener("paste", (e) => {
            e.preventDefault();
            const pasted = (e.clipboardData || window.clipboardData).getData("text").replace(/[^0-9]/g, "");
            if (pasted.length >= 6) {
                for (let i = 0; i < 6; i++) {
                    otpBoxes[i].value = pasted[i];
                }
                otpBoxes[5].focus();
                updateHiddenOtp();
            }
        });
    });

    function updateHiddenOtp() {
        let code = "";
        otpBoxes.forEach(b => code += b.value);
        const hiddenEl = document.getElementById("hiddenOtpInput") || document.getElementById("Otp");
        if (hiddenEl) hiddenEl.value = code;
        return code;
    }

    function validateAndShowError(e) {
        const code = updateHiddenOtp();
        const clientErr = document.getElementById("clientOtpError");
        if (code.length < 6) {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            if (clientErr) {
                clientErr.textContent = "Please enter all 6 digits of your verification code.";
                clientErr.classList.remove("d-none");
            }
            const firstEmpty = Array.from(otpBoxes).find(b => !b.value);
            if (firstEmpty) firstEmpty.focus();
            return false;
        } else {
            if (clientErr) clientErr.classList.add("d-none");
            return true;
        }
    }

    const submitBtn = document.getElementById("verifyOtpSubmitBtn");
    if (submitBtn) {
        submitBtn.addEventListener("click", validateAndShowError);
    }

    if (form) {
        form.addEventListener("submit", validateAndShowError);
    }

    // Auto-focus first box
    if (otpBoxes.length > 0) otpBoxes[0].focus();

    // 60-Second Resend Countdown Timer
    let countdown = 60;
    const timerEl = document.getElementById("countdownTimer");
    const containerEl = document.getElementById("resendCountdownContainer");
    const resendBtn = document.getElementById("resendOtpBtn");

    const timerInterval = setInterval(() => {
        countdown--;
        if (timerEl) timerEl.innerText = countdown;
        if (countdown <= 0) {
            clearInterval(timerInterval);
            if (containerEl) containerEl.classList.add("d-none");
            if (resendBtn) resendBtn.classList.remove("d-none");
        }
    }, 1000);

    // Resend OTP Action
    if (resendBtn) {
        resendBtn.addEventListener("click", () => {
            resendBtn.disabled = true;
            resendBtn.innerText = "Sending code...";

            fetch("/account/resend-otp", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ email: "@Model.Email" })
            })
            .then(res => res.json())
            .then(data => {
                resendBtn.disabled = false;
                resendBtn.classList.add("d-none");
                containerEl.classList.remove("d-none");
                countdown = 60;
                if (timerEl) timerEl.innerText = countdown;
                alert(data.message || "A new 6-digit verification code has been dispatched.");
            })
            .catch(err => {
                resendBtn.disabled = false;
                resendBtn.innerText = "Resend Verification Code";
                alert("Failed to resend code. Please try again.");
            });
        });
    }
</script>
}
