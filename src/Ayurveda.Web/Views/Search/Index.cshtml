@model Ayurveda.Application.ViewModels.SearchResultsViewModel
@inject Ayurveda.Infrastructure.Data.AyurvedaDbContext DbContext
@using Microsoft.EntityFrameworkCore
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Apothecary Search & Formulations" : $"Search Results for \"{Model.Query}\"";
    var catalog = Model.Catalog;
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var searchTopAd = await DbContext.Banners.FirstOrDefaultAsync(b => b.IsActive && b.Placement == "ad_search_top");
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-muted">Apothecary</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">
                @(string.IsNullOrWhiteSpace(Model.Query) ? "Explore" : $"\"{Model.Query}\"")
            </li>
        </ol>
    </nav>

    @if (searchTopAd != null)
    {
        <div class="mb-3">
            <partial name="_AdBanner" model="searchTopAd" />
        </div>
    }

    <!-- Typo Tolerance "Did you mean ...?" Banner -->
    @if (!string.IsNullOrWhiteSpace(Model.DidYouMean))
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-3 d-flex align-items-center justify-content-between p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-lightbulb-fill text-warning fs-4"></i>
                <div>
                    <span class="text-muted small">Did you mean:</span>
                    <a asp-action="Index" asp-route-q="@Model.DidYouMean" class="fw-bold text-success text-decoration-underline ms-1">
                        @Model.DidYouMean
                    </a>?
                    <span class="text-muted small ms-2 d-none d-md-inline">(Showing matching formulations)</span>
                </div>
            </div>
            <a asp-action="Index" asp-route-q="@Model.DidYouMean" class="btn btn-sm btn-outline-success rounded-pill px-3">
                Search "@Model.DidYouMean"
            </a>
        </div>
    }

    <!-- Hindi / Hinglish Transliteration Synonym Banner -->
    @if (!string.IsNullOrWhiteSpace(Model.SynonymApplied))
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-3 d-flex align-items-center gap-3 p-3">
            <i class="bi bi-translate text-success fs-4"></i>
            <div>
                <span class="fw-semibold">Ayurvedic Transliteration:</span>
                <span class="ms-1">Mapped "<strong>@Model.Query</strong>" to traditional therapeutic concern <strong>@Model.SynonymApplied</strong>.</span>
            </div>
        </div>
    }

    <!-- Header, Total Count & Sort Controls -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 border-bottom pb-3">
        <div>
            <h1 class="h4 fw-bold font-serif text-success mb-1">
                @if (string.IsNullOrWhiteSpace(Model.Query))
                {
                    <span>Explore Classical Formulations</span>
                }
                else
                {
                    <span>Results for <span class="text-dark">"@Model.Query"</span></span>
                }
            </h1>
            <p class="text-muted small mb-0">
                Found <strong>@catalog.TotalCount</strong> authentic Ayurvedic item@(catalog.TotalCount == 1 ? "" : "s")
                <span class="badge bg-light text-muted border ms-2">⚡ p95 @Model.LatencyMs ms</span>
            </p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Mobile Filter Trigger Button -->
            <button class="btn btn-outline-success btn-sm rounded-pill d-lg-none d-inline-flex align-items-center gap-1 px-3" 
                    type="button" 
                    data-bs-toggle="offcanvas" 
                    data-bs-target="#mobileFilterDrawer" 
                    aria-controls="mobileFilterDrawer"
                    style="min-height: 38px;">
                <i class="bi bi-funnel"></i>
                <span>Filters</span>
                @if (catalog.ActiveChips.Any())
                {
                    <span class="badge bg-success rounded-pill ms-1">@catalog.ActiveChips.Count</span>
                }
            </button>

            <!-- Sort Control -->
            <form method="get" id="sortForm" class="d-flex align-items-center gap-1 m-0">
                <input type="hidden" name="q" value="@Model.Query" />
                @if (catalog.SelectedCategoryId.HasValue) { <input type="hidden" name="categoryId" value="@catalog.SelectedCategoryId.Value" /> }
                @if (catalog.SelectedSubcategoryId.HasValue) { <input type="hidden" name="subcategoryId" value="@catalog.SelectedSubcategoryId.Value" /> }
                @if (!string.IsNullOrWhiteSpace(catalog.SelectedBrand)) { <input type="hidden" name="brand" value="@catalog.SelectedBrand" /> }
                @if (!string.IsNullOrWhiteSpace(catalog.Concern)) { <input type="hidden" name="concern" value="@catalog.Concern" /> }
                @if (catalog.MinPrice.HasValue) { <input type="hidden" name="minPrice" value="@catalog.MinPrice.Value" /> }
                @if (catalog.MaxPrice.HasValue) { <input type="hidden" name="maxPrice" value="@catalog.MaxPrice.Value" /> }
                @if (catalog.MinRating.HasValue) { <input type="hidden" name="minRating" value="@catalog.MinRating.Value" /> }
                @if (catalog.MinDiscount.HasValue) { <input type="hidden" name="minDiscount" value="@catalog.MinDiscount.Value" /> }
                @if (catalog.InStockOnly) { <input type="hidden" name="inStockOnly" value="true" /> }

                <label for="sortSelect" class="small text-muted text-nowrap d-none d-sm-inline">Sort by:</label>
                <select name="sort" id="sortSelect" class="form-select form-select-sm rounded-pill border-secondary-subtle" onchange="this.form.submit()" style="min-width: 140px; min-height: 38px;">
                    <option value="relevance" selected="@(catalog.SelectedSort == "relevance")">Relevance</option>
                    <option value="price_asc" selected="@(catalog.SelectedSort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(catalog.SelectedSort == "price_desc")">Price: High to Low</option>
                    <option value="rating" selected="@(catalog.SelectedSort == "rating")">Highest Rated (4★+)</option>
                    <option value="discount" selected="@(catalog.SelectedSort == "discount")">Special Discount</option>
                    <option value="newest" selected="@(catalog.SelectedSort == "newest")">Newest Arrivals</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Active Filter Chips -->
    @if (catalog.ActiveChips.Any())
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 bg-light rounded-3">
            <span class="small fw-semibold text-muted me-1"><i class="bi bi-funnel-fill me-1"></i> Active Filters:</span>
            @foreach (var chip in catalog.ActiveChips)
            {
                <a href="@chip.RemoveUrl" class="badge rounded-pill bg-white text-dark border p-2 px-3 text-decoration-none shadow-xs d-inline-flex align-items-center gap-1 hover-shadow">
                    <span>@chip.Label</span>
                    <i class="bi bi-x text-danger fw-bold fs-6"></i>
                </a>
            }
            <a asp-action="Index" asp-route-q="@Model.Query" class="btn btn-link text-danger text-decoration-none small p-0 ms-2 fw-semibold">
                Clear all
            </a>
        </div>
    }

    <!-- Main Results Row -->
    <div class="row g-4">
        <!-- Desktop Left Filter Sidebar -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 shadow-sm rounded-4 p-3 sticky-top" style="top: 90px; max-height: calc(100vh - 110px); overflow-y: auto;">
                <div class="d-flex align-items-center justify-content-between pb-2 mb-3 border-bottom">
                    <h5 class="fw-bold text-success mb-0 fs-6"><i class="bi bi-sliders me-1"></i> Refine Formulations</h5>
                    @if (catalog.ActiveChips.Any())
                    {
                        <a asp-action="Index" asp-route-q="@Model.Query" class="small text-danger text-decoration-none fw-semibold">Clear All</a>
                    }
                </div>

                @await Html.PartialAsync("_SearchFilterContent", Model)

                @if (ViewBag.AdShopSide != null)
                {
                    <div class="pt-3 border-top mt-3">
                        <partial name="_AdBanner" model="ViewBag.AdShopSide" />
                    </div>
                }
            </div>
        </div>

        <!-- Mobile Offcanvas Filter Drawer -->
        <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileFilterDrawer" aria-labelledby="mobileFilterDrawerLabel">
            <div class="offcanvas-header border-bottom py-3">
                <h5 class="offcanvas-title fw-bold text-success" id="mobileFilterDrawerLabel">
                    <i class="bi bi-sliders me-1"></i> Filter Formulations
                </h5>
                <button type="button" class="btn-close tga-touch-target" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body p-3">
                @await Html.PartialAsync("_SearchFilterContent", Model)
            </div>
        </div>

        <!-- Products Grid / Empty State -->
        <div class="col-lg-9">
            @if (catalog.TotalCount == 0)
            {
                <!-- Zero Results State -->
                <div class="card border-0 shadow-sm rounded-4 text-center p-4 p-md-5">
                    <div class="mb-3">
                        <span class="badge bg-warning-subtle text-warning p-3 rounded-circle fs-2">
                            <i class="bi bi-search"></i>
                        </span>
                    </div>
                    <h3 class="fw-bold text-dark mb-2 font-serif">No Ayurvedic formulations matched your search</h3>
                    <p class="text-muted mb-4 mx-auto" style="max-width: 520px;">
                        We couldn't find any products matching "<strong>@Model.Query</strong>". Try checking the spelling, resetting active filters, or exploring classical botanicals.
                    </p>

                    <div class="card bg-light border-0 rounded-4 p-3 p-md-4 mb-4 mx-auto text-start" style="max-width: 600px;">
                        <h6 class="fw-bold text-success mb-2"><i class="bi bi-compass me-1"></i> Search Suggestions:</h6>
                        <ul class="small text-muted mb-0 ps-3">
                            <li class="mb-1">Use broader keywords (e.g. <em>oil</em>, <em>churna</em>, <em>ghee</em>, <em>tea</em>).</li>
                            <li class="mb-1">Try traditional transliterations (e.g. <em>bukhar</em>, <em>neend</em>, <em>kabz</em>).</li>
                            <li>Explore by health concern: <a asp-controller="Shop" asp-action="Index" asp-route-concern="Digestion" class="text-success fw-semibold">Digestion</a>, <a asp-controller="Shop" asp-action="Index" asp-route-concern="Stress" class="text-success fw-semibold">Stress</a>, <a asp-controller="Shop" asp-action="Index" asp-route-concern="Immunity" class="text-success fw-semibold">Immunity</a>.</li>
                        </ul>
                    </div>

                    <div>
                        <div class="small fw-bold text-muted text-uppercase mb-2">Popular Ayurveda Searches:</div>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            @foreach (var trend in Model.TrendingSearches)
                            {
                                <a asp-action="Index" asp-route-q="@trend" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1">
                                    <i class="bi bi-fire text-warning me-1"></i> @trend
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Products Grid -->
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-4">
                    @for (int idx = 0; idx < catalog.Products.Count; idx++)
                    {
                        var product = catalog.Products[idx];
                        <div class="col">
                            <div class="card h-100 border product-card shadow-xs rounded-4 overflow-hidden position-relative hover-shadow transition-all">
                                @if (!string.IsNullOrEmpty(product.Badge))
                                {
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-success text-white shadow-xs z-1">
                                        @product.Badge
                                    </span>
                                }

                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none">
                                    <div class="p-3 text-center bg-light" style="height: 180px;">
                                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.svg" : product.ImageUrl)" 
                                             alt="@product.Title" 
                                             class="img-fluid h-100 object-fit-contain" 
                                             onerror="this.onerror=null;this.src='/images/placeholder.svg';" 
                                             loading="lazy" />
                                    </div>
                                </a>

                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="text-muted text-xs text-uppercase fw-semibold mb-1">
                                        @product.Brand • @product.CategoryName
                                    </div>
                                    <h6 class="card-title fw-bold mb-1 text-truncate-2" style="font-size: 0.95rem; min-height: 2.6rem;">
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none">
                                            @product.Title
                                        </a>
                                    </h6>

                                    <div class="d-flex align-items-center gap-1 mb-2">
                                        <span class="badge bg-warning text-dark text-xs"><i class="bi bi-star-fill"></i> @product.AverageRating.ToString("F1")</span>
                                        @if (!string.IsNullOrEmpty(product.TraditionallyUsedFor))
                                        {
                                            <span class="text-muted text-xs text-truncate">@product.TraditionallyUsedFor</span>
                                        }
                                    </div>

                                    <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold text-success fs-6">₹@product.Price.ToString("N0")</span>
                                            @if (product.Mrp > product.Price)
                                            {
                                                <span class="text-muted text-decoration-line-through text-xs ms-1">₹@product.Mrp.ToString("N0")</span>
                                                <span class="text-danger text-xs fw-semibold ms-1">(@product.DiscountPercent% off)</span>
                                            }
                                        </div>

                                        <button type="button" 
                                                class="btn btn-tga-gold btn-sm rounded-pill px-3 btn-add-to-cart-ajax tga-touch-target" 
                                                data-product-id="@product.Id"
                                                style="min-height: 38px;"
                                                title="Add to Basket">
                                            <i class="bi bi-bag-plus"></i> Add
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if ((idx + 1) % 8 == 0 && ViewBag.AdShopInline is List<Ayurveda.Domain.Entities.Banner> inlineAds && inlineAds.Count > 0)
                        {
                            var ad = inlineAds[((idx + 1) / 8 - 1) % inlineAds.Count];
                            <div class="col">
                                <partial name="_AdBanner" model="ad" />
                            </div>
                        }
                    }
                </div>

                <!-- Pagination -->
                @if (catalog.TotalPages > 1)
                {
                    <nav aria-label="Search navigation" class="mt-4">
                        <ul class="pagination justify-content-center flex-wrap gap-1">
                            @if (catalog.PageIndex > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill px-3" href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(catalog.PageIndex - 1)">Previous</a>
                                </li>
                            }

                            @for (var p = 1; p <= catalog.TotalPages; p++)
                            {
                                <li class="page-item @(p == catalog.PageIndex ? "active" : "")">
                                    <a class="page-link rounded-circle text-center" style="width: 38px; height: 38px; line-height: 24px;" href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@p">@p</a>
                                </li>
                            }

                            @if (catalog.PageIndex < catalog.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill px-3" href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(catalog.PageIndex + 1)">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
