@model Ayurveda.Application.ViewModels.SearchResultsViewModel
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Query) ? "Search Medicines & Formulations" : $"Search Results for \"{Model.Query}\"";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-muted">Apothecary</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">
                @(string.IsNullOrWhiteSpace(Model.Query) ? "Search" : $"\"{Model.Query}\"")
            </li>
        </ol>
    </nav>

    <!-- Typo Tolerance "Did you mean ...?" Banner -->
    @if (!string.IsNullOrWhiteSpace(Model.DidYouMean))
    {
        <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center justify-content-between p-3">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-lightbulb-fill text-warning fs-4"></i>
                <div>
                    <span class="text-muted small">Did you mean:</span>
                    <a asp-action="Index" asp-route-q="@Model.DidYouMean" class="fw-bold text-success text-decoration-underline ms-1">
                        @Model.DidYouMean
                    </a>?
                    <span class="text-muted small ms-2 d-none d-md-inline">(Showing matching results for your query)</span>
                </div>
            </div>
            <a asp-action="Index" asp-route-q="@Model.DidYouMean" class="btn btn-sm btn-outline-success rounded-pill px-3">
                Search "@Model.DidYouMean" instead
            </a>
        </div>
    }

    <!-- Hindi / Hinglish Transliteration Synonym Banner -->
    @if (!string.IsNullOrWhiteSpace(Model.SynonymApplied))
    {
        <div class="alert alert-success border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center gap-3 p-3">
            <i class="bi bi-translate text-success fs-4"></i>
            <div>
                <span class="fw-semibold">Ayurvedic Transliteration Applied:</span>
                <span class="ms-1">Translated "<strong>@Model.Query</strong>" to traditional therapeutic category <strong>@Model.SynonymApplied</strong>.</span>
            </div>
        </div>
    }

    <!-- Header & Latency Indicator -->
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4 border-bottom pb-3">
        <div>
            <h1 class="h3 fw-bold font-serif text-success mb-1">
                @if (string.IsNullOrWhiteSpace(Model.Query))
                {
                    <span>Explore Classical Apothecary</span>
                }
                else
                {
                    <span>Results for <span class="text-dark">"@Model.Query"</span></span>
                }
            </h1>
            <p class="text-muted small mb-0">
                Found <strong>@Model.Catalog.TotalCount</strong> authentic Ayurvedic formulation@(Model.Catalog.TotalCount == 1 ? "" : "s")
                <span class="badge bg-light text-muted border ms-2">⚡ p95 @Model.LatencyMs ms</span>
            </p>
        </div>

        <!-- Sort Control -->
        <form method="get" class="d-flex align-items-center gap-2">
            <input type="hidden" name="q" value="@Model.Query" />
            @if (Model.Catalog.SelectedCategoryId.HasValue)
            {
                <input type="hidden" name="categoryId" value="@Model.Catalog.SelectedCategoryId.Value" />
            }
            @if (!string.IsNullOrWhiteSpace(Model.Catalog.SelectedBrand))
            {
                <input type="hidden" name="brand" value="@Model.Catalog.SelectedBrand" />
            }
            @if (Model.Catalog.MinPrice.HasValue)
            {
                <input type="hidden" name="minPrice" value="@Model.Catalog.MinPrice.Value" />
            }
            @if (Model.Catalog.MaxPrice.HasValue)
            {
                <input type="hidden" name="maxPrice" value="@Model.Catalog.MaxPrice.Value" />
            }
            @if (Model.Catalog.MinRating.HasValue)
            {
                <input type="hidden" name="minRating" value="@Model.Catalog.MinRating.Value" />
            }

            <label for="sortSelect" class="small text-muted text-nowrap">Sort by:</label>
            <select name="sort" id="sortSelect" class="form-select form-select-sm rounded-pill border-secondary-subtle" onchange="this.form.submit()">
                <option value="relevance" selected="@(Model.Catalog.SelectedSort == "relevance")">Relevance</option>
                <option value="price_asc" selected="@(Model.Catalog.SelectedSort == "price_asc")">Price: Low to High</option>
                <option value="price_desc" selected="@(Model.Catalog.SelectedSort == "price_desc")">Price: High to Low</option>
                <option value="rating" selected="@(Model.Catalog.SelectedSort == "rating")">Highest Rated</option>
                <option value="newest" selected="@(Model.Catalog.SelectedSort == "newest")">Newest Arrivals</option>
            </select>
        </form>
    </div>

    <!-- Classical Herb Spotlight (if matched) -->
    @if (Model.MatchingHerbs != null && Model.MatchingHerbs.Any())
    {
        <div class="card bg-success-subtle border-0 rounded-4 p-3 mb-4 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2 text-success fw-bold small text-uppercase">
                <i class="bi bi-flower1"></i> Classical Ayurvedic Herb Spotlight
            </div>
            <div class="row g-2">
                @foreach (var herb in Model.MatchingHerbs)
                {
                    <div class="col-md-4">
                        <div class="p-3 bg-white rounded-3 border h-100 shadow-xs">
                            <h6 class="fw-bold text-success mb-1">@herb.Title</h6>
                            <p class="small text-muted mb-2">@herb.Subtitle</p>
                            <a href="@herb.Url" class="small fw-semibold text-success text-decoration-none">
                                Browse @herb.Title medicines &rarr;
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Verified Doctor Spotlight (if matched) -->
    @if (Model.MatchingDoctors != null && Model.MatchingDoctors.Any())
    {
        <div class="card bg-light border rounded-4 p-3 mb-4 shadow-sm">
            <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-bold small text-uppercase">
                <i class="bi bi-person-badge"></i> Certified AYUSH Vaidyas Available for Video Consult
            </div>
            <div class="row g-2">
                @foreach (var doc in Model.MatchingDoctors)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="p-2 bg-white rounded-3 border d-flex align-items-center gap-3">
                            <i class="bi bi-person-circle fs-2 text-success"></i>
                            <div class="flex-grow-1 overflow-hidden">
                                <div class="fw-bold small text-truncate">@doc.Title</div>
                                <div class="text-muted text-xs text-truncate">@doc.Subtitle</div>
                            </div>
                            <a href="@doc.Url" class="btn btn-sm btn-outline-success rounded-pill px-3">
                                Consult
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Active Filter Chips -->
    @if (Model.Catalog.ActiveChips.Any())
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
            <span class="small text-muted me-1">Active Filters:</span>
            @foreach (var chip in Model.Catalog.ActiveChips)
            {
                <a href="@chip.RemoveUrl" class="badge rounded-pill bg-white text-dark border p-2 px-3 text-decoration-none shadow-xs d-inline-flex align-items-center gap-2">
                    <span>@chip.Label</span>
                    <i class="bi bi-x-circle-fill text-muted"></i>
                </a>
            }
            <a asp-action="Index" asp-route-q="@Model.Query" class="small text-danger text-decoration-none ms-2">
                Clear all filters
            </a>
        </div>
    }

    <!-- Main Results Row -->
    <div class="row g-4">
        <!-- Sidebar Filters -->
        <div class="col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 sticky-top" style="top: 100px;">
                <h5 class="fw-bold text-success mb-3 pb-2 border-bottom">Refine Formulations</h5>

                <!-- Search within results -->
                <form method="get" class="mb-4">
                    <label class="form-label small fw-semibold text-muted">Search Query</label>
                    <div class="input-group input-group-sm">
                        <input type="text" name="q" value="@Model.Query" class="form-control rounded-start-pill" placeholder="Change search..." />
                        <button type="submit" class="btn btn-tga-gold rounded-end-pill px-3">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>
                </form>

                <!-- Categories Facet -->
                <div class="mb-4">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Category</h6>
                    <div class="d-flex flex-column gap-1 max-h-200 overflow-y-auto">
                        @foreach (var cat in Model.Catalog.Categories.Take(10))
                        {
                            <a href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&categoryId=@cat.Id" 
                               class="d-flex justify-content-between align-items-center py-1 px-2 rounded text-decoration-none small @(cat.IsSelected ? "bg-success-subtle text-success fw-bold" : "text-muted hover-bg-light")">
                                <span>@cat.Name</span>
                                <span class="badge bg-light text-muted border">@cat.ProductCount</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Brands Facet -->
                <div class="mb-4">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Brand / Pharmacy</h6>
                    <div class="d-flex flex-column gap-1 max-h-200 overflow-y-auto">
                        @foreach (var b in Model.Catalog.Brands.Take(8))
                        {
                            <a href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&brand=@Uri.EscapeDataString(b.Name)" 
                               class="d-flex justify-content-between align-items-center py-1 px-2 rounded text-decoration-none small @(b.IsSelected ? "bg-success-subtle text-success fw-bold" : "text-muted hover-bg-light")">
                                <span>@b.Name</span>
                                <span class="badge bg-light text-muted border">@b.ProductCount</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Price Range Filter Form -->
                <form method="get" class="mb-3">
                    <input type="hidden" name="q" value="@Model.Query" />
                    @if (Model.Catalog.SelectedCategoryId.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@Model.Catalog.SelectedCategoryId.Value" />
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Catalog.SelectedBrand))
                    {
                        <input type="hidden" name="brand" value="@Model.Catalog.SelectedBrand" />
                    }
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Price Range (₹)</h6>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <input type="number" name="minPrice" value="@Model.Catalog.MinPrice" class="form-control form-control-sm" placeholder="Min" />
                        <span class="text-muted">-</span>
                        <input type="number" name="maxPrice" value="@Model.Catalog.MaxPrice" class="form-control form-control-sm" placeholder="Max" />
                    </div>
                    <button type="submit" class="btn btn-outline-success btn-sm w-100 rounded-pill">Apply Price</button>
                </form>

                <!-- Rating Filter -->
                <div>
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Minimum Rating</h6>
                    <div class="d-flex flex-column gap-1">
                        <a href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&minRating=4.5" class="small text-decoration-none text-muted py-1 px-2 rounded hover-bg-light">
                            <span class="text-warning">★★★★★</span> 4.5 &amp; above
                        </a>
                        <a href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&minRating=4.0" class="small text-decoration-none text-muted py-1 px-2 rounded hover-bg-light">
                            <span class="text-warning">★★★★☆</span> 4.0 &amp; above
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Grid / Empty State -->
        <div class="col-lg-9">
            @if (Model.Catalog.TotalCount == 0)
            {
                <!-- Zero Results State -->
                <div class="card border-0 shadow-sm rounded-4 text-center p-5">
                    <div class="mb-3">
                        <span class="badge bg-warning-subtle text-warning p-3 rounded-circle fs-2">
                            <i class="bi bi-search"></i>
                        </span>
                    </div>
                    <h4 class="fw-bold text-dark mb-2">No Ayurvedic formulations matched your search</h4>
                    <p class="text-muted mb-4 mx-auto" style="max-width: 500px;">
                        We couldn't find any items matching "<strong>@Model.Query</strong>". Please try alternative terms, classical botanical names, or explore our popular health concerns.
                    </p>

                    <div class="card bg-light border-0 rounded-4 p-4 mb-4 mx-auto text-start" style="max-width: 600px;">
                        <h6 class="fw-bold text-success mb-2"><i class="bi bi-compass me-1"></i> Search Suggestions:</h6>
                        <ul class="small text-muted mb-0 ps-3">
                            <li class="mb-1">Check spelling or try Sanskrit/Hindi transliterations (e.g., <em>bukhar</em>, <em>neend</em>, <em>gas</em>).</li>
                            <li class="mb-1">Search for the primary herbal ingredient directly (e.g., <em>Ashwagandha</em>, <em>Triphala</em>, <em>Brahmi</em>, <em>Kumkumadi</em>).</li>
                            <li>Explore remedies by concern: <a asp-controller="Shop" asp-action="Index" asp-route-concern="Digestion" class="text-success fw-semibold">Digestion</a>, <a asp-controller="Shop" asp-action="Index" asp-route-concern="Stress" class="text-success fw-semibold">Stress &amp; Sleep</a>, <a asp-controller="Shop" asp-action="Index" asp-route-concern="Immunity" class="text-success fw-semibold">Immunity</a>.</li>
                        </ul>
                    </div>

                    <div>
                        <div class="small fw-bold text-muted text-uppercase mb-2">Popular Ayurveda Searches:</div>
                        <div class="d-flex flex-wrap justify-content-center gap-2">
                            @foreach (var trend in Model.TrendingSearches)
                            {
                                <a asp-action="Index" asp-route-q="@trend" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                    <i class="bi bi-fire text-warning me-1"></i> @trend
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Products Grid -->
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 mb-4">
                    @foreach (var product in Model.Catalog.Products)
                    {
                        <div class="col">
                            <div class="card h-100 border product-card shadow-xs rounded-4 overflow-hidden position-relative">
                                @if (!string.IsNullOrEmpty(product.Badge))
                                {
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-success text-white shadow-xs">
                                        @product.Badge
                                    </span>
                                }

                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none">
                                    <div class="p-3 text-center bg-light" style="height: 180px;">
                                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/products/chyawanprash.svg" : product.ImageUrl)" 
                                             alt="@product.Title" 
                                             class="img-fluid h-100 object-fit-contain" />
                                    </div>
                                </a>

                                <div class="card-body p-3 d-flex flex-column">
                                    <div class="text-muted text-xs text-uppercase fw-semibold mb-1">
                                        @product.Brand • @product.CategoryName
                                    </div>
                                    <h6 class="card-title fw-bold mb-1 text-truncate-2" style="font-size: 0.95rem;">
                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none">
                                            @product.Title
                                        </a>
                                    </h6>

                                    <div class="d-flex align-items-center gap-1 mb-2">
                                        <span class="badge bg-warning text-dark text-xs"><i class="bi bi-star-fill"></i> @product.AverageRating.ToString("F1")</span>
                                        @if (!string.IsNullOrEmpty(product.TraditionallyUsedFor))
                                        {
                                            <span class="text-muted text-xs text-truncate">@product.TraditionallyUsedFor</span>
                                        }
                                    </div>

                                    <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="fw-bold text-success fs-6">₹@product.Price.ToString("N0")</span>
                                            @if (product.Mrp > product.Price)
                                            {
                                                <span class="text-muted text-decoration-line-through text-xs ms-1">₹@product.Mrp.ToString("N0")</span>
                                                <span class="text-danger text-xs fw-semibold ms-1">(@product.DiscountPercent% off)</span>
                                            }
                                        </div>

                                        <button type="button" 
                                                class="btn btn-tga-gold btn-sm rounded-pill px-3 btn-add-to-cart-ajax" 
                                                data-product-id="@product.Id"
                                                title="Add to Basket">
                                            <i class="bi bi-bag-plus"></i> Add
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Pagination -->
                @if (Model.Catalog.TotalPages > 1)
                {
                    <nav aria-label="Search navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            @if (Model.Catalog.PageIndex > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill me-1" href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Catalog.PageIndex - 1)">Previous</a>
                                </li>
                            }

                            @for (var p = 1; p <= Model.Catalog.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Catalog.PageIndex ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1" href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@p">@p</a>
                                </li>
                            }

                            @if (Model.Catalog.PageIndex < Model.Catalog.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill ms-1" href="/search?q=@Uri.EscapeDataString(Model.Query ?? "")&page=@(Model.Catalog.PageIndex + 1)">Next</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
