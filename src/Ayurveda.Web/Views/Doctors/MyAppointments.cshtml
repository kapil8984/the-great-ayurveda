@model List<Ayurveda.Application.ViewModels.AppointmentDetailsViewModel>
@{
    ViewData["Title"] = "My Ayurvedic Consultations";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1 text-dark font-serif">My Consultations &amp; Tele-Health Records</h1>
            <p class="text-muted small mb-0">Track upcoming video appointments, join secure consultation rooms, view digital prescriptions, and leave reviews.</p>
        </div>
        <a asp-action="Index" class="btn btn-tga-gold btn-sm rounded-pill px-3 fw-bold">
            <i class="bi bi-camera-video me-1"></i> Book New Consultation
        </a>
    </div>

    <!-- Medical Emergency Banner -->
    <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex align-items-center gap-3 p-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-4 text-warning"></i>
        <div class="small">
            <strong>Emergency Advisory:</strong> If you are experiencing sudden acute symptoms, chest discomfort, or severe shortness of breath, please immediately call emergency services (<strong>112 / 102 / 108</strong>) or visit an emergency room.
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var appt in Model)
            {
                <div class="card p-4 shadow-sm border-0 rounded-4 bg-white">
                    <div class="row align-items-center g-3">
                        <div class="col-md-3">
                            <h5 class="fw-bold text-dark mb-1 font-serif">@appt.FormattedDoctorName</h5>
                            <span class="badge bg-success-subtle text-success border border-success-subtle text-xs">@appt.SpecializationName</span>
                            <div class="small text-muted mt-2">
                                <i class="bi bi-broadcast text-secondary me-1"></i> @appt.ConsultationType Mode
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="small text-muted">Scheduled Slot (IST):</div>
                            <div class="fw-bold text-dark">@appt.StartUtc.AddHours(5.5).ToString("dd MMM yyyy")</div>
                            <div class="text-success small fw-semibold">@appt.TimeSlot</div>
                        </div>

                        <div class="col-md-2">
                            <div class="small text-muted mb-1">Status:</div>
                            <span class="badge @(appt.Status == "Confirmed" ? "bg-success" : appt.Status == "Completed" ? "bg-primary" : appt.Status == "Cancelled" ? "bg-danger" : "bg-warning text-dark") px-2 py-1">
                                @appt.Status
                            </span>
                            @if (!string.IsNullOrEmpty(appt.HealthConcern))
                            {
                                <div class="text-xs text-muted text-truncate mt-1" title="@appt.HealthConcern">@appt.HealthConcern</div>
                            }
                        </div>

                        <div class="col-md-4 text-md-end d-flex flex-wrap gap-2 justify-content-md-end">
                            @if (appt.Status == "Confirmed")
                            {
                                <a asp-action="Room" asp-route-id="@appt.Id" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs fw-semibold">
                                    <i class="bi bi-camera-video me-1"></i> Join Room
                                </a>

                                @if (appt.CanCancelOrReschedule)
                                {
                                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-2 text-xs" data-bs-toggle="modal" data-bs-target="#rescheduleModal_@appt.Id">
                                        Reschedule
                                    </button>
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-2 text-xs" data-bs-toggle="modal" data-bs-target="#cancelModal_@appt.Id">
                                        Cancel
                                    </button>
                                }
                            }
                            else if (appt.Status == "Completed")
                            {
                                @if (appt.HasPrescription)
                                {
                                    <a asp-action="Prescription" asp-route-id="@appt.Id" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                        <i class="bi bi-file-earmark-medical me-1"></i> View Prescription
                                    </a>
                                }

                                @if (appt.HasReviewed)
                                {
                                    <span class="badge bg-light text-dark border p-2 text-xs">
                                        <span class="text-warning">★ @appt.ReviewRating</span> Reviewed
                                    </span>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-outline-warning text-dark btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#reviewModal_@appt.Id">
                                        <i class="bi bi-star me-1"></i> Leave Review
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(appt.PrescriptionNotes))
                    {
                        <div class="mt-3 pt-3 border-top bg-light p-3 rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <h6 class="fw-bold text-success mb-0 small"><i class="bi bi-file-earmark-medical me-1"></i> Vaidya Clinical Notes:</h6>
                                <a asp-action="Prescription" asp-route-id="@appt.Id" class="small text-success text-decoration-none fw-semibold">Full Rx Slip &rarr;</a>
                            </div>
                            <p class="small text-dark mb-0">@appt.PrescriptionNotes</p>
                        </div>
                    }
                </div>

                <!-- Cancel Modal -->
                @if (appt.CanCancelOrReschedule)
                {
                    <div class="modal fade" id="cancelModal_@appt.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold">Cancel Consultation</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="CancelAppointment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@appt.Id" />
                                    <div class="modal-body py-3">
                                        <p class="small text-muted mb-3">
                                            You are cancelling your appointment with @appt.FormattedDoctorName on @appt.StartUtc.AddHours(5.5).ToString("dd MMM yyyy") at @appt.TimeSlot.
                                        </p>
                                        <label class="form-label small fw-semibold">Reason for Cancellation</label>
                                        <select name="reason" class="form-select form-select-sm mb-3">
                                            <option>Schedule conflict</option>
                                            <option>Symptoms improved</option>
                                            <option>Wish to change doctor</option>
                                            <option>Other</option>
                                        </select>
                                        <div class="alert alert-info py-2 px-3 small border-0 mb-0">
                                            <i class="bi bi-info-circle me-1"></i> Refund of ₹@appt.ConsultationFee.ToString("N0") will be credited back within 2-4 business days under our 2-hour policy.
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Keep Appointment</button>
                                        <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Cancellation</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Reschedule Modal -->
                    <div class="modal fade" id="rescheduleModal_@appt.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold">Reschedule Consultation</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="RescheduleAppointment" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@appt.Id" />
                                    <div class="modal-body py-3">
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Select New Date</label>
                                            <input type="date" name="newDate" class="form-control rounded-pill" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(2).ToString("yyyy-MM-dd")" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Select New Slot (IST)</label>
                                            <select name="newSlot" class="form-select rounded-pill" required>
                                                <option value="10:00 AM">10:00 AM (Morning)</option>
                                                <option value="11:30 AM">11:30 AM (Morning)</option>
                                                <option value="02:30 PM">02:30 PM (Afternoon)</option>
                                                <option value="04:00 PM">04:00 PM (Evening)</option>
                                                <option value="06:00 PM">06:00 PM (Evening)</option>
                                            </select>
                                        </div>
                                        <div class="text-xs text-muted">
                                            Free reschedule under the 2-hour advance policy.
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Close</button>
                                        <button type="submit" class="btn btn-success rounded-pill px-4">Confirm Reschedule</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                <!-- Review Submission Modal (Unlocked strictly after completion) -->
                @if (appt.Status == "Completed" && !appt.HasReviewed)
                {
                    <div class="modal fade" id="reviewModal_@appt.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold font-serif">Rate Your Consultation</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <form asp-action="SubmitReview" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="AppointmentId" value="@appt.Id" />
                                    <input type="hidden" name="DoctorId" value="@appt.DoctorId" />
                                    <div class="modal-body py-3">
                                        <p class="small text-muted mb-3">
                                            Share your consultation experience with @appt.FormattedDoctorName. Your review helps other seekers find the right Vaidya.
                                        </p>
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Consultation Rating *</label>
                                            <select name="Rating" class="form-select rounded-pill" required>
                                                <option value="5">★★★★★ — Exceptional (5 stars)</option>
                                                <option value="4">★★★★☆ — Very Good (4 stars)</option>
                                                <option value="3">★★★☆☆ — Satisfactory (3 stars)</option>
                                                <option value="2">★★☆☆☆ — Needs Improvement (2 stars)</option>
                                                <option value="1">★☆☆☆☆ — Unsatisfactory (1 star)</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Your Clinical Experience &amp; Feedback *</label>
                                            <textarea name="ReviewText" class="form-control rounded-3" rows="3" required placeholder="How was the pulse/tongue observation? Was the dietary pathya advice clear and helpful?"></textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-tga-gold rounded-pill px-4 fw-bold">Submit Review</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
            <i class="bi bi-calendar-x text-muted display-4 mb-3"></i>
            <h4 class="fw-bold font-serif">No consultations scheduled yet</h4>
            <p class="text-muted small mx-auto mb-4" style="max-width: 480px;">
                Looking for holistic wellness and root-cause healing? Connect with experienced BAMS &amp; MD Ayurvedic specialists online today.
            </p>
            <div>
                <a asp-action="Index" class="btn btn-tga-gold rounded-pill px-4 fw-bold">
                    Browse Vaidyas
                </a>
            </div>
        </div>
    }
</div>
