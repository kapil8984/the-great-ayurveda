@model List<Ayurveda.Application.ViewModels.AppointmentDetailsViewModel>
@{
    ViewData["Title"] = "My Consultations";
}

<div class="container py-4">
    <h1 class="h3 fw-bold mb-4" style="font-family: Georgia, serif;">My Doctor Consultations</h1>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var appt in Model)
            {
                <div class="card p-4 shadow-sm border-0 rounded-4">
                    <div class="row align-items-center g-3">
                        <div class="col-md-3">
                            <h5 class="fw-bold text-dark mb-1">Dr. @appt.DoctorName</h5>
                            <span class="badge bg-success-subtle text-success">@appt.SpecializationName</span>
                            <div class="small text-muted mt-2">Consultation Mode: @appt.ConsultationType</div>
                        </div>

                        <div class="col-md-3">
                            <div class="small text-muted">Scheduled Slot:</div>
                            <div class="fw-bold">@appt.StartUtc.ToString("dd MMM yyyy")</div>
                            <div class="text-success small fw-semibold">@appt.TimeSlot</div>
                        </div>

                        <div class="col-md-3">
                            <div class="small text-muted">Status:</div>
                            <span class="badge @(appt.Status == "Confirmed" ? "bg-success" : "bg-warning text-dark")">@appt.Status</span>
                            @if (!string.IsNullOrEmpty(appt.HealthConcern))
                            {
                                <div class="small text-muted text-truncate mt-1" title="@appt.HealthConcern">Concern: @appt.HealthConcern</div>
                            }
                        </div>

                        <div class="col-md-3 text-md-end">
                            @if (!string.IsNullOrEmpty(appt.MeetingRoomUrl))
                            {
                                <a href="@appt.MeetingRoomUrl" target="_blank" class="btn btn-tga-gold btn-sm rounded-pill px-3 shadow-sm">
                                    <i class="bi bi-camera-video me-1"></i> Join Consultation Room
                                </a>
                            }
                            else
                            {
                                <button class="btn btn-light btn-sm text-muted rounded-pill px-3" disabled>
                                    Room Opens at Slot Time
                                </button>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(appt.PrescriptionNotes))
                    {
                        <div class="mt-3 pt-3 border-top bg-light p-3 rounded-3">
                            <h6 class="fw-bold text-success mb-1"><i class="bi bi-file-earmark-medical me-1"></i> Physician's Holistic Notes & Advice:</h6>
                            <p class="small text-dark mb-0">@appt.PrescriptionNotes</p>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-calendar-x text-muted display-4 mb-3"></i>
            <h4 class="fw-bold">No consultations scheduled</h4>
            <p class="text-muted">Need holistic health guidance? Connect with verified Ayurvedic physicians today.</p>
            <a asp-action="Index" class="btn btn-tga-primary px-4 rounded-pill">
                Consult a Doctor
            </a>
        </div>
    }
</div>
