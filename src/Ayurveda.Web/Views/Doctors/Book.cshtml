@model Ayurveda.Application.ViewModels.BookAppointmentViewModel
@{
    ViewData["Title"] = $"Book Consultation with {Model.FormattedDoctorName}";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-success text-decoration-none">Vaidyas</a></li>
            <li class="breadcrumb-item"><a asp-action="Profile" asp-route-id="@Model.DoctorId" class="text-success text-decoration-none">@Model.FormattedDoctorName</a></li>
            <li class="breadcrumb-item active" aria-current="page">Book Consultation</li>
        </ol>
    </nav>

    <!-- Medical Emergency Banner -->
    <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex align-items-center gap-3 p-3 mb-4">
        <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
        <div class="small">
            <strong>Emergency Advisory:</strong> If you are experiencing acute medical emergencies such as severe chest pain, acute respiratory distress, or severe trauma, please dial <strong>112 / 102 / 108</strong> immediately. Online consultations are for chronic and non-urgent care only.
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-4 p-md-5 shadow-sm border-0 rounded-4 bg-white position-relative">
                <!-- Demo Badge -->
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 border-bottom pb-3 gap-2">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-success-subtle text-success border border-success-subtle text-xs px-2 py-1">Encrypted Tele-Consultation</span>
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle text-xs px-2 py-1">
                                <i class="bi bi-shield-check me-1"></i> Demo mode - no real payment
                            </span>
                        </div>
                        <h2 class="h4 fw-bold mb-0 text-dark font-serif">Book Ayurvedic Consultation</h2>
                        <div class="text-muted small">Consulting with <strong>@Model.FormattedDoctorName</strong> • @Model.SpecializationName</div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Consultation Fee</div>
                        <div class="fs-4 fw-bold text-success">₹@Model.ConsultationFee.ToString("N0")</div>
                    </div>
                </div>

                <form asp-action="BookPost" method="post" enctype="multipart/form-data" id="bookConsultationForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DoctorId" />
                    <input type="hidden" asp-for="DoctorName" />
                    <input type="hidden" asp-for="ConsultationFee" />
                    <input type="hidden" asp-for="SpecializationName" />
                    <input type="hidden" asp-for="IsLiveRazorpay" id="docRzpIsLive" />
                    <input type="hidden" asp-for="RazorpayKeyId" id="docRzpKeyId" />
                    <input type="hidden" asp-for="RazorpayOrderId" id="docRzpOrderId" />
                    <input type="hidden" asp-for="RazorpayPaymentId" id="docRzpPaymentId" />
                    <input type="hidden" asp-for="RazorpaySignature" id="docRzpSignature" />

                    <!-- 1. Date & Time Slot -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark"><i class="bi bi-calendar3 text-success me-1"></i> 1. Select Consultation Date &amp; Time (IST)</label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Consultation Date *</label>
                                <input asp-for="SelectedDate" type="date" class="form-control rounded-pill" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="SelectedDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Select Time Slot (Indian Standard Time / IST) *</label>
                                <div class="d-flex flex-wrap gap-2 mb-2" id="slotChipsContainer">
                                    @foreach (var slot in (Model.AvailableSlots?.Any() == true ? Model.AvailableSlots : new List<string> { "10:00 AM", "11:30 AM", "02:30 PM", "04:00 PM", "06:00 PM" }))
                                    {
                                        <button type="button" class="btn btn-outline-success rounded-pill px-3 py-2 slot-chip-btn @(Model.SelectedTimeSlot == slot || (string.IsNullOrEmpty(Model.SelectedTimeSlot) && slot == "10:00 AM") ? "active" : "")" data-slot="@slot" style="min-height: 44px;">
                                            <i class="bi bi-clock me-1"></i> @slot
                                        </button>
                                    }
                                </div>
                                <select asp-for="SelectedTimeSlot" class="form-select rounded-pill d-none" id="selectedTimeSlotSelect" required>
                                    @if (Model.AvailableSlots != null && Model.AvailableSlots.Any())
                                    {
                                        @foreach (var slot in Model.AvailableSlots)
                                        {
                                            <option value="@slot" selected="@(Model.SelectedTimeSlot == slot)">@slot (IST)</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="10:00 AM">10:00 AM (IST)</option>
                                        <option value="11:30 AM">11:30 AM (IST)</option>
                                        <option value="02:30 PM">02:30 PM (IST)</option>
                                        <option value="04:00 PM">04:00 PM (IST)</option>
                                        <option value="06:00 PM">06:00 PM (IST)</option>
                                    }
                                </select>
                                <span asp-validation-for="SelectedTimeSlot" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Consultation Mode -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark"><i class="bi bi-broadcast text-success me-1"></i> 2. Choose Consultation Mode</label>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="card p-3 border rounded-3 h-100 cursor-pointer text-center">
                                    <input class="form-check-input mx-auto mb-2" type="radio" asp-for="ConsultationType" value="Video" checked />
                                    <div class="fw-bold small text-dark"><i class="bi bi-camera-video text-success me-1"></i> HD Video Call</div>
                                    <div class="text-xs text-muted">Direct visual tongue &amp; pulse exam</div>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="card p-3 border rounded-3 h-100 cursor-pointer text-center">
                                    <input class="form-check-input mx-auto mb-2" type="radio" asp-for="ConsultationType" value="Audio" />
                                    <div class="fw-bold small text-dark"><i class="bi bi-telephone text-primary me-1"></i> Private Audio</div>
                                    <div class="text-xs text-muted">Voice only conversation</div>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="card p-3 border rounded-3 h-100 cursor-pointer text-center">
                                    <input class="form-check-input mx-auto mb-2" type="radio" asp-for="ConsultationType" value="Chat" />
                                    <div class="fw-bold small text-dark"><i class="bi bi-chat-text text-warning me-1"></i> Clinical Chat</div>
                                    <div class="text-xs text-muted">Text notes &amp; advice</div>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Patient Details & Medical History -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-dark"><i class="bi bi-person text-success me-1"></i> 3. Patient Medical Information</label>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Patient Full Name *</label>
                                <input asp-for="PatientName" class="form-control rounded-pill" required placeholder="Full Name" />
                                <span asp-validation-for="PatientName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Contact Mobile *</label>
                                <input asp-for="PatientContact" class="form-control rounded-pill" required placeholder="+91 98765 43210" />
                                <span asp-validation-for="PatientContact" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Patient Age:</label>
                                <input asp-for="PatientAge" type="number" class="form-control rounded-pill" min="1" max="120" placeholder="e.g. 35" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small text-muted">Gender:</label>
                                <select asp-for="PatientGender" class="form-select rounded-pill">
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted">Primary Health Concern or Symptoms *</label>
                                <textarea asp-for="HealthConcern" class="form-control rounded-3" rows="3" required placeholder="Describe your digestion pattern, sleep quality, stress levels, skin concerns, or chronic discomfort..."></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted"><i class="bi bi-file-earmark-arrow-up me-1 text-success"></i> Optional Medical Lab Reports (PDF / Image):</label>
                                <input type="file" name="reportFile" class="form-control" accept=".pdf,image/*" />
                                <div class="text-xs text-muted mt-1">Upload recent blood tests, scan summaries, or doctor prescriptions if available.</div>
                            </div>
                        </div>
                    </div>

                    <!-- 4. Consultation Demo Payment Section -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold text-dark m-0"><i class="bi bi-credit-card-2-front text-success me-1"></i> 4. Consultation Fee Payment</label>
                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1 small fw-bold"><i class="bi bi-shield-check me-1"></i> Demo payment - no money is charged</span>
                        </div>

                        <!-- Sandbox Test Credentials Advisory -->
                        <div class="alert alert-info py-2 px-3 small rounded-3 mb-3 border-info-subtle">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-info-circle-fill text-primary"></i>
                                <strong>Test Mode Sandbox Credentials:</strong>
                            </div>
                            <div class="text-xs text-muted">
                                <strong>Card:</strong> <code class="user-select-all">4111 1111 1111 1111</code>, any future date (e.g. 12/28), any CVV (e.g. 123)<br />
                                <strong>UPI:</strong> <code class="user-select-all">success@razorpay</code> (or <code class="user-select-all">failure@razorpay</code> to test decline)
                            </div>
                        </div>

                        <!-- Payment Method Radios -->
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <label class="card p-3 border rounded-3 text-center cursor-pointer h-100 bg-light">
                                    <input class="form-check-input mx-auto mb-2" type="radio" name="demoConsultPaymentMethod" value="UPI" checked />
                                    <span class="fw-bold small text-dark"><i class="bi bi-qr-code text-success me-1"></i> UPI</span>
                                    <div class="text-xs text-muted">GPay, PhonePe, Paytm</div>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="card p-3 border rounded-3 text-center cursor-pointer h-100 bg-light">
                                    <input class="form-check-input mx-auto mb-2" type="radio" name="demoConsultPaymentMethod" value="Card" />
                                    <span class="fw-bold small text-dark"><i class="bi bi-credit-card text-primary me-1"></i> Card</span>
                                    <div class="text-xs text-muted">Visa, MasterCard</div>
                                </label>
                            </div>
                            <div class="col-md-4">
                                <label class="card p-3 border rounded-3 text-center cursor-pointer h-100 bg-light">
                                    <input class="form-check-input mx-auto mb-2" type="radio" name="demoConsultPaymentMethod" value="NetBanking" />
                                    <span class="fw-bold small text-dark"><i class="bi bi-bank text-warning me-1"></i> Net Banking</span>
                                    <div class="text-xs text-muted">HDFC, SBI, ICICI</div>
                                </label>
                            </div>
                        </div>

                        <!-- Simulate Payment Failure Toggle -->
                        <div class="p-3 border rounded-3 bg-danger-subtle border-danger-subtle mb-3">
                            <div class="form-check form-switch m-0">
                                <input class="form-check-input" type="checkbox" role="switch" asp-for="SimulateFailure" id="simulateConsultFailureToggle" />
                                <label class="form-check-label small fw-bold text-danger" for="simulateConsultFailureToggle">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i> Simulate Payment Failure
                                </label>
                                <div class="text-xs text-danger opacity-75 ps-4">
                                    Toggle ON to simulate a gateway decline or bank timeout.
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="button" id="btnInitiateConsultPayment" class="btn btn-tga-gold w-100 py-3 fs-5 rounded-pill shadow-sm fw-bold">
                        <i class="bi bi-lock-fill me-1"></i> Pay Fee &amp; Book Room (₹@Model.ConsultationFee.ToString("N0"))
                    </button>
                    <div class="text-center text-muted small mt-3">
                        <i class="bi bi-shield-check text-success me-1"></i> Free rescheduling or cancellation up to 2 hours before appointment slot.
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL: Realistic Payment Processing & Result Simulator for Doctor Fee
     ========================================================================= -->
<div class="modal fade" id="consultPaymentModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center bg-light">
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1 small">
                    <i class="bi bi-shield-check me-1"></i> Demo Payment Gateway
                </span>
                <span class="text-muted small">Consultation Fee: <strong>₹@Model.ConsultationFee.ToString("N0")</strong></span>
            </div>

            <div class="modal-body p-4 text-center">
                <!-- State 1: Processing Animation -->
                <div id="consultModalStateProcessing">
                    <div class="my-4">
                        <div class="spinner-border text-success" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 0.35em;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Processing Consultation Payment...</h5>
                    <p class="text-muted small mb-3" id="consultProcessingStatusText">Authorizing fee for @Model.FormattedDoctorName...</p>
                    <div class="progress rounded-pill mb-2" style="height: 6px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" id="consultProgressBar" style="width: 25%;"></div>
                    </div>
                    <div class="text-xs text-muted"><i class="bi bi-lock-fill text-success me-1"></i> 256-Bit SSL Encrypted Sandbox Channel</div>
                </div>

                <!-- State 2: Simulated Failure Screen -->
                <div id="consultModalStateFailure" class="d-none">
                    <div class="my-3 text-danger">
                        <i class="bi bi-x-circle-fill display-3"></i>
                    </div>
                    <h5 class="fw-bold text-danger mb-1">Payment Declined / Timed Out</h5>
                    <p class="text-muted small mb-3">
                        Simulation Result: Bank authorization declined for consultation fee.
                    </p>
                    <div class="alert alert-light border small text-start mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Error Code:</span>
                            <span class="font-monospace text-danger fw-bold">ERR_DEMO_CONSULT_DECLINED</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Gateway Status:</span>
                            <span class="text-danger">Failed to capture ₹@Model.ConsultationFee.ToString("N0")</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill flex-fill" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-danger rounded-pill flex-fill" id="btnRetryConsultPayment">
                            <i class="bi bi-arrow-repeat me-1"></i> Retry Payment
                        </button>
                    </div>
                </div>

                <!-- State 3: Payment Success Tick -->
                <div id="consultModalStateSuccess" class="d-none">
                    <div class="my-3 text-success">
                        <i class="bi bi-check-circle-fill display-3"></i>
                    </div>
                    <h5 class="fw-bold text-success mb-1">Fee Authorized Successfully!</h5>
                    <p class="text-muted small mb-3">Generating video room link with @Model.FormattedDoctorName...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsLiveRazorpay)
{
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
}

<script>
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".slot-chip-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
            document.querySelectorAll(".slot-chip-btn").forEach(function (b) { b.classList.remove("active"); });
            this.classList.add("active");
            var slot = this.getAttribute("data-slot");
            var sel = document.getElementById("selectedTimeSlotSelect");
            if (sel && slot) {
                sel.value = slot;
            }
        });
    });

    const btnPay = document.getElementById("btnInitiateConsultPayment");
    const failureToggle = document.getElementById("simulateConsultFailureToggle");
    const bookForm = document.getElementById("bookConsultationForm");

    const modalEl = document.getElementById("consultPaymentModal");
    const modal = new bootstrap.Modal(modalEl);

    const stateProcessing = document.getElementById("consultModalStateProcessing");
    const stateFailure = document.getElementById("consultModalStateFailure");
    const stateSuccess = document.getElementById("consultModalStateSuccess");
    const progressBar = document.getElementById("consultProgressBar");
    const statusText = document.getElementById("consultProcessingStatusText");
    const btnRetry = document.getElementById("btnRetryConsultPayment");

    const isLiveRazorpay = @(Model.IsLiveRazorpay ? "true" : "false");

    btnPay.addEventListener("click", function () {
        if (!bookForm.checkValidity()) {
            bookForm.reportValidity();
            return;
        }

        // Live Razorpay Checkout flow
        if (isLiveRazorpay && typeof Razorpay !== "undefined") {
            if (failureToggle && failureToggle.checked) {
                stateProcessing.classList.add("d-none");
                stateFailure.classList.remove("d-none");
                modal.show();
                return;
            }

            const rzpOptions = {
                key: "@Model.RazorpayKeyId",
                amount: Math.round(@Model.ConsultationFee * 100),
                currency: "INR",
                name: "The Great Ayurveda",
                description: "Ayurvedic Physician Consultation Fee",
                order_id: "@Model.RazorpayOrderId",
                handler: function (response) {
                    const elPid = document.getElementById("docRzpPaymentId");
                    const elOid = document.getElementById("docRzpOrderId");
                    const elSig = document.getElementById("docRzpSignature");
                    if (elPid) elPid.value = response.razorpay_payment_id || "";
                    if (elOid) elOid.value = response.razorpay_order_id || "";
                    if (elSig) elSig.value = response.razorpay_signature || "";
                    bookForm.submit();
                },
                modal: {
                    ondismiss: function () {
                        stateProcessing.classList.add("d-none");
                        stateFailure.classList.remove("d-none");
                        modal.show();
                    }
                },
                theme: {
                    color: "#2E7D32"
                }
            };

            const rzp = new Razorpay(rzpOptions);
            rzp.on('payment.failed', function () {
                stateProcessing.classList.add("d-none");
                stateFailure.classList.remove("d-none");
                modal.show();
            });
            rzp.open();
            return;
        }

        // Show Simulated Processing Modal
        stateProcessing.classList.remove("d-none");
        stateFailure.classList.add("d-none");
        stateSuccess.classList.add("d-none");
        progressBar.style.width = "25%";
        statusText.textContent = "Authorizing consultation fee for @Model.FormattedDoctorName...";
        modal.show();

        setTimeout(() => {
            progressBar.style.width = "70%";
            statusText.textContent = "Routing transaction through simulated gateway...";
        }, 700);

        setTimeout(() => {
            if (failureToggle && failureToggle.checked) {
                stateProcessing.classList.add("d-none");
                stateFailure.classList.remove("d-none");
            } else {
                progressBar.style.width = "100%";
                stateProcessing.classList.add("d-none");
                stateSuccess.classList.remove("d-none");
                setTimeout(() => {
                    bookForm.submit();
                }, 800);
            }
        }, 1500);
    });

    btnRetry.addEventListener("click", function () {
        if (failureToggle) failureToggle.checked = false;
        modal.hide();
    });
});
</script>
