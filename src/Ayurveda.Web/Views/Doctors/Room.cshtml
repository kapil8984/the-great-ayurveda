@model Ayurveda.Domain.Entities.Appointment
@{
    ViewData["Title"] = $"Live Consultation Room — Dr. {Model.Doctor.DoctorName}";
    bool isDoctor = ViewBag.IsDoctor == true;
    bool isPatient = ViewBag.IsPatient == true;
    string docName = Model.Doctor.DoctorName;
    string docImage = string.IsNullOrEmpty(Model.Doctor.ProfileImage) ? "/images/doctor-avatar.svg" : Model.Doctor.ProfileImage;
}

<div class="container-fluid px-3 py-3" style="max-width: 1440px;">
    <!-- Emergency Warning Banner -->
    <div class="alert alert-warning border-0 rounded-4 shadow-sm d-flex align-items-center justify-content-between p-2 px-3 mb-3">
        <div class="small d-flex align-items-center gap-2">
            <i class="bi bi-shield-check text-success fs-5"></i>
            <span><strong>Clinical Simulation Mode:</strong> Simulated secure WebRTC end-to-end encrypted consultation active. No external third-party login required.</span>
        </div>
        <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-25">
            <i class="bi bi-record-fill text-danger me-1"></i> Connected (Simulated)
        </span>
    </div>

    <!-- Room Topbar -->
    <div class="card bg-dark text-white border-0 rounded-4 p-3 mb-3 shadow">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <span class="badge bg-danger rounded-pill px-3 py-2 d-inline-flex align-items-center gap-1">
                    <span class="spinner-grow spinner-grow-sm text-light" style="width: 8px; height: 8px;"></span> LIVE CONSULTATION
                </span>
                <div>
                    <h5 class="fw-bold mb-0 font-serif">Dr. @docName &amp; @Model.PatientName</h5>
                    <div class="text-white-50 small">
                        Slot: @Model.TimeSlot (@Model.AppointmentDate.ToString("dd MMM yyyy")) • @Model.ConsultationType Mode • Room #@Model.Id
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <!-- Live Duration Timer -->
                <div class="bg-black bg-opacity-50 px-3 py-2 rounded-pill font-monospace small border border-secondary text-warning">
                    <i class="bi bi-stopwatch text-warning me-1"></i> <span id="callDurationTimer">00:00:00</span>
                </div>

                @if (isDoctor)
                {
                    <a asp-controller="DoctorPortal" asp-action="WritePrescription" asp-route-id="@Model.Id" class="btn btn-warning rounded-pill px-3 fw-bold btn-sm">
                        <i class="bi bi-file-earmark-medical me-1"></i> End Call &amp; Write Prescription
                    </a>
                }
                else
                {
                    <a asp-action="MyAppointments" class="btn btn-outline-light rounded-pill px-3 btn-sm" onclick="return confirm('Exit this consultation room?');">
                        <i class="bi bi-box-arrow-left me-1"></i> Exit Consultation
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Main Video Frame -->
        <div class="col-lg-8 col-xl-9">
            <div class="card border-0 shadow rounded-4 overflow-hidden bg-black position-relative call-room-video-card">
                <!-- Simulated Doctor Screen -->
                <div class="w-100 h-100 position-relative d-flex flex-column align-items-center justify-content-center text-center p-4" id="doctorVideoContainer" style="background: radial-gradient(circle at center, #1b3323 0%, #0d1a12 60%, #050a07 100%);">
                    
                    <!-- Top Video Bar Overlay -->
                    <div class="position-absolute top-0 start-0 end-0 p-3 d-flex justify-content-between align-items-center" style="background: linear-gradient(180deg, rgba(0,0,0,0.8) 0%, transparent 100%); z-index: 10;">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success rounded-pill px-2 py-1 small">
                                <i class="bi bi-circle-fill text-light me-1" style="font-size: 8px;"></i> Connected
                            </span>
                            <span class="text-white-50 small font-monospace">HD 1080p • 30fps • 24ms WebRTC</span>
                        </div>
                        <div class="badge bg-black bg-opacity-50 border border-secondary text-white-50 px-2 py-1 small">
                            <i class="bi bi-lock-fill text-warning me-1"></i> 256-bit Encrypted
                        </div>
                    </div>

                    <!-- Doctor Avatar / Stream Presentation -->
                    <div class="doctor-stream-box my-auto position-relative">
                        <div class="position-relative d-inline-block">
                            <!-- Animated Pulse Ring -->
                            <div class="position-absolute top-50 start-50 translate-middle rounded-circle bg-success bg-opacity-25 pulse-ring" style="width: 220px; height: 220px; z-index: 1;"></div>
                            
                            <img src="@docImage" alt="Dr. @docName" 
                                 class="rounded-circle shadow-lg border border-3 border-success position-relative"
                                 style="width: 170px; height: 170px; object-fit: cover; z-index: 2; background-color: #244631;"
                                 data-fallback="/images/doctor-avatar.svg" />

                            <!-- Active Speaking Audio Wave Indicator -->
                            <div class="position-absolute bottom-0 start-50 translate-middle-x bg-black bg-opacity-75 border border-success rounded-pill px-3 py-1 d-flex align-items-center gap-1" style="z-index: 3;">
                                <span class="audio-bar"></span>
                                <span class="audio-bar" style="animation-delay: 0.2s;"></span>
                                <span class="audio-bar" style="animation-delay: 0.4s;"></span>
                                <span class="audio-bar" style="animation-delay: 0.1s;"></span>
                                <span class="text-success text-xs ms-1 fw-bold">Active Audio</span>
                            </div>
                        </div>

                        <h4 class="text-white font-serif fw-bold mt-4 mb-1">Dr. @docName</h4>
                        <div class="text-warning small mb-2">Ayurvedic Physician &amp; Wellness Specialist</div>
                        <div class="badge bg-success bg-opacity-20 text-success border border-success px-3 py-1 rounded-pill">
                            <i class="bi bi-camera-video me-1"></i> Live Stream Active
                        </div>
                    </div>

                    <!-- Patient Picture-In-Picture Overlay (Bottom Right) -->
                    <div class="position-absolute bottom-0 end-0 m-3 rounded-4 overflow-hidden shadow-lg border border-2 border-secondary bg-dark call-room-pip" 
                         style="width: 180px; height: 130px; z-index: 20; background: #121815;">
                        <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center p-2 text-center position-relative" id="patientPipBox">
                            <div class="rounded-circle bg-secondary bg-opacity-25 p-2 mb-1" id="patientPipAvatar">
                                <i class="bi bi-person-fill text-light fs-3"></i>
                            </div>
                            <span class="text-light small text-truncate w-100 px-1 fw-bold" style="font-size: 0.75rem;">@Model.PatientName</span>
                            <span class="badge bg-black bg-opacity-50 text-white-50 mt-1" style="font-size: 0.65rem;" id="patientStatusBadge">Camera Ready</span>
                        </div>
                    </div>

                    <!-- Bottom Floating Call Controls Bar -->
                    <div class="position-absolute bottom-0 start-50 translate-middle-x mb-3 d-flex align-items-center gap-2 p-2 rounded-pill bg-black bg-opacity-75 border border-secondary shadow-lg call-room-controls" style="z-index: 30;">
                        <!-- Mute Audio -->
                        <button type="button" class="btn btn-outline-light rounded-circle p-2" id="toggleMicBtn" style="width: 44px; height: 44px; min-width: 44px; min-height: 44px;" title="Mute/Unmute Mic">
                            <i class="bi bi-mic-fill" id="micIcon"></i>
                        </button>

                        <!-- Toggle Camera -->
                        <button type="button" class="btn btn-outline-light rounded-circle p-2" id="toggleCamBtn" style="width: 44px; height: 44px;" title="Turn Video On/Off">
                            <i class="bi bi-camera-video-fill" id="camIcon"></i>
                        </button>

                        <!-- Toggle Screen Share -->
                        <button type="button" class="btn btn-outline-light rounded-circle p-2" id="toggleShareBtn" style="width: 44px; height: 44px;" title="Simulate Screen Share">
                            <i class="bi bi-display" id="shareIcon"></i>
                        </button>

                        <!-- Toggle Chat -->
                        <button type="button" class="btn btn-outline-light rounded-circle p-2" id="toggleChatBtn" style="width: 44px; height: 44px;" title="Toggle In-Call Chat">
                            <i class="bi bi-chat-dots-fill"></i>
                        </button>

                        <!-- End Call (Red) -->
                        @if (isDoctor)
                        {
                            <a asp-controller="DoctorPortal" asp-action="WritePrescription" asp-route-id="@Model.Id" class="btn btn-danger rounded-circle p-2 ms-2" style="width: 44px; height: 44px;" title="End Consultation">
                                <i class="bi bi-telephone-x-fill"></i>
                            </a>
                        }
                        else
                        {
                            <a asp-action="MyAppointments" class="btn btn-danger rounded-circle p-2 ms-2" style="width: 44px; height: 44px;" title="Leave Consultation" onclick="return confirm('Leave this consultation room?');">
                                <i class="bi bi-telephone-x-fill"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Consultation Dossier & Live Interactive Chat Drawer -->
        <div class="col-lg-4 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 d-flex flex-column" style="max-height: 620px;">
                <!-- Nav Tabs for Dossier and Chat -->
                <ul class="nav nav-pills nav-fill mb-3 bg-light p-1 rounded-pill" id="roomTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill py-1 small fw-bold" id="chat-tab" data-bs-toggle="pill" data-bs-target="#chat-pane" type="button" role="tab">
                            <i class="bi bi-chat-dots me-1"></i> Live Chat
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill py-1 small fw-bold" id="dossier-tab" data-bs-toggle="pill" data-bs-target="#dossier-pane" type="button" role="tab">
                            <i class="bi bi-clipboard2-pulse me-1"></i> Patient Dossier
                        </button>
                    </li>
                </ul>

                <div class="tab-content flex-grow-1 d-flex flex-column overflow-hidden" id="roomTabContent">
                    <!-- Interactive Chat Pane -->
                    <div class="tab-pane fade show active flex-grow-1 d-flex flex-column" id="chat-pane" role="tabpanel">
                        <div class="chat-messages flex-grow-1 overflow-auto p-2 border rounded-3 bg-light mb-2" id="chatMessages" style="max-height: 420px; min-height: 360px;">
                            <div class="text-center my-2">
                                <span class="badge bg-secondary bg-opacity-25 text-secondary" style="font-size: 0.7rem;">
                                    Consultation Channel Initialized • Encrypted
                                </span>
                            </div>

                            <!-- Doctor greeting message -->
                            <div class="d-flex flex-column align-items-start mb-2">
                                <span class="text-success small fw-bold mb-1">Dr. @docName</span>
                                <div class="bg-white border rounded-3 p-2 small shadow-sm text-dark" style="max-width: 85%;">
                                    Namaste @Model.PatientName! Welcome to your consultation. I have reviewed your dossier. Please share more details regarding your symptoms and diet.
                                </div>
                                <span class="text-muted text-xs mt-1" style="font-size: 0.65rem;">Just now</span>
                            </div>
                        </div>

                        <!-- Chat input form -->
                        <div class="input-group">
                            <input type="text" id="chatInput" class="form-control form-control-sm rounded-start-pill" placeholder="Type a message to Dr. @docName..." autocomplete="off" />
                            <button class="btn btn-success btn-sm rounded-end-pill px-3" type="button" id="sendChatBtn">
                                <i class="bi bi-send-fill"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Patient Clinical Dossier Pane -->
                    <div class="tab-pane fade overflow-auto" id="dossier-pane" role="tabpanel" style="max-height: 520px;">
                        <h6 class="fw-bold text-success mb-2 font-serif border-bottom pb-2">
                            <i class="bi bi-clipboard2-pulse me-1"></i> Patient Details
                        </h6>

                        <div class="small text-muted mb-3">
                            <div class="mb-1"><strong>Patient:</strong> @Model.PatientName (@(Model.PatientAge?.ToString() ?? "N/A") yrs, @(Model.PatientGender ?? "N/A"))</div>
                            <div class="mb-1"><strong>Contact:</strong> @Model.PatientContact</div>
                            <div class="mb-1"><strong>Doctor:</strong> Dr. @docName</div>
                        </div>

                        <div class="mb-3">
                            <span class="small fw-bold text-dark d-block mb-1">Chief Health Concern:</span>
                            <div class="p-2 bg-light rounded-3 small text-secondary">
                                @(string.IsNullOrEmpty(Model.HealthConcern) ? "General consultation" : Model.HealthConcern)
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ReportUrl))
                        {
                            <div class="mb-3">
                                <span class="small fw-bold text-dark d-block mb-1">Uploaded Medical Lab Report:</span>
                                <a href="@Model.ReportUrl" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill w-100 text-truncate">
                                    <i class="bi bi-file-earmark-pdf me-1 text-danger"></i> View Attached Report
                                </a>
                            </div>
                        }

                        @if (isDoctor)
                        {
                            <div class="mt-auto pt-3 border-top">
                                <a asp-controller="DoctorPortal" asp-action="WritePrescription" asp-route-id="@Model.Id" class="btn btn-success w-100 rounded-pill py-2 fw-semibold">
                                    <i class="bi bi-pencil-square me-1"></i> Digital Prescription Writer
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .audio-bar {
        display: inline-block;
        width: 3px;
        height: 12px;
        background-color: #28a745;
        border-radius: 2px;
        animation: audioWave 1s ease-in-out infinite alternate;
    }
    @@keyframes audioWave {
        0% { height: 4px; }
        100% { height: 16px; }
    }
    .pulse-ring {
        animation: pulseRing 2s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
    }
    @@keyframes pulseRing {
        0% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.6; }
        100% { transform: translate(-50%, -50%) scale(1.25); opacity: 0; }
    }
</style>

@section Scripts {
<script>
    // 1. Live Call Duration Counter
    let seconds = 0;
    const timerEl = document.getElementById("callDurationTimer");
    if (timerEl) {
        setInterval(() => {
            seconds++;
            const h = String(Math.floor(seconds / 3600)).padStart(2, '0');
            const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, '0');
            const s = String(seconds % 60).padStart(2, '0');
            timerEl.innerText = `${h}:${m}:${s}`;
        }, 1000);
    }

    // 2. Mic and Camera Toggles
    let micMuted = false;
    let camMuted = false;
    const micBtn = document.getElementById("toggleMicBtn");
    const micIcon = document.getElementById("micIcon");
    const camBtn = document.getElementById("toggleCamBtn");
    const camIcon = document.getElementById("camIcon");

    if (micBtn && micIcon) {
        micBtn.addEventListener("click", () => {
            micMuted = !micMuted;
            if (micMuted) {
                micBtn.classList.replace("btn-outline-light", "btn-danger");
                micIcon.className = "bi bi-mic-mute-fill";
            } else {
                micBtn.classList.replace("btn-danger", "btn-outline-light");
                micIcon.className = "bi bi-mic-fill";
            }
        });
    }

    if (camBtn && camIcon) {
        camBtn.addEventListener("click", () => {
            camMuted = !camMuted;
            const badge = document.getElementById("patientStatusBadge");
            if (camMuted) {
                camBtn.classList.replace("btn-outline-light", "btn-danger");
                camIcon.className = "bi bi-camera-video-off-fill";
                if (badge) badge.innerText = "Camera Off";
            } else {
                camBtn.classList.replace("btn-danger", "btn-outline-light");
                camIcon.className = "bi bi-camera-video-fill";
                if (badge) badge.innerText = "Camera Ready";
            }
        });
    }

    // 3. Simulated Interactive Chat
    const chatInput = document.getElementById("chatInput");
    const sendBtn = document.getElementById("sendChatBtn");
    const chatMessages = document.getElementById("chatMessages");

    const doctorResponses = [
        "I understand completely. We should address the underlying Agni and pacify your Vata dosha.",
        "That is helpful context. I will include a rejuvenating Rasayana in your prescription to support your vitality.",
        "Make sure to drink lukewarm water throughout the day and avoid heavy meals after sunset.",
        "Your tongue diagnosis and symptoms suggest mild Pitta aggravation. I'm tailoring your wellness plan accordingly."
    ];
    let responseIdx = 0;

    function sendMessage() {
        if (!chatInput) return;
        const text = chatInput.value.trim();
        if (!text) return;

        // Append Patient Message
        const patientBubble = document.createElement("div");
        patientBubble.className = "d-flex flex-column align-items-end mb-2";
        patientBubble.innerHTML = `
            <span class="text-primary small fw-bold mb-1">You (@Model.PatientName)</span>
            <div class="bg-success text-white rounded-3 p-2 small shadow-sm" style="max-width: 85%;">
                ${escapeHtml(text)}
            </div>
            <span class="text-muted text-xs mt-1" style="font-size: 0.65rem;">Just now</span>
        `;
        chatMessages.appendChild(patientBubble);
        chatInput.value = "";
        chatMessages.scrollTop = chatMessages.scrollHeight;

        // Simulate Doctor Response after 1.2 seconds
        setTimeout(() => {
            const reply = doctorResponses[responseIdx % doctorResponses.length];
            responseIdx++;
            const docBubble = document.createElement("div");
            docBubble.className = "d-flex flex-column align-items-start mb-2";
            docBubble.innerHTML = `
                <span class="text-success small fw-bold mb-1">Dr. @docName</span>
                <div class="bg-white border rounded-3 p-2 small shadow-sm text-dark" style="max-width: 85%;">
                    ${escapeHtml(reply)}
                </div>
                <span class="text-muted text-xs mt-1" style="font-size: 0.65rem;">Just now</span>
            `;
            chatMessages.appendChild(docBubble);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }, 1200);
    }

    if (sendBtn) sendBtn.addEventListener("click", sendMessage);
    if (chatInput) {
        chatInput.addEventListener("keydown", (e) => {
            if (e.key === "Enter") {
                e.preventDefault();
                sendMessage();
            }
        });
    }

    function escapeHtml(str) {
        const div = document.createElement('div');
        div.appendChild(document.createTextNode(str));
        return div.innerHTML;
    }
</script>
}
