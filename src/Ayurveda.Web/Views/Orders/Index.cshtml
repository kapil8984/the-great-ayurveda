@model List<Ayurveda.Application.ViewModels.OrderSummaryViewModel>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <h1 class="h3 fw-bold mb-4" style="font-family: Georgia, serif;">My Orders History</h1>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var order in Model)
            {
                <div class="card shadow-sm border-0 rounded-3 p-3">
                    <div class="row align-items-center g-3">
                        <div class="col-md-3">
                            <div class="small text-muted">Order Placed:</div>
                            <div class="fw-bold">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                            <div class="small text-muted">#@order.OrderNumber</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Total Amount:</div>
                            <div class="fw-bold text-success">₹@order.TotalAmount.ToString("N2")</div>
                            <div class="small text-muted">@order.TotalItems items</div>
                        </div>
                        <div class="col-md-3">
                            <div class="small text-muted">Current Status:</div>
                            <span class="badge bg-success-subtle text-success fs-6">@order.Status</span>
                        </div>
                        <div class="col-md-3 text-md-end">
                            <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-outline-success btn-sm rounded-pill px-3">
                                View Details & Track
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <i class="bi bi-box-seam text-muted display-4 mb-3"></i>
            <h4 class="fw-bold">No orders found</h4>
            <p class="text-muted">You haven't placed any orders yet.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-tga-primary px-4 rounded-pill">
                Explore Medicines
            </a>
        </div>
    }
</div>
