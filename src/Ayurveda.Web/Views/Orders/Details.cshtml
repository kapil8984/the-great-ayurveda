@model Ayurveda.Application.ViewModels.OrderDetailViewModel
@{
    ViewData["Title"] = $"Order #{Model.OrderNumber}";
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-success text-decoration-none">Orders</a></li>
            <li class="breadcrumb-item active" aria-current="page">#@Model.OrderNumber</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1" style="font-family: Georgia, serif;">Order #@Model.OrderNumber</h1>
            <div class="text-muted small">Placed on @Model.OrderDate.ToString("dd MMMM yyyy, hh:mm tt")</div>
        </div>
        <div>
            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">Status: @Model.Status</span>
        </div>
    </div>

    <!-- Order Timeline / Tracking -->
    <div class="card p-4 shadow-sm border-0 rounded-4 mb-4">
        <h5 class="fw-bold mb-4">Order Progress</h5>
        <div class="row text-center g-3">
            @{
                var steps = new[] { "Placed", "Packed", "Shipped", "OutForDelivery", "Delivered" };
                var currentIdx = Array.IndexOf(steps, Model.Status);
                if (currentIdx == -1) currentIdx = 0;
            }
            @for (int i = 0; i < steps.Length; i++)
            {
                var isDone = i <= currentIdx;
                var isCurrent = i == currentIdx;
                <div class="col">
                    <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center mb-2 @(isDone ? "bg-success text-white" : "bg-light text-muted border")" style="width: 42px; height: 42px;">
                        <i class="bi @(isDone ? "bi-check-lg" : "bi-circle")"></i>
                    </div>
                    <div class="small fw-semibold @(isCurrent ? "text-success" : isDone ? "text-dark" : "text-muted")">
                        @steps[i]
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Order Items -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Items Ordered</h5>
                <div class="d-flex flex-column gap-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/products/chyawanprash.svg" : item.ImageUrl)" 
                                     alt="@item.Title" width="56" height="56" class="rounded border p-1" style="object-fit: contain;" />
                                <div>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <div class="small text-muted">₹@item.UnitPrice.ToString("N0") × @item.Quantity</div>
                                </div>
                            </div>
                            <div class="fw-bold text-success">₹@item.TotalPrice.ToString("N2")</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Order Summary & Shipping Address -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 p-4 mb-3">
                <h6 class="fw-bold mb-3 border-bottom pb-2">Shipping Information</h6>
                <div class="small text-muted mb-2">Delivery Address:</div>
                <div class="small text-dark fw-medium mb-3">@Model.ShippingAddress</div>

                <div class="small text-muted mb-1">Payment:</div>
                <div class="small text-dark fw-medium">@Model.PaymentMethod (@Model.PaymentStatus)</div>
            </div>

            <div class="card shadow-sm border-0 rounded-3 p-4">
                <h6 class="fw-bold mb-3 border-bottom pb-2">Price Breakdown</h6>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Subtotal:</span>
                    <span>₹@Model.Subtotal.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Delivery Fee:</span>
                    <span>@(Model.DeliveryFee == 0 ? "FREE" : $"₹{Model.DeliveryFee:N2}")</span>
                </div>
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">GST:</span>
                    <span>₹@Model.TaxAmount.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between fw-bold text-success border-top pt-2">
                    <span>Grand Total:</span>
                    <span>₹@Model.TotalAmount.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>
