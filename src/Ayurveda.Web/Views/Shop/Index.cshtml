@model Ayurveda.Application.ViewModels.CatalogListViewModel
@{
    ViewData["Title"] = "Ayurvedic Medicines & Herbal Formulations | Store";
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Breadcrumb & Page Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-success text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-success text-decoration-none">Store</a></li>
            @if (Model.SelectedCategoryId.HasValue)
            {
                var currentCat = Model.Categories.FirstOrDefault(c => c.Id == Model.SelectedCategoryId.Value);
                if (currentCat != null)
                {
                    <li class="breadcrumb-item active" aria-current="page">@currentCat.Name</li>
                }
            }
            else
            {
                <li class="breadcrumb-item active" aria-current="page">All Formulations</li>
            }
        </ol>
    </nav>

    @{
        var shopBanners = ViewBag.ShopBanners as List<Ayurveda.Domain.Entities.Banner> ?? new();
    }
    @if (shopBanners.Any())
    {
        <div class="mb-4">
            @foreach (var sb in shopBanners)
            {
                <a href="@(sb.LinkUrl ?? "/Shop")" class="d-block mb-3 rounded-4 overflow-hidden shadow-sm">
                    <img src="@sb.ImageUrl" alt="@sb.Title" class="w-100" style="max-height: 220px; object-fit: cover;" data-fallback="/images/banners/banner-newarrivals.svg" />
                </a>
            }
        </div>
    }

    <!-- Top Headline Strip -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-3 border-bottom gap-3">
        <div>
            <h1 class="h3 fw-bold mb-1" style="font-family: var(--tga-font-heading); color: var(--tga-primary);">
                Authentic Ayurvedic Pharmacopoeia
            </h1>
            <p class="text-muted small mb-0">
                Showing <strong>@Model.Products.Count</strong> of <strong>@Model.TotalCount</strong> classical and proprietary formulations
            </p>
        </div>

        <!-- Controls: Sort & Grid/List Switcher -->
        <div class="d-flex align-items-center gap-3">
            <!-- Mobile Filter Trigger -->
            <button class="btn btn-outline-success btn-sm d-lg-none rounded-pill px-3" type="button" data-bs-toggle="offcanvas" data-bs-target="#filtersOffcanvas">
                <i class="bi bi-funnel me-1"></i> Filter & Refine
            </button>

            <!-- View Switcher -->
            <div class="btn-group btn-group-sm d-none d-sm-inline-flex" role="group">
                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, query = Model.SearchQuery, sort = Model.SelectedSort, concern = Model.Concern, viewMode = "grid" })" 
                   class="btn @(Model.ViewMode == "grid" ? "btn-success" : "btn-outline-secondary")" title="Grid View">
                    <i class="bi bi-grid-3x3-gap-fill"></i>
                </a>
                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, query = Model.SearchQuery, sort = Model.SelectedSort, concern = Model.Concern, viewMode = "list" })" 
                   class="btn @(Model.ViewMode == "list" ? "btn-success" : "btn-outline-secondary")" title="List View">
                    <i class="bi bi-list-ul"></i>
                </a>
            </div>

            <!-- Sort Form -->
            <form method="get" id="sortForm" class="d-flex align-items-center gap-2 m-0">
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                <input type="hidden" name="subcategoryId" value="@Model.SelectedSubcategoryId" />
                <input type="hidden" name="brand" value="@Model.SelectedBrand" />
                <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                <input type="hidden" name="minRating" value="@Model.MinRating" />
                <input type="hidden" name="minDiscount" value="@Model.MinDiscount" />
                <input type="hidden" name="inStockOnly" value="@(Model.InStockOnly ? "true" : "false")" />
                <input type="hidden" name="query" value="@Model.SearchQuery" />
                <input type="hidden" name="concern" value="@Model.Concern" />
                <input type="hidden" name="viewMode" value="@Model.ViewMode" />

                <label class="small text-muted text-nowrap fw-semibold d-none d-md-inline">Sort by:</label>
                <select name="sort" class="form-select form-select-sm rounded-pill shadow-sm" onchange="document.getElementById('sortForm').submit()" style="min-width: 170px;">
                    <option value="popular" selected="@(Model.SelectedSort == "popular")">Most Popular</option>
                    <option value="rating" selected="@(Model.SelectedSort == "rating")">Customer Rating: High to Low</option>
                    <option value="price_asc" selected="@(Model.SelectedSort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SelectedSort == "price_desc")">Price: High to Low</option>
                    <option value="discount" selected="@(Model.SelectedSort == "discount")">Biggest Discount</option>
                    <option value="newest" selected="@(Model.SelectedSort == "newest")">Newest Arrivals</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Active Filter Chips Strip -->
    @if (Model.ActiveChips != null && Model.ActiveChips.Any())
    {
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 bg-light rounded-3 border">
            <span class="small fw-bold text-muted ps-1"><i class="bi bi-funnel-fill text-success me-1"></i>Filters:</span>
            @foreach (var chip in Model.ActiveChips)
            {
                <span class="badge bg-white text-dark border shadow-sm rounded-pill py-2 px-3 small d-inline-flex align-items-center gap-2">
                    <span>@chip.Label</span>
                    <a href="@chip.RemoveUrl" class="text-danger text-decoration-none fw-bold" title="Remove filter">&times;</a>
                </span>
            }
            <a asp-controller="Shop" asp-action="Index" class="small text-danger text-decoration-none fw-semibold ms-auto pe-2">
                Clear All Filters
            </a>
        </div>
    }

    <div class="row g-4">
        <!-- Sidebar Filters (Desktop) -->
        <aside class="col-lg-3 d-none d-lg-block">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white sticky-top" style="top: 90px; max-height: calc(100vh - 110px); overflow-y: auto;">
                <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                    <h6 class="fw-bold m-0 text-dark"><i class="bi bi-sliders2 text-success me-2"></i>Refine Catalogue</h6>
                    <a asp-action="Index" class="small text-muted text-decoration-none">Reset</a>
                </div>

                <!-- 1. Categories Accordion -->
                <div class="mb-4">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Ayurvedic Categories</h6>
                    <div class="list-group list-group-flush small" style="max-height: 220px; overflow-y: auto;">
                        <a href="@Url.Action("Index", new { subcategoryId = (int?)null, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-1 border-0 @(Model.SelectedCategoryId == null ? "fw-bold text-success" : "text-muted")">
                            <span>All Categories</span>
                            <span class="badge @(Model.SelectedCategoryId == null ? "bg-success text-white" : "bg-light text-muted") rounded-pill">@Model.TotalCount</span>
                        </a>
                        @foreach (var cat in Model.Categories)
                        {
                            <a href="@Url.Action("Index", new { categoryId = cat.Id, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-1 border-0 @(Model.SelectedCategoryId == cat.Id ? "fw-bold text-success" : "text-muted")">
                                <span class="text-truncate" style="max-width: 170px;">@cat.Name</span>
                                <span class="badge @(Model.SelectedCategoryId == cat.Id ? "bg-success text-white" : "bg-light text-muted") rounded-pill">@cat.ProductCount</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- 2. Subcategories (if available) -->
                @if (Model.Subcategories != null && Model.Subcategories.Any())
                {
                    <div class="mb-4 pt-3 border-top">
                        <h6 class="fw-bold small text-uppercase text-muted mb-2">Subcategories</h6>
                        <div class="list-group list-group-flush small" style="max-height: 180px; overflow-y: auto;">
                            @foreach (var sub in Model.Subcategories)
                            {
                                <a href="@Url.Action("Index", new { categoryId = sub.CategoryId, subcategoryId = sub.Id, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-1 px-1 border-0 @(Model.SelectedSubcategoryId == sub.Id ? "fw-bold text-success" : "text-muted")">
                                    <span class="text-truncate" style="max-width: 170px;">@sub.Name</span>
                                    <span class="badge @(Model.SelectedSubcategoryId == sub.Id ? "bg-success text-white" : "bg-light text-muted") rounded-pill">@sub.ProductCount</span>
                                </a>
                            }
                        </div>
                    </div>
                }

                <!-- 3. Health Concern Pills -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Health Concern (Roga/Dosha)</h6>
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var c in Model.AvailableConcerns)
                        {
                            var isSelected = !string.IsNullOrWhiteSpace(Model.Concern) && Model.Concern.Equals(c, StringComparison.OrdinalIgnoreCase);
                            <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, concern = isSelected ? null : c, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                               class="badge @(isSelected ? "bg-success text-white" : "bg-light text-muted border") rounded-pill py-2 px-2 text-decoration-none small">
                                @c
                            </a>
                        }
                    </div>
                </div>

                <!-- 4. Brands Filter -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Ayurvedic Brands</h6>
                    <div class="d-flex flex-column gap-1 small">
                        @foreach (var b in Model.Brands)
                        {
                            var isSelected = !string.IsNullOrWhiteSpace(Model.SelectedBrand) && Model.SelectedBrand == b.Name;
                            <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = isSelected ? null : b.Name, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                               class="d-flex justify-content-between align-items-center text-decoration-none py-1 @(isSelected ? "fw-bold text-success" : "text-muted")">
                                <span><i class="bi @(isSelected ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-1"></i> @b.Name</span>
                                <span class="badge bg-light text-muted rounded-pill">@b.ProductCount</span>
                            </a>
                        }
                    </div>
                </div>

                <!-- 5. Price Filter -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Price Range (₹)</h6>
                    <div class="d-flex flex-column gap-1 small">
                        <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 0, maxPrice = 300, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                           class="text-decoration-none py-1 @(Model.MinPrice == 0 && Model.MaxPrice == 300 ? "fw-bold text-success" : "text-muted")">
                            Under ₹300
                        </a>
                        <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 300, maxPrice = 600, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                           class="text-decoration-none py-1 @(Model.MinPrice == 300 && Model.MaxPrice == 600 ? "fw-bold text-success" : "text-muted")">
                            ₹300 - ₹600
                        </a>
                        <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 600, maxPrice = 1200, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                           class="text-decoration-none py-1 @(Model.MinPrice == 600 && Model.MaxPrice == 1200 ? "fw-bold text-success" : "text-muted")">
                            ₹600 - ₹1,200
                        </a>
                        <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 1200, maxPrice = (decimal?)null, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                           class="text-decoration-none py-1 @(Model.MinPrice == 1200 ? "fw-bold text-success" : "text-muted")">
                            Above ₹1,200
                        </a>
                    </div>
                </div>

                <!-- 6. Customer Ratings Filter -->
                <div class="mb-4 pt-3 border-top">
                    <h6 class="fw-bold small text-uppercase text-muted mb-2">Customer Rating</h6>
                    <div class="d-flex flex-column gap-1 small">
                        <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = 4.8, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                           class="text-decoration-none py-1 @(Model.MinRating == 4.8 ? "fw-bold text-success" : "text-muted")">
                            <i class="bi bi-star-fill text-warning"></i> 4.8 & above (Top Rated)
                        </a>
                        <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = 4.5, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                           class="text-decoration-none py-1 @(Model.MinRating == 4.5 ? "fw-bold text-success" : "text-muted")">
                            <i class="bi bi-star-fill text-warning"></i> 4.5 & above
                        </a>
                    </div>
                </div>

                <!-- 7. In-Stock Availability Switch -->
                <div class="pt-3 border-top">
                    <div class="form-check form-switch small">
                        <input class="form-check-input" type="checkbox" role="switch" id="stockSwitch" @(Model.InStockOnly ? "checked" : "")
                               onchange="window.location.href = '@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = !Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })'" />
                        <label class="form-check-label fw-semibold text-dark" for="stockSwitch">Exclude Out of Stock</label>
                    </div>
                </div>

                @if (ViewBag.AdShopSide != null)
                {
                    <div class="pt-3 border-top mt-3">
                        <partial name="_AdBanner" model="ViewBag.AdShopSide" />
                    </div>
                }
            </div>
        </aside>

        <!-- Product Listing Grid / List -->
        <main class="col-lg-9 pb-5 mb-5">
            @if (Model.Products != null && Model.Products.Any())
            {
                if (Model.ViewMode == "list")
                {
                    <!-- List View -->
                    <div class="d-flex flex-column gap-3">
                        @foreach (var product in Model.Products)
                        {
                            <div class="card border-0 shadow-sm rounded-3 overflow-hidden p-3 bg-white product-card-hover">
                                <div class="row align-items-center g-3">
                                    <div class="col-sm-3 text-center position-relative" style="background: #FDFBF7;">
                                        <a asp-action="Details" asp-route-id="@product.Id">
                                            <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/images/placeholder.svg" : product.ImageUrl)" 
                                                 alt="@product.Title" class="img-fluid" style="max-height: 140px; object-fit: contain;" 
                                                 onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
                                        </a>
                                        @if (product.DiscountPercent > 0)
                                        {
                                            <span class="badge bg-danger position-absolute top-0 start-0 m-1">@product.DiscountPercent% OFF</span>
                                        }
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="small text-muted text-uppercase fw-semibold mb-1">@product.Brand • @product.CategoryName</div>
                                        <h5 class="fw-bold mb-1">
                                            <a asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none hover-green">
                                                @product.Title
                                            </a>
                                        </h5>
                                        @if (!string.IsNullOrEmpty(product.TraditionallyUsedFor))
                                        {
                                            <p class="small text-muted mb-2"><i class="bi bi-heart-pulse text-success me-1"></i>@product.TraditionallyUsedFor</p>
                                        }
                                        <div class="d-flex align-items-center gap-1 small">
                                            <span class="text-warning"><i class="bi bi-star-fill"></i></span>
                                            <span class="fw-bold text-dark">@product.AverageRating.ToString("0.0")</span>
                                            <span class="text-muted ms-2">• SKU: @product.Sku</span>
                                        </div>
                                    </div>
                                    <div class="col-sm-3 text-sm-end border-sm-start ps-sm-3">
                                        <div class="fs-4 fw-bold text-success mb-1">₹@product.Price.ToString("N0")</div>
                                        @if (product.Mrp > product.Price)
                                        {
                                            <div class="small text-muted text-decoration-line-through mb-2">MRP ₹@product.Mrp.ToString("N0")</div>
                                        }

                                        @if (product.IsInStock)
                                        {
                                            <button type="button" class="btn btn-tga-primary btn-sm w-100 rounded-pill ajax-add-to-cart mb-2" data-product-id="@product.Id">
                                                <i class="bi bi-cart-plus me-1"></i> Add to Cart
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-light text-muted btn-sm w-100 rounded-pill mb-2" disabled>Out of Stock</button>
                                        }
                                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 rounded-pill wishlist-toggle-btn" data-product-id="@product.Id">
                                            <i class="bi bi-heart me-1"></i> Wishlist
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <!-- Grid View (Default) -->
                    <div class="row g-3">
                        @for (int pIdx = 0; pIdx < Model.Products.Count; pIdx++)
                        {
                            var product = Model.Products[pIdx];
                            <div class="col-6 col-md-4">
                                <partial name="_ProductCard" model="product" />
                            </div>

                            @if ((pIdx + 1) % 8 == 0 && ViewBag.AdShopInline is List<Ayurveda.Domain.Entities.Banner> inlineAds && inlineAds.Count > 0)
                            {
                                var ad = inlineAds[((pIdx + 1) / 8 - 1) % inlineAds.Count];
                                <div class="col-6 col-md-4">
                                    <partial name="_AdBanner" model="ad" />
                                </div>
                            }
                        }
                    </div>
                }

                <!-- Accessible Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav class="mt-5 pt-3 border-top" aria-label="Product catalogue pages">
                        <ul class="pagination justify-content-center">
                            @if (Model.PageIndex > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill me-1" href="@Url.Action("Index", new { page = Model.PageIndex - 1, categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })">
                                        <i class="bi bi-chevron-left"></i> Previous
                                    </a>
                                </li>
                            }

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                    <a class="page-link rounded-circle mx-1 text-center" style="width: 38px; height: 38px; line-height: 22px;" href="@Url.Action("Index", new { page = i, categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })">
                                        @i
                                    </a>
                                </li>
                            }

                            @if (Model.PageIndex < Model.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-pill ms-1" href="@Url.Action("Index", new { page = Model.PageIndex + 1, categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })">
                                        Next <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            }
            else
            {
                <!-- Empty State -->
                <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
                    <i class="bi bi-search text-muted display-4 mb-3 d-block"></i>
                    <h4 class="fw-bold text-dark">No formulations matched your filters</h4>
                    <p class="text-muted small">Try broadening your search terms or clearing selected price/category filters.</p>
                    <a asp-action="Index" class="btn btn-tga-primary btn-sm rounded-pill px-4">
                        Clear All Filters & Browse
                    </a>
                </div>
            }
        </main>
    </div>
</div>

<!-- Sticky Mobile Filter Button (Bottom Floating Pill) -->
<div class="d-lg-none position-fixed start-50 translate-middle-x" style="bottom: calc(66px + env(safe-area-inset-bottom, 0px)); z-index: 1040;">
    <button type="button" class="btn btn-tga-primary rounded-pill shadow-lg px-4 py-2 d-flex align-items-center gap-2 fw-bold text-nowrap" data-bs-toggle="offcanvas" data-bs-target="#filtersOffcanvas" style="min-height: 44px;">
        <i class="bi bi-sliders"></i> Filter &amp; Sort
        @if (Model.ActiveChips != null && Model.ActiveChips.Any())
        {
            <span class="badge bg-warning text-dark rounded-pill">@Model.ActiveChips.Count</span>
        }
    </button>
</div>

<!-- Mobile Filters Offcanvas Drawer -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="filtersOffcanvas" aria-labelledby="filtersOffcanvasLabel">
    <div class="offcanvas-header bg-light border-bottom py-3">
        <h5 class="offcanvas-title fw-bold text-dark d-flex align-items-center gap-2" id="filtersOffcanvasLabel">
            <i class="bi bi-sliders text-success"></i> Filter &amp; Sort
        </h5>
        <button type="button" class="btn-close tga-touch-target" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-3">
        <!-- Sort By -->
        <div class="mb-4">
            <h6 class="fw-bold small text-uppercase text-muted mb-2">Sort Results</h6>
            <form method="get" id="mobileSortForm">
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                <input type="hidden" name="subcategoryId" value="@Model.SelectedSubcategoryId" />
                <input type="hidden" name="brand" value="@Model.SelectedBrand" />
                <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                <input type="hidden" name="minRating" value="@Model.MinRating" />
                <input type="hidden" name="minDiscount" value="@Model.MinDiscount" />
                <input type="hidden" name="inStockOnly" value="@(Model.InStockOnly ? "true" : "false")" />
                <input type="hidden" name="query" value="@Model.SearchQuery" />
                <input type="hidden" name="concern" value="@Model.Concern" />
                <input type="hidden" name="viewMode" value="@Model.ViewMode" />
                <select name="sort" class="form-select rounded-pill shadow-sm" onchange="document.getElementById('mobileSortForm').submit()" style="min-height: 44px;">
                    <option value="popular" selected="@(Model.SelectedSort == "popular")">Most Popular</option>
                    <option value="rating" selected="@(Model.SelectedSort == "rating")">Customer Rating: High to Low</option>
                    <option value="price_asc" selected="@(Model.SelectedSort == "price_asc")">Price: Low to High</option>
                    <option value="price_desc" selected="@(Model.SelectedSort == "price_desc")">Price: High to Low</option>
                    <option value="discount" selected="@(Model.SelectedSort == "discount")">Biggest Discount</option>
                    <option value="newest" selected="@(Model.SelectedSort == "newest")">Newest Arrivals</option>
                </select>
            </form>
        </div>

        <!-- Categories -->
        <div class="mb-4 pt-3 border-top">
            <h6 class="fw-bold small text-uppercase text-muted mb-2">Categories</h6>
            <div class="list-group list-group-flush small" style="max-height: 200px; overflow-y: auto;">
                <a href="@Url.Action("Index", new { subcategoryId = (int?)null, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-1 border-0 @(Model.SelectedCategoryId == null ? "fw-bold text-success" : "text-muted")" style="min-height: 44px;">
                    <span>All Categories</span>
                    <span class="badge @(Model.SelectedCategoryId == null ? "bg-success text-white" : "bg-light text-muted") rounded-pill">@Model.TotalCount</span>
                </a>
                @foreach (var cat in Model.Categories)
                {
                    <a href="@Url.Action("Index", new { categoryId = cat.Id, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center py-2 px-1 border-0 @(Model.SelectedCategoryId == cat.Id ? "fw-bold text-success" : "text-muted")" style="min-height: 44px;">
                        <span class="text-truncate" style="max-width: 170px;">@cat.Name</span>
                        <span class="badge @(Model.SelectedCategoryId == cat.Id ? "bg-success text-white" : "bg-light text-muted") rounded-pill">@cat.ProductCount</span>
                    </a>
                }
            </div>
        </div>

        <!-- Health Concerns -->
        <div class="mb-4 pt-3 border-top">
            <h6 class="fw-bold small text-uppercase text-muted mb-2">Health Concern</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var c in Model.AvailableConcerns)
                {
                    var isSelected = !string.IsNullOrWhiteSpace(Model.Concern) && Model.Concern.Equals(c, StringComparison.OrdinalIgnoreCase);
                    <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, concern = isSelected ? null : c, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                       class="badge @(isSelected ? "bg-success text-white" : "bg-light text-dark border") rounded-pill p-2 text-decoration-none small d-inline-flex align-items-center" style="min-height: 38px;">
                        @c
                    </a>
                }
            </div>
        </div>

        <!-- Brands -->
        <div class="mb-4 pt-3 border-top">
            <h6 class="fw-bold small text-uppercase text-muted mb-2">Ayurvedic Brands</h6>
            <div class="d-flex flex-column gap-1 small">
                @foreach (var b in Model.Brands)
                {
                    var isSelected = !string.IsNullOrWhiteSpace(Model.SelectedBrand) && Model.SelectedBrand == b.Name;
                    <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = isSelected ? null : b.Name, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                       class="d-flex justify-content-between align-items-center text-decoration-none py-2 px-1 rounded @(isSelected ? "fw-bold text-success bg-light" : "text-muted")" style="min-height: 44px;">
                        <span><i class="bi @(isSelected ? "bi-check-circle-fill text-success" : "bi-circle text-muted") me-2"></i>@b.Name</span>
                        <span class="badge bg-light text-muted rounded-pill">@b.ProductCount</span>
                    </a>
                }
            </div>
        </div>

        <!-- Price Range -->
        <div class="mb-4 pt-3 border-top">
            <h6 class="fw-bold small text-uppercase text-muted mb-2">Price Range</h6>
            <div class="d-flex flex-column gap-1 small">
                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 0, maxPrice = 300, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                   class="text-decoration-none py-2 px-1 rounded @(Model.MinPrice == 0 && Model.MaxPrice == 300 ? "fw-bold text-success bg-light" : "text-muted")" style="min-height: 44px;">Under ₹300</a>
                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 300, maxPrice = 600, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                   class="text-decoration-none py-2 px-1 rounded @(Model.MinPrice == 300 && Model.MaxPrice == 600 ? "fw-bold text-success bg-light" : "text-muted")" style="min-height: 44px;">₹300 - ₹600</a>
                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 600, maxPrice = 1200, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                   class="text-decoration-none py-2 px-1 rounded @(Model.MinPrice == 600 && Model.MaxPrice == 1200 ? "fw-bold text-success bg-light" : "text-muted")" style="min-height: 44px;">₹600 - ₹1,200</a>
                <a href="@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = 1200, maxPrice = (decimal?)null, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })" 
                   class="text-decoration-none py-2 px-1 rounded @(Model.MinPrice == 1200 ? "fw-bold text-success bg-light" : "text-muted")" style="min-height: 44px;">Above ₹1,200</a>
            </div>
        </div>

        <!-- In Stock Switch -->
        <div class="pt-3 border-top mb-4">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="mobileStockSwitch" @(Model.InStockOnly ? "checked" : "")
                       onchange="window.location.href = '@Url.Action("Index", new { categoryId = Model.SelectedCategoryId, subcategoryId = Model.SelectedSubcategoryId, brand = Model.SelectedBrand, minPrice = Model.MinPrice, maxPrice = Model.MaxPrice, minRating = Model.MinRating, minDiscount = Model.MinDiscount, inStockOnly = !Model.InStockOnly, sort = Model.SelectedSort, viewMode = Model.ViewMode })'" />
                <label class="form-check-label fw-semibold text-dark" for="mobileStockSwitch">Exclude Out of Stock</label>
            </div>
        </div>
    </div>
    <div class="offcanvas-footer p-3 bg-light border-top d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill flex-fill d-inline-flex align-items-center justify-content-center" style="min-height: 44px;">
            Clear All
        </a>
        <button type="button" class="btn btn-tga-primary rounded-pill flex-fill d-inline-flex align-items-center justify-content-center" data-bs-dismiss="offcanvas" style="min-height: 44px;">
            Apply Filters
        </button>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Asynchronous Add to Cart
        document.querySelectorAll(".ajax-add-to-cart").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var productId = this.getAttribute("data-product-id");
                var self = this;
                var originalHtml = self.innerHTML;
                self.disabled = true;
                self.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Adding...';

                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                var formData = new FormData();
                formData.append("productId", productId);
                formData.append("quantity", "1");
                formData.append("__RequestVerificationToken", token);

                fetch("/Cart/AddToCartAjax", {
                    method: "POST",
                    body: formData
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    self.disabled = false;
                    self.innerHTML = '<i class="bi bi-check2"></i> Added!';
                    setTimeout(function () { self.innerHTML = originalHtml; }, 1800);

                    // Update badge if present
                    var badge = document.querySelector(".cart-count-badge");
                    if (badge && data.cartCount) {
                        badge.textContent = data.cartCount;
                    }
                })
                .catch(function () {
                    self.disabled = false;
                    self.innerHTML = originalHtml;
                });
            });
        });

        // Wishlist Toggle
        document.querySelectorAll(".wishlist-toggle-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var productId = this.getAttribute("data-product-id");
                var self = this;
                var icon = self.querySelector("i");
                var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                var formData = new FormData();
                formData.append("productId", productId);
                formData.append("__RequestVerificationToken", token);

                fetch("/Wishlist/Toggle", {
                    method: "POST",
                    body: formData
                })
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data.redirect) {
                        window.location.href = data.redirect;
                        return;
                    }
                    if (data.inWishlist) {
                        icon.className = "bi bi-heart-fill text-danger";
                    } else {
                        icon.className = "bi bi-heart text-muted";
                    }
                });
            });
        });
    });
</script>
}
