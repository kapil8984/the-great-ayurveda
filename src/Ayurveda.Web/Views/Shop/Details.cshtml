@model Ayurveda.Application.ViewModels.ProductDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Title} | The Great Ayurveda";
    var productJsonLd = System.Text.Json.JsonSerializer.Serialize(new {
        context = "https://schema.org/",
        type = "Product",
        name = Model.Title,
        image = Model.ImageUrl,
        description = Model.Description ?? "",
        sku = Model.Sku,
        brand = new {
            type = "Brand",
            name = Model.Brand ?? "The Great Ayurveda"
        },
        offers = new {
            type = "Offer",
            url = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}",
            priceCurrency = "INR",
            price = Model.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
            availability = Model.IsInStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
        }
    }).Replace("\"context\":", "\"@context\":").Replace("\"type\":", "\"@type\":");

    // Collect all genuine image angles for gallery
    var allGalleryImages = new List<string>();
    if (!string.IsNullOrEmpty(Model.ImageUrl))
    {
        allGalleryImages.Add(Model.ImageUrl);
    }
    if (Model.AdditionalImages != null)
    {
        foreach (var img in Model.AdditionalImages)
        {
            if (!string.IsNullOrEmpty(img) && !allGalleryImages.Contains(img))
            {
                allGalleryImages.Add(img);
            }
        }
    }
    if (!allGalleryImages.Any())
    {
        allGalleryImages.Add("/images/placeholder.svg");
    }
}

<script type="application/ld+json">
@Html.Raw(productJsonLd)
</script>

<div class="container py-3 py-md-4">
    <!-- Flipkart-Style Clean Breadcrumbs -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small text-muted mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none text-muted">Medicines</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none text-muted">@Model.CategoryName</a></li>
            @if (!string.IsNullOrEmpty(Model.SubcategoryName))
            {
                <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-subcategoryId="@Model.SubcategoryId" class="text-decoration-none text-muted">@Model.SubcategoryName</a></li>
            }
            <li class="breadcrumb-item text-dark fw-semibold active text-truncate" style="max-width: 320px;" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <!-- Main Flipkart-Style Showcase Row -->
    <div class="row g-4 mb-5">
        <!-- ========================================== -->
        <!-- LEFT SECTION: FLIPKART-STYLE IMAGE GALLERY -->
        <!-- ========================================== -->
        <div class="col-lg-5">
            <div class="position-sticky" style="top: 85px;">
                <div class="p-3 bg-white rounded-3 border position-relative">
                    <!-- Wishlist Toggle Button (Top Right of Image) -->
                    <button type="button" 
                            class="btn btn-light rounded-circle border shadow-sm position-absolute top-0 end-0 m-3 z-3 wishlist-toggle-btn d-flex align-items-center justify-content-center p-0"
                            data-product-id="@Model.Id"
                            title="Save to Wishlist"
                            style="width: 38px; height: 38px;">
                        <i class="bi @(Model.IsInWishlist ? "bi-heart-fill text-danger" : "bi-heart text-muted") fs-5"></i>
                    </button>

                    <!-- Gallery Container (Thumbnails + Main Stage) -->
                    <div class="flipkart-gallery-container position-relative">
                        <!-- Vertical Thumbnails Strip (Left) -->
                        <div class="flipkart-thumb-strip" id="flipkartThumbStrip">
                            @for (int i = 0; i < allGalleryImages.Count; i++)
                            {
                                var imgUrl = allGalleryImages[i];
                                <button type="button" 
                                        class="flipkart-thumb-btn @(i == 0 ? "active" : "")" 
                                        data-img-url="@imgUrl"
                                        data-index="@i"
                                        aria-label="Product Image View @(i + 1)">
                                    <img src="@imgUrl" alt="Angle @(i + 1)" onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
                                </button>
                            }
                        </div>

                        <!-- Main Image Viewport with Contained Smooth Zoom & Lightbox Trigger -->
                        <div class="flipkart-main-stage position-relative" id="mainImageStage" title="Hover to magnify • Click for fullscreen">
                            <img id="mainProductImage" 
                                 src="@allGalleryImages[0]" 
                                 alt="@Model.Title" 
                                 onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
                            
                            <!-- Contained Zoom & Fullscreen Indicator -->
                            <div class="position-absolute bottom-0 start-0 m-2 badge bg-dark bg-opacity-75 text-white rounded-pill px-2 py-1 small" style="pointer-events: none; font-size: 0.72rem; z-index: 4;">
                                <i class="bi bi-arrows-fullscreen me-1"></i> Hover to Zoom • Click for Fullscreen
                            </div>
                        </div>
                    </div>

                    <!-- Under-Image Primary Flipkart Actions (Add to Cart / Buy Now) -->
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" id="galleryPurchaseForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <input type="hidden" name="quantity" id="actionQuantityInput" value="1" />

                        <div class="flipkart-action-row">
                            @if (Model.IsInStock)
                            {
                                <button type="submit" class="flipkart-btn-cart" title="Add to Basket">
                                    <i class="bi bi-cart-plus-fill fs-5"></i> Add to Cart <span class="visually-hidden">Add to Basket</span>
                                </button>
                                <button type="submit" formaction="/Cart/BuyNow" class="flipkart-btn-buy">
                                    <i class="bi bi-lightning-charge-fill fs-5"></i> Buy Now
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary w-100 py-3 rounded-2 fw-bold" disabled>
                                    Currently Out of Stock <span class="visually-hidden">Add to Basket</span>
                                </button>
                            }
                        </div>
                    </form>

                    <!-- Trust Strip -->
                    <div class="d-flex justify-content-around align-items-center mt-3 pt-3 border-top small text-muted">
                        <span><i class="bi bi-shield-check text-success me-1"></i> 100% Genuine Ayurvedic</span>
                        <span><i class="bi bi-truck text-success me-1"></i> Fast Discreet Dispatch</span>
                        <button type="button" id="shareBtn" class="btn btn-link text-muted p-0 text-decoration-none small">
                            <i class="bi bi-share me-1"></i> Share
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============================================== -->
        <!-- RIGHT SECTION: FLIPKART-STYLE PRODUCT DETAILS -->
        <!-- ============================================== -->
        <div class="col-lg-7">
            <!-- Brand & Certification Row -->
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Shop" asp-action="Index" asp-route-brand="@Model.Brand" class="text-uppercase fw-bold text-muted small text-decoration-none hover-green" style="letter-spacing: 0.8px;">
                    @Model.Brand
                </a>
                <span class="text-muted">•</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill small" style="font-size: 0.7rem;">
                    <i class="bi bi-patch-check-fill me-1"></i> AYUSH Certified
                </span>
                <span class="text-muted ms-auto small">SKU: @Model.Sku</span>
            </div>

            <!-- Product Title -->
            <h1 class="h4 fw-bold text-dark mb-2" style="font-family: var(--tga-font-heading); line-height: 1.3;">
                @Model.Title
            </h1>

            <!-- Flipkart Ratings & Reviews Badge Row -->
            <div class="d-flex align-items-center gap-2 mb-3">
                <span class="flipkart-rating-badge fs-6">
                    @Model.AverageRating.ToString("0.0") <i class="bi bi-star-fill text-white" style="font-size: 0.75rem;"></i>
                </span>
                <span class="text-muted fw-semibold small">
                    @(Math.Max(18, Model.ReviewCount)) Ratings &amp; @(Math.Max(6, (int)(Model.ReviewCount * 0.4))) Reviews
                </span>
                <span class="badge bg-light text-muted border rounded-pill small ms-2">
                    <i class="bi bi-box-seam text-success me-1"></i> Verified Pack
                </span>
            </div>

            <!-- Flipkart Pricing Block -->
            <div class="p-3 bg-light rounded-3 mb-3 border">
                <div class="small text-success fw-bold mb-1">Special Ayurvedic Price</div>
                <div class="d-flex align-items-baseline gap-3">
                    <span class="display-6 fw-bold text-dark" id="displayPrice">₹@Model.Price.ToString("N0")</span>
                    @if (Model.Mrp > Model.Price)
                    {
                        <span class="fs-5 text-muted text-decoration-line-through" id="displayMrp">₹@Model.Mrp.ToString("N0")</span>
                        <span class="fs-5 fw-bold text-success" id="displayDiscount">@Model.DiscountPercent% off</span>
                    }
                </div>
                <div class="small text-muted mt-1">
                    Inclusive of all taxes &amp; GST • Free standard delivery on orders over ₹499
                </div>
            </div>

            <!-- Flipkart "Available Offers" Accordion -->
            <div class="card p-3 rounded-3 border-0 bg-white shadow-sm mb-4">
                <div class="fw-bold text-dark mb-2 small text-uppercase" style="letter-spacing: 0.5px;">
                    <i class="bi bi-tag-fill text-success me-1"></i> Available Offers:
                </div>
                <div class="flipkart-offer-item">
                    <i class="bi bi-tag-fill flipkart-offer-tag"></i>
                    <div><strong>Bank Offer:</strong> Flat 10% Instant Discount on HDFC, ICICI &amp; Axis Bank Cards. Use code <span class="badge bg-light text-dark border">AYUR10</span></div>
                </div>
                <div class="flipkart-offer-item">
                    <i class="bi bi-tag-fill flipkart-offer-tag"></i>
                    <div><strong>Special Price:</strong> Get extra ₹100 OFF on your first purchase above ₹599. Code <span class="badge bg-light text-dark border">TGAFIRST</span></div>
                </div>
                <div class="flipkart-offer-item">
                    <i class="bi bi-tag-fill flipkart-offer-tag"></i>
                    <div><strong>Doctor Consult Benefit:</strong> Book a free 15-minute follow-up consultation with a certified BAMS Vaidya on orders above ₹799.</div>
                </div>
            </div>

            <!-- Variants Selector (Size / Pack) -->
            @if (Model.Variants != null && Model.Variants.Any())
            {
                <div class="mb-4">
                    <label class="form-label small fw-bold text-uppercase text-muted">Select Pack Size / Quantity:</label>
                    <div class="d-flex flex-wrap gap-2" id="variantSelectorGroup">
                        <button type="button" 
                                class="btn btn-outline-success active rounded-2 px-3 py-2 variant-btn fw-semibold"
                                data-price="@Model.Price"
                                data-mrp="@Model.Mrp"
                                data-stock="@Model.Stock"
                                data-title="Standard">
                            Standard Pack
                        </button>
                        @foreach (var v in Model.Variants)
                        {
                            <button type="button" 
                                    class="btn btn-outline-secondary rounded-2 px-3 py-2 variant-btn fw-semibold"
                                    data-price="@v.Price"
                                    data-mrp="@v.Mrp"
                                    data-stock="@v.StockQuantity"
                                    data-title="@v.SizeOrPack">
                                @v.Title (@v.SizeOrPack)
                            </button>
                        }
                    </div>
                </div>
            }

            <!-- Quantity Stepper & Stock Status -->
            <div class="card p-3 rounded-3 border bg-white mb-4">
                <div class="row g-3 align-items-center">
                    <div class="col-auto">
                        <label class="form-label small fw-bold mb-0">Quantity:</label>
                    </div>
                    <div class="col-auto">
                        <div class="input-group input-group-sm" style="width: 110px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="decrementQty()" aria-label="Decrease quantity">-</button>
                            <input type="number" id="qtyInput" class="form-control text-center fw-bold" value="1" min="1" max="@Math.Max(1, Model.Stock)" aria-label="Quantity" />
                            <button class="btn btn-outline-secondary" type="button" onclick="incrementQty()" aria-label="Increase quantity">+</button>
                        </div>
                    </div>
                    <div class="col-auto">
                        @if (Model.IsInStock)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
                                <i class="bi bi-check-circle-fill me-1"></i> In Stock (@Model.Stock units available)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 rounded-pill small">
                                <i class="bi bi-x-circle-fill me-1"></i> Currently Out of Stock
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Delivery Pincode Checker -->
            <div class="card p-3 rounded-3 border bg-white mb-4">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-geo-alt-fill text-success fs-5"></i>
                    <h6 class="fw-bold m-0 text-dark">Check Delivery &amp; Cash on Delivery Availability</h6>
                </div>
                <div class="input-group input-group-sm mb-2" style="max-width: 320px;">
                    <input type="text" id="pincodeInput" class="form-control rounded-start" placeholder="Enter 6-digit PIN code" maxlength="6" />
                    <button class="btn btn-dark rounded-end px-3" type="button" id="checkPinBtn">Check</button>
                </div>
                <div id="pincodeResult" class="small text-muted">Enter PIN code to verify serviceability and estimated delivery date.</div>
            </div>

            <!-- Flipkart-Style Specifications & Highlights -->
            <div class="card p-4 rounded-3 border bg-white mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">Product Specifications &amp; Botanical Pharmacopoeia</h5>

                <!-- Highlights Bullet Points -->
                <div class="mb-4">
                    <h6 class="fw-bold text-dark small text-uppercase text-muted">Key Highlights:</h6>
                    <ul class="text-secondary small ps-3 mb-0">
                        <li class="mb-1"><strong>Classical Tradition:</strong> Formulated using authentic Shastra-mandated Ayurvedic herbs.</li>
                        <li class="mb-1"><strong>Traditionally Used For:</strong> @(string.IsNullOrEmpty(Model.TraditionallyUsedFor) ? "Daily vitality, immunity and dosha equilibrium" : Model.TraditionallyUsedFor)</li>
                        <li class="mb-1"><strong>Dosha Balance:</strong> Tridoshic equilibrium (supports balanced Vata, Pitta, and Kapha).</li>
                        <li class="mb-1"><strong>Purity Assurance:</strong> 100% natural, tested for heavy metals and purity under AYUSH norms.</li>
                        <li><strong>Prescription:</strong> @(Model.IsPrescriptionRequired ? "Doctor Consultation recommended for customized therapy." : "Over the Counter (OTC) wellness formulation.")</li>
                    </ul>
                </div>

                <!-- Specifications Table -->
                <h6 class="fw-bold text-dark small text-uppercase text-muted mb-2">Specifications:</h6>
                <table class="flipkart-spec-table">
                    <tbody>
                        <tr>
                            <th>Brand</th>
                            <td>@Model.Brand</td>
                        </tr>
                        <tr>
                            <th>Model Name</th>
                            <td>@Model.Title</td>
                        </tr>
                        <tr>
                            <th>SKU / Product Code</th>
                            <td>@Model.Sku</td>
                        </tr>
                        <tr>
                            <th>Category</th>
                            <td>@Model.CategoryName @(!string.IsNullOrEmpty(Model.SubcategoryName) ? $"({Model.SubcategoryName})" : "")</td>
                        </tr>
                        <tr>
                            <th>Organic / Natural</th>
                            <td>100% Authentic Herbal Formulation</td>
                        </tr>
                        <tr>
                            <th>Container Type</th>
                            <td>Sealed Pharmaceutical Packaging</td>
                        </tr>
                        <tr>
                            <th>Country of Origin</th>
                            <td>India</td>
                        </tr>
                        <tr>
                            <th>Prescription Required</th>
                            <td>@(Model.IsPrescriptionRequired ? "Yes" : "No")</td>
                        </tr>
                    </tbody>
                </table>

                <!-- Ingredients Section -->
                @if (!string.IsNullOrEmpty(Model.Ingredients))
                {
                    <div class="mt-4 pt-3 border-top">
                        <h6 class="fw-bold text-dark small text-uppercase text-muted mb-2"><i class="bi bi-flower1 text-success me-1"></i> Key Botanical Ingredients:</h6>
                        <p class="text-secondary small leading-relaxed mb-0">@Model.Ingredients</p>
                    </div>
                }

                <!-- Usage & Dosage -->
                @if (!string.IsNullOrEmpty(Model.HowToUse))
                {
                    <div class="mt-4 pt-3 border-top">
                        <h6 class="fw-bold text-dark small text-uppercase text-muted mb-2"><i class="bi bi-clock-history text-success me-1"></i> Dosage &amp; Method of Administration:</h6>
                        <p class="text-secondary small leading-relaxed mb-0">@Model.HowToUse</p>
                    </div>
                }

                <!-- Precautions & Safety Warnings -->
                @if (!string.IsNullOrEmpty(Model.Precautions))
                {
                    <div class="mt-4 pt-3 border-top">
                        <h6 class="fw-bold text-danger small text-uppercase mb-2"><i class="bi bi-exclamation-triangle-fill text-danger me-1"></i> Safety Warnings &amp; Precautions:</h6>
                        <p class="text-secondary small leading-relaxed mb-0">@Model.Precautions</p>
                    </div>
                }

                <!-- AYUSH Health Disclaimer -->
                <div class="mt-4 pt-3 border-top bg-light p-3 rounded-2">
                    <h6 class="fw-bold text-dark small text-uppercase mb-1"><i class="bi bi-shield-check text-success me-1"></i> AYUSH Health Disclaimer</h6>
                    <p class="text-muted small mb-0">Information provided is strictly educational and derived from recognized classical Ayurvedic pharmacopoeia. These classical formulations are not intended to replace personalized clinical diagnosis or prescription. Please consult an AYUSH-licensed Vaidya or healthcare provider for therapeutic advice.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products Grid -->
    @if (Model.RelatedProducts != null && Model.RelatedProducts.Any())
    {
        <div class="mb-5 pt-4 border-top">
            <h4 class="fw-bold mb-4" style="font-family: var(--tga-font-heading);">Similar Authentic Ayurvedic Formulations</h4>
            <div class="row g-3">
                @foreach (var related in Model.RelatedProducts)
                {
                    <div class="col-6 col-md-3">
                        <partial name="_ProductCard" model="related" />
                    </div>
                }
            </div>
        </div>
    }

    <!-- Recently Viewed Products -->
    @if (Model.RecentlyViewed != null && Model.RecentlyViewed.Any())
    {
        <div class="mb-5 pt-4 border-top">
            <h5 class="fw-bold mb-3 text-muted small text-uppercase"><i class="bi bi-clock-history me-1"></i> Recently Viewed Products</h5>
            <div class="row g-3">
                @foreach (var recent in Model.RecentlyViewed)
                {
                    <div class="col-6 col-md-3">
                        <partial name="_ProductCard" model="recent" />
                    </div>
                }
            </div>
        </div>
    }
</div>

<!-- ============================================================== -->
<!-- FULLSCREEN LIGHTBOX MODAL (Flipkart Style with Touch & Zoom)    -->
<!-- ============================================================== -->
<div class="flipkart-lightbox-backdrop" id="imageLightboxModal">
    <div class="flipkart-lightbox-header">
        <span class="fw-bold fs-6" id="lightboxCounter">1 of @allGalleryImages.Count</span>
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-sm btn-outline-light rounded-pill px-3" id="lightboxZoomToggle">
                <i class="bi bi-zoom-in me-1"></i> Zoom
            </button>
            <button type="button" class="btn btn-sm btn-outline-light rounded-circle p-0 d-flex align-items-center justify-content-center" id="lightboxCloseBtn" style="width: 36px; height: 36px;">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <div class="flipkart-lightbox-stage" id="lightboxStage">
        <button type="button" class="flipkart-lightbox-nav-btn flipkart-lightbox-prev" id="lightboxPrevBtn" aria-label="Previous Image">
            <i class="bi bi-chevron-left"></i>
        </button>

        <img id="lightboxMainImg" src="@allGalleryImages[0]" alt="@Model.Title" />

        <button type="button" class="flipkart-lightbox-nav-btn flipkart-lightbox-next" id="lightboxNextBtn" aria-label="Next Image">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>

    <div class="flipkart-lightbox-thumbs" id="lightboxThumbs">
        @for (int i = 0; i < allGalleryImages.Count; i++)
        {
            var imgUrl = allGalleryImages[i];
            <div class="flipkart-lightbox-thumb @(i == 0 ? "active" : "")" data-index="@i" data-img-url="@imgUrl">
                <img src="@imgUrl" alt="Thumb @(i + 1)" onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(allGalleryImages));
        var currentIndex = 0;

        var mainImg = document.getElementById("mainProductImage");
        var mainStage = document.getElementById("mainImageStage");

        // Switch main image and active thumbnail
        function setGalleryImage(index) {
            if (index < 0 || index >= images.length) return;
            currentIndex = index;
            var targetUrl = images[index];

            if (mainImg) {
                mainImg.style.opacity = "0.4";
                mainImg.src = targetUrl;
                mainImg.style.transform = "scale(1)";
                mainImg.style.transformOrigin = "center center";
                setTimeout(function () { mainImg.style.opacity = "1"; }, 150);
            }

            // Update thumb strip
            document.querySelectorAll(".flipkart-thumb-btn").forEach(function (btn, idx) {
                if (idx === index) {
                    btn.classList.add("active");
                } else {
                    btn.classList.remove("active");
                }
            });

            // Update lightbox active thumb & counter
            document.querySelectorAll(".flipkart-lightbox-thumb").forEach(function (btn, idx) {
                if (idx === index) {
                    btn.classList.add("active");
                } else {
                    btn.classList.remove("active");
                }
            });
            var counter = document.getElementById("lightboxCounter");
            if (counter) counter.textContent = (index + 1) + " of " + images.length;
            var lbImg = document.getElementById("lightboxMainImg");
            if (lbImg) lbImg.src = targetUrl;
        }

        // Attach click & hover events to thumbnails
        document.querySelectorAll(".flipkart-thumb-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var idx = parseInt(this.getAttribute("data-index")) || 0;
                setGalleryImage(idx);
            });
            btn.addEventListener("mouseenter", function () {
                var idx = parseInt(this.getAttribute("data-index")) || 0;
                setGalleryImage(idx);
            });
        });

        // -------------------------------------------------------------
        // Contained Smooth Image Hover Zoom (Restricted Strictly to Stage)
        // Never overlaps product details, price, offers, or other sections
        // -------------------------------------------------------------
        if (mainStage && mainImg) {
            var isHovering = false;

            mainStage.addEventListener("mouseenter", function () {
                if (window.innerWidth >= 768) {
                    isHovering = true;
                    mainImg.style.transition = "transform 0.1s ease-out";
                }
            });

            mainStage.addEventListener("mousemove", function (e) {
                if (!isHovering || window.innerWidth < 768) return;

                var rect = mainStage.getBoundingClientRect();
                var x = e.clientX - rect.left;
                var y = e.clientY - rect.top;

                var xPercent = Math.max(0, Math.min(100, (x / rect.width) * 100));
                var yPercent = Math.max(0, Math.min(100, (y / rect.height) * 100));

                mainImg.style.transformOrigin = xPercent + "% " + yPercent + "%";
                mainImg.style.transform = "scale(2.2)";
            });

            mainStage.addEventListener("mouseleave", function () {
                isHovering = false;
                mainImg.style.transition = "transform 0.3s cubic-bezier(0.2, 0.8, 0.4, 1)";
                mainImg.style.transformOrigin = "center center";
                mainImg.style.transform = "scale(1)";
            });
        }

        // -------------------------------------------------------------
        // Fullscreen Lightbox Modal Controls
        // -------------------------------------------------------------
        var modal = document.getElementById("imageLightboxModal");
        var closeBtn = document.getElementById("lightboxCloseBtn");
        var prevBtn = document.getElementById("lightboxPrevBtn");
        var nextBtn = document.getElementById("lightboxNextBtn");
        var zoomToggle = document.getElementById("lightboxZoomToggle");
        var lbImg = document.getElementById("lightboxMainImg");
        var isZoomed = false;

        function openLightbox(idx) {
            setGalleryImage(idx);
            if (modal) modal.classList.add("open");
            document.body.style.overflow = "hidden";
        }

        function closeLightbox() {
            if (modal) modal.classList.remove("open");
            document.body.style.overflow = "";
            if (isZoomed && lbImg) {
                lbImg.style.transform = "scale(1)";
                isZoomed = false;
            }
        }

        if (mainStage) {
            mainStage.addEventListener("click", function () {
                openLightbox(currentIndex);
            });
        }

        if (closeBtn) closeBtn.addEventListener("click", closeLightbox);

        if (prevBtn) {
            prevBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                var newIdx = (currentIndex - 1 + images.length) % images.length;
                setGalleryImage(newIdx);
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener("click", function (e) {
                e.stopPropagation();
                var newIdx = (currentIndex + 1) % images.length;
                setGalleryImage(newIdx);
            });
        }

        document.querySelectorAll(".flipkart-lightbox-thumb").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var idx = parseInt(this.getAttribute("data-index")) || 0;
                setGalleryImage(idx);
            });
        });

        if (zoomToggle && lbImg) {
            zoomToggle.addEventListener("click", function () {
                isZoomed = !isZoomed;
                lbImg.style.transform = isZoomed ? "scale(1.8)" : "scale(1)";
                zoomToggle.innerHTML = isZoomed ? '<i class="bi bi-zoom-out me-1"></i> Reset' : '<i class="bi bi-zoom-in me-1"></i> Zoom';
            });
        }

        // Keyboard navigation (Esc, Left, Right)
        document.addEventListener("keydown", function (e) {
            if (!modal || !modal.classList.contains("open")) return;
            if (e.key === "Escape") closeLightbox();
            if (e.key === "ArrowLeft" && prevBtn) prevBtn.click();
            if (e.key === "ArrowRight" && nextBtn) nextBtn.click();
        });

        // Touch Swipe Navigation for Mobile
        var touchStartX = 0;
        var touchEndX = 0;
        var stage = document.getElementById("lightboxStage");
        if (stage) {
            stage.addEventListener("touchstart", function (e) {
                touchStartX = e.changedTouches[0].screenX;
            }, { passive: true });

            stage.addEventListener("touchend", function (e) {
                touchEndX = e.changedTouches[0].screenX;
                var diff = touchEndX - touchStartX;
                if (Math.abs(diff) > 50) {
                    if (diff < 0 && nextBtn) nextBtn.click();
                    if (diff > 0 && prevBtn) prevBtn.click();
                }
            }, { passive: true });
        }

        // -------------------------------------------------------------
        // Variant picker pill listener
        // -------------------------------------------------------------
        document.querySelectorAll(".variant-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                document.querySelectorAll(".variant-btn").forEach(function (b) { 
                    b.classList.remove("active", "btn-outline-success"); 
                    b.classList.add("btn-outline-secondary"); 
                });
                this.classList.add("active", "btn-outline-success");
                this.classList.remove("btn-outline-secondary");

                var price = this.getAttribute("data-price");
                var mrp = this.getAttribute("data-mrp");
                if (price) {
                    document.getElementById("displayPrice").textContent = "₹" + Number(price).toLocaleString("en-IN");
                }
                if (mrp && document.getElementById("displayMrp")) {
                    document.getElementById("displayMrp").textContent = "₹" + Number(mrp).toLocaleString("en-IN");
                }
            });
        });

        // -------------------------------------------------------------
        // Pincode checker
        // -------------------------------------------------------------
        var checkPinBtn = document.getElementById("checkPinBtn");
        var pinInput = document.getElementById("pincodeInput");
        var pinResult = document.getElementById("pincodeResult");

        if (checkPinBtn && pinInput && pinResult) {
            checkPinBtn.addEventListener("click", function () {
                var pin = pinInput.value.trim();
                if (!pin) {
                    pinResult.innerHTML = '<span class="text-danger">Please enter a 6-digit PIN code.</span>';
                    return;
                }
                pinResult.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Checking delivery...';
                fetch("/Shop/CheckPincode?pincode=" + encodeURIComponent(pin))
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.isServiceable) {
                            pinResult.innerHTML = '<span class="text-success fw-bold"><i class="bi bi-truck me-1"></i> ' + data.message + '</span>';
                        } else {
                            pinResult.innerHTML = '<span class="text-danger">' + data.message + '</span>';
                        }
                    })
                    .catch(function () {
                        pinResult.innerHTML = '<span class="text-danger">Unable to verify PIN code right now.</span>';
                    });
            });
        }

        // -------------------------------------------------------------
        // Share button
        // -------------------------------------------------------------
        var shareBtn = document.getElementById("shareBtn");
        if (shareBtn) {
            shareBtn.addEventListener("click", function () {
                if (navigator.clipboard) {
                    navigator.clipboard.writeText(window.location.href).then(function () {
                        alert("Product link copied to clipboard!");
                    });
                } else {
                    alert("URL: " + window.location.href);
                }
            });
        }
    });

    function incrementQty() {
        var input = document.getElementById("qtyInput");
        var actionQty = document.getElementById("actionQuantityInput");
        if (input) {
            var current = parseInt(input.value) || 1;
            var max = parseInt(input.getAttribute("max")) || 99;
            if (current < max) {
                input.value = current + 1;
                if (actionQty) actionQty.value = current + 1;
            }
        }
    }

    function decrementQty() {
        var input = document.getElementById("qtyInput");
        var actionQty = document.getElementById("actionQuantityInput");
        if (input) {
            var current = parseInt(input.value) || 1;
            if (current > 1) {
                input.value = current - 1;
                if (actionQty) actionQty.value = current - 1;
            }
        }
    }
</script>
}
