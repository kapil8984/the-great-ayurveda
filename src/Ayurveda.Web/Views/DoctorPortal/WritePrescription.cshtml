@model Ayurveda.Application.ViewModels.WritePrescriptionViewModel
@{
    ViewData["Title"] = "Issue Digital Prescription - " + Model.PatientName;
    var products = ViewBag.AvailableProducts as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="container py-4">
    <partial name="_DoctorPortalNav" />

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a asp-action="Appointments" class="btn btn-sm btn-outline-secondary rounded-pill mb-2">
                <i class="bi bi-arrow-left me-1"></i> Back to Appointments
            </a>
            <h3 class="fw-bold mb-0"><i class="bi bi-journal-medical text-success me-2"></i>Digital Ayurvedic Prescription</h3>
            <p class="text-muted mb-0">Record Dosha diagnosis, clinical observations, lifestyle regimen, and prescribed classical formulations.</p>
        </div>
        <div class="text-end">
            <span class="badge bg-success-subtle text-success fs-6 px-3 py-2 rounded-pill border border-success-subtle">
                Appointment #@Model.AppointmentId
            </span>
        </div>
    </div>

    <!-- Patient Dossier Bar -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-light">
        <div class="card-body p-4">
            <div class="row align-items-center g-3">
                <div class="col-md-4">
                    <div class="small text-muted text-uppercase fw-semibold">Patient Name</div>
                    <div class="fs-5 fw-bold text-dark">@Model.PatientName</div>
                </div>
                <div class="col-md-5">
                    <div class="small text-muted text-uppercase fw-semibold">Reported Health Concern</div>
                    <div class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(Model.HealthConcern) ? "General Health & Lifestyle" : Model.HealthConcern)</div>
                </div>
                <div class="col-md-3 text-md-end">
                    @if (!string.IsNullOrEmpty(Model.ReportUrl))
                    {
                        <a href="@Model.ReportUrl" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                            <i class="bi bi-paperclip me-1"></i> View Patient Report
                        </a>
                    }
                    else
                    {
                        <span class="text-muted small"><i class="bi bi-file-earmark-x me-1"></i>No uploaded reports</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <form asp-action="WritePrescriptionPost" method="post" id="prescriptionForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="AppointmentId" />
        <input type="hidden" asp-for="DoctorId" />
        <input type="hidden" asp-for="PrescribedProductsJson" id="prescribedProductsInput" />

        <div class="row g-4">
            <!-- Left Column: Clinical Diagnosis & Lifestyle -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-clipboard2-pulse text-success me-2"></i>1. Clinical Assessment</h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="DoshaDiagnosis" class="form-label fw-semibold">Primary Dosha Imbalance (Vikriti)</label>
                            <select asp-for="DoshaDiagnosis" class="form-select rounded-3">
                                <option value="Vata Prakopa (Aggravated Vata)">Vata Prakopa (Aggravated Vata)</option>
                                <option value="Pitta Prakopa (Aggravated Pitta)">Pitta Prakopa (Aggravated Pitta)</option>
                                <option value="Kapha Prakopa (Aggravated Kapha)">Kapha Prakopa (Aggravated Kapha)</option>
                                <option value="Vata-Pitta Imbalance">Vata-Pitta Imbalance</option>
                                <option value="Pitta-Kapha Imbalance">Pitta-Kapha Imbalance</option>
                                <option value="Kapha-Vata Imbalance">Kapha-Vata Imbalance</option>
                                <option value="Sannipatika (Tridosha Imbalance)" selected>Sannipatika (Tridosha Imbalance)</option>
                                <option value="Agni Mandya (Weak Digestive Fire)">Agni Mandya (Weak Digestive Fire)</option>
                                <option value="Ama Accumulation (Toxins)">Ama Accumulation (Toxins)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ClinicalNotes" class="form-label fw-semibold">Clinical Observations &amp; Nadi Findings</label>
                            <textarea asp-for="ClinicalNotes" rows="4" class="form-control rounded-3" 
                                placeholder="Enter clinical assessment, tongue/pulse examination notes, and symptom root causes..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DietaryAdvice" class="form-label fw-semibold">Pathya &amp; Apathya (Diet &amp; Lifestyle Regimen)</label>
                            <textarea asp-for="DietaryAdvice" rows="4" class="form-control rounded-3" 
                                placeholder="Recommended foods (Pathya), foods to avoid (Apathya), hydration, dinacharya guidelines..."></textarea>
                        </div>

                        <div class="mb-2">
                            <label asp-for="FollowUpDate" class="form-label fw-semibold">Recommended Follow-up Consultation Date</label>
                            <input asp-for="FollowUpDate" type="date" class="form-control rounded-3" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Formulations & Medications -->
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-2">
                        <h5 class="fw-bold text-dark mb-0"><i class="bi bi-capsule text-success me-2"></i>2. Prescribed Classical Formulations</h5>
                        <p class="text-muted small mb-0">Select authenticated Ayurvedic products from the catalog. The patient can order them in 1 click.</p>
                    </div>
                    <div class="card-body p-4">
                        <!-- Add medicine picker -->
                        <div class="p-3 bg-light rounded-4 mb-3 border">
                            <div class="fw-semibold text-dark mb-2 small text-uppercase">Add Formulation to Prescription</div>
                            <div class="row g-2 mb-2">
                                <div class="col-12">
                                    <select id="medicineSelect" class="form-select form-select-sm rounded-3">
                                        <option value="">-- Choose Authentic Product from Store --</option>
                                        @foreach (var prod in products)
                                        {
                                            <option value="@prod.Id" data-name="@prod.Title" data-price="@prod.Price">
                                                @prod.Title (@prod.Brand) - ₹@prod.Price
                                            </option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-7">
                                    <input type="text" id="medicineDosage" class="form-control form-control-sm rounded-3" 
                                           placeholder="Dosage (e.g. 1 tab twice daily after food with warm water)" />
                                </div>
                                <div class="col-md-5">
                                    <input type="text" id="medicineDuration" class="form-control form-control-sm rounded-3" 
                                           placeholder="Duration (e.g. 15 days)" />
                                </div>
                            </div>
                            <button type="button" id="btnAddMedicine" class="btn btn-sm btn-success rounded-pill px-3 w-100">
                                <i class="bi bi-plus-circle me-1"></i> Add to Prescription Table
                            </button>
                        </div>

                        <!-- Prescribed list -->
                        <div class="table-responsive">
                            <table class="table table-sm align-middle" id="rxTable">
                                <thead class="table-light">
                                    <tr>
                                        <th>Formulation</th>
                                        <th>Dosage</th>
                                        <th>Duration</th>
                                        <th class="text-end">Price</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="rxTableBody">
                                    <!-- Rendered dynamically via JS -->
                                </tbody>
                            </table>
                        </div>
                        <div id="noMedsAlert" class="text-center text-muted py-3 small">
                            No formulations added yet. Select a product above to add to this prescription.
                        </div>
                    </div>
                    <div class="card-footer bg-white border-0 p-4 pt-0">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill w-100 shadow">
                            <i class="bi bi-check-circle-fill me-2"></i> Issue Digital Prescription &amp; Complete Consultation
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputHidden = document.getElementById("prescribedProductsInput");
        const tbody = document.getElementById("rxTableBody");
        const noMedsAlert = document.getElementById("noMedsAlert");
        const selectProd = document.getElementById("medicineSelect");
        const inputDosage = document.getElementById("medicineDosage");
        const inputDuration = document.getElementById("medicineDuration");
        const btnAdd = document.getElementById("btnAddMedicine");

        let items = [];
        try {
            if (inputHidden.value && inputHidden.value !== "[]") {
                items = JSON.parse(inputHidden.value);
            }
        } catch(e) {
            items = [];
        }

        function renderTable() {
            tbody.innerHTML = "";
            if (items.length === 0) {
                noMedsAlert.style.display = "block";
            } else {
                noMedsAlert.style.display = "none";
                items.forEach((item, idx) => {
                    const tr = document.createElement("tr");
                    tr.innerHTML = `
                        <td class="fw-semibold text-dark">${escapeHtml(item.productTitle || item.name || "Ayurvedic Formulation")}</td>
                        <td class="small text-muted">${escapeHtml(item.dosage || "As directed")}</td>
                        <td class="small text-muted">${escapeHtml(item.duration || "15 days")}</td>
                        <td class="text-end fw-bold text-success">₹${item.price || 0}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm border-0 py-0 px-2" data-idx="${idx}">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            }
            inputHidden.value = JSON.stringify(items);
        }

        btnAdd.addEventListener("click", function() {
            const selectedOpt = selectProd.options[selectProd.selectedIndex];
            if (!selectProd.value) {
                alert("Please select a product from the list.");
                return;
            }

            const productId = parseInt(selectProd.value);
            const title = selectedOpt.getAttribute("data-name");
            const price = parseFloat(selectedOpt.getAttribute("data-price") || 0);
            const dosage = inputDosage.value.trim() || "1 dose twice daily after meals";
            const duration = inputDuration.value.trim() || "15 days";

            items.push({
                productId: productId,
                productTitle: title,
                dosage: dosage,
                duration: duration,
                price: price
            });

            inputDosage.value = "";
            inputDuration.value = "";
            selectProd.selectedIndex = 0;
            renderTable();
        });

        tbody.addEventListener("click", function(e) {
            const btn = e.target.closest("button");
            if (btn && btn.dataset.idx !== undefined) {
                const idx = parseInt(btn.dataset.idx);
                items.splice(idx, 1);
                renderTable();
            }
        });

        function escapeHtml(str) {
            return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        renderTable();
    });
</script>
}
