@model List<Ayurveda.Application.ViewModels.AppointmentDetailsViewModel>
@{
    ViewData["Title"] = "Physician Portal Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1" style="font-family: Georgia, serif;">Doctor Clinical Portal</h1>
            <p class="text-muted small mb-0">Manage your consultation queue and patient treatment regimens</p>
        </div>
        <div>
            <span class="badge bg-success px-3 py-2 fs-6"><i class="bi bi-circle-fill me-1" style="font-size: 8px;"></i> Accepting Consultations</span>
        </div>
    </div>

    <!-- Stats row -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card p-3 shadow-sm border-0 rounded-3 bg-light">
                <div class="small text-muted">Appointments Queue:</div>
                <div class="fs-3 fw-bold text-success">@(Model?.Count ?? 0)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 shadow-sm border-0 rounded-3 bg-light">
                <div class="small text-muted">Consultation Mode:</div>
                <div class="fs-4 fw-bold text-dark">High-Definition Video</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 shadow-sm border-0 rounded-3 bg-light">
                <div class="small text-muted">Practice Standing:</div>
                <div class="fs-4 fw-bold text-warning"><i class="bi bi-star-fill"></i> Verified AYUSH</div>
            </div>
        </div>
    </div>

    <!-- Appointment Schedule -->
    <div class="card p-4 shadow-sm border-0 rounded-4">
        <h5 class="fw-bold mb-3 border-bottom pb-2">Upcoming Consultations</h5>

        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Patient Name</th>
                            <th>Date & Time</th>
                            <th>Mode</th>
                            <th>Health Goal / Concern</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@appt.PatientName</strong>
                                </td>
                                <td>
                                    <div>@appt.StartUtc.ToString("dd MMM yyyy")</div>
                                    <div class="small text-success fw-semibold">@appt.TimeSlot</div>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">@appt.ConsultationType</span>
                                </td>
                                <td>
                                    <div class="small text-muted text-truncate" style="max-width: 280px;" title="@appt.HealthConcern">
                                        @(string.IsNullOrEmpty(appt.HealthConcern) ? "General holistic intake" : appt.HealthConcern)
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(appt.MeetingRoomUrl))
                                    {
                                        <a href="@appt.MeetingRoomUrl" target="_blank" class="btn btn-tga-gold btn-sm rounded-pill px-3">
                                            <i class="bi bi-camera-video me-1"></i> Start Video Room
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted small mb-0 py-3 text-center">No upcoming appointments in your queue for today.</p>
        }
    </div>
</div>
