@model Ayurveda.Application.ViewModels.DoctorPortalDashboardViewModel
@{
    ViewData["Title"] = "Physician Desk Dashboard";
}

<div class="container py-4">
    <partial name="_DoctorPortalNav" />

    <!-- Top Banner -->
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <h1 class="h3 fw-bold mb-1 text-dark font-serif">Welcome, Dr. @Model.DoctorName</h1>
                <div class="text-muted small">Specialisation: <strong>@Model.SpecializationName</strong> • State AYUSH Council Certified</div>
            </div>

            <div class="d-flex align-items-center gap-3">
                <form asp-action="ToggleOnlineStatus" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.IsOnline ? "btn-success" : "btn-outline-secondary") rounded-pill px-4 btn-sm d-flex align-items-center gap-2 fw-semibold">
                        <span class="spinner-grow spinner-grow-sm @(Model.IsOnline ? "text-light" : "text-secondary")" style="width: 8px; height: 8px;"></span>
                        @(Model.IsOnline ? "Available for Instant Calls (\"Online Now\")" : "Practice Offline (Go Online)")
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- KPI Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 shadow-xs border-0 rounded-4 bg-white h-100">
                <div class="text-xs text-muted text-uppercase fw-semibold mb-1">Today's Schedule</div>
                <div class="fs-2 fw-bold text-success font-serif">@Model.TodayAppointmentsCount</div>
                <div class="text-xs text-muted">Consultations scheduled</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 shadow-xs border-0 rounded-4 bg-white h-100">
                <div class="text-xs text-muted text-uppercase fw-semibold mb-1">Total Completed</div>
                <div class="fs-2 fw-bold text-dark font-serif">@Model.TotalCompletedConsultations</div>
                <div class="text-xs text-muted">Lifetime clinical sessions</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 shadow-xs border-0 rounded-4 bg-white h-100">
                <div class="text-xs text-muted text-uppercase fw-semibold mb-1">Available Net Balance</div>
                <div class="fs-2 fw-bold text-success font-serif">₹@Model.NetAvailableBalance.ToString("N0")</div>
                <div class="text-xs text-muted">Gross: ₹@Model.TotalGrossEarnings.ToString("N0")</div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card p-3 shadow-xs border-0 rounded-4 bg-white h-100">
                <div class="text-xs text-muted text-uppercase fw-semibold mb-1">Physician Rating</div>
                <div class="fs-2 fw-bold text-warning font-serif">★ @Model.Rating.ToString("0.0")</div>
                <div class="text-xs text-muted">(@Model.ReviewCount patient reviews)</div>
            </div>
        </div>
    </div>

    <!-- Today's Schedule -->
    <div class="card p-4 shadow-sm border-0 rounded-4 bg-white mb-4">
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <h5 class="fw-bold mb-0 text-dark font-serif"><i class="bi bi-clock-history text-success me-2"></i> Today's Consultations</h5>
            <a asp-action="Appointments" class="small text-success text-decoration-none fw-semibold">View Full Queue &rarr;</a>
        </div>

        @if (Model.TodaySchedule.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th>Time Slot</th>
                            <th>Patient Name</th>
                            <th>Mode</th>
                            <th>Health Concern</th>
                            <th>Status</th>
                            <th class="text-end">Clinical Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appt in Model.TodaySchedule)
                        {
                            <tr>
                                <td class="fw-bold text-success">@appt.TimeSlot</td>
                                <td><strong>@appt.PatientName</strong></td>
                                <td><span class="badge bg-light text-dark border">@appt.ConsultationType</span></td>
                                <td class="text-truncate" style="max-width: 250px;">@(appt.HealthConcern ?? "General health review")</td>
                                <td>
                                    <span class="badge @(appt.Status == "Confirmed" ? "bg-success" : appt.Status == "Completed" ? "bg-primary" : "bg-secondary")">
                                        @appt.Status
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Doctors" asp-action="Room" asp-route-id="@appt.Id" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs">
                                        <i class="bi bi-camera-video me-1"></i> Video Room
                                    </a>
                                    <a asp-action="WritePrescription" asp-route-id="@appt.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 ms-1">
                                        <i class="bi bi-pencil me-1"></i> Rx
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted small">
                <i class="bi bi-check2-circle text-success fs-3 d-block mb-1"></i>
                No pending consultations scheduled for today. You may review your full appointments queue or adjust availability hours.
            </div>
        }
    </div>

    <!-- Upcoming Consultations Preview -->
    <div class="card p-4 shadow-sm border-0 rounded-4 bg-white">
        <h5 class="fw-bold mb-3 pb-2 border-bottom text-dark font-serif"><i class="bi bi-calendar3 text-success me-2"></i> Upcoming Bookings</h5>

        @if (Model.UpcomingAppointments.Any())
        {
            <div class="row row-cols-1 row-cols-md-3 g-3">
                @foreach (var up in Model.UpcomingAppointments)
                {
                    <div class="col">
                        <div class="p-3 bg-light rounded-3 border h-100 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small text-dark">@up.PatientName</span>
                                <span class="badge bg-success-subtle text-success text-xs">@up.TimeSlot</span>
                            </div>
                            <div class="text-xs text-muted mb-2">@up.StartUtc.AddHours(5.5).ToString("dd MMM yyyy") • @up.ConsultationType</div>
                            <p class="text-xs text-secondary mb-3 text-truncate flex-grow-1">@(up.HealthConcern ?? "General consultation")</p>
                            <a asp-controller="Doctors" asp-action="Room" asp-route-id="@up.Id" class="btn btn-outline-success btn-sm rounded-pill w-100">
                                Open Room
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-3 text-muted small">
                No upcoming consultations currently queued.
            </div>
        }
    </div>
</div>
