@using Microsoft.AspNetCore.Identity
@using Ayurveda.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<div id="tgaSiteHeaderWrapper" class="tga-header-wrapper">
    <!-- 1. Single Slim 32px Top Offers & Coupon Strip -->
    <div class="tga-top-bar" id="tgaTopBar" role="region" aria-label="Festive Offers and Coupons">
        <div class="container h-100 d-flex align-items-center">
            <div class="tga-marquee-track">
                <span class="marquee-item"><i class="bi bi-gift-fill text-warning me-1"></i> <strong>Shubh Festive Sale Live!</strong> Use Code: <span class="badge badge-code" data-copy-coupon="HEALTH15" title="Click to copy coupon">HEALTH15 (15% OFF)</span></span>
                <span class="marquee-item"><i class="bi bi-stars text-warning me-1"></i> <strong>Diwali Ojas Mahotsav:</strong> Flat 30% OFF with code <span class="badge badge-code" data-copy-coupon="DIWALI30" title="Click to copy coupon">DIWALI30</span></span>
                <span class="marquee-item"><i class="bi bi-brightness-alt-high text-warning me-1"></i> <strong>Navratri Sattvic Diet:</strong> 20% OFF with code <span class="badge badge-code" data-copy-coupon="NAVRATRI20" title="Click to copy coupon">NAVRATRI20</span></span>
                <span class="marquee-item"><i class="bi bi-truck text-warning me-1"></i> Complimentary Express Shipping Across India on Orders Above ₹499</span>
                <span class="marquee-item"><i class="bi bi-shield-check text-success me-1"></i> 100% Classical Shastriya Formulations • Authentic Botanicals</span>
                <!-- Duplicate for infinite seamless scroll -->
                <span class="marquee-item"><i class="bi bi-gift-fill text-warning me-1"></i> <strong>Shubh Festive Sale Live!</strong> Use Code: <span class="badge badge-code" data-copy-coupon="HEALTH15" title="Click to copy coupon">HEALTH15 (15% OFF)</span></span>
                <span class="marquee-item"><i class="bi bi-stars text-warning me-1"></i> <strong>Diwali Ojas Mahotsav:</strong> Flat 30% OFF with code <span class="badge badge-code" data-copy-coupon="DIWALI30" title="Click to copy coupon">DIWALI30</span></span>
                <span class="marquee-item"><i class="bi bi-brightness-alt-high text-warning me-1"></i> <strong>Navratri Sattvic Diet:</strong> 20% OFF with code <span class="badge badge-code" data-copy-coupon="NAVRATRI20" title="Click to copy coupon">NAVRATRI20</span></span>
                <span class="marquee-item"><i class="bi bi-truck text-warning me-1"></i> Complimentary Express Shipping Across India on Orders Above ₹499</span>
                <span class="marquee-item"><i class="bi bi-shield-check text-success me-1"></i> 100% Classical Shastriya Formulations • Authentic Botanicals</span>
            </div>
        </div>
    </div>

    <!-- 2. Main Desktop / Mobile Navigation Bar (44px Row 1 + 34px Row 2 = <= 110px Total with Top Bar) -->
    <header class="tga-navbar" id="tgaMainHeader">
        <div class="container">
            <!-- Row 1: [Back button] Brand Logo, Desktop Search, Cart with badge, Hamburger / Account -->
            <div class="tga-header-row-1 d-flex align-items-center justify-content-between gap-2">
                <!-- Left: Back Button & Brand Logo -->
                <div class="d-flex align-items-center flex-shrink-0">
                    <!-- B3: App-like Back Arrow (44px hit area, hidden on Home & root pages unless navigating back) -->
                    <button type="button" class="btn btn-link p-0 text-dark d-none align-items-center justify-content-center me-1 tga-touch-target" id="headerBackBtn" aria-label="Back" style="width: 44px; height: 44px; min-width: 44px; min-height: 44px; text-decoration: none;">
                        <i class="bi bi-arrow-left fs-4"></i>
                    </button>
                    <a asp-controller="Home" asp-action="Index" class="tga-brand d-inline-flex align-items-center" aria-label="The Great Ayurveda Home">
                        <img src="/images/logo-full.svg" alt="The Great Ayurveda" height="38" class="img-fluid tga-header-logo" data-fallback="/images/logo.svg" />
                    </a>
                </div>

                <!-- Wide Search Bar with Suggestions (Desktop only >= 992px) -->
                <div class="flex-grow-1 d-none d-lg-block tga-header-search-wrap px-3">
                    <partial name="_SearchBox" />
                </div>

                <!-- Right Actions -->
                <div class="d-flex align-items-center gap-2 flex-shrink-0">
                    <!-- Compact Consult Doctor Pill (Desktop only >= 992px) -->
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-tga-primary btn-sm rounded-pill px-3 text-nowrap d-none d-lg-inline-flex align-items-center gap-1 shadow-xs fw-semibold tga-btn-consult" style="height: 38px; font-size: 0.85rem;">
                        <i class="bi bi-camera-video"></i>
                        <span>Consult Doctor</span>
                    </a>

                    <!-- Wishlist Icon (Desktop only >= 992px) -->
                    <a asp-controller="Wishlist" asp-action="Index" class="btn btn-light position-relative border rounded-circle d-none d-lg-inline-flex align-items-center justify-content-center p-0 text-muted tga-icon-btn" style="width: 40px; height: 40px; min-width: 40px; min-height: 40px;" title="Saved Formulations" aria-label="Saved Formulations">
                        <i class="bi bi-heart text-danger" style="font-size: 1rem;"></i>
                    </a>

                    <!-- Cart Button with Live Badge (All breakpoints) -->
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-light position-relative border rounded-circle d-inline-flex align-items-center justify-content-center p-0 tga-icon-btn tga-touch-target" style="width: 44px; height: 44px; min-width: 44px; min-height: 44px;" title="Shopping Cart" aria-label="Shopping Cart">
                        <i class="bi bi-bag text-success" style="font-size: 1.1rem;"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" id="cartCountBadge" style="font-size: 0.7rem; padding: 0.25em 0.5em;">
                            @(ViewBag.CartCount ?? 0)
                        </span>
                    </a>

                    <!-- User Account / Dropdown (Desktop >= 992px) -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown d-none d-lg-block">
                            <button class="btn btn-light border rounded-pill px-2 py-0 dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="height: 40px; font-size: 0.85rem;">
                                <i class="bi bi-person-circle fs-5 text-success"></i>
                                <span class="small fw-semibold d-none d-xl-inline text-truncate" style="max-width: 100px;">@User.Identity?.Name?.Split('@')[0]</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 mt-2">
                                <li><h6 class="dropdown-header">Ayurvedic Patient Profile</h6></li>
                                <li><a class="dropdown-item py-2 @(currentCtrl == "Account" && currentAct == "Profile" ? "active bg-light text-dark fw-bold" : "")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-success"></i> Profile &amp; Addresses</a></li>
                                <li><a class="dropdown-item py-2 @(currentCtrl == "Orders" ? "active bg-light text-dark fw-bold" : "")" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2 text-success"></i> My Orders</a></li>
                                <li><a class="dropdown-item py-2 @(currentCtrl == "Doctors" && currentAct == "MyAppointments" ? "active bg-light text-dark fw-bold" : "")" asp-controller="Doctors" asp-action="MyAppointments"><i class="bi bi-calendar2-check me-2 text-success"></i> Video Consultations</a></li>
                                @if (User.IsInRole("Doctor"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-primary @(currentCtrl == "DoctorPortal" ? "active fw-bold" : "")" asp-controller="DoctorPortal" asp-action="Dashboard"><i class="bi bi-hospital me-2"></i> Doctor Clinical Desk</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item py-2 text-danger" data-tga-logout data-action-url="/Account/Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-none d-lg-flex align-items-center gap-1">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm px-3 rounded-pill text-nowrap" style="height: 38px; line-height: 24px; font-size: 0.85rem;">
                                Sign In
                            </a>
                            <div class="dropdown d-inline-block">
                                <button class="btn btn-tga-gold btn-sm px-3 rounded-pill text-dark fw-bold shadow-xs text-nowrap dropdown-toggle" type="button" id="headerRegisterDropdown" data-bs-toggle="dropdown" aria-expanded="false" style="height: 38px; line-height: 24px; font-size: 0.85rem;">
                                    Register
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 p-2 mt-2" aria-labelledby="headerRegisterDropdown" style="min-width: 250px;">
                                    <li>
                                        <a class="dropdown-item p-2 rounded-3 d-flex align-items-center gap-2" asp-controller="Account" asp-action="Register">
                                            <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; min-width: 36px;">
                                                <i class="bi bi-person-heart fs-5"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark small">Register as a Customer</div>
                                                <div class="text-muted text-xs">Explore herbs &amp; consultations</div>
                                            </div>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider my-1"></li>
                                    <li>
                                        <a class="dropdown-item p-2 rounded-3 d-flex align-items-center gap-2" href="/doctor/register">
                                            <div class="rounded-circle bg-teal bg-opacity-10 p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px; min-width: 36px; background-color: rgba(13, 148, 136, 0.12); color: #0d9488;">
                                                <i class="bi bi-hospital fs-5"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark small">Register as a Doctor</div>
                                                <div class="text-muted text-xs">Join verified Vaidya clinical desk</div>
                                            </div>
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }

                    <!-- Mobile Hamburger Toggle (< 992px) -->
                    <button class="btn btn-light d-lg-none border rounded-circle d-inline-flex align-items-center justify-content-center p-0 tga-touch-target" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenuDrawer" aria-controls="mobileMenuDrawer" style="width: 44px; height: 44px; min-width: 44px; min-height: 44px;" aria-label="Open menu">
                        <i class="bi bi-list fs-4 text-dark"></i>
                    </button>
                </div>
            </div>

            <!-- Row 2 on Phones & Small Tablets (< 992px): ONE full-width search bar -->
            <div class="d-lg-none pt-1 pb-2 tga-mobile-search-wrap">
                <partial name="_SearchBox" />
            </div>

            <!-- Row 2: Nav Tabs (Home, Products...) - Desktop Only (>= 992px) -->
            <nav class="d-none d-lg-flex align-items-center justify-content-between tga-header-nav-row text-nowrap" aria-label="Main Navigation">
                <ul class="nav align-items-center mb-0 tga-nav-list flex-nowrap">
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    </li>

                    <!-- Shop by Concern Dropdown with Popper Fixed Strategy (B2) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link tga-nav-link dropdown-toggle @(currentCtrl == "Shop" && !string.IsNullOrEmpty(Context.Request.Query["concern"]) ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                            <i class="bi bi-heart-pulse me-1"></i> Shop by Concern
                        </a>
                        <ul class="dropdown-menu shadow border-0 rounded-4 mt-1">
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Digestion"><i class="bi bi-fire text-warning me-2"></i> Digestion &amp; Gut Agni</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Stress"><i class="bi bi-moon-stars text-primary me-2"></i> Stress, Anxiety &amp; Sleep</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Immunity"><i class="bi bi-shield-plus text-success me-2"></i> Immunity &amp; Rasayana</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Joints"><i class="bi bi-activity text-danger me-2"></i> Joint &amp; Muscle Mobility</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Hair"><i class="bi bi-flower1 text-info me-2"></i> Hair Vitality &amp; Scalp</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Skin"><i class="bi bi-brightness-high text-warning me-2"></i> Skin Glow &amp; Detox</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Metabolism"><i class="bi bi-speedometer text-secondary me-2"></i> Healthy Metabolism</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Womens"><i class="bi bi-gender-female text-danger me-2"></i> Women's Hormonal Care</a></li>
                        </ul>
                    </li>

                    <!-- All Medicines -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Shop" && string.IsNullOrEmpty(Context.Request.Query["concern"]) ? "active" : "")" asp-controller="Shop" asp-action="Index">
                            <i class="bi bi-capsule me-1"></i> All Medicines
                        </a>
                    </li>

                    <!-- Doctor Consultations -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Doctors" ? "active" : "")" asp-controller="Doctors" asp-action="Index">
                            <i class="bi bi-camera-video me-1"></i> Consult Doctors
                        </a>
                    </li>

                    <!-- Yoga & Asanas -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Yoga" ? "active" : "")" asp-controller="Yoga" asp-action="Index">
                            <i class="bi bi-person-standing me-1"></i> Yoga &amp; Wellness
                        </a>
                    </li>

                    <!-- Ayurveda Wisdom / Dinacharya -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" href="/#dinacharya">
                            <i class="bi bi-clock-history me-1"></i> Dinacharya Routine
                        </a>
                    </li>

                    <!-- More Dropdown with Popper Fixed Strategy (B2) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link tga-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false">
                            <i class="bi bi-grid me-1"></i> More
                        </a>
                        <ul class="dropdown-menu shadow border-0 rounded-4 mt-1">
                            <li>
                                <a class="dropdown-item py-2 text-success fw-bold" href="/#prakritiQuizSection">
                                    <i class="bi bi-patch-question me-2"></i> Prakriti Dosha Quiz
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/Home/About">
                                    <i class="bi bi-shield-check me-2 text-success"></i> Authentic Ayurvedic Heritage
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/Home/Contact">
                                    <i class="bi bi-telephone me-2 text-primary"></i> 24x7 Vaidya Helpline
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>
    </header>
</div>

<!-- 4. Mobile Offcanvas Navigation Drawer with Accordions -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenuDrawer" aria-labelledby="mobileMenuDrawerLabel">
    <div class="offcanvas-header border-bottom py-2">
        <a asp-controller="Home" asp-action="Index" class="tga-brand d-inline-flex align-items-center">
            <img src="/images/logo-full.svg" alt="The Great Ayurveda" height="34" class="img-fluid" data-fallback="/images/logo.svg" />
        </a>
        <button type="button" class="btn-close tga-touch-target" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-3">
        <!-- User Status on Mobile -->
        <div class="p-3 bg-light rounded-4 mb-3">
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-muted">Signed in as</div>
                        <div class="fw-bold text-dark text-truncate" style="max-width: 160px;">@User.Identity?.Name</div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1" data-tga-logout data-action-url="/Account/Logout" style="min-height: 44px;">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm rounded-pill flex-fill d-inline-flex align-items-center justify-content-center" style="min-height: 44px;">Sign In</a>
                        <button class="btn btn-tga-gold btn-sm rounded-pill text-dark fw-bold flex-fill d-inline-flex align-items-center justify-content-center dropdown-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mobileRegisterChoice" aria-expanded="false" style="min-height: 44px;">
                            Register
                        </button>
                    </div>
                    <div class="collapse" id="mobileRegisterChoice">
                        <div class="bg-white border rounded-3 p-2 d-flex flex-column gap-2 shadow-xs mt-1">
                            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-success btn-sm rounded-pill w-100 text-start px-3 py-2 d-flex align-items-center gap-2">
                                <i class="bi bi-person-heart text-success fs-5"></i>
                                <div>
                                    <div class="fw-bold text-dark">Register as a Customer</div>
                                    <div class="text-xs text-muted">Shop herbal remedies &amp; book doctors</div>
                                </div>
                            </a>
                            <a href="/doctor/register" class="btn btn-outline-secondary btn-sm rounded-pill w-100 text-start px-3 py-2 d-flex align-items-center gap-2" style="border-color: #0d9488;">
                                <i class="bi bi-hospital fs-5" style="color: #0d9488;"></i>
                                <div>
                                    <div class="fw-bold text-dark">Register as a Doctor</div>
                                    <div class="text-xs text-muted">Join certified Vaidya panel</div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Quick Consult Doctor CTA in Drawer -->
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-tga-primary rounded-pill w-100 mb-3 fw-semibold d-flex align-items-center justify-content-center gap-2" style="min-height: 44px;">
            <i class="bi bi-camera-video"></i> Consult Ayurvedic Doctor
        </a>

        <!-- Main Navigation Links -->
        <div class="list-group list-group-flush mb-3">
            <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center border-0 rounded-3 mb-1 @(currentCtrl == "Home" && currentAct == "Index" ? "active bg-light text-success fw-bold" : "")" style="min-height: 44px;">
                <i class="bi bi-house me-3 fs-5"></i> Home
            </a>
            <a asp-controller="Shop" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center border-0 rounded-3 mb-1 @(currentCtrl == "Shop" && string.IsNullOrEmpty(Context.Request.Query["concern"]) ? "active bg-light text-success fw-bold" : "")" style="min-height: 44px;">
                <i class="bi bi-capsule me-3 fs-5"></i> All Medicines &amp; Herbs
            </a>
            <a asp-controller="Doctors" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center border-0 rounded-3 mb-1 @(currentCtrl == "Doctors" ? "active bg-light text-success fw-bold" : "")" style="min-height: 44px;">
                <i class="bi bi-camera-video me-3 fs-5"></i> Doctor Consultations
            </a>
            <a asp-controller="Yoga" asp-action="Index" class="list-group-item list-group-item-action d-flex align-items-center border-0 rounded-3 mb-1 @(currentCtrl == "Yoga" ? "active bg-light text-success fw-bold" : "")" style="min-height: 44px;">
                <i class="bi bi-person-standing me-3 fs-5"></i> Yoga &amp; Wellness
            </a>
            <a href="/#dinacharya" class="list-group-item list-group-item-action d-flex align-items-center border-0 rounded-3 mb-1" style="min-height: 44px;">
                <i class="bi bi-clock-history me-3 fs-5"></i> Dinacharya Routine
            </a>
        </div>

        <!-- Accordion Sub-Menus in Drawer -->
        <div class="accordion accordion-flush mb-3" id="mobileDrawerAccordion">
            <!-- Shop by Concern Accordion -->
            <div class="accordion-item border-0">
                <h2 class="accordion-header" id="headingConcern">
                    <button class="accordion-button collapsed px-3 py-2 rounded-3 text-dark fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#collapseConcern" aria-expanded="false" aria-controls="collapseConcern" style="min-height: 44px;">
                        <i class="bi bi-heart-pulse text-danger me-2"></i> Shop by Concern
                    </button>
                </h2>
                <div id="collapseConcern" class="accordion-collapse collapse" aria-labelledby="headingConcern" data-bs-parent="#mobileDrawerAccordion">
                    <div class="accordion-body px-2 py-2">
                        <div class="d-flex flex-column gap-1">
                            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Digestion" class="d-flex align-items-center p-2 rounded text-decoration-none text-dark hover-bg-light" style="min-height: 44px;">
                                <i class="bi bi-fire text-warning me-2"></i> Digestion &amp; Gut Agni
                            </a>
                            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Stress" class="d-flex align-items-center p-2 rounded text-decoration-none text-dark hover-bg-light" style="min-height: 44px;">
                                <i class="bi bi-moon-stars text-primary me-2"></i> Stress, Anxiety &amp; Sleep
                            </a>
                            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Immunity" class="d-flex align-items-center p-2 rounded text-decoration-none text-dark hover-bg-light" style="min-height: 44px;">
                                <i class="bi bi-shield-plus text-success me-2"></i> Immunity &amp; Rasayana
                            </a>
                            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Joints" class="d-flex align-items-center p-2 rounded text-decoration-none text-dark hover-bg-light" style="min-height: 44px;">
                                <i class="bi bi-activity text-danger me-2"></i> Joint &amp; Muscle Mobility
                            </a>
                            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Hair" class="d-flex align-items-center p-2 rounded text-decoration-none text-dark hover-bg-light" style="min-height: 44px;">
                                <i class="bi bi-flower1 text-info me-2"></i> Hair Vitality &amp; Scalp
                            </a>
                            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Skin" class="d-flex align-items-center p-2 rounded text-decoration-none text-dark hover-bg-light" style="min-height: 44px;">
                                <i class="bi bi-brightness-high text-warning me-2"></i> Skin Glow &amp; Detox
                            </a>
