@using Microsoft.AspNetCore.Identity
@using Ayurveda.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<div id="tgaSiteHeaderWrapper" class="tga-header-wrapper">
    <!-- 1. Single Slim 32px Top Offers & Coupon Strip -->
    <div class="tga-top-bar" id="tgaTopBar" role="region" aria-label="Festive Offers and Coupons">
        <div class="container h-100 d-flex align-items-center">
            <div class="tga-marquee-track">
                <span class="marquee-item"><i class="bi bi-gift-fill text-warning me-1"></i> <strong>Shubh Festive Sale Live!</strong> Use Code: <span class="badge badge-code" data-copy-coupon="HEALTH15" title="Click to copy coupon">HEALTH15 (15% OFF)</span></span>
                <span class="marquee-item"><i class="bi bi-stars text-warning me-1"></i> <strong>Diwali Ojas Mahotsav:</strong> Flat 30% OFF with code <span class="badge badge-code" data-copy-coupon="DIWALI30" title="Click to copy coupon">DIWALI30</span></span>
                <span class="marquee-item"><i class="bi bi-brightness-alt-high text-warning me-1"></i> <strong>Navratri Sattvic Diet:</strong> 20% OFF with code <span class="badge badge-code" data-copy-coupon="NAVRATRI20" title="Click to copy coupon">NAVRATRI20</span></span>
                <span class="marquee-item"><i class="bi bi-truck text-warning me-1"></i> Complimentary Express Shipping Across India on Orders Above ₹499</span>
                <span class="marquee-item"><i class="bi bi-shield-check text-success me-1"></i> 100% Classical Shastriya Formulations • Authentic Botanicals</span>
                <!-- Duplicate for infinite seamless scroll -->
                <span class="marquee-item"><i class="bi bi-gift-fill text-warning me-1"></i> <strong>Shubh Festive Sale Live!</strong> Use Code: <span class="badge badge-code" data-copy-coupon="HEALTH15" title="Click to copy coupon">HEALTH15 (15% OFF)</span></span>
                <span class="marquee-item"><i class="bi bi-stars text-warning me-1"></i> <strong>Diwali Ojas Mahotsav:</strong> Flat 30% OFF with code <span class="badge badge-code" data-copy-coupon="DIWALI30" title="Click to copy coupon">DIWALI30</span></span>
                <span class="marquee-item"><i class="bi bi-brightness-alt-high text-warning me-1"></i> <strong>Navratri Sattvic Diet:</strong> 20% OFF with code <span class="badge badge-code" data-copy-coupon="NAVRATRI20" title="Click to copy coupon">NAVRATRI20</span></span>
                <span class="marquee-item"><i class="bi bi-truck text-warning me-1"></i> Complimentary Express Shipping Across India on Orders Above ₹499</span>
                <span class="marquee-item"><i class="bi bi-shield-check text-success me-1"></i> 100% Classical Shastriya Formulations • Authentic Botanicals</span>
            </div>
        </div>
    </div>

    <!-- 2. Main Desktop / Mobile Navigation Bar (44px Row 1 + 34px Row 2 = <= 110px Total with Top Bar) -->
    <header class="tga-navbar" id="tgaMainHeader">
        <div class="container">
            <!-- Row 1: Brand Logo, Wide Search, Consult Doctor Pill, Wishlist, Cart, Account -->
            <div class="tga-header-row-1 d-flex align-items-center justify-content-between gap-3">
                <!-- Small Logo (~38-42px tall) -->
                <div class="flex-shrink-0 d-flex align-items-center">
                    <a asp-controller="Home" asp-action="Index" class="tga-brand d-inline-flex align-items-center" aria-label="The Great Ayurveda Home">
                        <img src="/images/logo-full.svg" alt="The Great Ayurveda" height="38" class="img-fluid tga-header-logo" onerror="this.onerror=null;this.src='/images/logo.svg';" />
                    </a>
                </div>

                <!-- Wide Search Bar with Suggestions -->
                <div class="flex-grow-1 d-none d-md-block tga-header-search-wrap">
                    <partial name="_SearchBox" />
                </div>

                <!-- Right Actions: Consult Doctor Pill, Wishlist, Cart, Account, Mobile Drawer Toggle -->
                <div class="d-flex align-items-center gap-2 gap-lg-2 flex-shrink-0">
                    <!-- Compact Consult Doctor Pill -->
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-tga-primary btn-sm rounded-pill px-3 text-nowrap d-none d-sm-inline-flex align-items-center gap-1 shadow-xs fw-semibold tga-btn-consult" style="height: 32px; font-size: 0.82rem;">
                        <i class="bi bi-camera-video"></i>
                        <span>Consult Doctor</span>
                    </a>

                    <!-- Wishlist Icon -->
                    <a asp-controller="Wishlist" asp-action="Index" class="btn btn-light position-relative border rounded-pill d-inline-flex align-items-center justify-content-center p-0 text-muted tga-icon-btn" style="width: 34px; height: 34px;" title="Saved Formulations">
                        <i class="bi bi-heart text-danger" style="font-size: 0.95rem;"></i>
                    </a>

                    <!-- Cart Button with Live Badge -->
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-light position-relative border rounded-pill d-inline-flex align-items-center justify-content-center p-0 tga-icon-btn" style="width: 34px; height: 34px;" title="Shopping Cart">
                        <i class="bi bi-bag text-success" style="font-size: 0.95rem;"></i>
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" id="cartCountBadge" style="font-size: 0.65rem; padding: 0.25em 0.45em;">
                            @(ViewBag.CartCount ?? 0)
                        </span>
                    </a>

                    <!-- User Account / Dropdown -->
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <div class="dropdown">
                            <button class="btn btn-light border rounded-pill px-2 py-0 dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="height: 34px; font-size: 0.82rem;">
                                <i class="bi bi-person-circle fs-6 text-success"></i>
                                <span class="small fw-semibold d-none d-md-inline text-truncate" style="max-width: 100px;">@User.Identity?.Name?.Split('@')[0]</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 mt-2">
                                <li><h6 class="dropdown-header">Ayurvedic Patient Profile</h6></li>
                                <li><a class="dropdown-item py-2 @(currentCtrl == "Account" && currentAct == "Profile" ? "active bg-light text-dark fw-bold" : "")" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2 text-success"></i> Profile &amp; Addresses</a></li>
                                <li><a class="dropdown-item py-2 @(currentCtrl == "Orders" ? "active bg-light text-dark fw-bold" : "")" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2 text-success"></i> My Orders</a></li>
                                <li><a class="dropdown-item py-2 @(currentCtrl == "Doctors" && currentAct == "MyAppointments" ? "active bg-light text-dark fw-bold" : "")" asp-controller="Doctors" asp-action="MyAppointments"><i class="bi bi-calendar2-check me-2 text-success"></i> Video Consultations</a></li>
                                @if (User.IsInRole("Doctor"))
                                {
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item py-2 text-primary @(currentCtrl == "DoctorPortal" ? "active fw-bold" : "")" asp-controller="DoctorPortal" asp-action="Dashboard"><i class="bi bi-hospital me-2"></i> Doctor Clinical Desk</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button type="button" class="dropdown-item py-2 text-danger" data-tga-logout data-action-url="/Account/Logout">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-none d-md-flex align-items-center gap-1">
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm px-2 rounded-pill text-nowrap" style="height: 32px; line-height: 18px; font-size: 0.8rem;">
                                Sign In
                            </a>
                            <a asp-controller="Account" asp-action="Register" class="btn btn-tga-gold btn-sm px-2 rounded-pill text-dark fw-bold shadow-xs text-nowrap" style="height: 32px; line-height: 18px; font-size: 0.8rem;">
                                Register
                            </a>
                        </div>
                    }

                    <!-- Mobile Hamburger Toggle -->
                    <button class="btn btn-light d-lg-none border rounded-pill d-inline-flex align-items-center justify-content-center p-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenuDrawer" aria-controls="mobileMenuDrawer" style="width: 34px; height: 34px;" aria-label="Open menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                </div>
            </div>

            <!-- Mobile Search Bar (Only visible on small viewports) -->
            <div class="d-md-none py-1 tga-mobile-search">
                <partial name="_SearchBox" />
            </div>

            <!-- Row 2: Thin Nav (34px) - GUARANTEED single line with NO wrapping -->
            <nav class="d-none d-lg-flex align-items-center justify-content-between tga-header-nav-row" aria-label="Main Navigation">
                <ul class="nav align-items-center mb-0 tga-nav-list">
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Home" && currentAct == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    </li>

                    <!-- Shop by Concern Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link tga-nav-link dropdown-toggle @(currentCtrl == "Shop" && !string.IsNullOrEmpty(Context.Request.Query["concern"]) ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-heart-pulse me-1"></i> Shop by Concern
                        </a>
                        <ul class="dropdown-menu shadow border-0 rounded-4 mt-1">
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Digestion"><i class="bi bi-fire text-warning me-2"></i> Digestion &amp; Gut Agni</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Stress"><i class="bi bi-moon-stars text-primary me-2"></i> Stress, Anxiety &amp; Sleep</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Immunity"><i class="bi bi-shield-plus text-success me-2"></i> Immunity &amp; Rasayana</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Joints"><i class="bi bi-activity text-danger me-2"></i> Joint &amp; Muscle Mobility</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Hair"><i class="bi bi-flower1 text-info me-2"></i> Hair Vitality &amp; Scalp</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Skin"><i class="bi bi-brightness-high text-warning me-2"></i> Skin Glow &amp; Detox</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Metabolism"><i class="bi bi-speedometer text-secondary me-2"></i> Healthy Metabolism</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Womens"><i class="bi bi-gender-female text-danger me-2"></i> Women's Hormonal Care</a></li>
                        </ul>
                    </li>

                    <!-- All Medicines -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Shop" && string.IsNullOrEmpty(Context.Request.Query["concern"]) ? "active" : "")" asp-controller="Shop" asp-action="Index">
                            <i class="bi bi-capsule me-1"></i> All Medicines
                        </a>
                    </li>

                    <!-- Doctor Consultations -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Doctors" ? "active" : "")" asp-controller="Doctors" asp-action="Index">
                            <i class="bi bi-camera-video me-1"></i> Consult Doctors
                        </a>
                    </li>

                    <!-- Yoga & Asanas -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link @(currentCtrl == "Yoga" ? "active" : "")" asp-controller="Yoga" asp-action="Index">
                            <i class="bi bi-person-standing me-1"></i> Yoga &amp; Wellness
                        </a>
                    </li>

                    <!-- Ayurveda Wisdom / Dinacharya -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" href="/#dinacharya">
                            <i class="bi bi-clock-history me-1"></i> Dinacharya Routine
                        </a>
                    </li>

                    <!-- More Dropdown (Keeps Row 2 to a Single Non-Wrapping Line) -->
                    <li class="nav-item dropdown">
                        <a class="nav-link tga-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-grid me-1"></i> More
                        </a>
                        <ul class="dropdown-menu shadow border-0 rounded-4 mt-1">
                            <li>
                                <a class="dropdown-item py-2 text-success fw-bold" href="/#prakritiQuizSection">
                                    <i class="bi bi-patch-question me-2"></i> Prakriti Dosha Quiz
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/Home/About">
                                    <i class="bi bi-shield-check me-2 text-success"></i> Authentic Ayurvedic Heritage
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="/Home/Contact">
                                    <i class="bi bi-telephone me-2 text-primary"></i> 24x7 Vaidya Helpline
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </nav>
        </div>
    </header>
</div>

<!-- 3. Mobile Offcanvas Navigation Drawer -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenuDrawer" aria-labelledby="mobileMenuDrawerLabel">
    <div class="offcanvas-header border-bottom py-2">
        <a asp-controller="Home" asp-action="Index" class="tga-brand d-inline-flex align-items-center">
            <img src="/images/logo-full.svg" alt="The Great Ayurveda" height="34" class="img-fluid" onerror="this.onerror=null;this.src='/images/logo.svg';" />
        </a>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body p-3">
        <!-- User Status on Mobile -->
        <div class="p-3 bg-light rounded-4 mb-3">
            @if (SignInManager.IsSignedIn(User))
            {
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="small text-muted">Signed in as</div>
                        <div class="fw-bold text-dark text-truncate" style="max-width: 170px;">@User.Identity?.Name</div>
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1" data-tga-logout data-action-url="/Account/Logout">
                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                    </button>
                </div>
            }
            else
            {
                <div class="d-flex gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm rounded-pill flex-fill">Sign In</a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-tga-gold btn-sm rounded-pill text-dark fw-bold flex-fill">Register</a>
                </div>
            }
        </div>

        <!-- Quick Consult Doctor CTA in Drawer -->
        <a asp-controller="Doctors" asp-action="Index" class="btn btn-tga-primary rounded-pill w-100 mb-3 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-camera-video"></i> Consult Ayurvedic Doctor
        </a>

        <!-- Navigation Links -->
        <div class="list-group list-group-flush mb-4">
            <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action py-2 border-0 rounded-3 mb-1 @(currentCtrl == "Home" && currentAct == "Index" ? "active bg-light text-success fw-bold" : "")">
                <i class="bi bi-house me-2"></i> Home
            </a>
            <a asp-controller="Shop" asp-action="Index" class="list-group-item list-group-item-action py-2 border-0 rounded-3 mb-1 @(currentCtrl == "Shop" ? "active bg-light text-success fw-bold" : "")">
                <i class="bi bi-capsule me-2"></i> All Medicines &amp; Herbs
            </a>
            <a asp-controller="Doctors" asp-action="Index" class="list-group-item list-group-item-action py-2 border-0 rounded-3 mb-1 @(currentCtrl == "Doctors" ? "active bg-light text-success fw-bold" : "")">
                <i class="bi bi-camera-video me-2"></i> Doctor Consultations
            </a>
            <a asp-controller="Yoga" asp-action="Index" class="list-group-item list-group-item-action py-2 border-0 rounded-3 mb-1 @(currentCtrl == "Yoga" ? "active bg-light text-success fw-bold" : "")">
                <i class="bi bi-person-standing me-2"></i> Yoga &amp; Wellness
            </a>
            <a href="/#dinacharya" class="list-group-item list-group-item-action py-2 border-0 rounded-3 mb-1">
                <i class="bi bi-clock-history me-2"></i> Dinacharya Routine
            </a>
            <a href="/#prakritiQuizSection" class="list-group-item list-group-item-action py-2 border-0 rounded-3 mb-1 text-success fw-bold">
                <i class="bi bi-patch-question me-2"></i> Take Prakriti Quiz
            </a>
        </div>

        <!-- Categories & Concerns in Drawer -->
        <h6 class="text-uppercase text-muted fw-bold small mb-2 px-1">Shop by Health Concern</h6>
        <div class="d-flex flex-wrap gap-1 mb-4">
            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Digestion" class="badge bg-light text-dark border p-2 text-decoration-none rounded-pill">Digestion</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Stress" class="badge bg-light text-dark border p-2 text-decoration-none rounded-pill">Sleep &amp; Stress</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Immunity" class="badge bg-light text-dark border p-2 text-decoration-none rounded-pill">Immunity</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Joints" class="badge bg-light text-dark border p-2 text-decoration-none rounded-pill">Joint Pain</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Hair" class="badge bg-light text-dark border p-2 text-decoration-none rounded-pill">Hair Care</a>
            <a asp-controller="Shop" asp-action="Index" asp-route-concern="Skin" class="badge bg-light text-dark border p-2 text-decoration-none rounded-pill">Skin Glow</a>
        </div>
    </div>
</div>
