@using Microsoft.AspNetCore.Identity
@using Ayurveda.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!-- 1. Announcement Top Banner with Click-to-Copy Coupon -->
<div class="announcement-bar text-center">
    <div class="container d-flex flex-wrap justify-content-between align-items-center py-1">
        <span class="d-none d-md-inline">
            <i class="bi bi-shield-check me-1 text-warning"></i> 100% Classical Shastriya Formulations
        </span>
        <span class="d-flex align-items-center gap-2 mx-auto mx-md-0">
            <i class="bi bi-truck text-warning"></i> Free Express Shipping on orders &gt; ₹499
            <span class="badge badge-code rounded-pill px-2 py-1" data-copy-coupon="AYUSH15" title="Click to copy coupon code">
                Use Code: AYUSH15 (15% OFF)
            </span>
        </span>
        <span class="d-none d-lg-inline">
            <i class="bi bi-person-check me-1 text-warning"></i> Verified BAMS/MD AYUSH Doctors
        </span>
    </div>
</div>

<!-- 2. Sticky Glass Main Navigation -->
<header class="sticky-top tga-navbar" id="tgaMainHeader">
    <div class="container py-2">
        <div class="row align-items-center g-2 g-md-3">
            <!-- Brand Logo -->
            <div class="col-6 col-lg-3">
                <a asp-controller="Home" asp-action="Index" class="tga-brand">
                    <img src="/images/logo-full.svg" alt="The Great Ayurveda" height="42" class="img-fluid" />
                </a>
            </div>

            <!-- Smart Search Bar -->
            <div class="col-12 col-lg-5 order-3 order-lg-2">
                <partial name="_SearchBox" />
            </div>

            <!-- Quick Actions: Consult CTA, Wishlist, Cart, Account -->
            <div class="col-6 col-lg-4 order-2 order-lg-3 d-flex justify-content-end align-items-center gap-2 gap-md-3">
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-tga-primary btn-sm rounded-pill d-none d-xl-inline-flex align-items-center gap-1 shadow-sm">
                    <i class="bi bi-camera-video"></i> Consult Doctor
                </a>

                <!-- Wishlist -->
                <a asp-controller="Wishlist" asp-action="Index" class="btn btn-light position-relative border rounded-pill p-2 px-3 text-muted" title="Saved Formulations">
                    <i class="bi bi-heart text-danger"></i>
                </a>

                <!-- Live Cart -->
                <a asp-controller="Cart" asp-action="Index" class="btn btn-light position-relative border rounded-pill p-2 px-3" title="Shopping Cart">
                    <i class="bi bi-bag fs-6 text-success"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" id="cartCountBadge">
                        @(ViewBag.CartCount ?? 0)
                    </span>
                </a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="dropdown">
                        <button class="btn btn-light border rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5 text-success"></i>
                            <span class="small fw-semibold d-none d-md-inline">@User.Identity?.Name?.Split('@')[0]</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><h6 class="dropdown-header">Ayurvedic Patient Profile</h6></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> Profile &amp; Addresses</a></li>
                            <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2"></i> Order Tracking</a></li>
                            <li><a class="dropdown-item" asp-controller="Doctors" asp-action="MyAppointments"><i class="bi bi-calendar2-check me-2"></i> Video Consultations</a></li>
                            @if (User.IsInRole("Doctor"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-primary" asp-controller="DoctorPortal" asp-action="Dashboard"><i class="bi bi-hospital me-2"></i> Doctor Clinical Desk</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button type="button" class="dropdown-item text-danger" data-tga-logout data-action-url="/Account/Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                </button>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                            Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-tga-gold btn-sm px-3 rounded-pill text-dark fw-bold">
                            Register
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Mega-Menu Navigation Links -->
        <nav class="navbar navbar-expand-lg p-0 mt-2 border-top pt-2">
            <button class="navbar-toggler w-100 mb-2 py-1 border-0" type="button" data-bs-toggle="collapse" data-bs-target="#tgaNavContent">
                <span class="navbar-toggler-icon"></span> <span class="small fw-semibold ms-2">Explore Medicines, Concerns &amp; Vaidyas</span>
            </button>
            <div class="collapse navbar-collapse" id="tgaNavContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    </li>

                    <!-- Shop by Concern Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link tga-nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-heart-pulse me-1"></i> Shop by Concern
                        </a>
                        <ul class="dropdown-menu shadow border-0 mt-2">
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Digestion"><i class="bi bi-fire text-warning me-2"></i> Digestion &amp; Gut Agni</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Stress"><i class="bi bi-moon-stars text-primary me-2"></i> Stress, Anxiety &amp; Sleep</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Immunity"><i class="bi bi-shield-plus text-success me-2"></i> Immunity &amp; Rasayana</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Joints"><i class="bi bi-activity text-danger me-2"></i> Joint &amp; Muscle Mobility</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Hair"><i class="bi bi-flower1 text-info me-2"></i> Hair Vitality &amp; Scalp</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Skin"><i class="bi bi-brightness-high text-warning me-2"></i> Skin Glow &amp; Detox</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Metabolism"><i class="bi bi-speedometer text-secondary me-2"></i> Healthy Metabolism</a></li>
                            <li><a class="dropdown-item py-2" asp-controller="Shop" asp-action="Index" asp-route-concern="Womens"><i class="bi bi-gender-female text-danger me-2"></i> Women's Hormonal Care</a></li>
                        </ul>
                    </li>

                    <!-- All Medicines -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Shop" asp-action="Index">
                            <i class="bi bi-capsule me-1"></i> All Medicines
                        </a>
                    </li>

                    <!-- Doctor Consultations -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Doctors" asp-action="Index">
                            <i class="bi bi-camera-video me-1"></i> Consult Doctors
                        </a>
                    </li>

                    <!-- Yoga & Asanas -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Yoga" asp-action="Index">
                            <i class="bi bi-person-standing me-1"></i> Yoga &amp; Wellness
                        </a>
                    </li>

                    <!-- Ayurveda Wisdom / Dinacharya -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" href="#dinacharya">
                            <i class="bi bi-clock-history me-1"></i> Dinacharya Routine
                        </a>
                    </li>

                    <!-- Prakriti Quiz -->
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link text-success fw-bold" href="#prakritiQuizSection">
                            <i class="bi bi-patch-question me-1"></i> Prakriti Quiz
                        </a>
                    </li>
                </ul>

                <div class="text-muted small d-none d-xl-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-patch-check-fill me-1"></i> Ministry of AYUSH Standards
                    </span>
                </div>
            </div>
        </nav>
    </div>
</header>
