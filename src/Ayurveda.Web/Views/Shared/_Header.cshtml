@using Microsoft.AspNetCore.Identity
@using Ayurveda.Domain.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!-- Announcement Top Banner -->
<div class="announcement-bar text-center">
    <div class="container d-flex justify-content-between align-items-center">
        <span class="d-none d-md-inline"><i class="bi bi-shield-check me-1 text-warning"></i> 100% Authentic Classical Formulations</span>
        <span><i class="bi bi-truck me-1 text-warning"></i> Free Shipping on orders above ₹499 across India</span>
        <span class="d-none d-md-inline"><i class="bi bi-person-check me-1 text-warning"></i> Verified AYUSH Doctors</span>
    </div>
</div>

<!-- Sticky Main Navigation -->
<header class="sticky-top tga-navbar">
    <div class="container py-2">
        <div class="row align-items-center g-3">
            <!-- Brand Logo -->
            <div class="col-6 col-lg-3">
                <a asp-controller="Home" asp-action="Index" class="tga-brand">
                    <img src="/images/logo.svg" alt="The Great Ayurveda" height="42" />
                </a>
            </div>

            <!-- Search Bar -->
            <div class="col-12 col-lg-5 order-3 order-lg-2">
                <partial name="_SearchBox" />
            </div>

            <!-- Header Quick Actions (Cart, Account) -->
            <div class="col-6 col-lg-4 order-2 order-lg-3 d-flex justify-content-end align-items-center gap-3">
                <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-success btn-sm rounded-pill d-none d-xl-inline-flex align-items-center gap-1">
                    <i class="bi bi-camera-video"></i> Consult Doctor
                </a>

                <a asp-controller="Cart" asp-action="Index" class="btn btn-light position-relative border rounded-pill px-3 py-2">
                    <i class="bi bi-cart3 fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-success" id="cartCountBadge">
                        @(ViewBag.CartCount ?? 0)
                    </span>
                </a>

                @if (SignInManager.IsSignedIn(User))
                {
                    <div class="dropdown">
                        <button class="btn btn-light border rounded-pill px-3 py-2 dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5 text-success"></i>
                            <span class="small fw-semibold d-none d-md-inline">@User.Identity?.Name?.Split('@')[0]</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li><h6 class="dropdown-header">My Account</h6></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile"><i class="bi bi-person me-2"></i> Profile & Addresses</a></li>
                            <li><a class="dropdown-item" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2"></i> My Orders</a></li>
                            <li><a class="dropdown-item" asp-controller="Doctors" asp-action="MyAppointments"><i class="bi bi-calendar2-check me-2"></i> Consultations</a></li>
                            @if (User.IsInRole("Doctor"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-primary" asp-controller="DoctorPortal" asp-action="Dashboard"><i class="bi bi-hospital me-2"></i> Doctor Portal</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="button" class="dropdown-item text-danger btn-logout-trigger">
                                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="d-flex gap-2">
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-sm px-3 rounded-pill">
                            Sign In
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-tga-primary btn-sm px-3 rounded-pill">
                            Register
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Navigation Menu Links -->
        <nav class="navbar navbar-expand-lg p-0 mt-2 border-top pt-2">
            <button class="navbar-toggler w-100 mb-2 py-1" type="button" data-bs-toggle="collapse" data-bs-target="#tgaNavContent">
                <span class="navbar-toggler-icon"></span> Explore Categories & Consultations
            </button>
            <div class="collapse navbar-collapse" id="tgaNavContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Shop" asp-action="Index">Shop Medicines</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Doctors" asp-action="Index">Doctor Consultation</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Diseases" asp-action="Index">Diseases & Remedies</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Yoga" asp-action="Index">Yoga & Wellness</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Home" asp-action="About">About Us</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link tga-nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                </ul>
                <div class="text-muted small d-none d-xl-block">
                    <i class="bi bi-shield-lock me-1"></i> AYUSH Compliant Healthcare
                </div>
            </div>
        </nav>
    </div>
</header>
