<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | The Great Ayurveda" : "The Great Ayurveda | Authentic Ayurveda Care & Consultation")</title>
    <meta name="description" content="Discover authentic Ayurvedic medicines, organic herbs, and book personalized video consultations with certified AYUSH doctors." />
    
    <!-- Local Bootstrap 5.3 & Bootstrap Icons (No CDN) -->
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />
    
    <!-- Custom Design Tokens & Stylesheet -->
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <partial name="_Header" />

    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <partial name="_Footer" />
    <partial name="_ConfirmModal" />
    <partial name="_Toasts" />

    <!-- Local Bootstrap 5.3 JavaScript -->
    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
