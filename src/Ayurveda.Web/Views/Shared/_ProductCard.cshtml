@model Ayurveda.Application.ViewModels.ProductCardViewModel

<div class="card h-100 tga-card border-0 shadow-sm rounded-3 overflow-hidden position-relative product-card-hover" id="product-card-@Model.Id">
    <!-- Top Tags & Badges -->
    <div class="position-absolute top-0 start-0 m-2 z-2 d-flex flex-column gap-1">
        @if (Model.DiscountPercent > 0)
        {
            <span class="badge bg-danger rounded-pill px-2 py-1 shadow-sm">@Model.DiscountPercent% OFF</span>
        }
        @if (!string.IsNullOrEmpty(Model.Badge))
        {
            <span class="badge bg-warning text-dark fw-bold rounded-pill px-2 py-1 shadow-sm"><i class="bi bi-award-fill me-1"></i>@Model.Badge</span>
        }
    </div>

    <!-- Wishlist Heart Button -->
    <button type="button" 
            class="btn btn-sm btn-light rounded-circle position-absolute top-0 end-0 m-2 z-2 shadow-sm wishlist-toggle-btn border"
            data-product-id="@Model.Id"
            title="Save to Wishlist"
            style="width: 34px; height: 34px; display: flex; align-items: center; justify-content: center;">
        <i class="bi @(Model.IsInWishlist ? "bi-heart-fill text-danger" : "bi-heart text-muted")"></i>
    </button>

    <!-- Product Image Preview -->
    <div class="position-relative overflow-hidden text-center p-3" style="background: #FDFBF7;">
        <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none d-block">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/products/chyawanprash.svg" : Model.ImageUrl)" 
                 class="card-img-top img-fluid transition-scale" 
                 alt="@Model.Title" 
                 style="height: 200px; object-fit: contain;" />
        </a>
    </div>

    <!-- Product Details -->
    <div class="card-body d-flex flex-column p-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <span class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem; letter-spacing: 0.5px;">@Model.Brand</span>
            <span class="badge bg-light text-muted border rounded-pill" style="font-size: 0.65rem;">@Model.CategoryName</span>
        </div>

        <h6 class="card-title fw-bold text-dark mb-1" style="min-height: 40px; font-size: 0.95rem; line-height: 1.3;">
            <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="text-dark text-decoration-none hover-green">
                @Model.Title
            </a>
        </h6>

        @if (!string.IsNullOrEmpty(Model.TraditionallyUsedFor))
        {
            <div class="small text-muted text-truncate mb-2" style="font-size: 0.75rem;" title="@Model.TraditionallyUsedFor">
                <i class="bi bi-heart-pulse text-success me-1"></i>@Model.TraditionallyUsedFor
            </div>
        }

        <!-- Rating Stars -->
        <div class="d-flex align-items-center gap-1 mb-2">
            <span class="text-warning small">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="bi @(i <= Math.Round(Model.AverageRating) ? "bi-star-fill" : "bi-star")"></i>
                }
            </span>
            <span class="small fw-bold text-dark ms-1">@Model.AverageRating.ToString("0.0")</span>
        </div>

        <div class="mt-auto pt-2 border-top">
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-5 fw-bold text-success">₹@Model.Price.ToString("N0")</span>
                @if (Model.Mrp > Model.Price)
                {
                    <span class="small text-muted text-decoration-line-through">₹@Model.Mrp.ToString("N0")</span>
                }
            </div>

            <div class="d-flex gap-2">
                @if (Model.IsInStock)
                {
                    <button type="button" class="btn btn-tga-outline btn-sm flex-grow-1 ajax-add-to-cart rounded-pill" data-product-id="@Model.Id">
                        <i class="bi bi-cart-plus me-1"></i> Add to Cart
                    </button>
                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-light border rounded-circle text-muted" title="View details" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                        <i class="bi bi-eye"></i>
                    </a>
                }
                else
                {
                    <button type="button" class="btn btn-light text-muted w-100 btn-sm rounded-pill" disabled>
                        Out of Stock
                    </button>
                }
            </div>
        </div>
    </div>
</div>
