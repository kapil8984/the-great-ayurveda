@model Ayurveda.Application.ViewModels.ProductCardViewModel

<div class="card h-100 tga-card">
    <div class="position-relative">
        <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/products/chyawanprash.svg" : Model.ImageUrl)" 
                 class="card-img-top p-3" 
                 alt="@Model.Title" 
                 style="height: 220px; object-fit: contain; background: #FAF7F0;" />
        </a>
        @if (Model.DiscountPercent > 0)
        {
            <span class="position-absolute top-0 start-0 m-2 badge bg-danger">@Model.DiscountPercent% OFF</span>
        }
        @if (!string.IsNullOrEmpty(Model.Badge))
        {
            <span class="position-absolute top-0 end-0 m-2 badge-tga-bestseller">@Model.Badge</span>
        }
    </div>
    <div class="card-body d-flex flex-column p-3">
        <div class="small text-muted text-uppercase fw-semibold mb-1" style="font-size: 0.75rem;">@Model.Brand</div>
        <h6 class="card-title fw-bold text-dark mb-2 text-truncate-2" style="min-height: 42px;">
            <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="text-dark text-decoration-none">
                @Model.Title
            </a>
        </h6>
        
        <div class="d-flex align-items-center gap-1 mb-2">
            <span class="tga-rating">
                <i class="bi bi-star-fill"></i>
            </span>
            <span class="small fw-semibold text-dark">@Model.AverageRating.ToString("0.0")</span>
        </div>

        <div class="mt-auto">
            <div class="d-flex align-items-baseline gap-2 mb-3">
                <span class="fs-5 fw-bold text-success">₹@Model.Price.ToString("N0")</span>
                @if (Model.Mrp > Model.Price)
                {
                    <span class="small text-muted text-decoration-line-through">₹@Model.Mrp.ToString("N0")</span>
                }
            </div>

            @if (Model.IsInStock)
            {
                <button type="button" class="btn btn-tga-outline w-100 btn-sm ajax-add-to-cart" data-product-id="@Model.Id">
                    <i class="bi bi-cart-plus me-1"></i> Add to Cart
                </button>
            }
            else
            {
                <button type="button" class="btn btn-light text-muted w-100 btn-sm" disabled>
                    Out of Stock
                </button>
            }
        </div>
    </div>
</div>
