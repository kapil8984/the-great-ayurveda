@model Ayurveda.Application.ViewModels.ProductCardViewModel

<div class="card h-100 flipkart-listing-card shadow-sm border-0 position-relative d-flex flex-column" id="product-card-@Model.Id">
    <!-- Top Tags & Badges -->
    <div class="position-absolute top-0 start-0 m-2 z-2 d-flex flex-column gap-1">
        @if (Model.DiscountPercent > 0)
        {
            <span class="badge bg-danger rounded-1 px-2 py-1 shadow-sm fw-bold">@Model.DiscountPercent% OFF</span>
        }
        @if (!string.IsNullOrEmpty(Model.Badge))
        {
            <span class="badge bg-warning text-dark fw-bold rounded-1 px-2 py-1 shadow-sm"><i class="bi bi-award-fill me-1"></i>@Model.Badge</span>
        }
    </div>

    <!-- Top Right Actions: Wishlist Heart -->
    <div class="position-absolute top-0 end-0 m-2 z-2 d-flex flex-column gap-1">
        <button type="button" 
                class="btn btn-sm btn-light rounded-circle shadow-sm wishlist-toggle-btn border d-flex align-items-center justify-content-center p-0"
                data-product-id="@Model.Id"
                title="Save to Wishlist"
                aria-label="Save to Wishlist"
                style="width: 34px; height: 34px; min-width: 34px; min-height: 34px;">
            <i class="bi @(Model.IsInWishlist ? "bi-heart-fill text-danger" : "bi-heart text-muted")"></i>
        </button>
    </div>

    <!-- Product Image: Flipkart-Style Contain Container with Pure Background -->
    <div class="flipkart-listing-img-box">
        <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none d-flex align-items-center justify-content-center w-100 h-100">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.svg" : Model.ImageUrl)" 
                 class="img-fluid" 
                 alt="@Model.Title" 
                 loading="lazy"
                 onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
        </a>
    </div>

    <!-- Product Details -->
    <div class="card-body d-flex flex-column p-3 flex-grow-1">
        <!-- Brand & Category Row -->
        <div class="d-flex justify-content-between align-items-center gap-1 mb-1">
            <span class="text-muted text-uppercase fw-bold text-truncate" style="font-size: 0.72rem; letter-spacing: 0.6px;" title="@Model.Brand">@Model.Brand</span>
            <span class="badge bg-light text-muted border rounded-pill text-truncate" style="font-size: 0.65rem;" title="@Model.CategoryName">@Model.CategoryName</span>
        </div>

        <!-- Clamped Product Title -->
        <h6 class="card-title fw-bold text-dark mb-1 line-clamp-2" style="font-size: 0.92rem; line-height: 1.35; min-height: 2.7em;" title="@Model.Title">
            <a asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" class="text-dark text-decoration-none hover-green">
                @Model.Title
            </a>
        </h6>

        @if (!string.IsNullOrEmpty(Model.TraditionallyUsedFor))
        {
            <div class="small text-muted text-truncate mb-2" style="font-size: 0.75rem;" title="@Model.TraditionallyUsedFor">
                <i class="bi bi-heart-pulse text-success me-1"></i>@Model.TraditionallyUsedFor
            </div>
        }

        <!-- Flipkart-Style Rating Badge -->
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="flipkart-rating-badge">
                @Model.AverageRating.ToString("0.0") <i class="bi bi-star-fill text-white" style="font-size: 0.65rem;"></i>
            </span>
            <span class="small text-muted">(@Math.Max(12, (int)(Model.AverageRating * 28)))</span>
        </div>

        <!-- Price & Add Button Row -->
        <div class="mt-auto pt-2 border-top">
            <div class="d-flex align-items-baseline gap-2 mb-2">
                <span class="fs-5 fw-bold text-dark">₹@Model.Price.ToString("N0")</span>
                @if (Model.Mrp > Model.Price)
                {
                    <span class="small text-muted text-decoration-line-through">₹@Model.Mrp.ToString("N0")</span>
                    <span class="small fw-bold text-success">@Model.DiscountPercent% off</span>
                }
            </div>

            <!-- Full-Width Add Button -->
            @if (Model.IsInStock)
            {
                <button type="button" 
                        class="btn btn-tga-primary w-100 ajax-add-to-cart rounded-pill fw-semibold d-flex align-items-center justify-content-center text-nowrap shadow-sm" 
                        style="height: 38px; min-height: 38px; font-size: 0.88rem; white-space: nowrap;" 
                        data-product-id="@Model.Id"
                        aria-label="Add @Model.Title to Cart">
                    <i class="bi bi-cart-plus me-1"></i> <span>Add to Cart</span>
                </button>
            }
            else
            {
                <button type="button" 
                        class="btn btn-secondary w-100 rounded-pill text-nowrap" 
                        style="height: 38px; min-height: 38px; font-size: 0.85rem;" 
                        disabled>
                    Out of Stock
                </button>
            }
        </div>
    </div>
</div>
