<div id="cookieNoticeBanner" class="position-fixed bottom-0 start-0 end-0 bg-dark text-white p-3 shadow-lg d-none tga-cookie-notice" style="z-index: 1060; border-top: 2px solid #D4AF37;">
    <div class="container d-flex flex-column flex-md-row align-items-center justify-content-between gap-3">
        <div class="small">
            <i class="bi bi-cookie text-warning me-2 fs-5"></i>
            We use essential cookies and session state to ensure proper store browsing, guest cart isolation, and authentication. By continuing to browse, you agree to our <a asp-controller="Home" asp-action="Privacy" class="text-warning text-decoration-underline">Privacy Policy</a>.
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            <button type="button" id="acceptCookiesBtn" class="btn btn-warning btn-sm px-4 rounded-pill fw-bold d-inline-flex align-items-center justify-content-center" style="min-height: 44px;">Accept &amp; Continue</button>
        </div>
    </div>
</div>
<script>
    (function () {
        try {
            if (!localStorage.getItem("tga_cookies_accepted")) {
                var b = document.getElementById("cookieNoticeBanner");
                if (b) b.classList.remove("d-none");
            }
            var btn = document.getElementById("acceptCookiesBtn");
            if (btn) {
                btn.addEventListener("click", function () {
                    localStorage.setItem("tga_cookies_accepted", "true");
                    var b = document.getElementById("cookieNoticeBanner");
                    if (b) b.classList.add("d-none");
                });
            }
        } catch (e) { }
    })();
</script>
