@model Ayurveda.Application.ViewModels.DoctorCardViewModel

<div class="card h-100 product-card shadow-xs rounded-4 border overflow-hidden">
    <div class="card-body p-4 d-flex flex-column">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="position-relative">
                <img src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/images/doctor-avatar.svg" : Model.ProfileImage)" 
                     class="rounded-circle border" 
                     alt="@Model.DoctorName" 
                     width="64" height="64" 
                     style="object-fit: cover; background: #EAF4EE;" />
                @if (Model.IsOnline)
                {
                    <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-2 border-white rounded-circle" title="Online for instant consultation"></span>
                }
            </div>
            <div class="overflow-hidden">
                <h5 class="fw-bold mb-1 text-dark text-truncate">Dr. @Model.DoctorName</h5>
                <div class="badge bg-success-subtle text-success border border-success-subtle fw-medium text-truncate">@Model.SpecializationName</div>
            </div>
        </div>

        <div class="small text-muted mb-3 d-flex flex-column gap-1">
            <div class="text-truncate"><i class="bi bi-mortarboard me-1 text-success"></i> @(Model.Qualification ?? "BAMS, Ayurveda Expert")</div>
            <div><i class="bi bi-clock-history me-1 text-success"></i> @Model.ExperienceYears+ Years Clinical Experience</div>
            @if (!string.IsNullOrEmpty(Model.Languages))
            {
                <div class="text-truncate"><i class="bi bi-translate me-1 text-success"></i> @Model.Languages</div>
            }
            @if (!string.IsNullOrEmpty(Model.ClinicAddress))
            {
                <div class="text-truncate text-xs"><i class="bi bi-geo-alt me-1 text-muted"></i> @Model.ClinicAddress</div>
            }
        </div>

        <div class="d-flex align-items-center justify-content-between my-2 pt-2 border-top">
            <div>
                <div class="text-xs text-muted">Consultation Fee</div>
                <div class="fs-5 fw-bold text-success">₹@Model.ConsultationFee.ToString("N0")</div>
            </div>
            <div class="text-end">
                <div class="d-flex align-items-center gap-1 justify-content-end">
                    <span class="badge bg-warning text-dark text-xs"><i class="bi bi-star-fill"></i> @Model.Rating.ToString("0.0")</span>
                </div>
                <div class="text-muted text-xs">(@Model.ReviewCount reviews)</div>
            </div>
        </div>

        <div class="mt-auto pt-3 d-flex gap-2">
            <a asp-controller="Doctors" asp-action="Profile" asp-route-id="@Model.Id" class="btn btn-outline-secondary btn-sm rounded-pill flex-fill">
                View Profile
            </a>
            @if (Model.IsOnline)
            {
                <a asp-controller="Doctors" asp-action="Book" asp-route-id="@Model.Id" asp-route-mode="Video" class="btn btn-success btn-sm rounded-pill flex-fill d-inline-flex align-items-center justify-content-center gap-1 shadow-xs">
                    <span class="spinner-grow spinner-grow-sm text-light" style="width: 8px; height: 8px;" role="status"></span> Call Now
                </a>
            }
            else
            {
                <a asp-controller="Doctors" asp-action="Book" asp-route-id="@Model.Id" class="btn btn-tga-gold btn-sm rounded-pill flex-fill fw-semibold">
                    Book Slot
                </a>
            }
        </div>
    </div>
</div>
