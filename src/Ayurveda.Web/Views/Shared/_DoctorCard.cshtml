@model Ayurveda.Application.ViewModels.DoctorCardViewModel

<div class="card h-100 tga-card">
    <div class="card-body p-4 d-flex flex-column">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="position-relative">
                <img src="@(string.IsNullOrEmpty(Model.ProfileImage) ? "/images/doctor-avatar.svg" : Model.ProfileImage)" 
                     class="rounded-circle border" 
                     alt="@Model.DoctorName" 
                     width="64" height="64" 
                     style="object-fit: cover; background: #EAF4EE;" />
                @if (Model.IsOnline)
                {
                    <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-white rounded-circle" title="Online now"></span>
                }
            </div>
            <div>
                <h5 class="fw-bold mb-1 text-dark">Dr. @Model.DoctorName</h5>
                <div class="badge bg-success-subtle text-success fw-medium">@Model.SpecializationName</div>
            </div>
        </div>

        <div class="small text-muted mb-2">
            <div><i class="bi bi-mortarboard me-1 text-secondary"></i> @(Model.Qualification ?? "BAMS, Ayurveda Expert")</div>
            <div><i class="bi bi-clock-history me-1 text-secondary"></i> @Model.ExperienceYears+ Years Clinical Experience</div>
            @if (!string.IsNullOrEmpty(Model.Languages))
            {
                <div><i class="bi bi-translate me-1 text-secondary"></i> @Model.Languages</div>
            }
        </div>

        <div class="d-flex align-items-center justify-content-between my-3 pt-2 border-top">
            <div>
                <div class="small text-muted">Consultation Fee</div>
                <div class="fs-5 fw-bold text-dark">₹@Model.ConsultationFee.ToString("N0")</div>
            </div>
            <div class="text-end">
                <div class="tga-rating">
                    <i class="bi bi-star-fill"></i> <span class="fw-bold text-dark">@Model.Rating.ToString("0.0")</span>
                </div>
                <div class="small text-muted">(@Model.ReviewCount reviews)</div>
            </div>
        </div>

        <div class="mt-auto pt-2 d-flex gap-2">
            <a asp-controller="Doctors" asp-action="Profile" asp-route-id="@Model.Id" class="btn btn-tga-outline btn-sm flex-fill">
                View Profile
            </a>
            <a asp-controller="Doctors" asp-action="Book" asp-route-id="@Model.Id" class="btn btn-tga-primary btn-sm flex-fill">
                Book Slot
            </a>
        </div>
    </div>
</div>
