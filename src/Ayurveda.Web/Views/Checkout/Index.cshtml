@model Ayurveda.Application.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Secure Checkout | The Great Ayurveda";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 fw-bold m-0" style="font-family: var(--tga-font-heading); color: var(--tga-primary);">
                Finalize Your Order
            </h1>
            <p class="text-muted small mb-0">Express botanical checkout with classical pharmacy fulfillment.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill small fw-semibold">
                <i class="bi bi-shield-check me-1"></i> Demo mode - no real payment
            </span>
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small">
                <i class="bi bi-shield-lock-fill me-1"></i> 256-Bit SSL Encrypted
            </span>
        </div>
    </div>

    <form asp-action="PlaceOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="IdempotencyKey" />
        <input type="hidden" asp-for="IsLiveRazorpay" id="rzpIsLive" />
        <input type="hidden" asp-for="RazorpayKeyId" id="rzpKeyId" />
        <input type="hidden" asp-for="RazorpayOrderId" id="rzpOrderId" />
        <input type="hidden" asp-for="RazorpayPaymentId" id="rzpPaymentId" />
        <input type="hidden" asp-for="RazorpaySignature" id="rzpSignature" />
        
        <div class="row g-4">
            <!-- Left Col: Shipping Address, Delivery Options & Payment Selection -->
            <div class="col-lg-8">
                <!-- 1. Shipping Address Section -->
                <div class="card p-4 shadow-sm border-0 rounded-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-geo-alt-fill text-success me-2"></i> 1. Delivery Address</h5>
                    
                    @if (Model.SavedAddresses != null && Model.SavedAddresses.Any())
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted text-uppercase">Select from Saved Addresses:</label>
                            <div class="row g-2">
                                @foreach (var addr in Model.SavedAddresses)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check p-3 border rounded-3 bg-light h-100">
                                            <input class="form-check-input" type="radio" name="SelectedAddressId" id="addr_@addr.Id" value="@addr.Id" @(addr.IsDefault || Model.SelectedAddressId == addr.Id ? "checked" : "") />
                                            <label class="form-check-label small" for="addr_@addr.Id">
                                                <strong>@addr.RecipientName</strong> (@addr.Phone)<br />
                                                @addr.AddressLine1 @(addr.AddressLine2 ?? "")<br />
                                                @addr.City, @addr.State - <strong>@addr.PostalCode</strong>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="text-muted small mb-3">--- OR enter a new address below ---</div>
                    }

                    <div class="p-3 border rounded-3 bg-light">
                        <h6 class="fw-bold text-dark mb-3">Add / Enter Delivery Address:</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">Recipient Full Name *</label>
                                <input asp-for="NewAddress.RecipientName" class="form-control form-control-sm rounded-pill" placeholder="Full Name" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold">10-Digit Mobile Number *</label>
                                <input asp-for="NewAddress.Phone" class="form-control form-control-sm rounded-pill" placeholder="e.g. 9876543210" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-semibold">Flat / House No., Building & Street Address *</label>
                                <input asp-for="NewAddress.AddressLine1" class="form-control form-control-sm rounded-3" placeholder="e.g. 204, Lotus Meadows, MG Road" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">City *</label>
                                <input asp-for="NewAddress.City" class="form-control form-control-sm rounded-pill" placeholder="City" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">State *</label>
                                <input asp-for="NewAddress.State" class="form-control form-control-sm rounded-pill" placeholder="State" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold">PIN Code *</label>
                                <input asp-for="NewAddress.PostalCode" class="form-control form-control-sm rounded-pill" placeholder="6-digit PIN" maxlength="6" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Delivery Speed Section -->
                <div class="card p-4 shadow-sm border-0 rounded-4 bg-white mb-4">
                    <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-truck text-success me-2"></i> 2. Delivery Speed</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded-3 bg-light">
                                <input class="form-check-input" type="radio" asp-for="DeliveryType" id="delStandard" value="Standard" checked />
                                <label class="form-check-label small" for="delStandard">
                                    <strong class="text-dark">Standard Delivery (3-5 Days)</strong><br />
                                    <span class="text-success fw-semibold">FREE on orders &gt; ₹499</span> (else ₹40)
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check p-3 border rounded-3 bg-light">
                                <input class="form-check-input" type="radio" asp-for="DeliveryType" id="delExpress" value="Express" />
                                <label class="form-check-label small" for="delExpress">
                                    <strong class="text-dark">Express Priority (1-2 Days)</strong><br />
                                    <span class="text-primary fw-semibold">+₹99 Healthcare Logistics</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Payment Method Section -->
                <div class="card p-4 shadow-sm border-0 rounded-4 bg-white mb-4">
                    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                        <h5 class="fw-bold text-dark m-0"><i class="bi bi-credit-card-2-front text-success me-2"></i> 3. Payment Method</h5>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-light text-muted border rounded-pill px-2 py-1 small">Razorpay Secure Gateway</span>
                            @if (Model.IsLiveRazorpay && !string.IsNullOrEmpty(Model.RazorpayKeyId))
                            {
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1 small fw-bold">
                                    <i class="bi bi-shield-check me-1"></i> Razorpay Test Mode
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill px-3 py-1 small fw-bold">
                                    <i class="bi bi-shield-check me-1"></i> Demo payment
                                </span>
                            }
                        </div>
                    </div>

                    @if (Model.IsLiveRazorpay && !string.IsNullOrEmpty(Model.RazorpayKeyId) && Model.RazorpayKeyId.StartsWith("rzp_test_"))
                    {
                        <!-- Collapsible 'How to pay in test mode' Panel (shown when test keys exist) -->
                        <div class="accordion mb-3" id="howToPayAccordion">
                            <div class="accordion-item border rounded-3 overflow-hidden shadow-xs">
                                <h2 class="accordion-header" id="headingTestHelp">
                                    <button class="accordion-button collapsed py-2 px-3 small fw-bold bg-light text-dark" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTestHelp" aria-expanded="false" aria-controls="collapseTestHelp">
                                        <i class="bi bi-info-circle-fill text-primary me-2"></i> How to pay in test mode
                                    </button>
                                </h2>
                                <div id="collapseTestHelp" class="accordion-collapse collapse" aria-labelledby="headingTestHelp" data-bs-parent="#howToPayAccordion">
                                    <div class="accordion-body p-3 small text-muted bg-white">
                                        <div class="mb-2">
                                            <strong>Card:</strong> <code class="user-select-all fw-bold text-dark">4111 1111 1111 1111</code>, any future expiry (e.g. <code>12/28</code>), any CVV (e.g. <code>123</code>)
                                        </div>
                                        <div class="mb-2">
                                            <strong>UPI:</strong> <code class="user-select-all fw-bold text-dark">success@razorpay</code> (or <code class="user-select-all text-danger">failure@razorpay</code> to fail)
                                        </div>
                                        <div class="text-xs text-secondary">
                                            <i class="bi bi-bank me-1"></i> On the mock bank authorization page, press <strong>Success</strong>.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Payment Option Cards in CSS Grid -->
                    <div class="checkout-payment-grid mb-3" id="paymentOptionsGroup">
                        <!-- UPI -->
                        <label class="card p-3 border rounded-3 cursor-pointer payment-method-card active-card m-0" data-method="UPI" for="payUpi">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input class="form-check-input mt-0 payment-radio flex-shrink-0" type="radio" asp-for="SelectedPaymentMethod" value="Razorpay" id="payUpi" checked />
                                <span class="fw-bold small text-dark"><i class="bi bi-qr-code-scan text-success me-1"></i> UPI (Instant)</span>
                            </div>
                            <div class="text-xs text-muted">Google Pay, PhonePe, Paytm, BHIM or any UPI ID</div>
                        </label>
                        <!-- Cards -->
                        <label class="card p-3 border rounded-3 cursor-pointer payment-method-card m-0" data-method="Card" for="payCard">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input class="form-check-input mt-0 payment-radio flex-shrink-0" type="radio" asp-for="SelectedPaymentMethod" value="Razorpay" id="payCard" />
                                <span class="fw-bold small text-dark"><i class="bi bi-credit-card text-primary me-1"></i> Credit / Debit Card</span>
                            </div>
                            <div class="text-xs text-muted">Visa, MasterCard, RuPay, Maestro</div>
                        </label>
                        <!-- Net Banking -->
                        <label class="card p-3 border rounded-3 cursor-pointer payment-method-card m-0" data-method="NetBanking" for="payNetBanking">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input class="form-check-input mt-0 payment-radio flex-shrink-0" type="radio" asp-for="SelectedPaymentMethod" value="Razorpay" id="payNetBanking" />
                                <span class="fw-bold small text-dark"><i class="bi bi-bank text-warning me-1"></i> Net Banking</span>
                            </div>
                            <div class="text-xs text-muted">HDFC, SBI, ICICI, Axis, Kotak, 50+ Banks</div>
                        </label>
                        <!-- COD -->
                        <label class="card p-3 border rounded-3 cursor-pointer payment-method-card m-0" data-method="COD" for="payCod">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <input class="form-check-input mt-0 payment-radio flex-shrink-0" type="radio" asp-for="SelectedPaymentMethod" value="CashOnDelivery" id="payCod" />
                                <span class="fw-bold small text-dark"><i class="bi bi-cash-stack text-success me-1"></i> Cash on Delivery</span>
                            </div>
                            <div class="text-xs text-muted">Pay cash or UPI upon package arrival</div>
                        </label>
                    </div>

                    <!-- Dynamic Details Panel for Selected Method (Normal Flow BELOW Cards) -->
                    <div class="p-3 border rounded-4 bg-light mb-3" id="paymentDetailsPanel">
                        <!-- UPI View -->
                        <div class="payment-detail-view" id="view-UPI">
                            <h6 class="fw-bold small text-dark mb-2"><i class="bi bi-phone me-1 text-success"></i> Enter UPI Virtual Private Address (VPA):</h6>
                            <div class="input-group input-group-sm mb-2" style="max-width: 360px;">
                                <input type="text" class="form-control" id="upiVpaInput" placeholder="username@okhdfcbank" value="ayurveda.customer@upi" />
                                <span class="input-group-text bg-white text-muted"><i class="bi bi-check2"></i> Demo VPA</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2 align-items-center small text-muted">
                                <span>Popular apps:</span>
                                <span class="badge bg-white text-dark border">GPay</span>
                                <span class="badge bg-white text-dark border">PhonePe</span>
                                <span class="badge bg-white text-dark border">Paytm</span>
                                <span class="badge bg-white text-dark border">BHIM</span>
                            </div>
                        </div>

                        <!-- Card View -->
                        <div class="payment-detail-view d-none" id="view-Card">
                            <h6 class="fw-bold small text-dark mb-3"><i class="bi bi-credit-card me-1 text-primary"></i> Card Details:</h6>
                            <div class="row g-2" style="max-width: 420px;">
                                <div class="col-12">
                                    <label class="form-label text-xs text-muted mb-1">Card Number</label>
                                    <input type="text" class="form-control form-control-sm" placeholder="4532 •••• •••• 8892" value="4532 8900 1234 8892" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-xs text-muted mb-1">Expiry (MM/YY)</label>
                                    <input type="text" class="form-control form-control-sm" placeholder="12/28" value="10/28" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label text-xs text-muted mb-1">CVV</label>
                                    <input type="password" class="form-control form-control-sm" placeholder="•••" value="789" maxlength="3" />
                                </div>
                            </div>
                        </div>

                        <!-- Net Banking View -->
                        <div class="payment-detail-view d-none" id="view-NetBanking">
                            <h6 class="fw-bold small text-dark mb-2"><i class="bi bi-bank me-1 text-warning"></i> Select Bank:</h6>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                <button type="button" class="btn btn-sm btn-white border rounded-pill px-3 active fw-semibold">HDFC Bank</button>
                                <button type="button" class="btn btn-sm btn-white border rounded-pill px-3">State Bank of India</button>
                                <button type="button" class="btn btn-sm btn-white border rounded-pill px-3">ICICI Bank</button>
                                <button type="button" class="btn btn-sm btn-white border rounded-pill px-3">Axis Bank</button>
                            </div>
                        </div>

                        <!-- COD View -->
                        <div class="payment-detail-view d-none" id="view-COD">
                            <div class="small text-muted">
                                <i class="bi bi-info-circle text-success me-1"></i> You can pay cash or scan the courier's dynamic QR code on delivery. Please keep exact change ready.
                            </div>
                        </div>
                    </div>

                    <!-- Normal Block: Sandbox Environment Notice -->
                    <div class="p-3 border rounded-3 bg-light mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-shield-check text-success"></i>
                            <span class="small fw-semibold text-dark">Payment Sandbox Environment</span>
                        </div>
                        <div class="text-xs text-muted mt-1">
                            All transactions are routed through a sandboxed botanical checkout system. No real banking fees or currency debits occur.
                        </div>
                    </div>

                    <!-- Normal Block: Simulate Payment Failure Toggle -->
                    <div class="p-3 border rounded-3 bg-danger-subtle border-danger-subtle mb-3">
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="SimulateFailure" id="simulateFailureToggle" />
                            <label class="form-check-label small fw-bold text-danger" for="simulateFailureToggle">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Simulate Payment Failure
                            </label>
                            <div class="text-xs text-danger opacity-75 ps-4">
                                Toggle ON to test the error recovery UI (declined card / bank timeout simulation with retry button).
                            </div>
                        </div>
                    </div>

                    <!-- Payment Help & Troubleshooting Panel -->
                    <div class="card border rounded-3 p-3 bg-white">
                        <div class="d-flex align-items-center justify-content-between cursor-pointer" data-bs-toggle="collapse" data-bs-target="#paymentHelpCollapse" aria-expanded="false" aria-controls="paymentHelpCollapse" style="cursor: pointer;">
                            <span class="small fw-bold text-success d-flex align-items-center gap-2">
                                <i class="bi bi-question-circle-fill"></i> Payment Troubleshooting &amp; Guidance
                            </span>
                            <i class="bi bi-chevron-down text-muted small"></i>
                        </div>
                        <div class="collapse mt-2" id="paymentHelpCollapse">
                            <div class="small text-muted pt-2 border-top">
                                <div class="mb-2"><strong>UPI Transactions:</strong> If your UPI app (GPay, PhonePe, Paytm) times out or shows pending, do not re-initiate payment immediately; wait 30 seconds for the bank status callback.</div>
                                <div class="mb-2"><strong>Debit/Credit Cards:</strong> Ensure international or e-commerce transactions are activated in your bank app. 3D-Secure OTPs expire after 3 minutes.</div>
                                <div class="mb-2"><strong>NetBanking:</strong> Keep your popup blocker disabled to allow your bank's authentication gateway window to complete.</div>
                                <div class="mb-0"><strong>Failed Debits:</strong> In the rare event an amount is debited on a failed order, automated banking refunds are credited back to your original source within 3-5 business days.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Col: Order Review & Confirmation -->
            <div class="col-lg-4">
                <div class="card p-4 shadow-sm border-0 rounded-4 bg-white sticky-lg-top" style="top: 90px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2" style="font-family: var(--tga-font-heading);">
                        Order Review (@Model.Cart.Items.Sum(i => i.Quantity) items)
                    </h5>

                    <!-- Item Preview List -->
                    <div class="overflow-auto mb-3" style="max-height: 200px;">
                        @foreach (var item in Model.Cart.Items)
                        {
                            <div class="d-flex align-items-center justify-content-between mb-2 small pb-2 border-bottom">
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder.svg" : item.ImageUrl)" width="38" height="38" class="rounded border p-1" style="object-fit: contain;" alt="@item.Title" onerror="this.onerror=null;this.src='/images/placeholder.svg';" />
                                    <div>
                                        <div class="text-truncate fw-semibold" style="max-width: 140px;">@item.Title</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">Qty: @item.Quantity</div>
                                    </div>
                                </div>
                                <span class="fw-bold text-dark">₹@item.TotalPrice.ToString("N0")</span>
                            </div>
                        }
                    </div>

                    <!-- Price Summary -->
                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Item Subtotal:</span>
                        <span>₹@Model.Cart.Subtotal.ToString("N2")</span>
                    </div>

                    @if (Model.Cart.CouponDiscount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 small text-success">
                            <span>Promo Discount:</span>
                            <span>-₹@Model.Cart.CouponDiscount.ToString("N2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2 small">
                        <span class="text-muted">Delivery:</span>
                        <span>@(Model.Cart.DeliveryFee == 0 ? "FREE" : $"₹{Model.Cart.DeliveryFee:N2}")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 small">
                        <span class="text-muted">GST (5%):</span>
                        <span>₹@Model.Cart.TaxAmount.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-4 fs-5 fw-bold text-success border-top pt-2">
                        <span>Total Payable:</span>
                        <span id="displayGrandTotal">₹@Model.Cart.GrandTotal.ToString("N2")</span>
                    </div>

                    <button type="button" id="btnInitiatePayment" class="btn btn-tga-gold w-100 py-3 fs-6 rounded-pill shadow-sm fw-bold" style="min-height: 44px;">
                        <i class="bi bi-lock-fill me-1"></i> Pay &amp; Place Order (₹@Model.Cart.GrandTotal.ToString("N0"))
                    </button>

                    <div class="medical-disclaimer-banner mt-3 text-center" style="font-size: 0.72rem;">
                        <i class="bi bi-shield-check me-1 text-success"></i> 100% Secure Simulated Transaction • Demo Mode
                    </div>
                </div>
            </div>
        </div>

        <!-- Mobile Sticky Payment Trigger Bar -->
        <div class="d-lg-none position-fixed start-0 end-0 bg-white border-top shadow-lg p-2 px-3 d-flex align-items-center justify-content-between" style="bottom: calc(58px + env(safe-area-inset-bottom, 0px)); z-index: 1045;">
            <div>
                <span class="text-xs text-muted d-block">Total Payable</span>
                <span class="fs-5 fw-bold text-success">₹@Model.Cart.GrandTotal.ToString("N0")</span>
            </div>
            <button type="button" class="btn btn-tga-gold rounded-pill px-4 fw-bold text-dark d-flex align-items-center gap-2" onclick="document.getElementById('btnInitiatePayment').click()" style="min-height: 44px;">
                <i class="bi bi-lock-fill"></i> Pay Now
            </button>
        </div>
    </form>
</div>

<!-- =========================================================================
     MODAL: Realistic Payment Processing & Result Simulator
     ========================================================================= -->
<div class="modal fade" id="paymentProcessModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-fullscreen-sm-down">
        <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
            <!-- Modal Header with Demo Tag -->
            <div class="modal-header border-0 pb-0 d-flex justify-content-between align-items-center bg-light">
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-1 small">
                    <i class="bi bi-shield-check me-1"></i> Demo Payment Gateway
                </span>
                <span class="text-muted small">Total: <strong>₹@Model.Cart.GrandTotal.ToString("N0")</strong></span>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4 text-center">
                <!-- State 1: Processing Animation -->
                <div id="modalStateProcessing">
                    <div class="my-4">
                        <div class="spinner-border text-success" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 0.35em;">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">Processing Payment...</h5>
                    <p class="text-muted small mb-3" id="processingStatusText">Contacting simulated bank gateway & verifying credentials...</p>
                    <div class="progress rounded-pill mb-2" style="height: 6px;">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" id="paymentProgressBar" style="width: 20%;"></div>
                    </div>
                    <div class="text-xs text-muted"><i class="bi bi-lock-fill text-success me-1"></i> 256-Bit SSL Encrypted Sandbox Channel</div>
                </div>

                <!-- State 2: Simulated Failure Screen -->
                <div id="modalStateFailure" class="d-none">
                    <div class="my-3 text-danger">
                        <i class="bi bi-x-circle-fill display-3"></i>
                    </div>
                    <h5 class="fw-bold text-danger mb-1">Payment Declined / Failed</h5>
                    <p class="text-muted small mb-3">
                        Simulation Result: The issuing bank rejected the transaction or the session timed out.
                    </p>
                    <div class="alert alert-light border small text-start mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted">Error Code:</span>
                            <span class="font-monospace text-danger fw-bold">ERR_DEMO_DECLINED_402</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Gateway Status:</span>
                            <span class="text-danger">Card / Bank Declined</span>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary rounded-pill flex-fill" data-bs-dismiss="modal">
                            Cancel &amp; Review Cart
                        </button>
                        <button type="button" class="btn btn-danger rounded-pill flex-fill" id="btnRetryPayment">
                            <i class="bi bi-arrow-repeat me-1"></i> Retry Payment
                        </button>
                    </div>
                </div>

                <!-- State 3: Payment Success Tick -->
                <div id="modalStateSuccess" class="d-none">
                    <div class="my-3 text-success">
                        <i class="bi bi-check-circle-fill display-3"></i>
                    </div>
                    <h5 class="fw-bold text-success mb-1">Payment Successful!</h5>
                    <p class="text-muted small mb-3">Your transaction has been authorized. Placing order...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsLiveRazorpay)
{
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
}

<script>
document.addEventListener("DOMContentLoaded", function () {
    const methodCards = document.querySelectorAll(".payment-method-card");
    const detailViews = document.querySelectorAll(".payment-detail-view");
    const btnPay = document.getElementById("btnInitiatePayment");
    const failureToggle = document.getElementById("simulateFailureToggle");
    const checkoutForm = document.getElementById("checkoutForm");
    
    const paymentModalEl = document.getElementById("paymentProcessModal");
    const paymentModal = new bootstrap.Modal(paymentModalEl);
    
    const stateProcessing = document.getElementById("modalStateProcessing");
    const stateFailure = document.getElementById("modalStateFailure");
    const stateSuccess = document.getElementById("modalStateSuccess");
    const progressBar = document.getElementById("paymentProgressBar");
    const statusText = document.getElementById("processingStatusText");
    const btnRetry = document.getElementById("btnRetryPayment");

    const isLiveRazorpay = @(Model.IsLiveRazorpay ? "true" : "false");

    // Method selection handling
    methodCards.forEach(card => {
        card.addEventListener("click", function () {
            methodCards.forEach(c => c.classList.remove("active-card", "border-success", "bg-success-subtle"));
            this.classList.add("active-card", "border-success");
            
            const radio = this.querySelector("input[type='radio']");
            if (radio) radio.checked = true;

            const method = this.getAttribute("data-method");
            detailViews.forEach(v => v.classList.add("d-none"));
            const targetView = document.getElementById("view-" + method);
            if (targetView) targetView.classList.remove("d-none");
        });
    });

    // Pay button handler
    btnPay.addEventListener("click", function () {
        const selectedMethodRadio = document.querySelector("input[name='SelectedPaymentMethod']:checked");
        const isCod = selectedMethodRadio && selectedMethodRadio.value === "CashOnDelivery";

        if (isCod) {
            checkoutForm.submit();
            return;
        }

        // Live Razorpay Checkout flow
        if (isLiveRazorpay && typeof Razorpay !== "undefined") {
            if (failureToggle && failureToggle.checked) {
                stateProcessing.classList.add("d-none");
                stateFailure.classList.remove("d-none");
                paymentModal.show();
                return;
            }

            const rzpOptions = {
                key: "@Model.RazorpayKeyId",
                amount: Math.round(@Model.Cart.GrandTotal * 100),
                currency: "INR",
                name: "The Great Ayurveda",
                description: "Retail Botanical Pharmacy Order",
                order_id: "@Model.RazorpayOrderId",
                handler: function (response) {
                    const elPid = document.getElementById("rzpPaymentId");
                    const elOid = document.getElementById("rzpOrderId");
                    const elSig = document.getElementById("rzpSignature");
                    if (elPid) elPid.value = response.razorpay_payment_id || "";
                    if (elOid) elOid.value = response.razorpay_order_id || "";
                    if (elSig) elSig.value = response.razorpay_signature || "";
                    checkoutForm.submit();
                },
                modal: {
                    ondismiss: function () {
                        stateProcessing.classList.add("d-none");
                        stateFailure.classList.remove("d-none");
                        paymentModal.show();
                    }
                },
                theme: {
                    color: "#2E7D32"
                }
            };

            const rzp = new Razorpay(rzpOptions);
            rzp.on('payment.failed', function () {
                stateProcessing.classList.add("d-none");
                stateFailure.classList.remove("d-none");
                paymentModal.show();
            });
            rzp.open();
            return;
        }

        // Simulated Demo Payment Modal Flow
        stateProcessing.classList.remove("d-none");
        stateFailure.classList.add("d-none");
        stateSuccess.classList.add("d-none");
        progressBar.style.width = "20%";
        statusText.textContent = "Connecting to simulated bank gateway & verifying credentials...";
        paymentModal.show();

        setTimeout(() => {
            progressBar.style.width = "65%";
            statusText.textContent = "Authenticating secure token with merchant network...";
        }, 800);

        setTimeout(() => {
            progressBar.style.width = "95%";
            if (failureToggle && failureToggle.checked) {
                stateProcessing.classList.add("d-none");
                stateFailure.classList.remove("d-none");
            } else {
                progressBar.style.width = "100%";
                stateProcessing.classList.add("d-none");
                stateSuccess.classList.remove("d-none");
                setTimeout(() => {
                    checkoutForm.submit();
                }, 800);
            }
        }, 1600);
    });

    btnRetry.addEventListener("click", function () {
        if (failureToggle) failureToggle.checked = false;
        paymentModal.hide();
    });
});
</script>

<style>
.checkout-payment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: 0.75rem;
}
@@media (max-width: 575.98px) {
    .checkout-payment-grid {
        grid-template-columns: 1fr;
    }
}
.payment-method-card {
    transition: all 0.2s ease;
    user-select: none;
}
.payment-method-card:hover {
    border-color: #2E7D32 !important;
    transform: translateY(-2px);
}
.payment-method-card.active-card {
    border-color: #2E7D32 !important;
    background-color: #F4F9F5 !important;
}
.payment-radio {
    width: 20px;
    height: 20px;
    cursor: pointer;
}
</style>
