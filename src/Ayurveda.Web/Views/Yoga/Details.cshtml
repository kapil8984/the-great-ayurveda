@model Ayurveda.Application.ViewModels.YogaDetailsViewModel
@{
    ViewData["Title"] = $"{Model.SanskritName} ({Model.EnglishName}) - Classical Asana Guide";
}

<div class="tga-yoga-details container py-4 py-lg-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-success text-decoration-none">Classical Yoga &amp; Asanas</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.SanskritName</li>
        </ol>
    </nav>

    <!-- Hero Section -->
    <div class="row g-4 g-lg-5 mb-5 align-items-center">
        <div class="col-lg-5">
            <div class="tga-yoga-hero-img-wrap p-3 bg-white rounded-4 border shadow-sm position-relative text-center">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/yoga/surya-namaskar.webp" : Model.ImageUrl)" 
                     alt="@Model.YogaName" 
                     class="img-fluid rounded-3 tga-hero-img" 
                     width="600" 
                     height="450" />
                <div class="position-absolute top-0 start-0 p-4 d-flex flex-wrap gap-2">
                    <span class="badge bg-white text-dark shadow-xs border px-3 py-2 rounded-pill fw-medium">
                        <i class="bi bi-activity text-success me-1"></i>@Model.Difficulty
                    </span>
                    <span class="badge bg-white text-secondary shadow-xs border px-3 py-2 rounded-pill fw-medium">
                        <i class="bi bi-clock me-1"></i>@Model.Duration
                    </span>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">
                    @(Model.CategoryName ?? "Classical Hatha")
                </span>
                <span class="text-warning small fw-bold">
                    <i class="bi bi-star-fill"></i> @Model.AverageRating.ToString("0.0") / 5.0
                </span>
            </div>

            <h1 class="display-6 fw-bold text-dark mb-1 font-serif">@Model.SanskritName</h1>
            <h2 class="h5 text-muted fw-normal mb-3">@Model.EnglishName</h2>

            <p class="text-secondary lead fs-6 mb-4">@Model.Description</p>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="p-3 bg-white border rounded-3 h-100 shadow-xs">
                        <h6 class="fw-bold text-success mb-2" style="font-size: 0.85rem;">
                            <i class="bi bi-check2-circle me-1"></i> Traditionally Practiced For
                        </h6>
                        <ul class="list-unstyled small text-dark d-flex flex-column gap-2 mb-0">
                            @foreach (var b in Model.Benefits)
                            {
                                <li class="d-flex align-items-start">
                                    <i class="bi bi-check-lg text-success me-2 mt-1 flex-shrink-0"></i>
                                    <span>@b</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="p-3 bg-light border border-warning-subtle rounded-3 h-100 shadow-xs">
                        <h6 class="fw-bold text-danger mb-2" style="font-size: 0.85rem;">
                            <i class="bi bi-shield-exclamation me-1"></i> Cautions &amp; Contraindications
                        </h6>
                        <p class="small text-secondary mb-0" style="line-height: 1.6;">
                            @(string.IsNullOrEmpty(Model.Precautions) 
                                ? "Practice on an empty stomach. If experiencing spinal disc or cardiac conditions, consult an expert instructor before performing." 
                                : Model.Precautions)
                        </p>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3">
                <a href="#stepsSection" class="btn btn-success rounded-pill px-4 py-2 fw-semibold shadow-xs">
                    <i class="bi bi-list-ol me-1"></i> View Step-by-Step Steps
                </a>
                @if (!string.IsNullOrEmpty(Model.VideoId))
                {
                    <a href="#videoSection" class="btn btn-outline-success rounded-pill px-4 py-2 fw-semibold">
                        <i class="bi bi-play-circle me-1"></i> Watch Video Demonstration
                    </a>
                }
            </div>
        </div>
    </div>

    <!-- YouTube nocookie Facade Section -->
    @if (!string.IsNullOrEmpty(Model.VideoId))
    {
        <div id="videoSection" class="card border-0 shadow-sm rounded-4 overflow-hidden mb-5 bg-white">
            <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-youtube text-danger me-2"></i>Official Classical Demonstration</h5>
                    <small class="text-muted">Recorded &amp; preserved by @(string.IsNullOrEmpty(Model.ChannelTitle) ? "Ministry of Ayush" : Model.ChannelTitle)</small>
                </div>
                <span class="badge bg-light text-dark border px-3 py-1 rounded-pill small">
                    <i class="bi bi-lock-fill text-success me-1"></i> Privacy-Enhanced (youtube-nocookie)
                </span>
            </div>
            <div class="card-body p-3 p-md-4">
                <!-- Facade container: loads external iframe ONLY when clicked -->
                <div class="tga-video-facade ratio ratio-16x9 rounded-3 overflow-hidden position-relative bg-black" 
                     id="detailsVideoFacade" 
                     data-video-id="@Model.VideoId" 
                     title="Click to play demonstration">
                    <img src="@Model.ImageUrl" 
                         alt="@Model.YogaName Demonstration" 
                         class="tga-facade-bg position-absolute top-0 start-0 w-100 h-100" 
                         style="object-fit: cover; opacity: 0.65; filter: blur(2px);" />
                    <div class="position-absolute top-50 start-50 translate-middle text-center text-white z-2 pointer-events-none">
                        <div class="tga-facade-play-btn rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center shadow-lg">
                            <i class="bi bi-play-fill text-white fs-1"></i>
                        </div>
                        <span class="fw-semibold text-shadow-sm d-block">Watch Practice Demonstration</span>
                        <small class="text-white-50">Click to start video (loads from youtube-nocookie.com)</small>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Step-by-Step Instructions Grid / Mobile Horizontal Scroller -->
    <div id="stepsSection" class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <span class="badge bg-success-subtle text-success text-uppercase fw-semibold px-3 py-1 rounded-pill mb-1">
                    Guided Sequence
                </span>
                <h3 class="fw-bold text-dark mb-0 font-serif">5 to 6 Stage Step-by-Step Sequence</h3>
            </div>
            <small class="text-muted d-block d-md-none"><i class="bi bi-arrows-expand me-1"></i> Swipe horizontally</small>
        </div>

        @if (Model.Steps != null && Model.Steps.Any())
        {
            <div class="tga-steps-scroll-container pb-3">
                <div class="row g-4 flex-nowrap flex-md-wrap tga-steps-row">
                    @foreach (var step in Model.Steps)
                    {
                        var stepImg = !string.IsNullOrEmpty(step.ImageUrl) ? step.ImageUrl : Model.ImageUrl;
                        <div class="col-10 col-sm-8 col-md-6 col-lg-4 tga-step-col flex-shrink-0 flex-md-shrink-1">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white tga-step-card d-flex flex-column">
                                <div class="tga-step-img-wrap position-relative bg-light">
                                    <img src="@stepImg" 
                                         alt="@step.Title" 
                                         class="w-100 h-100 object-fit-cover" 
                                         loading="lazy" 
                                         width="480" 
                                         height="360" />
                                    <div class="position-absolute top-0 start-0 p-3">
                                        <span class="badge bg-success text-white px-3 py-1 rounded-pill shadow-xs fw-bold">
                                            Step @step.StepNumber
                                        </span>
                                    </div>
                                </div>
                                <div class="card-body p-4 d-flex flex-column">
                                    <h5 class="fw-bold text-dark mb-2 font-serif" style="font-size: 1.05rem;">@step.Title</h5>
                                    <p class="text-secondary small mb-0" style="line-height: 1.6;">@step.Instruction</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card p-4 bg-white border-0 shadow-sm rounded-4">
                <p class="text-secondary mb-0" style="white-space: pre-line; line-height: 1.7;">@Model.Instructions</p>
            </div>
        }
    </div>

    <!-- Reviews Section -->
    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-chat-heart text-success me-2"></i>Practitioner Experiences</h5>
            <div class="row g-3">
                @foreach (var rev in Model.Reviews)
                {
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-semibold text-dark small">@rev.UserName</span>
                                <span class="text-warning small"><i class="bi bi-star-fill"></i> @rev.Rating</span>
                            </div>
                            <p class="small text-muted mb-0">@rev.ReviewText</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: Georgia, 'Times New Roman', serif;
    }
    .tga-yoga-hero-img-wrap {
        background: #f7f9f6;
    }
    .tga-hero-img {
        max-height: 380px;
        width: 100%;
        object-fit: cover;
    }
    .tga-video-facade {
        cursor: pointer;
    }
    .tga-facade-play-btn {
        width: 72px;
        height: 72px;
        background: #dc3545;
        transition: transform 0.2s ease, background-color 0.2s ease;
    }
    .tga-video-facade:hover .tga-facade-play-btn {
        transform: scale(1.1);
        background: #bb2d3b;
    }
    .tga-step-card {
        border: 1px solid rgba(0, 0, 0, 0.05) !important;
        transition: transform 0.2s ease;
    }
    .tga-step-card:hover {
        transform: translateY(-3px);
    }
    .tga-step-img-wrap {
        height: 200px;
        overflow: hidden;
    }

    /* Mobile horizontal swipe support for steps */
    @@media (max-width: 767.98px) {
        .tga-steps-scroll-container {
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
        }
        .tga-steps-row {
            margin-right: -0.75rem;
            margin-left: -0.75rem;
            padding-right: 0.75rem;
            padding-left: 0.75rem;
        }
        .tga-step-col {
            scroll-snap-align: start;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const facade = document.getElementById('detailsVideoFacade');
        if (!facade) return;

        facade.addEventListener('click', function () {
            const videoId = this.getAttribute('data-video-id');
            if (!videoId) return;

            // Replace facade with iframe dynamically on interaction
            this.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&rel=0" 
                                     title="Classical Demonstration" 
                                     allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                                     allowfullscreen 
                                     style="width: 100%; height: 100%; border: 0;" 
                                     class="position-absolute top-0 start-0 w-100 h-100"></iframe>`;
        });
    });
</script>
