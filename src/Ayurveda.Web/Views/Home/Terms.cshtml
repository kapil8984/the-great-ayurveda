@{
    ViewData["Title"] = "Terms & Conditions (Demo)";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Demo Disclaimer Banner -->
            <div class="alert alert-warning border border-warning-subtle rounded-4 p-3 mb-4 d-flex align-items-center gap-3">
                <i class="bi bi-info-circle-fill text-warning fs-3 flex-shrink-0"></i>
                <div class="small">
                    <strong>Demo Platform Notice:</strong> This website is an educational demonstration prototype. No real commercial transactions, medical contracts, or statutory liabilities are formed through this interface.
                </div>
            </div>

            <h1 class="display-6 fw-bold mb-4" style="font-family: Georgia, serif;">Terms &amp; Conditions (Demo)</h1>
            
            <div class="p-4 bg-white rounded-4 shadow-sm border mb-4">
                <h5 class="fw-bold text-success mb-3">1. Demonstration Scope &amp; Usage</h5>
                <p class="text-muted small">
                    The Great Ayurveda is a demonstration platform engineered to exhibit modern full-stack web architecture and Ayurvedic catalog presentation. All product listings, pricing, and doctor profiles represent sample or illustrative data.
                </p>
                
                <h5 class="fw-bold text-success mb-3">2. Simulated Orders &amp; Payments</h5>
                <p class="text-muted small">
                    All payment processing interfaces provided on this platform are simulated in sandbox mode. No real money, payment credentials, credit card charges, or UPI transactions are ever processed.
                </p>

                <h5 class="fw-bold text-success mb-3">3. Tele-Consultation Guidance</h5>
                <p class="text-muted small">
                    Doctor profiles and consultation scheduling features on this site are illustrative demonstration components. In case of acute medical emergencies, users must contact their local emergency medical facilities immediately.
                </p>

                <h5 class="fw-bold text-success mb-3">4. Intellectual Property &amp; Trademarks</h5>
                <p class="text-muted small">
                    Ayurvedic herbology references and classical text concepts (Charaka Samhita, Sushruta Samhita) belong to the public domain heritage of Indian medicine. Formulation brand names and trademarks belong to their respective proprietary owners.
                </p>
            </div>
        </div>
    </div>
</div>
