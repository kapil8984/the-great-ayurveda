@{
    ViewData["Title"] = "Frequently Asked Questions";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="text-success fw-bold text-uppercase small">Knowledge & Guidance</span>
        <h1 class="display-6 fw-bold" style="font-family: Georgia, serif;">Frequently Asked Questions</h1>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="accordion shadow-sm" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                            How do online Ayurvedic doctor consultations work?
                        </button>
                    </h2>
                    <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            You choose a verified AYUSH practitioner, pick a convenient date and time slot, and join a secure one-on-one browser audio or video room. The doctor conducts a thorough intake regarding your constitution (Prakriti), health concerns, and current lifestyle, followed by a personalized Ayurvedic regimen.
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                            Are the herbal products lab-tested and certified?
                        </button>
                    </h2>
                    <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Yes. All formulations hosted on The Great Ayurveda are manufactured in GMP-certified facilities, adhering to the Ayurvedic Pharmacopoeia of India (API) standards with rigorous batch screening for heavy metals, microbial safety, and authenticity.
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                            What is your shipping policy and delivery timeline?
                        </button>
                    </h2>
                    <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            Orders are dispatched within 24-48 business hours. Deliveries across major Indian metros typically arrive within 2-4 business days, and other regions within 4-7 business days. We provide free shipping on all orders exceeding ₹499.
                        </div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                            Can I take Ayurvedic herbs alongside my conventional medications?
                        </button>
                    </h2>
                    <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">
                            We always recommend discussing with an AYUSH practitioner before introducing any new supplement or botanical formula into your daily regimen, especially if you are on prescription medications for cardiac conditions, blood pressure, or diabetes.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
