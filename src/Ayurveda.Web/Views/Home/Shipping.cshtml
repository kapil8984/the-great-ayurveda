@{
    ViewData["Title"] = "Shipping & Delivery Policy (Demo)";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Demo Disclaimer Banner -->
            <div class="alert alert-warning border border-warning-subtle rounded-4 p-3 mb-4 d-flex align-items-center gap-3">
                <i class="bi bi-info-circle-fill text-warning fs-3 flex-shrink-0"></i>
                <div class="small">
                    <strong>Demo Platform Notice:</strong> This shipping policy is for demonstration purposes. Orders placed in this environment generate sample tracking IDs and simulated fulfillment workflows.
                </div>
            </div>

            <h1 class="display-6 fw-bold mb-4" style="font-family: Georgia, serif;">Shipping &amp; Delivery Policy (Demo)</h1>
            
            <div class="p-4 bg-white rounded-4 shadow-sm border mb-4">
                <h5 class="fw-bold text-success mb-3">1. Pan-India Distribution Network (Simulated)</h5>
                <p class="text-muted small">
                    The platform architecture models express dispatch capabilities across metro zones (Delhi NCR, Mumbai, Bengaluru, Hyderabad, Chennai, Kolkata) and regional delivery hubs nationwide.
                </p>
                
                <h5 class="fw-bold text-success mb-3">2. Dispatch Timelines</h5>
                <p class="text-muted small">
                    Standard orders are simulated as dispatched within 24 to 48 business hours from regional warehouse hubs. Metro deliveries typically simulate arrival within 2-3 business days.
                </p>

                <h5 class="fw-bold text-success mb-3">3. Tracking &amp; Notifications</h5>
                <p class="text-muted small">
                    Upon order completion in the demo store, a sample tracking number (e.g. TGA-IN-XXXX) is created. Users can view status updates (Pending, Processing, Shipped, Delivered) directly within the "Track Order" portal.
                </p>

                <h5 class="fw-bold text-success mb-3">4. Free Shipping Tier</h5>
                <p class="text-muted small">
                    Orders with total formulation value above ₹499 qualify for complimentary zero-fee shipping in the shopping basket calculator.
                </p>
            </div>
        </div>
    </div>
</div>
