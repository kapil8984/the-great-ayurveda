@{
    ViewData["Title"] = "Privacy Policy & Medical Terms";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <h1 class="display-6 fw-bold mb-4" style="font-family: Georgia, serif;">Privacy Policy & Terms of Service</h1>
            
            <div class="p-4 bg-white rounded-4 shadow-sm border mb-4">
                <h5 class="fw-bold text-success mb-3">1. Data Privacy & Health Information</h5>
                <p class="text-muted small">
                    The Great Ayurveda respects patient confidentiality and complies with the Digital Personal Data Protection Act (DPDP) and prevailing telemedicine guidelines in India. Health records, intake questionnaires, and consultation notes are encrypted and accessible strictly by your designated consulting doctor and you.
                </p>
                
                <h5 class="fw-bold text-success mb-3">2. Statutory Healthcare Terms</h5>
                <p class="text-muted small">
                    This platform serves solely as an intermediary connecting licensed AYUSH medical practitioners and consumers. Tele-consultations are not substitutes for physical in-person emergency room care. In case of acute medical emergencies, please promptly dial your local national emergency services.
                </p>

                <h5 class="fw-bold text-success mb-3">3. Product Guidance</h5>
                <p class="text-muted small">
                    Classical Ayurvedic formulations are based on historical principles of dosha balancing. Descriptions reflect traditional usage in Ayurvedic texts and do not make disease-curative claims.
                </p>
            </div>
        </div>
    </div>
</div>
