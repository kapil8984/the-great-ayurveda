@model Ayurveda.Application.ViewModels.HomeViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnv
@{
    ViewData["Title"] = "The Great Ayurveda | Authentic Ayurveda Care & Consultation";
    var heroBanners = ViewBag.HeroBanners as List<Ayurveda.Domain.Entities.Banner> ?? new();
    var middleBanners = ViewBag.MiddleBanners as List<Ayurveda.Domain.Entities.Banner> ?? new();

    string? GetMobileBannerUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return null;
        var ext = System.IO.Path.GetExtension(url);
        if (string.IsNullOrEmpty(ext)) return null;
        var mobileUrl = url.Substring(0, url.Length - ext.Length) + "-m" + ext;
        var webRoot = WebHostEnv.WebRootPath ?? System.IO.Path.Combine(WebHostEnv.ContentRootPath, "wwwroot");
        var physical = System.IO.Path.Combine(webRoot, mobileUrl.TrimStart('/', '\\').Replace('/', System.IO.Path.DirectorySeparatorChar));
        return System.IO.File.Exists(physical) ? mobileUrl : null;
    }
}

@section Styles {
    @if (heroBanners.Any())
    {
        var firstHero = heroBanners.First();
        var mobileFirst = GetMobileBannerUrl(firstHero.ImageUrl);
        @if (!string.IsNullOrEmpty(mobileFirst))
        {
            <link rel="preload" as="image" href="@mobileFirst" media="(max-width: 576px)" />
        }
        <link rel="preload" as="image" href="@firstHero.ImageUrl" media="(min-width: 577px)" />
    }
}

@if (heroBanners.Any())
{
    <!-- Storefront Responsive Ken Burns Hero Carousel (Autoplay 4.5s) -->
    <div class="hero-carousel-container position-relative overflow-hidden mb-4">
        <div id="homeHeroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="4500" data-bs-pause="hover">
            <!-- Indicators with Dynamic Progress Bar -->
            <div class="carousel-indicators tga-carousel-indicators mb-3">
                @for (int i = 0; i < heroBanners.Count; i++)
                {
                    <button type="button" data-bs-target="#homeHeroCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "") tga-indicator-dot" aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i+1)">
                        <span class="progress-bar-fill"></span>
                    </button>
                }
            </div>

            <!-- Slides Deck -->
            <div class="carousel-inner">
                @for (int i = 0; i < heroBanners.Count; i++)
                {
                    var b = heroBanners[i];
                    var mobUrl = GetMobileBannerUrl(b.ImageUrl);
                    <div class="carousel-item @(i == 0 ? "active" : "")" data-slide-index="@i">
                        <a href="@(b.LinkUrl ?? "/Shop")" class="d-block text-decoration-none position-relative hero-slide-link">
                            <div class="hero-slide-img-wrap overflow-hidden">
                                <picture class="hero-banner-picture w-100 h-100">
                                    @if (!string.IsNullOrEmpty(mobUrl))
                                    {
                                        <source media="(max-width: 576px)" srcset="@mobUrl" />
                                    }
                                    <img src="@b.ImageUrl" 
                                         class="d-block w-100 banner-img hero-kenburns-img" 
                                         alt="@b.Title" 
                                         data-fallback="/images/placeholder.svg" 
                                         decoding="async" 
                                         fetchpriority="@(i == 0 ? "high" : "auto")" />
                                </picture>
                            </div>
                            <div class="hero-overlay-gradient"></div>
                            @if (!string.IsNullOrWhiteSpace(b.Title))
                            {
                                <div class="carousel-caption text-start banner-caption-box p-3 p-md-4 p-lg-5">
                                    <span class="badge bg-warning bg-opacity-90 text-dark fw-bold px-3 py-1 rounded-pill mb-2 shadow-xs text-uppercase small banner-badge">
                                        <i class="bi bi-stars me-1"></i> Authentic Ayurveda Heritage
                                    </span>
                                    <h2 class="display-5 fw-bold text-white mb-2 banner-caption-title font-serif">@b.Title</h2>
                                    @if (!string.IsNullOrWhiteSpace(b.Subtitle))
                                    {
                                        <p class="lead text-light text-opacity-90 mb-3 mb-md-4 banner-caption-subtitle max-w-700">@b.Subtitle</p>
                                    }
                                    <span class="btn btn-tga-gold btn-lg fw-bold rounded-pill px-4 py-2 banner-caption-btn text-dark shadow-md">
                                        Explore Formulations <i class="bi bi-arrow-right ms-2"></i>
                                    </span>
                                </div>
                            }
                        </a>
                    </div>
                }
            </div>

            <!-- Stylish Navigation Arrows (Hidden on mobile phones, swipe + dots active) -->
            <button class="carousel-control-prev tga-carousel-nav-btn start-0 ms-3 d-none d-md-flex" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="prev" aria-label="Previous Slide">
                <span class="carousel-nav-icon shadow-sm"><i class="bi bi-chevron-left"></i></span>
            </button>
            <button class="carousel-control-next tga-carousel-nav-btn end-0 me-3 d-none d-md-flex" type="button" data-bs-target="#homeHeroCarousel" data-bs-slide="next" aria-label="Next Slide">
                <span class="carousel-nav-icon shadow-sm"><i class="bi bi-chevron-right"></i></span>
            </button>
        </div>
    </div>
}

