<!-- ========================================================================
     SECTION 4: "FIND YOUR PRAKRITI" MINI QUIZ CARD (VATA / PITTA / KAPHA)
     ======================================================================== -->
<section class="py-5 bg-light" id="prakritiQuizSection">
    <div class="container py-4">
        <div class="text-center max-w-700 mx-auto mb-5">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 fw-bold text-uppercase">
                Interactive Vedic Assessment
            </span>
            <h2 class="display-5 fw-bold font-serif text-dark mt-2 mb-3">
                Discover Your True Ayurvedic Prakriti
            </h2>
            <p class="text-muted">
                According to the Charaka Samhita, every human body has a unique elemental constitution (Dosha). Answer 5 simple questions to understand your dominant bio-energy and receive personalized guidance.
            </p>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="prakriti-quiz-card p-4 p-md-5">
                    <!-- Progress Bar -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-xs fw-bold text-success text-uppercase" id="quizStepCounter">Question 1 of 5</span>
                        <span class="text-xs text-muted">Takes ~90 seconds</span>
                    </div>
                    <div class="progress mb-4" style="height: 6px;">
                        <div class="progress-bar bg-success" id="quizProgressBar" style="width: 20%;"></div>
                    </div>

                    <!-- Quiz Question Body -->
                    <div id="quizBodyContainer">
                        <h4 class="fw-bold font-serif text-dark mb-4" id="quizQuestionText">
                            1. What best describes your physical frame and body build?
                        </h4>
                        <div id="quizOptionsContainer" class="d-flex flex-column gap-2 mb-4">
                            <!-- Populated dynamically via site.js -->
                        </div>
                    </div>

                    <!-- Quiz Result Container (Initially Hidden) -->
                    <div id="quizResultContainer" class="d-none">
                        <!-- Populated dynamically upon quiz completion -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

