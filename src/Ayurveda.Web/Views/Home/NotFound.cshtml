@{
    ViewData["Title"] = "Page Not Found (404) | The Great Ayurveda";
}

<div class="container py-5 text-center my-auto">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="p-5 bg-white rounded-4 shadow-sm border my-4">
                <div class="mb-3 text-warning">
                    <i class="bi bi-compass fs-1" style="font-size: 4rem;"></i>
                </div>
                <h1 class="display-5 fw-bold text-dark mb-2" style="font-family: Georgia, serif;">Page Not Found</h1>
                <p class="badge bg-warning-subtle text-warning-emphasis px-3 py-2 rounded-pill font-monospace mb-3">HTTP Error 404</p>
                <p class="text-secondary mb-4 leading-relaxed">
                    The Ayurvedic resource, product formulation, or page you were seeking appears to have moved, been renamed, or does not exist.
                </p>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-tga-primary px-4 py-2 rounded-pill">
                        <i class="bi bi-house-door me-1"></i> Return Home
                    </a>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-success px-4 py-2 rounded-pill">
                        <i class="bi bi-shop me-1"></i> Explore Medicines
                    </a>
                    <a asp-controller="Doctors" asp-action="Index" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                        <i class="bi bi-person-heart me-1"></i> Consult Doctors
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
