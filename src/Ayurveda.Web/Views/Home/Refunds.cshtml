@{
    ViewData["Title"] = "Refund & Return Policy (Demo)";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <!-- Demo Disclaimer Banner -->
            <div class="alert alert-warning border border-warning-subtle rounded-4 p-3 mb-4 d-flex align-items-center gap-3">
                <i class="bi bi-info-circle-fill text-warning fs-3 flex-shrink-0"></i>
                <div class="small">
                    <strong>Demo Platform Notice:</strong> This policy is an illustrative demonstration template. Because no real funds are ever collected on this demonstration platform, actual monetary refunds are neither required nor processed.
                </div>
            </div>

            <h1 class="display-6 fw-bold mb-4" style="font-family: Georgia, serif;">Refund &amp; Return Policy (Demo)</h1>
            
            <div class="p-4 bg-white rounded-4 shadow-sm border mb-4">
                <h5 class="fw-bold text-success mb-3">1. Illustrative 14-Day Return Window</h5>
                <p class="text-muted small">
                    Under standard retail policy guidelines represented here, unopened classical formulations, oils, and churnas with intact tamper seals may be requested for return within 14 calendar days of delivery.
                </p>
                
                <h5 class="fw-bold text-success mb-3">2. Damaged or Tampered Shipments</h5>
                <p class="text-muted small">
                    In a production retail environment, items delivered with transit damage, seal compromise, or discrepancy against order invoices qualify for immediate no-cost replacement upon photo verification.
                </p>

                <h5 class="fw-bold text-success mb-3">3. Tele-Consultation Cancellation</h5>
                <p class="text-muted small">
                    Consultation appointments scheduled through the doctor booking module can be cancelled up to 2 hours prior to the scheduled slot for simulated full store credit.
                </p>

                <h5 class="fw-bold text-success mb-3">4. Simulated Refund Settlement</h5>
                <p class="text-muted small">
                    In this demonstration sandbox, any simulated refund triggers an immediate status update on the sample order view without involving banking gateways.
                </p>
            </div>
        </div>
    </div>
</div>
