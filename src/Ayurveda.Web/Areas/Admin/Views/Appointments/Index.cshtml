@model List<Ayurveda.Domain.Entities.Appointment>
@{
    ViewData["Title"] = "Telemedicine Appointments & Consultations";
    var currentStatus = ViewBag.SelectedStatus as string ?? "All";
    var statuses = new[] { "All", "Confirmed", "Pending", "Completed", "Cancelled", "Declined" };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-calendar2-heart text-success me-2"></i>Telemedicine Consultations</h2>
        <p class="text-muted small mb-0">Oversee encrypted WebRTC sessions, prescription issuances, disputes, and no-shows.</p>
    </div>
    <div class="badge bg-success-subtle text-success fs-6 px-3 py-2 border border-success-subtle rounded-pill">
        Total Consultations: @ViewBag.TotalCount
    </div>
</div>

<!-- Status Filters -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var s in statuses)
        {
            <a asp-action="Index" asp-route-status="@(s == "All" ? "" : s)" asp-route-search="@ViewBag.SearchQuery" 
               class="btn btn-sm rounded-pill px-3 @(currentStatus == s ? "btn-success text-white shadow-xs" : "btn-outline-secondary")">
                @s
            </a>
        }
    </div>

    <form method="get" class="row g-2 align-items-center">
        <input type="hidden" name="status" value="@ViewBag.SelectedStatus" />
        <div class="col-md-9">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.SearchQuery" class="form-control border-start-0" placeholder="Search by patient name, doctor, chief health concern..." />
            </div>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-success btn-sm rounded-pill w-100">Search</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Reset</a>
        </div>
    </form>
</div>

<!-- Appointments Table -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small text-nowrap">
                <tr>
                    <th class="ps-4">Appointment</th>
                    <th>Consulting Vaidya</th>
                    <th>Patient</th>
                    <th>Date &amp; Time (UTC)</th>
                    <th>Mode</th>
                    <th class="text-center">Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x display-4 d-block mb-2"></i>
                            No telemedicine appointments match the filter.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <a asp-action="Details" asp-route-id="@a.Id" class="fw-bold text-dark text-decoration-none">
                                    #@a.Id.ToString("D5")
                                </a>
                                <div class="text-muted" style="font-size: 0.725rem;">Fee: ₹@a.ConsultationFee</div>
                            </td>
                            <td>
                                <div class="fw-bold small text-dark">Dr. @a.Doctor.DoctorName</div>
                                <div class="text-muted" style="font-size: 0.725rem;">@a.Doctor.Email</div>
                            </td>
                            <td>
                                <div class="small fw-semibold text-dark">@a.PatientName</div>
                                <div class="text-muted text-truncate" style="font-size: 0.725rem; max-width: 160px;">@(a.HealthConcern ?? "General Wellness")</div>
                            </td>
                            <td class="small text-muted">
                                @a.StartUtc.ToString("dd MMM yyyy")<br />
                                <strong>@a.TimeSlot</strong>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi @(a.ConsultationType == Ayurveda.Domain.Enums.ConsultationType.Video ? "bi-camera-video text-primary" : a.ConsultationType == Ayurveda.Domain.Enums.ConsultationType.Audio ? "bi-telephone text-success" : "bi-chat-dots text-warning") me-1"></i>
                                    @a.ConsultationType
                                </span>
                            </td>
                            <td class="text-center">
                                @if (a.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Completed</span>
                                }
                                else if (a.Status == "Confirmed")
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Confirmed</span>
                                }
                                else if (a.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Pending</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">@a.Status</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@a.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1">
                                    Clinical Audit
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if ((int)ViewBag.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3">
            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    @for (int p = 1; p <= (int)ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == (int)ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@ViewBag.SelectedStatus" asp-route-search="@ViewBag.SearchQuery">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>
