@model List<(Ayurveda.Domain.Entities.ApplicationUser User, string Role)>
@{
    ViewData["Title"] = "Administrative Roles & Staff Permissions";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-shield-lock text-success me-2"></i>Admin Roles &amp; Staff Permissions</h2>
        <p class="text-muted small mb-0">Role-based access control (RBAC), multi-factor enforcement, and admin users directory.</p>
    </div>
    <button type="button" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs fw-semibold" data-bs-toggle="modal" data-bs-target="#createAdminModal">
        <i class="bi bi-person-plus me-1"></i> Provision Admin User
    </button>
</div>

<!-- 4 Administrative Roles Hierarchy Card -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="p-3 bg-white rounded-4 border-0 shadow-sm border-start border-4 border-danger">
            <h6 class="fw-bold text-danger mb-1">SuperAdmin</h6>
            <div class="text-muted small">Unrestricted access across all financial, database, RBAC, and system settings.</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 bg-white rounded-4 border-0 shadow-sm border-start border-4 border-success">
            <h6 class="fw-bold text-success mb-1">CatalogManager</h6>
            <div class="text-muted small">Authority over herbal products, pricing, stock, Yoga, and marketing coupons.</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 bg-white rounded-4 border-0 shadow-sm border-start border-4 border-primary">
            <h6 class="fw-bold text-primary mb-1">SupportAgent</h6>
            <div class="text-muted small">Handles customer orders, refunds, appointment disputes, and reviews.</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="p-3 bg-white rounded-4 border-0 shadow-sm border-start border-4 border-warning">
            <h6 class="fw-bold text-warning mb-1">FinanceManager</h6>
            <div class="text-muted small">Access to financial ledgers, GST tax reporting, refunds, and doctor payout settlement.</div>
        </div>
    </div>
</div>

<!-- Admin Users Table -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th class="ps-4">Staff Name</th>
                    <th>Email Address</th>
                    <th>Administrative Role</th>
                    <th>Provisioned On</th>
                    <th class="text-center">2FA Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <div class="rounded-circle bg-success-subtle text-success mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                                <i class="bi bi-people"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-1">No Administrative Personnel Found</h6>
                            <p class="text-muted small mb-3">Provision staff accounts with segregated role-based permissions.</p>
                            <button type="button" class="btn btn-success btn-sm rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#createAdminModal">
                                <i class="bi bi-person-plus me-1"></i> Provision Admin User
                            </button>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var staff in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">
                                <i class="bi bi-person-badge text-success me-2"></i>@staff.User.FullName
                            </td>
                            <td class="small">@staff.User.Email</td>
                            <td>
                                <span class="badge @(staff.Role == "SuperAdmin" ? "bg-danger" : staff.Role == "FinanceManager" ? "bg-warning text-dark" : staff.Role == "CatalogManager" ? "bg-success" : "bg-primary")">
                                    @staff.Role
                                </span>
                            </td>
                            <td class="small text-muted">@staff.User.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="bi bi-shield-check me-1"></i>Enforced
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Provision Admin Modal -->
<div class="modal fade" id="createAdminModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-person-plus text-success me-2"></i>Provision Admin Staff</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Full Legal Name *</label>
                        <input type="text" name="fullName" class="form-control rounded-3" placeholder="e.g. Ramesh Chandra" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Corporate Email Address *</label>
                        <input type="email" name="email" class="form-control rounded-3" placeholder="user@thegreatayurveda.com" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Assigned Administrative Role *</label>
                        <select name="role" class="form-select rounded-3" required>
                            <option value="CatalogManager">CatalogManager (Products &amp; Campaigns)</option>
                            <option value="SupportAgent">SupportAgent (Customer Orders &amp; Disputes)</option>
                            <option value="FinanceManager">FinanceManager (Ledger, GST &amp; Payouts)</option>
                            <option value="SuperAdmin">SuperAdmin (Full Unrestricted Access)</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Initial Password *</label>
                        <input type="password" name="password" class="form-control rounded-3" minlength="8" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Provision Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
