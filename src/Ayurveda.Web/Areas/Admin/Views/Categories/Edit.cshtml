@model Ayurveda.Domain.Entities.Category
@{
    ViewData["Title"] = $"Edit Category: {Model.Name}";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small">
        <i class="bi bi-arrow-left me-1"></i> Back to Categories Catalog
    </a>
    <h3 class="fw-bold text-dark mt-2">
        <i class="bi bi-pencil-square text-primary me-2"></i> Edit Category: @Model.Name
    </h3>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" id="editCategoryForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ImageUrl" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Current Category Icon</label>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/categories/herbs.svg" : Model.ImageUrl)" 
                                 alt="@Model.Name" 
                                 class="border rounded-3 p-1 bg-white" 
                                 style="width: 64px; height: 64px; object-fit: contain;" />
                            <span class="text-muted small">@(Model.ImageUrl ?? "Default SVG placeholder")</span>
                        </div>
                        <label class="form-label fw-semibold">Upload New Icon (Optional)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" id="categoryImgInput" />
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" />
                        <label class="form-check-label fw-semibold" for="isActiveSwitch">Category Active & Visible to Patients</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" id="btnSubmitEditCategory" class="btn btn-primary rounded-pill px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i> Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
