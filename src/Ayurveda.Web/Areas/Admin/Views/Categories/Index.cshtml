@model IEnumerable<Ayurveda.Domain.Entities.Category>
@{
    ViewData["Title"] = "Categories Management";
    var search = ViewBag.Search as string;
    bool? active = ViewBag.Active as bool?;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalCount = ViewBag.TotalCount ?? 0;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-grid text-success me-2"></i> Category Catalog
        </h3>
        <p class="text-muted small mb-0">Manage classical Ayurvedic health categories, doshic departments, and icons.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Add Category
        </a>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0" placeholder="Search by category name or description..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="active" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="true" selected="@(active == true)">Active Only</option>
                    <option value="false" selected="@(active == false)">Disabled Only</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-pill px-4">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">Clear</a>
                <span class="ms-auto align-self-center text-muted small"><strong>@totalCount</strong> categories</span>
            </div>
        </form>
    </div>
</div>

<!-- Categories Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 80px;">Icon</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th class="text-center" style="width: 130px;">Products</th>
                    <th class="text-center" style="width: 120px;">Status</th>
                    <th class="text-end" style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-folder-x fs-1 d-block mb-2 text-secondary"></i>
                            No categories found matching criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>
                                <img src="@(string.IsNullOrEmpty(cat.ImageUrl) ? "/images/categories/herbs.svg" : cat.ImageUrl)" 
                                     alt="@cat.Name" 
                                     class="rounded-3 border p-1 bg-white" 
                                     style="width: 48px; height: 48px; object-fit: contain;" />
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@cat.Name</div>
                                <span class="badge bg-light text-secondary border">ID: #@cat.Id</span>
                            </td>
                            <td>
                                <div class="text-muted small text-truncate" style="max-width: 380px;">
                                    @(cat.Description ?? "No description provided.")
                                </div>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-semibold">
                                    @(cat.Products?.Count ?? 0) formulations
                                </span>
                            </td>
                            <td class="text-center">
                                @if (cat.IsActive)
                                {
                                    <span class="badge bg-success px-3 py-1 rounded-pill">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-1 rounded-pill">Disabled</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-secondary btn-edit-category" title="Edit Category">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Toggle" asp-route-id="@cat.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-@(cat.IsActive ? "warning" : "success")" title="@(cat.IsActive ? "Disable" : "Enable")">
                                            <i class="bi bi-@(cat.IsActive ? "eye-slash" : "eye")"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger btn-delete-category" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal_@cat.Id" title="Delete Category">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                    <!-- Delete Category Modal -->
                                    <div class="modal fade text-start" id="deleteCategoryModal_@cat.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Category</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <p>Are you sure you want to delete category <strong>@cat.Name</strong>?</p>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@cat.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4 btn-confirm-delete-category">
                                                            Confirm Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center py-3">
            <span class="text-muted small">Page @currentPage of @totalPages</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@search" asp-route-active="@active">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
