@model Ayurveda.Application.ViewModels.AdminFinanceOverviewViewModel
@{
    ViewData["Title"] = "GST & Financial Reports (Demo)";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-bar-graph text-success me-2"></i>GST &amp; Financial Reports <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle small fs-6">Demo</span></h2>
        <p class="text-muted small mb-0">Financial reconciliation, estimated GST filing schedules (demo calculation), doctor payout settlement audit, and ledger downloads.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportGstCsv" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs">
            <i class="bi bi-download me-1"></i> Download GST Report CSV (Demo)
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Finance Overview
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h6 class="text-muted small text-uppercase fw-semibold mb-2">Estimated GST (5% - Demo)</h6>
            <h3 class="fw-bold text-success mb-1">₹@Model.TotalGstCollected.ToString("N2")</h3>
            <p class="small text-muted mb-0">Calculated composite GST matching cart &amp; checkout rate (5% Ayurvedic formulations - Demo).</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h6 class="text-muted small text-uppercase fw-semibold mb-2">Net Formulation Turnover</h6>
            <h3 class="fw-bold text-primary mb-1">₹@Model.GrossECommerceRevenue.ToString("N2")</h3>
            <p class="small text-muted mb-0">Total gross receipts across successful orders.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <h6 class="text-muted small text-uppercase fw-semibold mb-2">Doctor Consultations Gross</h6>
            <h3 class="fw-bold text-dark mb-1">₹@Model.GrossConsultationRevenue.ToString("N2")</h3>
            <p class="small text-muted mb-0">Platform commission retained (15%): ₹@Model.PlatformConsultationFeeCommission.ToString("N2")</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-journal-text text-success me-2"></i>Recent Transaction Ledger &amp; Invoice Records</h6>
        <span class="badge bg-light text-dark border">Audited Transactions (Demo)</span>
    </div>
    @if (!Model.RecentTransactions.Any())
    {
        <div class="text-center py-5 px-3">
            <div class="rounded-circle bg-success-subtle text-success mx-auto d-flex align-items-center justify-content-center mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                <i class="bi bi-file-earmark-spreadsheet"></i>
            </div>
            <h6 class="fw-bold text-dark mb-1">No Financial Transactions Recorded</h6>
            <p class="text-muted small mb-0">Orders and consultations will populate transaction ledgers automatically.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 small">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Invoice #</th>
                        <th>Date (UTC)</th>
                        <th>Customer</th>
                        <th>Payment Mode</th>
                        <th class="text-end">Taxable Amount</th>
                        <th class="text-end">Estimated GST (5% - Demo)</th>
                        <th class="text-end pe-4">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model.RecentTransactions)
                    {
                        var taxable = Math.Round(o.TotalAmount / 1.05m, 2);
                        var gst = o.TotalAmount - taxable;
                        <tr>
                            <td class="ps-4 fw-bold font-monospace">TGA-INV-@o.OrderNumber</td>
                            <td class="text-muted">@o.OrderDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@(o.User?.FullName ?? o.UserId.ToString())</td>
                            <td><span class="badge bg-light text-dark border">@o.PaymentMethod</span></td>
                            <td class="text-end font-monospace">₹@taxable.ToString("N2")</td>
                            <td class="text-end font-monospace text-warning fw-semibold">₹@gst.ToString("N2")</td>
                            <td class="text-end pe-4 font-monospace fw-bold text-success">₹@o.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
