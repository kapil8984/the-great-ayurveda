@model Ayurveda.Application.ViewModels.AdminFinanceOverviewViewModel
@{
    ViewData["Title"] = "Financial Ledger & GST Accounting";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-cash-stack text-success me-2"></i>Finance, Payouts &amp; GST Ledger</h2>
        <p class="text-muted small mb-0">Restricted financial ledger, statutory GST returns, and doctor commission payout reconciliation.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportGstCsv" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export GST Compliance CSV
        </a>
    </div>
</div>

<!-- Financial KPIs -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <span class="text-muted small text-uppercase fw-semibold">E-Commerce Gross</span>
            <h3 class="fw-bold text-success mb-0 mt-1">₹@Model.GrossECommerceRevenue.ToString("N0")</h3>
            <small class="text-muted">Direct formulation sales</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <span class="text-muted small text-uppercase fw-semibold">Consultations Gross</span>
            <h3 class="fw-bold text-primary mb-0 mt-1">₹@Model.GrossConsultationRevenue.ToString("N0")</h3>
            <small class="text-muted">Telemedicine fees</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <span class="text-muted small text-uppercase fw-semibold">Platform Fee (15%)</span>
            <h3 class="fw-bold text-dark mb-0 mt-1">₹@Model.PlatformConsultationFeeCommission.ToString("N0")</h3>
            <small class="text-muted">Retained platform commission</small>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card p-3 border-0 shadow-sm rounded-4 bg-white h-100">
            <span class="text-muted small text-uppercase fw-semibold">Total GST Accrued</span>
            <h3 class="fw-bold text-warning mb-0 mt-1">₹@Model.TotalGstCollected.ToString("N0")</h3>
            <small class="text-muted">12% products + 18% services</small>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Doctor Payouts Ledger -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-hospital text-success me-2"></i>Doctor Payouts &amp; Settlements</h5>
                <span class="badge bg-light text-dark border">15% Standard Deduction</span>
            </div>

            @if (!Model.DoctorPayoutLedger.Any())
            {
                <p class="text-muted small py-4 text-center mb-0">No completed consultations awaiting doctor settlement.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Doctor</th>
                                <th class="text-center">Consults</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Net (85%)</th>
                                <th class="text-end pe-3">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in Model.DoctorPayoutLedger)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold small text-dark">Dr. @p.DoctorName</div>
                                        <div class="text-muted" style="font-size: 0.725rem;">@p.Email</div>
                                    </td>
                                    <td class="text-center fw-semibold">@p.CompletedConsultations</td>
                                    <td class="text-end text-muted small">₹@p.TotalEarnings.ToString("N0")</td>
                                    <td class="text-end fw-bold text-success">₹@p.NetPayable.ToString("N0")</td>
                                    <td class="text-end pe-3">
                                        <form asp-action="ApprovePayout" method="post" class="d-inline" onsubmit="return confirm('Release settlement of ₹@p.NetPayable.ToString("N0") to Dr. @p.DoctorName?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="doctorId" value="@p.DoctorId" />
                                            <input type="hidden" name="amount" value="@p.NetPayable" />
                                            <button type="submit" class="btn btn-outline-success btn-sm rounded-pill px-3 py-1">
                                                Release Payout
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Recent Transactions & Settlement Escrow -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
            <h5 class="fw-bold text-dark mb-3"><i class="bi bi-receipt-cutoff text-primary me-2"></i>Recent Orders Ledger</h5>
            <div class="list-group list-group-flush">
                @foreach (var o in Model.RecentTransactions)
                {
                    <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold small">#@o.OrderNumber</div>
                            <div class="text-muted" style="font-size: 0.725rem;">@o.PaymentMethod • @o.OrderDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <div class="text-end">
                            <div class="fw-bold text-success small">₹@o.TotalAmount.ToString("N0")</div>
                            <span class="badge bg-light text-dark border" style="font-size: 0.65rem;">@o.Status</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-bank text-success me-1"></i>Statutory Tax Compliance</h6>
            <p class="small text-muted mb-0">GST calculations adhere strictly to CGST/SGST 2017 schedules. Monthly GSTR-1 returns can be filed using the exported compliance CSV.</p>
        </div>
    </div>
</div>
