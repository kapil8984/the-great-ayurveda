@model List<Ayurveda.Domain.Entities.Coupon>
@{
    ViewData["Title"] = "Festival Coupons & Offers";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tag text-success me-2"></i> Festive Offers &amp; Promo Coupons</h2>
        <p class="text-muted small mb-0">Manage customer promotional discounts, festive campaigns (Diwali, Navratri), basket minimums, and category eligibility.</p>
    </div>
    <button type="button" class="btn btn-success rounded-pill px-4 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#createCouponModal">
        <i class="bi bi-plus-circle me-1"></i> New Promo Coupon
    </button>
</div>

<!-- Coupons Table -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th class="ps-4">Promo Code</th>
                    <th>Type</th>
                    <th>Discount</th>
                    <th>Min. Order</th>
                    <th>Max. Cap</th>
                    <th>Category</th>
                    <th>Validity</th>
                    <th>Usage</th>
                    <th class="text-center">State</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-tag-fill display-4 d-block mb-2 text-secondary"></i>
                            No coupons created yet.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold font-monospace fs-6 text-success bg-success-subtle px-2 py-1 rounded">@c.Code</span>
                            </td>
                            <td><span class="badge bg-light text-dark border">@c.DiscountType</span></td>
                            <td class="fw-bold text-dark">
                                @(c.DiscountType == Ayurveda.Domain.Enums.DiscountType.Percentage ? $"{c.DiscountAmount}% OFF" : $"₹{c.DiscountAmount:N0} Flat")
                            </td>
                            <td class="small text-muted">₹@c.MinOrderAmount</td>
                            <td class="small text-muted">₹@c.MaxDiscountAmount</td>
                            <td>
                                <span class="badge bg-light text-secondary border">@(string.IsNullOrEmpty(c.ApplicableCategory) ? "All Categories" : c.ApplicableCategory)</span>
                            </td>
                            <td class="small text-muted">
                                @(c.StartDate?.ToString("dd MMM") ?? "Now") &rarr; @(c.ExpiryDate?.ToString("dd MMM yyyy") ?? "No Expiry")
                            </td>
                            <td class="small text-muted">@c.UsageCount / @c.UsageLimit</td>
                            <td class="text-center">
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border rounded-pill px-3 py-1">Disabled</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <form asp-action="ToggleCoupon" asp-route-id="@c.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn @(c.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(c.IsActive ? "Disable" : "Enable")">
                                            <i class="bi bi-@(c.IsActive ? "eye-slash" : "eye")"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editCouponModal-@c.Id" title="Edit Coupon">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <form asp-action="DeleteCoupon" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Delete coupon @c.Code?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Delete Coupon">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        <!-- Edit Coupon Modal -->
                        <div class="modal fade" id="editCouponModal-@c.Id" tabindex="-1">
                            <div class="modal-dialog modal-dialog-centered">
                                <div class="modal-content rounded-4 border-0 shadow">
                                    <form asp-action="EditCoupon" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <div class="modal-header border-0 pb-0">
                                            <h5 class="modal-title fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Edit Coupon: @c.Code</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                        </div>
                                        <div class="modal-body py-3">
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Coupon Code *</label>
                                                <input type="text" name="code" value="@c.Code" class="form-control rounded-3 font-monospace text-uppercase" required />
                                            </div>
                                            <div class="row g-2 mb-3">
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Discount Type</label>
                                                    <select name="discountType" class="form-select rounded-3">
                                                        <option value="Percentage" selected="@(c.DiscountType == Ayurveda.Domain.Enums.DiscountType.Percentage)">Percentage (%)</option>
                                                        <option value="Flat" selected="@(c.DiscountType == Ayurveda.Domain.Enums.DiscountType.Flat)">Flat Amount (₹)</option>
                                                    </select>
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Discount Amount *</label>
                                                    <input type="number" name="discountAmount" value="@c.DiscountAmount" step="1" class="form-control rounded-3" required />
                                                </div>
                                            </div>
                                            <div class="row g-2 mb-3">
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Min Cart Amount (₹)</label>
                                                    <input type="number" name="minOrderAmount" value="@c.MinOrderAmount" class="form-control rounded-3" />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Max Discount Cap (₹)</label>
                                                    <input type="number" name="maxDiscountAmount" value="@c.MaxDiscountAmount" class="form-control rounded-3" />
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label class="form-label small fw-semibold">Applicable Category (Optional)</label>
                                                <select name="applicableCategory" class="form-select rounded-3">
                                                    <option value="">All Store Categories</option>
                                                    @foreach (var cat in categories)
                                                    {
                                                        <option value="@cat" selected="@(c.ApplicableCategory == cat)">@cat</option>
                                                    }
                                                </select>
                                            </div>
                                            <div class="row g-2 mb-3">
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Start Date (Optional)</label>
                                                    <input type="date" name="startDate" value="@(c.StartDate?.ToString("yyyy-MM-dd"))" class="form-control rounded-3" />
                                                </div>
                                                <div class="col-6">
                                                    <label class="form-label small fw-semibold">Expiry Date (Optional)</label>
                                                    <input type="date" name="expiryDate" value="@(c.ExpiryDate?.ToString("yyyy-MM-dd"))" class="form-control rounded-3" />
                                                </div>
                                            </div>
                                            <div class="form-check form-switch mb-2">
                                                <input name="isActive" value="true" type="checkbox" class="form-check-input" id="cIsActive-@c.Id" @(c.IsActive ? "checked" : "") />
                                                <label class="form-check-label small fw-semibold" for="cIsActive-@c.Id">Coupon Active</label>
                                            </div>
                                        </div>
                                        <div class="modal-footer border-0 pt-0">
                                            <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Coupon Modal -->
<div class="modal fade" id="createCouponModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="CreateCoupon" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-tag text-success me-2"></i>Create Promo Coupon</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Coupon Code *</label>
                        <input type="text" name="code" class="form-control rounded-3 font-monospace text-uppercase" placeholder="e.g. DIWALI30, NAVRATRI20" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Discount Type</label>
                            <select name="discountType" class="form-select rounded-3">
                                <option value="Percentage">Percentage (%)</option>
                                <option value="Flat">Flat Amount (₹)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Discount Amount *</label>
                            <input type="number" name="discountAmount" step="1" class="form-control rounded-3" placeholder="e.g. 30" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Min Cart Amount (₹)</label>
                            <input type="number" name="minOrderAmount" value="499" class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Max Discount Cap (₹)</label>
                            <input type="number" name="maxDiscountAmount" value="500" class="form-control rounded-3" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Applicable Category (Optional)</label>
                        <select name="applicableCategory" class="form-select rounded-3">
                            <option value="">All Store Categories</option>
                            @foreach (var cat in categories)
                            {
                                <option value="@cat">@cat</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Start Date (Optional)</label>
                            <input type="date" name="startDate" class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Expiry Date (Optional)</label>
                            <input type="date" name="expiryDate" class="form-control rounded-3" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Create Coupon</button>
                </div>
            </form>
        </div>
    </div>
</div>
