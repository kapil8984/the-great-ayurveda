@model Ayurveda.Application.ViewModels.AdminProductListViewModel
@{
    ViewData["Title"] = "Herbal Catalogue & Inventory Management";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-box-seam text-success me-2"></i>Formulations &amp; Inventory</h2>
        <p class="text-muted small mb-0">Manage classical Shastriya formulations, pricing, warehouse stock, and catalog publishing.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Add Formulation
        </a>
        <a asp-action="ExportCsv" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-download me-1"></i> Export CSV
        </a>
        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#importCsvModal">
            <i class="bi bi-upload me-1"></i> Bulk CSV Update
        </button>
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@Model.SearchQuery" class="form-control border-start-0" placeholder="Search by title, SKU, brand..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">-- All Shastriya Categories --</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.SelectedCategoryId == cat.Id)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check form-switch pt-1">
                <input class="form-check-input" type="checkbox" role="switch" name="lowStock" value="true" id="lowStockSwitch" @(Model.LowStockOnly == true ? "checked" : "") onchange="this.form.submit()">
                <label class="form-check-label small text-warning fw-semibold" for="lowStockSwitch">Low Stock (&lt; 10)</label>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-check form-switch pt-1">
                <input class="form-check-input" type="checkbox" role="switch" name="outOfStock" value="true" id="outOfStockSwitch" @(Model.OutOfStockOnly == true ? "checked" : "") onchange="this.form.submit()">
                <label class="form-check-label small text-danger fw-semibold" for="outOfStockSwitch">Out of Stock</label>
            </div>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-success btn-sm rounded-pill w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Reset</a>
        </div>
    </form>
</div>

<!-- Products Table -->
<div class="card shadow-sm border-0 rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th class="ps-4">Formulation Details</th>
                    <th>Category</th>
                    <th>SKU</th>
                    <th>Price / MRP</th>
                    <th>Warehouse Stock</th>
                    <th class="text-center">Live Status</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Products.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-box display-4 d-block mb-2"></i>
                            No products match your filter criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var prod in Model.Products)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="@(string.IsNullOrEmpty(prod.ImageUrl) ? "/images/products/placeholder.svg" : prod.ImageUrl)" 
                                         alt="@prod.Title" width="44" height="44" class="rounded-3 border p-1 bg-light" style="object-fit: contain;" 
                                         onerror="this.onerror=null;this.src='/images/products/placeholder.svg';" />
                                    <div>
                                        <div class="fw-bold text-dark">@prod.Title</div>
                                        <div class="small text-muted" style="font-size: 0.75rem;">@prod.Brand</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @(prod.Category?.Name ?? "General")
                                </span>
                            </td>
                            <td>
                                <span class="small font-monospace text-muted">@prod.Sku</span>
                            </td>
                            <td>
                                <div class="fw-bold text-success">₹@prod.Price.ToString("N0")</div>
                                @if (prod.Mrp > prod.Price)
                                {
                                    <div class="text-muted text-decoration-line-through" style="font-size: 0.725rem;">₹@prod.Mrp.ToString("N0")</div>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (prod.Stock <= 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Out of Stock (0)</span>
                                    }
                                    else if (prod.Stock < 10)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-exclamation-triangle me-1"></i>Low: @prod.Stock Left
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success">@prod.Stock units</span>
                                    }
                                    <button type="button" class="btn btn-outline-secondary btn-sm p-0 rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 24px; height: 24px;" title="Quick Update Stock" data-bs-toggle="modal" data-bs-target="#stockModal_@prod.Id">
                                        <i class="bi bi-pencil" style="font-size: 0.65rem;"></i>
                                    </button>
                                </div>

                                <!-- Quick Stock Modal -->
                                <div class="modal fade" id="stockModal_@prod.Id" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <form asp-action="QuickStockUpdate" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@prod.Id" />
                                                <div class="modal-header border-0 pb-0">
                                                    <h6 class="modal-title fw-bold text-dark">Quick Stock Update</h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body py-2">
                                                    <div class="small text-muted mb-2 text-truncate">@prod.Title</div>
                                                    <label class="form-label text-xs fw-semibold">New Inventory Units:</label>
                                                    <input type="number" name="stock" value="@prod.Stock" min="0" class="form-control form-control-sm rounded-3" required />
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light btn-sm rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">Save</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (prod.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Published</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Unpublished</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-action="Edit" asp-route-id="@prod.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-2 py-1 btn-edit-product" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" asp-route-id="@prod.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm rounded-pill px-2 @(prod.IsActive ? "btn-outline-warning" : "btn-outline-success")" title="@(prod.IsActive ? "Unpublish" : "Publish")">
                                            <i class="bi @(prod.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-2 btn-delete-product" data-bs-toggle="modal" data-bs-target="#deleteProductModal_@prod.Id" title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>

                                    <!-- Delete Product Modal -->
                                    <div class="modal fade text-start" id="deleteProductModal_@prod.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Formulation</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <p>Are you sure you want to delete formulation <strong>@prod.Title</strong> (SKU: @prod.Sku)?</p>
                                                    <div class="alert alert-light border small text-muted">
                                                        <i class="bi bi-info-circle me-1 text-primary"></i> If this formulation is referenced by customer orders, it will be safely archived to protect order history while immediately removing it from public storefronts.
                                                    </div>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@prod.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4 btn-confirm-delete-product">
                                                            Confirm Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-0 py-3">
            <nav>
                <ul class="pagination pagination-sm justify-content-center mb-0">
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-lowStock="@Model.LowStockOnly" asp-route-search="@Model.SearchQuery">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

<!-- Bulk CSV Import Modal -->
<div class="modal fade" id="importCsvModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form asp-action="ImportCsv" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-spreadsheet text-success me-2"></i>Bulk Inventory &amp; Price Update</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="text-muted small">Upload a CSV exported from this system to update prices and stock levels in bulk. Column format: <code>Id,Title,SKU,Category,Brand,Price,MRP,StockQuantity...</code></p>
                    <input type="file" name="csvFile" class="form-control" accept=".csv" required />
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Upload &amp; Sync</button>
                </div>
            </form>
        </div>
    </div>
</div>
