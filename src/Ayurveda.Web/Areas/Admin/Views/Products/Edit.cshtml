@model Ayurveda.Application.ViewModels.AdminProductEditViewModel
@{
    ViewData["Title"] = $"Edit Formulation — {Model.Title}";
    var categories = ViewBag.Categories as List<Ayurveda.Domain.Entities.Category> ?? new();
    var subcategories = ViewBag.Subcategories as List<Ayurveda.Domain.Entities.Subcategory> ?? new();
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill mb-2">
        <i class="bi bi-arrow-left me-1"></i> Back to Inventory
    </a>
    <h2 class="fw-bold mb-1">Edit Formulation — @Model.Title</h2>
    <p class="text-muted small mb-0">Update SKU pricing, inventory stock, images, gallery, and botanical descriptions.</p>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 bg-white" style="max-width: 950px;">
    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editProductForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Title" class="form-label small fw-semibold">Formulation Title *</label>
                <input asp-for="Title" id="inputProductTitle" class="form-control rounded-3" required />
            </div>

            <div class="col-md-4">
                <label asp-for="Sku" class="form-label small fw-semibold">SKU Code *</label>
                <input asp-for="Sku" id="inputProductSku" class="form-control rounded-3" required />
            </div>

            <div class="col-md-6">
                <label asp-for="CategoryId" class="form-label small fw-semibold">Primary Category *</label>
                <select asp-for="CategoryId" id="selectCategory" class="form-select rounded-3" required>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id" selected="@(Model.CategoryId == c.Id)">@c.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="SubcategoryId" class="form-label small fw-semibold">Subcategory</label>
                <select asp-for="SubcategoryId" id="selectSubcategory" class="form-select rounded-3">
                    <option value="">-- None / Select Subcategory --</option>
                    @foreach (var s in subcategories)
                    {
                        <option value="@s.Id" selected="@(Model.SubcategoryId == s.Id)">@s.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="Brand" class="form-label small fw-semibold">Brand / Apothecary</label>
                <input asp-for="Brand" class="form-control rounded-3" />
            </div>

            <div class="col-md-3">
                <label asp-for="Price" class="form-label small fw-semibold">Selling Price (₹) *</label>
                <input asp-for="Price" id="inputProductPrice" type="number" step="1" min="0" class="form-control rounded-3" required />
            </div>

            <div class="col-md-3">
                <label asp-for="Mrp" class="form-label small fw-semibold">Maximum Retail Price (MRP ₹)</label>
                <input asp-for="Mrp" id="inputProductMrp" type="number" step="1" min="0" class="form-control rounded-3" />
            </div>

            <div class="col-md-4">
                <label asp-for="StockQuantity" class="form-label small fw-semibold">Warehouse Stock *</label>
                <input asp-for="StockQuantity" id="inputProductStock" type="number" min="0" class="form-control rounded-3" required />
            </div>

            <!-- Main Image with Preview -->
            <div class="col-md-8">
                <label class="form-label small fw-semibold">Upload New Main Image File (Max 5MB)</label>
                <input type="file" name="imageFile" id="mainImageEditInput" class="form-control rounded-3" accept="image/*,.svg" />
                <div class="d-flex align-items-center gap-3 mt-2">
                    <img id="mainImgEditPreview" src="@Model.ImageUrl" alt="Current Photo" class="rounded-3 border p-1" style="width: 80px; height: 80px; object-fit: contain; background: #fafafa;" onerror="this.src='/images/products/placeholder.svg'" />
                    <span class="text-xs text-muted">Current main image. Select a file to replace it.</span>
                </div>
            </div>

            <!-- Gallery Images -->
            <div class="col-12">
                <label class="form-label small fw-semibold">Add Gallery Images (Multiple Upload)</label>
                <input type="file" name="galleryFiles" id="galleryFilesEditInput" class="form-control rounded-3" accept="image/*,.svg" multiple />
                
                @if (Model.GalleryImageUrls.Any())
                {
                    <div class="mt-2">
                        <span class="text-xs text-muted d-block mb-1">Existing gallery photos:</span>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var g in Model.GalleryImageUrls)
                            {
                                <img src="@g" alt="Gallery" class="rounded-3 border p-1" style="width: 60px; height: 60px; object-fit: cover;" />
                            }
                        </div>
                    </div>
                }
                <div id="galleryEditPreviewGrid" class="d-flex flex-wrap gap-2 mt-2"></div>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label small fw-semibold">Classical Description *</label>
                <textarea asp-for="Description" id="inputProductDesc" rows="3" class="form-control rounded-3" required></textarea>
            </div>

            <div class="col-md-6">
                <label asp-for="KeyIngredients" class="form-label small fw-semibold">Key Ingredients</label>
                <input asp-for="KeyIngredients" class="form-control rounded-3" />
            </div>

            <div class="col-md-6">
                <label asp-for="HowToUse" class="form-label small fw-semibold">Dosage Instructions</label>
                <input asp-for="HowToUse" class="form-control rounded-3" />
            </div>

            <div class="col-12">
                <div class="d-flex gap-4 pt-2">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="IsActive" id="activeSwitchEdit">
                        <label class="form-check-label small fw-semibold" for="activeSwitchEdit">Publish Live</label>
                    </div>
                </div>
            </div>

            <div class="col-12 text-end pt-3 border-top">
                <button type="submit" id="btnSubmitEditProduct" class="btn btn-success rounded-pill px-4 py-2 shadow-sm">
                    <i class="bi bi-check-lg me-1"></i> Save Formulation Changes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById('mainImageEditInput')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert('File exceeds 5MB size limit.');
                    this.value = '';
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(evt) {
                    const img = document.getElementById('mainImgEditPreview');
                    if (img) img.src = evt.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        document.getElementById('galleryFilesEditInput')?.addEventListener('change', function(e) {
            const grid = document.getElementById('galleryEditPreviewGrid');
            if (!grid) return;
            grid.innerHTML = '';
            Array.from(e.target.files).forEach(file => {
                if (file.size <= 5 * 1024 * 1024) {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        const thumb = document.createElement('img');
                        thumb.src = evt.target.result;
                        thumb.className = 'rounded-3 border p-1';
                        thumb.style.width = '60px';
                        thumb.style.height = '60px';
                        thumb.style.objectFit = 'cover';
                        grid.appendChild(thumb);
                    };
                    reader.readAsDataURL(file);
                }
            });
        });
    </script>
}
