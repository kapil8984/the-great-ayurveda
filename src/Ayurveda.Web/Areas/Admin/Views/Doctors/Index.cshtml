@model List<Ayurveda.Domain.Entities.Doctor>
@{
    ViewData["Title"] = "Practicing Vaidyas & Doctor Directory";
    var specializations = ViewBag.Specializations as List<string> ?? new();
    var selectedStatus = ViewBag.SelectedStatus as string;
    var selectedSpec = ViewBag.SelectedSpecialization as string;
    var searchQuery = ViewBag.SearchQuery as string;
    var demoCount = (int)(ViewBag.DemoDoctorCount ?? 0);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-hospital text-success me-2"></i>Doctor Practice Management</h2>
        <p class="text-muted small mb-0">Audit verified AYUSH physicians, manage fee schedules, and oversee practice status.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Create" class="btn btn-success btn-sm rounded-pill px-3 shadow-xs fw-semibold">
            <i class="bi bi-plus-circle me-1"></i> Add Doctor
        </a>
        <a asp-action="Pending" class="btn btn-warning btn-sm rounded-pill px-3 shadow-xs fw-semibold">
            <i class="bi bi-person-exclamation me-1"></i> Verification Queue
        </a>
        @if (demoCount > 0 && User.IsInRole("SuperAdmin"))
        {
            <form asp-action="BulkRemoveDemoDoctors" method="post" class="d-inline" onsubmit="return confirm('WARNING: Are you sure you want to permanently bulk-remove all @demoCount seeded demonstration doctor profiles and their associated consultations?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                    <i class="bi bi-trash3 me-1"></i> Purge Demo Doctors (@demoCount)
                </button>
            </form>
        }
    </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-4">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@searchQuery" class="form-control border-start-0" placeholder="Search by name, email, phone..." />
            </div>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">-- All Practice Statuses --</option>
                <option value="Approved" selected="@(selectedStatus == "Approved")">Approved / Active</option>
                <option value="Pending" selected="@(selectedStatus == "Pending")">Pending Audit</option>
                <option value="Suspended" selected="@(selectedStatus == "Suspended")">Suspended</option>
                <option value="Rejected" selected="@(selectedStatus == "Rejected")">Rejected</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="specialization" class="form-select form-select-sm">
                <option value="">-- All Specializations --</option>
                @foreach (var spec in specializations)
                {
                    <option value="@spec" selected="@(selectedSpec == spec)">@spec</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-success btn-sm rounded-pill w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Reset</a>
        </div>
    </form>
</div>

<!-- Doctor Directory Table -->
<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th class="ps-4">Vaidya Details</th>
                        <th>Specialization</th>
                        <th>Registration No.</th>
                        <th>Fee (INR)</th>
                        <th>Rating</th>
                        <th class="text-center">Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x display-4 d-block mb-2"></i>
                                No doctor records matched the specified filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var doc in Model)
                        {
                            var detail = doc.DoctorDetail;
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(doc.ProfileImage) ? "/images/doctor-avatar.svg" : doc.ProfileImage)" alt="@doc.DoctorName" width="40" height="40" class="rounded-circle border bg-light" style="object-fit: cover;" data-fallback="/images/doctor-avatar.svg" />
                                        <div>
                                            <a asp-action="Details" asp-route-id="@doc.Id" class="fw-bold text-dark text-decoration-none">
                                                @doc.DoctorName
                                            </a>
                                            @if (detail != null && detail.IsDemoData)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary ms-1 font-monospace" style="font-size: 0.65rem;">DEMO</span>
                                            }
                                            <div class="small text-muted" style="font-size: 0.75rem;">@doc.Email</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-success-subtle text-success">
                                        @(detail?.Specialization?.Name ?? "General Practice")
                                    </span>
                                </td>
                                <td>
                                    <span class="small font-monospace text-muted">@(detail?.RegistrationNumber ?? "DEMO-PENDING")</span>
                                </td>
                                <td class="fw-bold text-dark">
                                    ₹@(detail?.ConsultationFee ?? 500m)
                                </td>
                                <td>
                                    <span class="small fw-semibold text-warning">
                                        <i class="bi bi-star-fill"></i> @(detail?.Rating.ToString("0.0") ?? "5.0")
                                    </span>
                                    <small class="text-muted">(@(detail?.ReviewCount ?? 0))</small>
                                </td>
                                <td class="text-center">
                                    @if (detail?.Status == 1)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            <i class="bi bi-check-circle-fill me-1"></i>Active
                                        </span>
                                    }
                                    else if (detail?.Status == 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">
                                            <i class="bi bi-hourglass-split me-1"></i>Pending
                                        </span>
                                    }
                                    else if (detail?.Status == 2)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                            <i class="bi bi-pause-circle me-1"></i>Suspended
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Rejected</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="dropdown">
                                        <button class="btn btn-light btn-sm rounded-circle p-2" type="button" data-bs-toggle="dropdown">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@doc.Id"><i class="bi bi-eye me-2"></i>360 View Profile</a></li>
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@doc.Id"><i class="bi bi-pencil-square me-2"></i>Edit Full Profile</a></li>
                                            <li><button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#editDoctorModal-@doc.Id"><i class="bi bi-pencil me-2"></i>Quick Edit Fee</button></li>
                                            <li><hr class="dropdown-divider"></li>
                                            @if (detail?.Status == 1)
                                            {
                                                <li>
                                                    <form asp-action="Suspend" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="doctorId" value="@doc.Id" />
                                                        <input type="hidden" name="reason" value="Suspended via admin console" />
                                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-pause-circle me-2"></i>Suspend Practice</button>
                                                    </form>
                                                </li>
                                            }
                                            else if (detail?.Status == 2)
                                            {
                                                <li>
                                                    <form asp-action="Reactivate" method="post" class="m-0">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="doctorId" value="@doc.Id" />
                                                        <button type="submit" class="dropdown-item text-success"><i class="bi bi-play-circle me-2"></i>Reactivate Practice</button>
                                                    </form>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteDocModal-@doc.Id">
                                                    <i class="bi bi-trash me-2"></i>Delete Doctor
                                                </button>
                                            </li>
                                        </ul>
                                    </div>

                                    <!-- Delete Doctor Modal -->
                                    <div class="modal fade text-start" id="deleteDocModal-@doc.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Dr. @doc.DoctorName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body py-3">
                                                    <p class="small text-muted mb-0">If this doctor has active consultations or reviews, the account will be safely soft-deleted to maintain patient medical history while immediately removing the doctor from public directories.</p>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@doc.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4">Confirm Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Edit Fee & Experience Modal -->
                                    <div class="modal fade text-start" id="editDoctorModal-@doc.Id" tabindex="-1">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <form asp-action="EditDetails" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="doctorId" value="@doc.Id" />
                                                    <div class="modal-header border-0 pb-0">
                                                        <h5 class="modal-title fw-bold">Edit Dr. @doc.DoctorName</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body py-3">
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Consultation Fee (₹)</label>
                                                            <input type="number" name="fee" value="@(detail?.ConsultationFee ?? 500m)" class="form-control rounded-3" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Clinical Experience (Years)</label>
                                                            <input type="number" name="experience" value="@(detail?.Experience ?? 5)" class="form-control rounded-3" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Affiliated Clinic Address</label>
                                                            <input type="text" name="clinicAddress" value="@(detail?.ClinicAddress)" class="form-control rounded-3" />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success rounded-pill px-4">Save Changes</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
