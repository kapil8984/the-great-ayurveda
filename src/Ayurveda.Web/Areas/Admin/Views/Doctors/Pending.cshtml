@model List<Ayurveda.Application.ViewModels.AdminPendingDoctorDto>
@{
    ViewData["Title"] = "Physician Verification Queue";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Doctor Verification Queue</h2>
        <p class="text-muted small mb-0">Verify AYUSH registrations and approve or reject clinical practitioner accounts</p>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Doctor</th>
                        <th>Credentials & Experience</th>
                        <th>Contact</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold fs-6">Dr. @doc.DoctorName</div>
                                <div class="badge bg-success-subtle text-success">@doc.Specialization</div>
                            </td>
                            <td>
                                <div><strong>Qualification:</strong> @doc.Qualification</div>
                                <div class="small text-muted"><strong>Experience:</strong> @doc.ExperienceYears Years</div>
                            </td>
                            <td>
                                <div>@doc.Email</div>
                                <div class="small text-muted">@doc.ContactNumber</div>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <form asp-action="Approve" method="post" class="m-0">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3">
                                            <i class="bi bi-check-lg"></i> Approve
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#rejectModal_@doc.DoctorId">
                                        <i class="bi bi-x-lg"></i> Reject
                                    </button>
                                </div>

                                <!-- Reject Reason Modal -->
                                <div class="modal fade" id="rejectModal_@doc.DoctorId" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <form asp-action="Reject" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="doctorId" value="@doc.DoctorId" />
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Reject Application: Dr. @doc.DoctorName</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <label class="form-label small fw-semibold">Mandatory Rejection Reason *</label>
                                                    <textarea name="rejectionReason" class="form-control" rows="3" required placeholder="e.g. Registration number could not be verified on state AYUSH register..."></textarea>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card p-5 text-center border-0 shadow-sm rounded-4">
        <i class="bi bi-check-circle text-success display-4 mb-3"></i>
        <h5 class="fw-bold">No Pending Applications</h5>
        <p class="text-muted small">All physician registrations are currently reviewed and up to date.</p>
    </div>
}
