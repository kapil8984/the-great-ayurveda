@model Ayurveda.Application.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Demo Admin Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Demo Admin Sign Up • The Great Ayurveda</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0C1E14" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        :root {
            --tga-forest-deep: #08150E;
            --tga-forest-base: #0E2418;
            --tga-forest-surface: #153423;
            --tga-gold-primary: #D4AF37;
            --tga-gold-light: #F3E5AB;
            --tga-ink-light: #E6ECE8;
            --tga-ink-muted: #94A39B;
        }

        body {
            background-color: var(--tga-forest-deep);
            color: var(--tga-ink-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .auth-card {
            background: linear-gradient(145deg, rgba(21, 52, 35, 0.95), rgba(14, 36, 24, 0.98));
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 480px;
            padding: 2.5rem 2rem;
        }

        .form-control {
            background-color: rgba(8, 21, 14, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: var(--tga-ink-light);
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }

        .form-control:focus {
            background-color: rgba(8, 21, 14, 0.9);
            border-color: var(--tga-gold-primary);
            color: #FFFFFF;
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.2);
        }

        .btn-gold {
            background: linear-gradient(135deg, #D4AF37, #AA820A);
            color: #08150E;
            font-weight: 700;
            border: none;
            border-radius: 9999px;
            padding: 0.8rem 1.5rem;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .btn-gold:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(212, 175, 55, 0.35);
            color: #08150E;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 rounded-circle bg-dark border border-warning mb-2">
                <i class="bi bi-shield-lock text-warning fs-3"></i>
            </div>
            <h3 class="fw-bold text-white mb-1">Demo Admin Registration</h3>
            <p class="text-muted small">
                Sign up for explore access as <strong class="text-warning">Demo admin (read-only)</strong>
            </p>
            <div class="badge bg-warning text-dark px-3 py-1 rounded-pill small mb-2">
                <i class="bi bi-info-circle me-1"></i> Read-only Sandbox Access
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small border-0 rounded-3 mb-3 text-start" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Register" method="post" id="adminRegisterForm">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="FullName" class="form-label small text-warning fw-semibold">Full Name *</label>
                <input asp-for="FullName" class="form-control" placeholder="Demo Admin Name" required />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small text-warning fw-semibold">Email Address (name@domain.tld) *</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="admin@domain.com" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small text-warning fw-semibold">Password *</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label small text-warning fw-semibold">Confirm Password *</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gold w-100 mb-3">
                <i class="bi bi-person-check me-1"></i> Register as Demo Admin
            </button>
        </form>

        <div class="pt-3 border-top border-secondary border-opacity-25 text-center">
            <span class="text-muted small">Already have admin credentials?</span>
            <a href="/admin-portal/auth/login" class="text-warning text-decoration-none fw-semibold small ms-1">Sign In →</a>
        </div>
    </div>
</body>
</html>
