@model Ayurveda.Application.ViewModels.VerifyEmailOtpViewModel
@{
    ViewData["Title"] = "Verify Demo Admin Email";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Verify Demo Admin • The Great Ayurveda</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0C1E14" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        :root {
            --tga-forest-deep: #08150E;
            --tga-forest-base: #0E2418;
            --tga-forest-surface: #153423;
            --tga-gold-primary: #D4AF37;
            --tga-gold-light: #F3E5AB;
            --tga-ink-light: #E6ECE8;
            --tga-ink-muted: #94A39B;
        }

        body {
            background-color: var(--tga-forest-deep);
            color: var(--tga-ink-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .auth-card {
            background: linear-gradient(145deg, rgba(21, 52, 35, 0.95), rgba(14, 36, 24, 0.98));
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 480px;
            padding: 2.5rem 2rem;
        }

        .admin-otp-box {
            width: clamp(36px, 10vw, 46px);
            height: clamp(44px, 12vw, 54px);
            text-align: center;
            font-size: 1.5rem;
            font-weight: 700;
            background-color: rgba(8, 21, 14, 0.85);
            border: 2px solid rgba(212, 175, 55, 0.4);
            color: var(--tga-gold-light);
            border-radius: 8px;
        }

        .admin-otp-box:focus {
            border-color: var(--tga-gold-primary);
            box-shadow: 0 0 8px rgba(212, 175, 55, 0.4);
            outline: none;
        }

        .btn-gold {
            background: linear-gradient(135deg, #D4AF37, #AA820A);
            color: #08150E;
            font-weight: 700;
            border: none;
            border-radius: 9999px;
            padding: 0.8rem 1.5rem;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .btn-gold:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(212, 175, 55, 0.35);
            color: #08150E;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 rounded-circle bg-dark border border-warning mb-2">
                <i class="bi bi-shield-check text-warning fs-3"></i>
            </div>
            <h3 class="fw-bold text-white mb-1">Verify Demo Admin Account</h3>
            <p class="text-muted small">
                Verification for <strong class="text-warning">@Model.Email</strong>
            </p>
            <div class="badge bg-warning text-dark px-3 py-1 rounded-pill small mb-2">
                <i class="bi bi-info-circle me-1"></i> Demo: enter any 6 digits
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small border-0 rounded-3 mb-3 text-start" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <div id="adminClientError" class="alert alert-danger py-2 small border-0 rounded-3 mb-3 d-none text-start"></div>

        <form asp-action="VerifyOtp" method="post" id="adminVerifyOtpForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Otp" id="adminHiddenVerifyOtp" />

            <div class="mb-4 text-center">
                <label class="form-label small text-warning fw-semibold mb-2">Enter 6-Digit Code</label>
                <div class="d-flex justify-content-center gap-2 mb-2">
                    @for (int i = 0; i < 6; i++)
                    {
                        <input type="text" 
                               maxlength="1" 
                               class="admin-otp-box" 
                               data-index="@i" 
                               inputmode="numeric" 
                               pattern="[0-9]*" 
                               autocomplete="one-time-code" 
                               required />
                    }
                </div>
            </div>

            <button type="submit" id="btnVerifyOtp" class="btn btn-gold w-100 mb-3">
                <i class="bi bi-check-circle me-1"></i> Confirm &amp; Access Admin Portal
            </button>
        </form>
    </div>

    <script>
        const boxes = document.querySelectorAll(".admin-otp-box");
        const hiddenOtp = document.getElementById("adminHiddenVerifyOtp");
        const form = document.getElementById("adminVerifyOtpForm");
        const errDiv = document.getElementById("adminClientError");

        boxes.forEach((box, idx) => {
            box.addEventListener("input", (e) => {
                const val = e.target.value.replace(/[^0-9]/g, "");
                e.target.value = val;
                if (val.length === 1 && idx < boxes.length - 1) {
                    boxes[idx + 1].focus();
                }
                syncOtp();
            });

            box.addEventListener("keydown", (e) => {
                if (e.key === "Backspace" && !box.value && idx > 0) {
                    boxes[idx - 1].focus();
                }
            });

            box.addEventListener("paste", (e) => {
                e.preventDefault();
                const pasted = (e.clipboardData || window.clipboardData).getData("text").replace(/[^0-9]/g, "");
                if (pasted.length >= 6) {
                    for (let i = 0; i < 6; i++) {
                        boxes[i].value = pasted[i];
                    }
                    boxes[5].focus();
                    syncOtp();
                }
            });
        });

        function syncOtp() {
            let code = "";
            boxes.forEach(b => code += b.value);
            if (hiddenOtp) hiddenOtp.value = code;
        }

        if (boxes.length > 0) boxes[0].focus();

        if (form) {
            form.addEventListener("submit", (e) => {
                syncOtp();
                if (hiddenOtp.value.length < 6 || !/^\d{6}$/.test(hiddenOtp.value)) {
                    e.preventDefault();
                    if (errDiv) {
                        errDiv.innerText = "Please enter all 6 numeric digits (Demo: enter any 6 digits).";
                        errDiv.classList.remove("d-none");
                    }
                }
            });
        }
    </script>
</body>
</html>
