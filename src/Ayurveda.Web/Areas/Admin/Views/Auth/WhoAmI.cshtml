@{
    ViewData["Title"] = "Admin Identity Diagnostic (WhoAmI)";
    var email = ViewBag.Email as string ?? "Unknown";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
    var menuItems = ViewBag.MenuItems as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-badge text-success me-2"></i>Admin Identity &amp; RBAC Diagnostic</h2>
        <p class="text-muted small mb-0">Active administrative session credentials, assigned roles, and policy evaluation results.</p>
    </div>
    <div>
        <a href="?json=1" target="_blank" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-filetype-json me-1"></i> View Raw JSON
        </a>
    </div>
</div>

<div class="row g-4">
    <!-- User Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; font-size: 1.5rem;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-0 text-dark">Authenticated Admin</h5>
                    <span class="badge bg-success-subtle text-success border border-success-subtle">AdminCookieScheme</span>
                </div>
            </div>
            
            <div class="mb-3">
                <label class="form-label small text-muted text-uppercase fw-semibold mb-1">Account Email</label>
                <div class="fw-semibold text-dark font-monospace">@email</div>
            </div>

            <div>
                <label class="form-label small text-muted text-uppercase fw-semibold mb-1">Assigned Identity Roles</label>
                <div class="d-flex flex-wrap gap-1">
                    @if (roles.Any())
                    {
                        @foreach (var r in roles)
                        {
                            <span class="badge @(r == "SuperAdmin" ? "bg-danger" : r == "Admin" ? "bg-dark" : r == "FinanceManager" ? "bg-warning text-dark" : r == "CatalogManager" ? "bg-success" : r == "DemoViewer" ? "bg-info text-dark" : "bg-primary") px-2 py-1">
                                @r
                            </span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-secondary">No Explicit Roles Assigned</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Menu Accessibility Table -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-layout-sidebar-inset text-success me-2"></i>Menu Items &amp; Policy Status</h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Sidebar Menu Item</th>
                            <th>Guarding Policy</th>
                            <th class="text-center">Visibility Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in menuItems)
                        {
                            bool isVis = item.Visible;
                            <tr>
                                <td class="ps-4 fw-semibold text-dark">@item.Item</td>
                                <td class="font-monospace text-muted">@item.Policy</td>
                                <td class="text-center">
                                    @if (isVis)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-eye me-1"></i>Visible
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                            <i class="bi bi-eye-slash me-1"></i>Hidden
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
