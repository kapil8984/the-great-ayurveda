@model Ayurveda.Application.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Admin Password Recovery";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Password Recovery • Admin Portal • The Great Ayurveda</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0C1E14" />

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/bootstrap-icons/bootstrap-icons.min.css" />

    <style>
        :root {
            --tga-forest-deep: #08150E;
            --tga-forest-base: #0E2418;
            --tga-forest-surface: #153423;
            --tga-gold-primary: #D4AF37;
            --tga-gold-light: #F3E5AB;
            --tga-ink-light: #E6ECE8;
            --tga-ink-muted: #94A39B;
        }

        body {
            background-color: var(--tga-forest-deep);
            color: var(--tga-ink-light);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }

        .auth-card {
            background: linear-gradient(145deg, rgba(21, 52, 35, 0.95), rgba(14, 36, 24, 0.98));
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 460px;
            padding: 2.5rem 2rem;
        }

        .form-control {
            background-color: rgba(8, 21, 14, 0.7);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: var(--tga-ink-light);
            border-radius: 10px;
            padding: 0.75rem 1rem;
        }

        .form-control:focus {
            background-color: rgba(8, 21, 14, 0.9);
            border-color: var(--tga-gold-primary);
            color: #FFFFFF;
            box-shadow: 0 0 0 0.25rem rgba(212, 175, 55, 0.2);
        }

        .btn-gold {
            background: linear-gradient(135deg, #D4AF37, #AA820A);
            color: #08150E;
            font-weight: 700;
            border: none;
            border-radius: 9999px;
            padding: 0.8rem 1.5rem;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .btn-gold:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(212, 175, 55, 0.35);
            color: #08150E;
        }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex p-3 rounded-circle bg-dark border border-warning mb-3">
                <i class="bi bi-shield-lock text-warning fs-3"></i>
            </div>
            <h3 class="fw-bold text-white mb-1">Administrative Recovery</h3>
            <p class="text-muted small">Enter your administrative email to receive a secure 6-digit recovery code.</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 small border-0 rounded-3 mb-3" role="alert">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-4">
                <label class="form-label small text-warning fw-semibold">Admin Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-warning border-opacity-25 text-warning"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control" placeholder="admin@thegreatayurveda.com" required autocomplete="email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-gold w-100 mb-3">
                <i class="bi bi-send me-1"></i> Send Recovery Code
            </button>

            <div class="text-center">
                <a asp-action="Login" class="text-decoration-none small text-warning opacity-75 hover-opacity-100">
                    <i class="bi bi-arrow-left me-1"></i> Return to Admin Sign In
                </a>
            </div>
        </form>
    </div>
</body>
</html>
